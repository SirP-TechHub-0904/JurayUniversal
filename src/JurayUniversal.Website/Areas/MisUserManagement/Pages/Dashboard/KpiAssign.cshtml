@page "{id?}"
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.KpiAssignModel
@{
    ViewData["Title"] = "Evaluate KPIs";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
    ViewData["ShowBackButton"] = false;
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "Users";
}

@section HeaderActions {
    <a asp-page="/Dashboard/Detail" asp-route-id="@Model.UserProfile.Id" class="btn btn-secondary rounded-pill px-4">
        <i class="bi bi-x-circle me-1"></i> Cancel
    </a>
}

<div class="page-content">
    <!-- Period Configuration Card -->
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-4">
            <form method="get" id="periodForm">
                <label class="form-label text-muted fw-semibold">Evaluation Period</label>
                <div class="d-flex flex-column flex-md-row gap-3 mb-2">
                    <div class="flex-grow-1">
                        <select id="periodDropdown" name="Period" class="form-select" onchange="handlePeriodChange(this)">
                            @if (Model.ExistingPeriods.Count == 0 && !Model.PeriodIsNew)
                            {
                                <option value="@Model.Period" selected>@Model.Period (Default)</option>
                            }
                            @foreach (var p in Model.ExistingPeriods)
                            {
                                <option value="@p" selected="@(p.Equals(Model.Period, StringComparison.OrdinalIgnoreCase))">@p</option>
                            }
                            <option value="__NEW__" selected="@Model.PeriodIsNew">+ Create New Evaluation Period...</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill" id="refreshBtn">
                        <i class="bi bi-arrow-repeat me-1"></i> Load Period / Scoresheet
                    </button>
                </div>

                <div id="newPeriodInputGroup" class="mt-3 p-3 bg-light rounded-3 border @(Model.PeriodIsNew ? "" : "d-none")">
                    <label class="form-label text-primary fw-bold mb-1"><i class="bi bi-plus-circle me-1"></i> Enter New Evaluation Period Title</label>
                    <input type="text" id="newPeriodTitleInput" name="NewPeriodTitle" class="form-control" placeholder="e.g. Q3 2026, Q4 2026, August 2026..." value="@(Model.PeriodIsNew ? Model.Period : "")" />
                    <small class="text-muted fs-7 mt-1 d-block">This new period title will be saved and available in the dropdown for all user evaluations.</small>
                </div>
            </form>
        </div>
    </div>

    <!-- Evaluation Scoresheet Card -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header border-bottom bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">
                <i class="bi bi-clipboard-check text-success me-1"></i> 
                Scoresheet for Period: <span class="text-success fw-bold" id="currentPeriodDisplay">@(Model.PeriodIsNew ? (string.IsNullOrEmpty(Model.Period) ? "New Period" : Model.Period) : Model.Period)</span>
            </h5>
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">
                User: @Model.UserProfile.GetFullName()
            </span>
        </div>
        <div class="card-body py-4">
            @if (Model.ScoreSheet.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>
                    No active KPI indicators are currently configured. 
                    <a asp-page="/Dashboard/KpiSettings" class="btn btn-sm btn-primary rounded-pill ms-2">Configure Indicators First</a>
                </div>
            }
            else
            {
                <form method="post" id="postScoresheetForm">
                    <input type="hidden" name="Period" id="postPeriodInput" value="@Model.Period" />
                    <input type="hidden" name="NewPeriodTitle" id="postNewPeriodTitleInput" value="" />

                    <div class="d-flex flex-column gap-4 mb-4">
                        @for (int i = 0; i < Model.ScoreSheet.Count; i++)
                        {
                            <div class="p-3 border rounded-3 bg-light bg-opacity-50">
                                <input type="hidden" asp-for="ScoreSheet[i].Id" />
                                <input type="hidden" asp-for="ScoreSheet[i].ProfileId" />
                                <input type="hidden" asp-for="ScoreSheet[i].Period" />
                                <input type="hidden" asp-for="ScoreSheet[i].MisKpiIndicatorId" />
                                <input type="hidden" asp-for="ScoreSheet[i].IndicatorTitle" />
                                <input type="hidden" asp-for="ScoreSheet[i].MaxScore" />

                                <div class="row align-items-center g-3">
                                    <div class="col-12 col-md-5">
                                        <h6 class="mb-1 text-dark fw-bold">@Model.ScoreSheet[i].IndicatorTitle</h6>
                                        <span class="text-muted fs-7">Maximum possible score: <strong>@Model.ScoreSheet[i].MaxScore</strong></span>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label text-muted fs-7 mb-1">Score Given</label>
                                        <div class="d-flex align-items-center">
                                            <input type="number" step="0.01" min="0" max="@Model.ScoreSheet[i].MaxScore" asp-for="ScoreSheet[i].Score" class="form-control fw-bold text-success text-center" style="width: 120px;" required />
                                            <span class="ms-2 text-muted fw-bold">/ @Model.ScoreSheet[i].MaxScore</span>
                                        </div>
                                        <span asp-validation-for="ScoreSheet[i].Score" class="text-danger fs-7"></span>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label text-muted fs-7 mb-1">Remarks / Feedback</label>
                                        <input type="text" asp-for="ScoreSheet[i].Remarks" class="form-control fs-7" placeholder="Add optional remarks..." />
                                        <span asp-validation-for="ScoreSheet[i].Remarks" class="text-danger fs-7"></span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-bold" onclick="syncPeriodBeforeSubmit()">
                        <i class="bi bi-check-circle-fill me-1"></i> Save Evaluations & Submit Ratings
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<script>
    function handlePeriodChange(selectEl) {
        var newGroup = document.getElementById('newPeriodInputGroup');
        if (selectEl.value === '__NEW__') {
            newGroup.classList.remove('d-none');
            document.getElementById('newPeriodTitleInput').focus();
        } else {
            newGroup.classList.add('d-none');
            document.getElementById('periodForm').submit();
        }
    }

    function syncPeriodBeforeSubmit() {
        var dropdownVal = document.getElementById('periodDropdown').value;
        var postPeriod = document.getElementById('postPeriodInput');
        var postNewTitle = document.getElementById('postNewPeriodTitleInput');
        var newTitleInput = document.getElementById('newPeriodTitleInput');

        if (dropdownVal === '__NEW__') {
            postPeriod.value = '__NEW__';
            postNewTitle.value = newTitleInput.value;
        } else {
            postPeriod.value = dropdownVal;
            postNewTitle.value = '';
        }
    }
</script>
