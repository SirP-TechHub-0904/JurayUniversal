@page
@model JurayUniversal.Website.Areas.MisFinances.Pages.Dashboard.OverdueModel
@{
    ViewData["Title"] = "Overdue & Compliance";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
    ViewData["ActiveMenu"] = "MisFinances";
    ViewData["ActiveSubMenu"] = "Overdue";
}

<div class="mis-page-header d-flex justify-content-between align-items-center">
    <div>
        
        <div class="text-muted fs-7">Track members who have missed compulsory payments for the current period.</div>
    </div>
    <div class="d-flex gap-2">
        
        <a asp-page="./Categories" class="btn btn-light btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> Categories</a>
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fs-1 fw-bold text-primary">@Model.TotalCompulsoryCategories</div>
                <div class="text-muted fs-7">Compulsory Fees</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fs-1 fw-bold text-danger">@Model.TotalDefaulters</div>
                <div class="text-muted fs-7">Total Overdue</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fs-1 fw-bold text-success">@Model.FullyPaidCategories</div>
                <div class="text-muted fs-7">Fully Compliant Categories</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                @{
                    var avgCompliance = Model.OverdueCategories.Any()
                        ? (int)Math.Round(Model.OverdueCategories.Average(c => c.CompliancePercent))
                        : 100;
                    var complianceColor = avgCompliance >= 80 ? "text-success" : avgCompliance >= 50 ? "text-warning" : "text-danger";
                }
                <div class="fs-1 fw-bold @complianceColor">@avgCompliance%</div>
                <div class="text-muted fs-7">Avg Compliance Rate</div>
            </div>
        </div>
    </div>

    @if (!Model.OverdueCategories.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle-fill text-success fs-1 mb-2 d-block"></i>
                <h4 class="fw-bold text-muted">No Compulsory Fees Set Up</h4>
                <p class="text-muted">Create compulsory payment categories to start tracking member compliance.</p>
                <a asp-page="./Categories" class="btn btn-primary rounded-pill px-4 mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Go to Categories
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model.OverdueCategories)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center rounded-top-4">
                    <div>
                        <h5 class="fw-bold mb-0">
                            @item.Category.Title
                            @if (item.DefaulterCount > 0)
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill ms-2">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @item.DefaulterCount Overdue
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill ms-2">
                                    <i class="bi bi-check-circle-fill me-1"></i> All Paid
                                </span>
                            }
                        </h5>
                        <div class="text-muted fs-7 mt-1">
                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill me-1">@item.Category.Frequency</span>
                            <span>Period: <strong>@item.PeriodLabel</strong></span>
                            @if (item.Category.FixedAmount.HasValue)
                            {
                                <span class="ms-2">Â· Amount: <strong>&#8358;@item.Category.FixedAmount.Value.ToString("N2")</strong></span>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        <!-- Compliance ring -->
                        <div class="d-inline-flex align-items-center gap-2">
                            <div class="position-relative d-inline-flex justify-content-center align-items-center" style="width: 56px; height: 56px;">
                                <svg viewBox="0 0 36 36" style="width: 56px; height: 56px; transform: rotate(-90deg);">
                                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                          fill="none" stroke="#e9ecef" stroke-width="3" />
                                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                          fill="none"
                                          stroke="@(item.CompliancePercent >= 80 ? "#198754" : item.CompliancePercent >= 50 ? "#ffc107" : "#dc3545")"
                                          stroke-width="3"
                                          stroke-dasharray="@item.CompliancePercent, 100" />
                                </svg>
                                <span class="position-absolute fw-bold" style="font-size: 11px;">@item.CompliancePercent%</span>
                            </div>
                            <div class="text-muted fs-8">
                                <div>@item.PaidCount / @item.TotalMembers paid</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (item.DefaulterCount > 0)
                {
                    <div class="card-body px-4 pt-0 pb-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;">#</th>
                                        <th>Member Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int idx = 0; }
                                    @foreach (var u in item.Defaulters)
                                    {
                                        idx++;
                                        <tr>
                                            <td class="text-muted">@idx</td>
                                            <td class="fw-semibold">@u.FirstName @u.LastName</td>
                                            <td class="text-muted">@u.Email</td>
                                            <td class="text-muted">@(u.PhoneNumber ?? "â€”")</td>
                                            <td>
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">
                                                    <i class="bi bi-x-circle me-1"></i> Not Paid
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />


