@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Dashboard.PhoneBooks.CreateModel
@{
    ViewData["Title"] = "Create Global Phone Book";
    ViewData["Subtitle"] = "Fill out the form below to add a new record.";
}



<div class="row">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="fa fa-book text-primary"></i> Phone Book Details</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="PhoneBook.Name" class="form-label font-weight-bold">Name</label>
                        <input asp-for="PhoneBook.Name" class="form-control" required placeholder="e.g. All Active Staff" />
                        <span asp-validation-for="PhoneBook.Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="PhoneBook.Name" class="form-label font-weight-bold">Description (Optional)</label>
                        <textarea asp-for="PhoneBook.Name" class="form-control" rows="3" placeholder="Brief description of this global contact list..."></textarea>
                        <span asp-validation-for="PhoneBook.Name" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fa fa-save"></i> Save Global Phone Book
                    </button>
                    
                    <div class="mt-3 text-center">
                        <a href="/MisMassComm/Dashboard/PhoneBooks/Index" class="text-muted">Cancel and return</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

