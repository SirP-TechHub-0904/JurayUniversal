@page
@model JurayUniversal.MisCentral.Pages.PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_PublicLayout";
}

<!-- breadcrumb-area -->
<section class="breadcrumb__area breadcrumb__bg fix" data-background="/xyz-mis/assets/img/bg/breadcrumb_bg.jpg">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb__content">
                    <h2 class="title">Privacy Policy</h2>
                    <nav class="breadcrumb">
                        <span property="itemListElement" typeof="ListItem">
                            <a asp-page="/Index">Home</a>
                        </span>
                        <span class="breadcrumb-separator">/</span>
                        <span property="itemListElement" typeof="ListItem">Privacy Policy</span>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- breadcrumb-area-end -->

<!-- privacy-content-area -->
<section class="section-py-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill font-semibold mb-3">Last Updated: October 2026</span>
                    <h1 class="fw-bold text-gray-900 mb-4">Exwhyzee MIS Privacy Policy</h1>
                    
                    <p class="lead text-muted mb-4">At Exwhyzee MIS, we are committed to protecting the confidentiality, privacy, and integrity of the data entrusted to us by schools, hospitals, businesses, and government organizations.</p>

                    <hr class="my-4" />

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">1. 100% Dedicated &amp; Private Workspaces</h4>
                    <p class="text-gray-600 leading-relaxed">Every client organization on Exwhyzee MIS operates within their own completely private and isolated environment. Your student data, staff payroll records, accounting books, and medical files are never mixed or shared with any other organization.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">2. Information We Collect</h4>
                    <p class="text-gray-600 leading-relaxed">We collect only necessary information required to operate and provide our management software, including:</p>
                    <ul class="text-gray-600 space-y-2 mb-4">
                        <li><strong>Account Profile:</strong> Name, official organization email, phone number, and administrative credentials.</li>
                        <li><strong>Institutional Operational Data:</strong> Records inputted directly by your authorized personnel (such as student profiles, staff rosters, attendance, fee invoices, and exam questions).</li>
                        <li><strong>Technical Logs:</strong> IP addresses and browser types strictly for system security, fraud prevention, and audit logs.</li>
                    </ul>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">3. How We Use Your Information</h4>
                    <p class="text-gray-600 leading-relaxed">Your data is strictly used to deliver, maintain, and support your organization’s management system. We <strong>never sell, lease, or monetize</strong> your personal or organizational data to third parties or advertisers.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">4. Data Encryption &amp; Security Standards</h4>
                    <p class="text-gray-600 leading-relaxed">All information transmitted between your web browser and our servers is secured using modern SSL/TLS 256-bit encryption. We perform automated daily backups and automated threat monitoring to prevent unauthorized access.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">5. Data Ownership &amp; Export</h4>
                    <p class="text-gray-600 leading-relaxed">You own 100% of your data. As an administrator, you have full rights to export your student rosters, financial reports, payroll summaries, and examination grades at any time in standard Excel/PDF formats.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">6. Contact Our Data Protection Officer</h4>
                    <p class="text-gray-600 leading-relaxed">If you have questions regarding data privacy or security compliance, reach us anytime at <a href="mailto:support@exwhyzee.ng" class="text-primary fw-bold">support@exwhyzee.ng</a> or call <a href="tel:+2348165680904" class="text-primary fw-bold">+234 816 568 0904</a>.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- privacy-content-area-end -->
