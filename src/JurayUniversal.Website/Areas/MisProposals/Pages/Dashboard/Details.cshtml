@page
@model JurayUniversal.Website.Areas.MisProposals.Pages.Dashboard.DetailsModel
@{
    ViewData["Title"] = "Review Proposal";
    ViewData["Subtitle"] = "View detailed information and associated records.";
}

<div class="container-fluid max-w-900 mx-auto">

    <div class="row g-4">
        <!-- Main Proposal Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    
                    <div class="mb-4">
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill float-end">
                            <i class="bi bi-calendar3 me-1"></i> @Model.Proposal.DateSubmitted?.ToString("MMM dd, yyyy")
                        </span>
                        <h4 class="fw-bold text-dark mb-1">@Model.Proposal.Title</h4>
                        @if (!string.IsNullOrEmpty(Model.Proposal.Address))
                        {
                            <p class="text-muted small"><i class="bi bi-geo-alt-fill me-1 text-danger"></i> @Model.Proposal.Address</p>
                        }
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4">
                        <h6 class="fw-bold text-dark mb-2">Executive Summary</h6>
                        <p class="mb-0 text-muted">@Model.Proposal.Description</p>
                    </div>

                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Full Narrative</h5>
                    <div class="mb-4">
                        @if (!string.IsNullOrEmpty(Model.Proposal.TypedProposal))
                        {
                            <div>@Html.Raw(Model.Proposal.TypedProposal)</div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic">No typed narrative provided. Please check the attached files.</p>
                        }
                    </div>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.Proposal.Note))
            {
                <div class="card border-0 bg-warning bg-opacity-10 rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Applicant's Note</h6>
                        <p class="mb-0 text-dark">@Model.Proposal.Note</p>
                    </div>
                </div>
            }

        @if (Model.Proposal.Status == JurayUniversal.Domain.Enum.Enum.ProposalStatus.Approved)
        {
            <!-- Execution Plan -->
            <div class="card border-0 shadow-sm rounded-4 mt-4">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-list-check text-success me-2"></i> Execution Plan & Phases</h5>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addPhaseModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Phase
                    </button>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4 text-muted small d-flex justify-content-between">
                        <span><strong>Duration:</strong> @(Model.Proposal.ExecutionDuration ?? "N/A")</span>
                        <span><strong>Start:</strong> @Model.Proposal.ProjectStartDate?.ToString("MMM dd, yyyy")</span>
                        <span><strong>End:</strong> @Model.Proposal.ProjectEndDate?.ToString("MMM dd, yyyy")</span>
                    </div>

                    @if (!Model.Proposal.Phases.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-clipboard text-muted display-6 d-block mb-2 opacity-50"></i>
                            <p>No execution phases have been added yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Phase</th>
                                        <th>Timeline</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var phase in Model.Proposal.Phases.OrderBy(p => p.StartDate ?? DateTime.MaxValue))
                                    {
                                        <tr>
                                            <td class="fw-600">@phase.Title</td>
                                            <td class="small">
                                                @(phase.StartDate?.ToString("MMM dd, yy") ?? "?") - @(phase.EndDate?.ToString("MMM dd, yy") ?? "?")
                                            </td>
                                            <td>
                                                @if (phase.Status == JurayUniversal.Domain.Enum.Enum.PhaseStatus.Upcoming)
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2">Upcoming</span>
                                                }
                                                else if (phase.Status == JurayUniversal.Domain.Enum.Enum.PhaseStatus.InProgress)
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2">In Progress</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">Done</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#updatePhaseModal-@phase.Id">
                                                    Update
                                                </button>
                                            </td>
                                        </tr>

                                        <!-- Update Phase Modal -->
                                        <div class="modal fade text-start" id="updatePhaseModal-@phase.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow rounded-4">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="fw-bold mb-0">Update @phase.Title</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <form method="post" asp-page-handler="UpdatePhase">
                                                            <input type="hidden" name="phaseId" value="@phase.Id" />
                                                            
                                                            <div class="mb-3">
                                                                <label class="form-label fw-600">Status</label>
                                                                <select name="status" class="form-select">
                                                                    <!option value="@JurayUniversal.Domain.Enum.Enum.PhaseStatus.Upcoming" @(phase.Status == JurayUniversal.Domain.Enum.Enum.PhaseStatus.Upcoming ? "selected" : "")>Upcoming</!option>
                                                                    <!option value="@JurayUniversal.Domain.Enum.Enum.PhaseStatus.InProgress" @(phase.Status == JurayUniversal.Domain.Enum.Enum.PhaseStatus.InProgress ? "selected" : "")>In Progress</!option>
                                                                    <!option value="@JurayUniversal.Domain.Enum.Enum.PhaseStatus.Done" @(phase.Status == JurayUniversal.Domain.Enum.Enum.PhaseStatus.Done ? "selected" : "")>Done</!option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-4">
                                                                <label class="form-label fw-600">Report / Statistics</label>
                                                                <textarea name="reportSummary" class="form-control" rows="4" placeholder="Summarize outcomes, budget spent, statistics, etc.">@phase.ReportSummary</textarea>
                                                            </div>
                                                            
                                                            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Save Update</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
        <div class="col-lg-4">
            
            <!-- Applicant Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 text-center">
                    <div class="avatar-circle bg-primary text-white d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 70px; height: 70px; font-size: 24px;">
                        @if(Model.Proposal.UserProfile != null) {
                            <span>@Model.Proposal.UserProfile.FirstName?.FirstOrDefault()</span>
                        } else {
                            <i class="bi bi-person"></i>
                        }
                    </div>
                    <h6 class="fw-bold mb-1">@(Model.Proposal.UserProfile?.FirstName ?? "Unknown") @(Model.Proposal.UserProfile?.LastName ?? "User")</h6>
                    <p class="text-muted small mb-0">@Model.Proposal.UserProfile?.Email</p>
                    <hr />
                    <div class="d-flex justify-content-between text-start small">
                        <span class="text-muted">Status</span>
                        <span class="fw-bold">
                            @switch (Model.Proposal.Status)
                            {
                                case JurayUniversal.Domain.Enum.Enum.ProposalStatus.UnderReview:
                                    <span class="text-warning text-dark"><i class="bi bi-search me-1"></i> Under Review</span>
                                    break;
                                case JurayUniversal.Domain.Enum.Enum.ProposalStatus.Approved:
                                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Approved</span>
                                    break;
                                case JurayUniversal.Domain.Enum.Enum.ProposalStatus.Rejected:
                                    <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i> Rejected</span>
                                    break;
                                default:
                                    <span>@Model.Proposal.Status.ToString()</span>
                                    break;
                            }
                        </span>
                    </div>
                </div>
            </div>

            <!-- Attachments Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-paperclip me-2"></i> Attachments (@Model.Proposal.ProposalFiles.Count)</h6>
                    
                    @if(Model.Proposal.ProposalFiles.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach(var file in Model.Proposal.ProposalFiles)
                            {
                                <li class="list-group-item px-0 border-0 d-flex justify-content-between align-items-center">
                                    <div class="text-truncate me-2" style="max-width: 200px;">
                                        <i class="bi bi-file-earmark-text text-primary me-2"></i>
                                        <span class="small fw-semibold">@file.Title</span>
                                    </div>
                                    <a href="@file.Url" target="_blank" class="btn btn-sm btn-light border rounded-pill px-3">
                                        View
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small fst-italic mb-0">No files attached to this proposal.</p>
                    }
                </div>
            </div>

            <!-- Decision Actions -->
            @if (Model.Proposal.Status != JurayUniversal.Domain.Enum.Enum.ProposalStatus.Approved && Model.Proposal.Status != JurayUniversal.Domain.Enum.Enum.ProposalStatus.Rejected)
            {
                <div class="card border-0 shadow-sm rounded-4 bg-light">
                    <div class="card-body p-4 text-center">
                        <h6 class="fw-bold mb-3">Committee Decision</h6>
                        <p class="small text-muted mb-4">Make a final decision on this pitch. This action cannot be undone.</p>
                        
                        <form method="post" class="d-grid gap-2">
                            <button type="submit" asp-page-handler="Approve" asp-route-id="@Model.Proposal.Id" class="btn btn-success rounded-pill fw-bold" onclick="return confirm('Are you sure you want to approve this proposal?');">
                                <i class="bi bi-check-lg me-1"></i> Approve Pitch
                            </button>
                            <button type="submit" asp-page-handler="Reject" asp-route-id="@Model.Proposal.Id" class="btn btn-outline-danger rounded-pill fw-bold" onclick="return confirm('Are you sure you want to reject this proposal?');">
                                <i class="bi bi-x-lg me-1"></i> Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Proposal.Status == JurayUniversal.Domain.Enum.Enum.ProposalStatus.Approved)
            {
                <div class="alert alert-success border-0 rounded-4 mb-0 text-center">
                    <i class="bi bi-check-circle-fill display-6 d-block mb-2"></i>
                    <h6 class="fw-bold mb-1">Approved</h6>
                    <span class="small">Approved on @Model.Proposal.DateApproved?.ToString("MMM dd, yyyy")</span>
                </div>
            }
            else if (Model.Proposal.Status == JurayUniversal.Domain.Enum.Enum.ProposalStatus.Rejected)
            {
                <div class="alert alert-danger border-0 rounded-4 mb-0 text-center">
                    <i class="bi bi-x-circle-fill display-6 d-block mb-2"></i>
                    <h6 class="fw-bold mb-0">Rejected</h6>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.Proposal.Status == JurayUniversal.Domain.Enum.Enum.ProposalStatus.Approved)
{
    <!-- Add Phase Modal -->
    <div class="modal fade" id="addPhaseModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold mb-0">Add Execution Phase</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form method="post" asp-page-handler="AddPhase">
                        <input type="hidden" name="proposalId" value="@Model.Proposal.Id" />
                        
                        <div class="mb-3">
                            <label asp-for="NewPhase.Title" class="form-label fw-600">Phase Title <span class="text-danger">*</span></label>
                            <input asp-for="NewPhase.Title" class="form-control" placeholder="e.g., Phase 1: Planning" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPhase.Description" class="form-label fw-600">Description</label>
                            <textarea asp-for="NewPhase.Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="row mb-4">
                            <div class="col-6">
                                <label asp-for="NewPhase.StartDate" class="form-label fw-600">Start Date</label>
                                <input asp-for="NewPhase.StartDate" type="date" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label asp-for="NewPhase.EndDate" class="form-label fw-600">End Date</label>
                                <input asp-for="NewPhase.EndDate" type="date" class="form-control" />
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Create Phase</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
