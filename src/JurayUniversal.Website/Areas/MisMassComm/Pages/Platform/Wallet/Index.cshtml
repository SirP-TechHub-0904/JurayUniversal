@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Platform.Wallet.IndexModel
@{
    ViewData["Title"] = "My SMS Wallet";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

@section HeaderActions {
    <a href="/MisMassComm/Platform/Wallet/Transfer" class="btn btn-warning me-2"><i class="fa fa-exchange-alt"></i> Transfer Units</a>
    <a href="/MisMassComm/Platform/Wallet/Fund" class="btn btn-success"><i class="fa fa-plus-circle"></i> Fund Wallet</a>
}

<div class="row">
    <div class="col-xl-4">
        <div class="card border-0 bg-blue text-white shadow-sm mb-4">
            <div class="card-body py-5 text-center">
                <i class="fa fa-wallet fa-4x mb-3 opacity-5"></i>
                <h5 class="text-white-50">AVAILABLE BALANCE</h5>
                <h1 class="display-4 text-white font-weight-bold">&#8358;@Model.UserWallet.Balance.ToString("N2")</h1>
            </div>
        </div>
    </div>
    
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="fa fa-history text-primary"></i> Recent Transactions</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Description</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Transactions.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">No transactions found.</td></tr>
                            }
                            @foreach (var item in Model.Transactions)
                            {
                                <tr>
                                    <td>@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        @if (item.TransactionType == JurayUniversal.Domain.Enum.Enum.MisWalletTransactionType.Credit)
                                        {
                                            <span class="badge bg-success">Credit</span>
                                        }
                                        else if (item.TransactionType == JurayUniversal.Domain.Enum.Enum.MisWalletTransactionType.Debit)
                                        {
                                            <span class="badge bg-danger">Debit</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Transfer</span>
                                        }
                                    </td>
                                    <td class="font-weight-bold @(item.TransactionType == JurayUniversal.Domain.Enum.Enum.MisWalletTransactionType.Credit ? "text-success" : "text-danger")">
                                        @(item.TransactionType == JurayUniversal.Domain.Enum.Enum.MisWalletTransactionType.Credit ? "+" : "-")&#8358;@item.Amount.ToString("N2")
                                    </td>
                                    <td>@item.Description</td>
                                    <td><small class="text-muted">@item.Reference</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


