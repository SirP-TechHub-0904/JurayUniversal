@page "/pay/{key}"
@model JurayUniversal.Website.Pages.Pay.CheckoutModel
@{
    var catTitle = Model.Category?.Title ?? "Checkout";
    ViewData["Title"] = catTitle;
    ViewData["MetaTitle"] = catTitle;
    if (!string.IsNullOrEmpty(Model.Category?.Description))
    {
        ViewData["MetaDescription"] = Model.Category.Description;
    }
    if (!string.IsNullOrEmpty(Model.SuperSetting?.CompanyIconUrl))
    {
        ViewData["MetaImage"] = Model.SuperSetting.CompanyIconUrl;
    }
    else if (!string.IsNullOrEmpty(Model.SuperSetting?.CompanyLogoUrl))
    {
        ViewData["MetaImage"] = Model.SuperSetting.CompanyLogoUrl;
    }
    Layout = "~/Pages/Shared/Layouts/_PayLayout.cshtml";
}

@if (Model.Category == null)
{
    <div class="card pay-card shadow-sm p-5 text-center">
        <i class="bi bi-exclamation-circle text-danger fs-1 mb-3 d-block"></i>
        <h4 class="fw-bold">Category Not Found</h4>
        <a href="/pay" class="btn btn-primary rounded-pill mt-3">Back to Categories</a>
    </div>
}
else if (!Model.Category.AllowGuestPayment && !Model.IsLoggedIn)
{
    <div class="card pay-card shadow-sm p-5 text-center">
        <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex p-3 mb-3 mx-auto align-items-center justify-content-center" style="width:72px; height:72px;">
            <i class="bi bi-person-lock text-warning fs-1"></i>
        </div>
        <h3 class="fw-bold mb-2 text-dark">Members-Only Payment</h3>
        <p class="text-muted mb-4">This payment category (<strong>@Model.Category.Title</strong>) is reserved for registered members only. Please log in to your member account before proceeding.</p>
        <a href="/Identity/Account/Login?returnUrl=@(Url.Page("/Pay/Checkout", new { key = Model.Category.Key ?? Model.Category.Id.ToString() }))" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 px-5 shadow-sm">
            <i class="bi bi-box-arrow-in-right me-2"></i> Log In to Pay
        </a>
    </div>
}
else
{
    <div class="card pay-card shadow-sm">
        <div class="card-body p-4 p-md-5">
            <!-- Category Header Info -->
            <div class="text-center mb-4">
                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex p-3 mb-3">
                    <i class="bi @(Model.Category.IsCompulsory ? "bi-credit-card-fill text-danger" : "bi-heart-fill text-success") fs-2"></i>
                </div>
                <h2 class="h4 fw-bold mb-1 text-dark">@Model.Category.Title</h2>
                @if (!string.IsNullOrEmpty(Model.Category.Description))
                {
                    <p class="text-muted mb-0 fs-14px">@Model.Category.Description</p>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                var isCredError = Model.StatusMessage.Contains("500") || Model.StatusMessage.Contains("Wrong details") || Model.StatusMessage.Contains("disabled_merchant");
                <div class="alert @(Model.StatusMessage.StartsWith("Error") ? "alert-danger" : "alert-info") rounded-4 mb-4">
                    <div class="fw-semibold mb-1">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Notice
                    </div>
                    <div class="small">
                        @Model.StatusMessage
                        @if (isCredError && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
                        {
                            <br /><a href="/MisSetting/Dashboard" class="alert-link">→ Go to MIS Settings to verify payment gateway keys</a>
                        }
                    </div>
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryId" value="@Model.Category.Id" />

                @if (Model.IsLoggedIn)
                {
                    <!-- Logged in member badge card -->
                    <div class="card bg-light border-0 rounded-4 p-3 mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="w-10 h-10 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm" style="width:42px; height:42px;">
                                @(string.IsNullOrEmpty(Model.PrefillName) ? "M" : Model.PrefillName.Substring(0,1).ToUpper())
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold text-dark text-truncate">@Model.PrefillName</div>
                                <div class="text-muted fs-8 text-truncate">@Model.PrefillEmail</div>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1.5 fs-12px">
                                <i class="bi bi-check-circle-fill me-1"></i> Logged In
                            </span>
                        </div>
                    </div>
                }

                <div class="mb-3 @(Model.IsLoggedIn ? "d-none" : "")">
                    <label class="form-label fw-bold text-dark">Full Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg rounded-3" name="DonorName"
                           value="@Model.PrefillName"
                           @(Model.IsLoggedIn ? "readonly" : "required")
                           placeholder="Enter your full name" />
                </div>
                <div class="mb-3 @(Model.IsLoggedIn ? "d-none" : "")">
                    <label class="form-label fw-bold text-dark">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control form-control-lg rounded-3" name="DonorEmail"
                           value="@Model.PrefillEmail"
                           @(Model.IsLoggedIn ? "readonly" : "required")
                           placeholder="your@email.com" />
                </div>
                @if (!Model.IsLoggedIn)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Phone Number</label>
                        <input type="tel" class="form-control form-control-lg rounded-3" name="DonorPhone"
                               value="@Model.PrefillPhone"
                               placeholder="+1 234 567 8900" />
                    </div>
                }

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">Amount <span class="text-danger">*</span></label>
                    @if (Model.Category.FixedAmount.HasValue)
                    {
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0">&#8358;</span>
                            <input type="number" step="0.01" class="form-control rounded-end-3 bg-light fw-bold"
                                   name="Amount" value="@Model.Category.FixedAmount" readonly />
                        </div>
                        <div class="form-text">Fixed amount for this category.</div>
                    }
                    else
                    {
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light">&#8358;</span>
                            <input type="number" step="0.01" min="0.01" class="form-control rounded-end-3 fw-bold"
                                   name="Amount" required placeholder="Enter contribution amount" />
                        </div>
                        <div class="form-text">You may enter any amount you wish to contribute.</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">Note / Remark <span class="text-muted fw-normal">(Optional)</span></label>
                    <input type="text" class="form-control form-control-lg rounded-3" name="Notes"
                           value="@Model.Notes" placeholder="e.g. Special remark or reference note..." />
                </div>

                <!-- Payment Provider Selector -->
                @{
                    var noneAvailable = !Model.PixelPayAvailable && !Model.PaystackAvailable;
                    var onlyPixelPay = Model.PixelPayAvailable && !Model.PaystackAvailable;
                    var onlyPaystack = !Model.PixelPayAvailable && Model.PaystackAvailable;
                }

                @if (noneAvailable)
                {
                    <div class="alert alert-warning rounded-4 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>No payment method currently available.</strong>
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <br /><a href="/MisSetting/Dashboard" class="alert-link">→ Enable a provider in MIS Settings</a>
                        }
                    </div>
                }
                else if (onlyPixelPay)
                {
                    <input type="hidden" name="PaymentProvider" value="PixelPay" />
                }
                else if (onlyPaystack)
                {
                    <input type="hidden" name="PaymentProvider" value="Paystack" />
                }
                else
                {
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Pay with</label>
                        <div class="d-flex gap-3">
                            @if (Model.PixelPayAvailable)
                            {
                                <label class="flex-fill" style="cursor:pointer;">
                                    <input type="radio" name="PaymentProvider" value="PixelPay" class="d-none provider-radio" required />
                                    <div class="provider-card border rounded-4 p-3 text-center h-100" data-provider="PixelPay">
                                        <i class="bi bi-credit-card-2-front-fill fs-2 text-primary d-block mb-1"></i>
                                        <div class="fw-semibold small">PixelPay</div>
                                    </div>
                                </label>
                            }
                            @if (Model.PaystackAvailable)
                            {
                                <label class="flex-fill" style="cursor:pointer;">
                                    <input type="radio" name="PaymentProvider" value="Paystack" class="d-none provider-radio" required />
                                    <div class="provider-card border rounded-4 p-3 text-center h-100" data-provider="Paystack">
                                        <i class="bi bi-wallet2 fs-2 text-success d-block mb-1"></i>
                                        <div class="fw-semibold small">Paystack</div>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }

                @if (!noneAvailable)
                {
                    <!-- Captcha Security Check -->
                    <div class="mb-4">
                        <partial name="_Captcha" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm">
                        <i class="bi bi-lock-fill me-2"></i> Proceed to Secure Payment
                    </button>
                }
            </form>

            <div class="text-center mt-4">
                <small class="text-muted"><i class="bi bi-shield-check me-1 text-success"></i> Secured Payment · Encrypted Data</small>
            </div>
        </div>
    </div>
}

<!-- Inline Help Accordion -->
<div class="mt-4 mb-5">
    <div class="card border border-slate-200 rounded-4 bg-white shadow-sm">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-question-circle text-primary me-2"></i> Payment Help</h6>
            <div class="accordion accordion-flush" id="payHelpAccordion">
                <div class="accordion-item border-0 bg-transparent mb-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-transparent text-dark fw-semibold px-0" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            What payment channels are accepted?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#payHelpAccordion">
                        <div class="accordion-body text-muted fs-8 px-0">
                            Debit/Credit Cards (Visa, Mastercard, Verve), Bank Transfers (Pay-by-Transfer / USSD), and mobile money wallets.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 bg-transparent mb-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-transparent text-dark fw-semibold px-0" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            Is my payment transaction secure?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#payHelpAccordion">
                        <div class="accordion-body text-muted fs-8 px-0">
                            Yes. All transactions are processed through PCI-DSS compliant payment gateways with 3D Secure verification.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 bg-transparent">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-transparent text-dark fw-semibold px-0" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            When is payment updated on my account?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#payHelpAccordion">
                        <div class="accordion-body text-muted fs-8 px-0">
                            Payment status is updated immediately upon successful gateway confirmation. Registered members can view history under My Finances.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Highlight selected provider card
        document.querySelectorAll('.provider-radio').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.provider-card').forEach(c => c.classList.remove('selected'));
                radio.closest('label').querySelector('.provider-card').classList.add('selected');
            });
        });
    </script>
    @if (!string.IsNullOrEmpty(Model.PaystackAccessCode))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (typeof PaystackPop !== 'undefined') {
                    var handler = PaystackPop.setup({
                        key: '@Model.PaystackPublicKey',
                        email: '@Model.PaystackEmail',
                        amount: Math.round(@Model.PaystackAmount * 100),
                        ref: '@Model.PaystackReference',
                        access_code: '@Model.PaystackAccessCode',
                        onClose: function () {
                            console.log('Payment popup closed by user.');
                        },
                        callback: function (response) {
                            window.location.href = "/pay/callback?ref=" + encodeURIComponent('@Model.PaystackReference');
                        }
                    });
                    handler.openIframe();
                } else {
                    console.error('PaystackPop inline library failed to load.');
                }
            });
        </script>
    }
}
