@page
@model JurayUniversal.Website.Areas.MisAlumni.Pages.Dashboard.ListModel
@{
    ViewData["Title"] = Model.AlumniAlias + " Directory";
    ViewData["ActiveMenu"] = "MisAlumni";
    ViewData["ActiveSubMenu"] = "Dashboard";
    Layout = "/Pages/Shared/Layouts/MIS/_MisAdminLayout.cshtml";
}

<div class="mis-page-header">
    
    <div class="d-flex gap-2">
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
        
        <a asp-page="./Create" class="btn btn-primary btn-sm rounded-pill"><i class="bi bi-person-plus me-1"></i> Flag New @Model.AlumniAlias</a>
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <div class="card mis-card shadow-sm border-0">
        <div class="card-body mis-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">User Profile</th>
                            <th>Exit Year</th>
                            <th>Current Profession</th>
                            <th>Mentorship?</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AlumniProfiles)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <span class="fw-bold fs-6">@item.UserProfile?.FirstName?.Substring(0, 1)</span>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.UserProfile?.FirstName @item.UserProfile?.LastName</h6>
                                            <span class="text-muted fs-8">@item.UserProfile?.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.ExitYear</td>
                                <td>
                                    <div class="fw-medium">@item.CurrentProfession</div>
                                    <div class="text-muted fs-8">@item.Company</div>
                                </td>
                                <td>
                                    @if (item.IsAvailableForMentorship)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2"><i class="bi bi-x-circle me-1"></i> No</span>
                                    }
                                </td>
                                <td>
                                    @if (item.VerificationStatus == "Verified")
                                    {
                                        <span class="badge bg-primary rounded-pill px-3">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3">@item.VerificationStatus</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            @if (item.VerificationStatus != "Verified")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="Verify" asp-route-id="@item.Id">
                                                        <button class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i> Verify Status</button>
                                                    </form>
                                                </li>
                                            }
                                            <li>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Are you sure you want to remove this user from the Alumni network?');">
                                                    <button class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i> Remove</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.AlumniProfiles.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="bi bi-people text-muted fs-1 mb-3 d-block"></i>
                                    <h5 class="fw-bold">No @Model.AlumniAlias found.</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


