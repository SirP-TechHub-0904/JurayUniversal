@page
@model JurayUniversal.Website.Areas.MisAuth.Pages.Auth.MisShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
 }

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-key-fill fs-3"></i>
                </div>
                <h3 class="fw-800 text-dark mb-0 me-auto">Recovery Codes</h3>
                
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />
            
            <div class="alert alert-warning rounded-4 border-0 shadow-sm p-4 mb-4" role="alert">
                <div class="d-flex mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Put these codes in a safe place.</h5>
                        <p class="mb-0 fs-14px">If you lose your device and don't have the recovery codes you will lose access to your account.</p>
                    </div>
                </div>
            </div>
            
            <div class="bg-light p-4 rounded-4 shadow-sm border text-center">
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @for (var row = 0; row < Model.RecoveryCodes.Length; row += 2)
                    {
                        <div class="col">
                            <kbd class="fs-5 px-3 py-2 bg-dark rounded-3 font-monospace d-block">@Model.RecoveryCodes[row]</kbd>
                        </div>
                        <div class="col">
                            <kbd class="fs-5 px-3 py-2 bg-dark rounded-3 font-monospace d-block">@Model.RecoveryCodes[row + 1]</kbd>
                        </div>
                    }
                </div>
            </div>
            
            <div class="mt-4 text-center">
                <a asp-page="./MisTwoFactorAuthentication" class="text-decoration-none text-muted fw-600"><i class="bi bi-arrow-left me-1"></i> Back to 2FA Settings</a>
            </div>
        </div>
    </div>
</div>

