@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Platform.MyKpisModel
@{
    ViewData["Title"] = "My KPI Performance";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
    ViewData["ShowBackButton"] = false;
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "MyKpis";
}

@section HeaderActions {
    <a asp-page="/Platform/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
}

<div class="page-content">
    <div class="card shadow-sm border-0">
        <div class="card-header border-bottom bg-transparent py-3">
            <h5 class="mb-0 text-dark"><i class="bi bi-graph-up text-success me-1"></i> Performance Evaluation Logs</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Evaluation Period</th>
                            <th class="py-3">Indicator Title</th>
                            <th class="py-3 text-center">Score</th>
                            <th class="py-3 text-center">Max Possible</th>
                            <th class="py-3">Evaluator</th>
                            <th class="px-4 py-3">Remarks / Feedback</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.KpiHistory.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-graph-down fs-2 d-block mb-2"></i>
                                    No KPI evaluations have been assigned to your profile yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var score in Model.KpiHistory)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <span class="badge bg-light-success text-success fw-bold">@score.Period</span>
                                    </td>
                                    <td class="py-3 fw-bold text-dark">
                                        @score.MisKpiIndicator?.Title
                                    </td>
                                    <td class="py-3 text-center fw-bold text-success">
                                        @score.Score
                                    </td>
                                    <td class="py-3 text-center text-muted">
                                        @score.MisKpiIndicator?.MaxScore
                                    </td>
                                    <td class="py-3 fs-7 text-muted">
                                        @score.EvaluatedBy
                                    </td>
                                    <td class="px-4 py-3 text-dark fs-7" style="white-space: pre-wrap;">
                                        @score.Remarks
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


