@page
@model JurayUniversal.Website.Areas.MisRecruitment.Pages.Platform.Auth.LoginModel
@{
    ViewData["Title"] = "Applicant Login";
    ViewData["Subtitle"] = "Authentication and security access.";
}

<div class="container py-5 max-w-700">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <i class="bi bi-box-arrow-in-right display-4 text-primary mb-2"></i>
                <h2 class="fw-bold">Welcome Back</h2>
                <p class="text-muted">Sign in to view and track your applications.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label fw-bold"></label>
                    <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Password" class="form-label fw-bold"></label>
                    <input asp-for="Input.Password" class="form-control form-control-lg" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">Sign In</button>
            </form>
            
            <div class="text-center mt-4">
                <p class="text-muted mb-0">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold">Register here</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
