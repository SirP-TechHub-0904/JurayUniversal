@page
@model JurayUniversal.MisCentral.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us & Book a Free Demo";
    ViewData["MetaDescription"] = "Connect with Exwhyzee MIS technical team for a personalized demo, custom onboarding, or support. Direct phone: +234 816 568 0904, WhatsApp, and official email.";
    Layout = "_PublicLayout";
}

@section Styles {
    <style>
        /* Modern Scoped Styling for Contact Page */
        .contact-hero-gradient {
            background: linear-gradient(135deg, #09142e 0%, #0d2352 50%, #07193f 100%);
            position: relative;
            overflow: hidden;
            padding-top: 175px !important;
            padding-bottom: 95px !important;
        }

        .contact-hero-gradient::before {
            content: "";
            position: absolute;
            top: -20%;
            right: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(13, 110, 253, 0.18) 0%, rgba(0, 210, 255, 0.05) 50%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .contact-hero-gradient::after {
            content: "";
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .channel-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 20px;
            padding: 28px 24px;
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }

        .channel-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 20px 35px -10px rgba(13, 110, 253, 0.12), 0 10px 15px -5px rgba(0, 0, 0, 0.04);
            border-color: rgba(13, 110, 253, 0.35);
        }

        .channel-card.featured-whatsapp {
            background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);
            border-color: rgba(34, 197, 94, 0.3);
        }

        .channel-card.featured-whatsapp:hover {
            border-color: rgba(34, 197, 94, 0.6);
            box-shadow: 0 20px 35px -10px rgba(34, 197, 94, 0.2);
        }

        .channel-icon-wrap {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            margin-bottom: 1.25rem;
            transition: transform 0.3s ease;
        }

        .channel-card:hover .channel-icon-wrap {
            transform: scale(1.08) rotate(3deg);
        }

        .pulse-indicator {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 50px;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            animation: pulseAnimation 2s infinite;
        }

        @@keyframes pulseAnimation {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 7px rgba(34, 197, 94, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }

        /* Form Card Styling */
        .assessment-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.08);
            border: 1px solid rgba(226, 232, 240, 0.8);
            position: relative;
            overflow: hidden;
        }

        .assessment-header-bar {
            background: linear-gradient(90deg, #0d6efd 0%, #00d2ff 50%, #10b981 100%);
            height: 6px;
            width: 100%;
        }

        .step-badge {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d6efd 0%, #0060df 100%);
            color: #ffffff;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            box-shadow: 0 4px 10px rgba(13, 110, 253, 0.25);
            flex-shrink: 0;
        }

        /* Selectable Feature Card in Form */
        .feature-select-card {
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            padding: 14px 16px;
            background: #ffffff;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            user-select: none;
            height: 100%;
            margin-bottom: 0;
        }

        .feature-select-card:hover {
            border-color: #0d6efd;
            background-color: #f8faff;
            transform: translateY(-2px);
        }

        .feature-select-card input[type="checkbox"]:checked ~ .feature-label-text strong {
            color: #0d6efd;
        }

        .feature-select-card input[type="checkbox"] {
            width: 1.25rem;
            height: 1.25rem;
            cursor: pointer;
            border-radius: 6px;
            accent-color: #0d6efd;
            flex-shrink: 0;
        }

        .feature-select-card .feat-icon {
            font-size: 1.25rem;
            color: #0d6efd;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(13, 110, 253, 0.08);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .input-group-modern {
            position: relative;
        }

        .input-icon-prefix {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.15rem;
            pointer-events: none;
            z-index: 4;
        }

        .form-control-modern {
            border-radius: 12px;
            padding: 13px 16px 13px 46px !important;
            border: 1.5px solid #e2e8f0;
            font-size: 0.95rem;
            font-weight: 500;
            color: #1e293b;
            transition: all 0.2s ease;
            background-color: #fdfdfd;
        }

        .form-control-modern:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
            background-color: #ffffff;
            outline: none;
        }

        .form-select-modern {
            border-radius: 12px;
            padding: 13px 16px 13px 44px;
            border: 1.5px solid #e2e8f0;
            font-size: 0.95rem;
            font-weight: 500;
            color: #1e293b;
            transition: all 0.2s ease;
            background-color: #fdfdfd;
        }

        .form-select-modern:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
            background-color: #ffffff;
            outline: none;
        }

        .textarea-modern {
            border-radius: 12px;
            padding: 14px 16px;
            border: 1.5px solid #e2e8f0;
            font-size: 0.95rem;
            font-weight: 500;
            color: #1e293b;
            transition: all 0.2s ease;
            background-color: #fdfdfd;
        }

        .textarea-modern:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
            background-color: #ffffff;
            outline: none;
        }

        .sidebar-trust-box {
            background: linear-gradient(145deg, #0a132c 0%, #0f1c3f 100%);
            border-radius: 20px;
            padding: 34px 28px;
            color: #ffffff;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sidebar-trust-box::before {
            content: "";
            position: absolute;
            top: -40px;
            right: -40px;
            width: 180px;
            height: 180px;
            background: radial-gradient(circle, rgba(13, 110, 253, 0.3) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        /* FAQ Accordion Styling */
        .modern-faq-item {
            border: 1px solid #e2e8f0;
            border-radius: 16px !important;
            margin-bottom: 1rem;
            overflow: hidden;
            background: #ffffff;
            transition: all 0.25s ease;
        }

        .modern-faq-item:hover {
            border-color: #cbd5e1;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);
        }

        .modern-faq-btn {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0f172a;
            padding: 20px 24px;
            background: #ffffff;
            border: none;
            box-shadow: none !important;
        }

        .modern-faq-btn:not(.collapsed) {
            color: #0d6efd;
            background: #f8faff;
        }

        .modern-faq-body {
            padding: 20px 24px 24px;
            color: #475569;
            font-size: 0.95rem;
            line-height: 1.7;
            background: #f8faff;
            border-top: 1px solid rgba(226, 232, 240, 0.6);
        }
    </style>
}

<!-- ========================================================================= -->
<!-- 1. HERO HEADER AREA -->
<!-- ========================================================================= -->
<section class="contact-hero-gradient text-white position-relative">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center justify-content-between g-5">
            <div class="col-lg-7 col-md-10">
                <!-- Badge -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-20 text-white fw-semibold text-xs text-uppercase mb-4" style="letter-spacing: 0.8px;">
                    <i class="bi bi-headset text-info fs-6"></i>
                    <span>Direct Consultation &amp; Onboarding</span>
                </div>

                <!-- Title -->
                <h1 class="display-5 fw-bolder text-white mb-3" style="letter-spacing: -0.8px; line-height: 1.2;">
                    Let’s Transform Your Operations with <span style="background: linear-gradient(135deg, #00d2ff 0%, #38bdf8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Exwhyzee MIS</span>
                </h1>

                <!-- Subtitle -->
                <p class="fs-6 mb-4" style="color: #cbd5e1; line-height: 1.75; max-width: 580px;">
                    Whether you need a personalized 1-on-1 live walkthrough, custom data migration from paper registers or Excel spreadsheets, or an institutional rollout across branches — our technical engineering team is at your service.
                </p>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a href="#demoFormSection" class="btn btn-primary px-4 py-3 rounded-pill fw-bold text-sm shadow-lg d-inline-flex align-items-center gap-2 border-0 hover-scale" style="background: linear-gradient(135deg, #00d2ff 0%, #0d6efd 100%);">
                        <span>Fill Assessment &amp; Book Demo</span>
                        <i class="bi bi-arrow-down-short fs-5"></i>
                    </a>
                    <a href="https://wa.me/2348165680904?text=Hello%20Exwhyzee%20MIS!%20I%20would%20like%20to%20inquire%20about%20your%20cloud%20management%20system." target="_blank" class="btn btn-outline-light px-4 py-3 rounded-pill fw-bold text-sm d-inline-flex align-items-center gap-2 hover-scale" style="background: rgba(37, 211, 102, 0.15); border: 1.5px solid rgba(37, 211, 102, 0.4); color: #ffffff;">
                        <i class="bi bi-whatsapp text-success fs-5"></i>
                        <span>Instant WhatsApp Chat</span>
                    </a>
                </div>
            </div>

            <!-- Right SLA Box -->
            <div class="col-lg-5 col-xl-4 d-none d-lg-block">
                <div class="p-4 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-15 shadow-lg position-relative overflow-hidden" style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);">
                    <!-- Top Accent -->
                    <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: linear-gradient(90deg, #10b981 0%, #00d2ff 100%);"></div>

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <span>Client Commitment SLA</span>
                        </h5>
                        <span class="badge rounded-pill bg-success bg-opacity-20 text-success border border-success border-opacity-25 px-2.5 py-1 text-xs fw-bold">Guaranteed</span>
                    </div>

                    <ul class="list-unstyled mb-0 d-flex flex-column gap-3 text-sm" style="color: #e2e8f0;">
                        <li class="d-flex align-items-start gap-2.5">
                            <div class="rounded-circle bg-warning bg-opacity-20 text-warning d-flex align-items-center justify-content-center flex-shrink-0 mt-0.5" style="width: 26px; height: 26px; font-size: 0.85rem;">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>
                            <div>
                                <strong class="text-white d-block" style="font-size: 0.88rem;">24/7 Demo &amp; Instant Response</strong>
                                <span class="text-white text-opacity-75" style="font-size: 0.78rem;">Submit your demo request anytime 24/7 with immediate dispatch &amp; WhatsApp confirmation.</span>
                            </div>
                        </li>
                        <li class="d-flex align-items-start gap-2.5">
                            <div class="rounded-circle bg-info bg-opacity-20 text-info d-flex align-items-center justify-content-center flex-shrink-0 mt-0.5" style="width: 26px; height: 26px; font-size: 0.85rem;">
                                <i class="bi bi-lock-fill"></i>
                            </div>
                            <div>
                                <strong class="text-white d-block" style="font-size: 0.88rem;">100% Private Workspace</strong>
                                <span class="text-white text-opacity-75" style="font-size: 0.78rem;">Dedicated isolated data container for your institution.</span>
                            </div>
                        </li>
                        <li class="d-flex align-items-start gap-2.5">
                            <div class="rounded-circle bg-success bg-opacity-20 text-success d-flex align-items-center justify-content-center flex-shrink-0 mt-0.5" style="width: 26px; height: 26px; font-size: 0.85rem;">
                                <i class="bi bi-gift-fill"></i>
                            </div>
                            <div>
                                <strong class="text-white d-block" style="font-size: 0.88rem;">Free Assisted Onboarding</strong>
                                <span class="text-white text-opacity-75" style="font-size: 0.78rem;">We help import your student, staff, &amp; account records with zero stress.</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================= -->
<!-- 2. CONTACT CHANNELS AREA -->
<!-- ========================================================================= -->
<section class="py-5 bg-light-subtle">
    <div class="container">
        <div class="row justify-content-center text-center mb-4">
            <div class="col-lg-8">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill font-semibold text-uppercase mb-2">Connect In Real Time</span>
                <h2 class="fw-bold text-dark fs-2 mb-2">Direct Contact &amp; Support Channels</h2>
                <p class="text-muted fs-6 mb-0">Choose your preferred channel below to speak directly with an Exwhyzee Solutions Architect.</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Channel 1: WhatsApp (Priority) -->
            <div class="col-lg-3 col-md-6" data-sal="slide-up" data-sal-duration="600" data-sal-delay="100">
                <div class="channel-card featured-whatsapp">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="channel-icon-wrap bg-success bg-opacity-10 text-success">
                                <i class="bi bi-whatsapp"></i>
                            </div>
                            <span class="pulse-indicator bg-success bg-opacity-10 text-success">
                                <span class="pulse-dot bg-success"></span> Online Now
                            </span>
                        </div>
                        <h4 class="fw-bold text-gray-900 fs-5 mb-1">WhatsApp Desk</h4>
                        <p class="text-muted text-xs mb-3">Instant chats, voice notes, screenshots &amp; quick onboarding inquiries.</p>
                    </div>
                    <div>
                        <a href="https://wa.me/2348165680904?text=Hello%20Exwhyzee%20MIS!%20I%20would%20like%20to%20inquire%20about%20your%20management%20system." target="_blank" class="btn btn-success w-100 rounded-pill fw-bold text-xs py-2.5 text-white shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-whatsapp"></i>
                            <span>Chat on WhatsApp &rarr;</span>
                        </a>
                        <span class="d-block text-center text-muted text-xs mt-2">+234 816 568 0904</span>
                    </div>
                </div>
            </div>

            <!-- Channel 2: Phone Hotline -->
            <div class="col-lg-3 col-md-6" data-sal="slide-up" data-sal-duration="600" data-sal-delay="200">
                <div class="channel-card">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="channel-icon-wrap bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-telephone-outbound-fill"></i>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 text-xs"><i class="bi bi-clock-fill me-1"></i> Available 24/7</span>
                        </div>
                        <h4 class="fw-bold text-gray-900 fs-5 mb-1">Direct Phone Hotline</h4>
                        <p class="text-muted text-xs mb-3">Speak directly with a specialist regarding features, pricing or custom proposals.</p>
                    </div>
                    <div>
                        <a href="tel:+2348165680904" class="btn btn-outline-primary w-100 rounded-pill fw-bold text-xs py-2.5 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-telephone-fill"></i>
                            <span>+234 816 568 0904</span>
                        </a>
                        <span class="d-block text-center text-muted text-xs mt-2">24/7 Hotline Support</span>
                    </div>
                </div>
            </div>

            <!-- Channel 3: Email Desk -->
            <div class="col-lg-3 col-md-6" data-sal="slide-up" data-sal-duration="600" data-sal-delay="300">
                <div class="channel-card">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="channel-icon-wrap bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-envelope-paper-fill"></i>
                            </div>
                            <span class="badge bg-light text-muted border text-xs">&lt; 2hr Reply Guarantee</span>
                        </div>
                        <h4 class="fw-bold text-gray-900 fs-5 mb-1">Official Email Desk</h4>
                        <p class="text-muted text-xs mb-3">Send official RFPs, enterprise requirements, quotation requests &amp; support.</p>
                    </div>
                    <div>
                        <a href="mailto:support@exwhyzee.ng" class="btn btn-outline-primary w-100 rounded-pill fw-bold text-xs py-2.5 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-envelope-fill"></i>
                            <span>support@exwhyzee.ng</span>
                        </a>
                        <span class="d-block text-center text-muted text-xs mt-2">Monitored 24/7/365</span>
                    </div>
                </div>
            </div>

            <!-- Channel 4: Headquarters -->
            <div class="col-lg-3 col-md-6" data-sal="slide-up" data-sal-duration="600" data-sal-delay="400">
                <div class="channel-card">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="channel-icon-wrap bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <span class="badge bg-light text-muted border text-xs">Abuja FCT, Nigeria</span>
                        </div>
                        <h4 class="fw-bold text-gray-900 fs-5 mb-1">Executive Office</h4>
                        <p class="text-muted text-xs mb-3">In-person consultations, institutional demonstrations, and partnership meetings.</p>
                    </div>
                    <div>
                        <a href="#demoFormSection" class="btn btn-outline-secondary w-100 rounded-pill fw-bold text-xs py-2.5 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-calendar-event"></i>
                            <span>Book In-Person Demo</span>
                        </a>
                        <span class="d-block text-center text-muted text-xs mt-2">Open Mon – Fri, 9am – 5pm</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================= -->
<!-- 3. INTERACTIVE QUESTIONNAIRE & ASSESSMENT FORM -->
<!-- ========================================================================= -->
<section class="py-5 bg-white" id="demoFormSection">
    <div class="container py-4">
        <div class="row g-5 align-items-start">
            
            <!-- Left Form Column -->
            <div class="col-lg-8">
                <div class="assessment-card">
                    <div class="assessment-header-bar"></div>
                    
                    <div class="p-4 p-md-5">
                        @if (Model.IsSubmitted)
                        {
                            <div class="text-center py-5">
                                <div class="w-20 h-20 bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-4" style="width: 84px; height: 84px;">
                                    <i class="bi bi-check2-circle" style="font-size: 3.5rem;"></i>
                                </div>
                                <h2 class="fw-bold text-gray-900 mb-2">Request Received Successfully!</h2>
                                <p class="text-muted fs-5 max-w-lg mx-auto mb-4">@Model.SuccessMessage</p>
                                
                                <div class="p-4 bg-light rounded-4 text-start mb-4 max-w-lg mx-auto border">
                                    <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                        <i class="bi bi-clock-history text-primary"></i>
                                        <span>What Happens Next?</span>
                                    </h6>
                                    <ol class="text-xs text-gray-700 ps-3 mb-0 d-flex flex-column gap-2">
                                        <li><strong>Assessment Review:</strong> A dedicated Solutions Architect reviews your organization's requirements.</li>
                                        <li><strong>Interactive Demo Schedule:</strong> We contact you via WhatsApp / Phone to confirm a convenient live demonstration.</li>
                                        <li><strong>Dedicated Pilot Environment:</strong> We provision your private 14-day testing sandbox.</li>
                                    </ol>
                                </div>

                                <div class="d-flex flex-wrap justify-content-center gap-3">
                                    <a asp-page="/Index" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill fw-bold text-sm">
                                        <i class="bi bi-house me-1"></i> Back to Homepage
                                    </a>
                                    <a href="https://wa.me/2348165680904?text=Hello%20Exwhyzee%20MIS!%20I%20just%20submitted%20a%20demo%20assessment%20form%20for%20our%20organization." target="_blank" class="btn btn-success px-4 py-2.5 rounded-pill fw-bold text-sm text-white shadow-sm">
                                        <i class="bi bi-whatsapp me-1"></i> Expedite on WhatsApp
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4 pb-3 border-bottom">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div>
                                        <h2 class="fw-bold text-dark fs-3 mb-1">Tell Us About Your Organization</h2>
                                        <p class="text-muted text-sm mb-0">Help us understand your setup so we can tailor a live walkthrough for your leadership team.</p>
                                    </div>
                                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-light border text-xs text-muted">
                                        <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                                        <span><strong>100% Confidential</strong> • No Spam</span>
                                    </div>
                                </div>
                            </div>

                            <form method="post" class="needs-validation" novalidate>
