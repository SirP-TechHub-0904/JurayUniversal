@page
@model JurayUniversal.Website.Areas.MisAuth.Pages.Auth.MisDisable2faModel
@{
    ViewData["Title"] = "Disable two-factor authentication (2FA)";
 }

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-shield-x fs-3"></i>
                </div>
                <h3 class="fw-800 text-dark mb-0">Disable 2FA</h3>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />
            
            <div class="alert alert-warning rounded-4 border-0 shadow-sm p-4 mb-4" role="alert">
                <div class="d-flex mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
                    <div>
                        <h5 class="fw-bold mb-1">This action only disables 2FA.</h5>
                        <p class="mb-0 fs-14px">Disabling 2FA does not change the keys used in authenticator apps. If you wish to change the key used in an authenticator app you should <a asp-page="./MisResetAuthenticator" class="fw-bold text-dark">reset your authenticator keys.</a></p>
                    </div>
                </div>
            </div>
            
            <form method="post" class="mt-4">
                <button class="btn btn-danger btn-lg w-100 rounded-pill fw-700 shadow-sm" type="submit">
                    <i class="bi bi-shield-slash me-2"></i> Confirm & Disable 2FA
                </button>
            </form>
            
            <div class="mt-4 text-center">
                <a asp-page="./MisTwoFactorAuthentication" class="text-decoration-none text-muted fw-600"><i class="bi bi-arrow-left me-1"></i> Cancel and go back</a>
            </div>
        </div>
    </div>
</div>
