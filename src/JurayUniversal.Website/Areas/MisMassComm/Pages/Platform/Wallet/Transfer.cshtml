@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Platform.Wallet.TransferModel
@{
    ViewData["Title"] = "Transfer Wallet Units";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}



<div class="row">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="fa fa-exchange-alt text-warning"></i> Send Units to Another User</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-danger">
                        @Model.StatusMessage
                    </div>
                }

                <div class="mb-4">
                    <h6>Available Balance: <span class="text-primary font-weight-bold">&#8358;@Model.UserWallet.Balance.ToString("N2")</span></h6>
                </div>

                <form method="post">
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Recipient Email Address</label>
                        <input asp-for="RecipientEmail" class="form-control" type="email" required placeholder="user@company.com" />
                        <small class="text-muted">The user must have an active account in the system.</small>
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label font-weight-bold">Amount to Transfer (&#8358;)</label>
                        <input asp-for="Amount" class="form-control" type="number" min="1" step="0.01" required placeholder="e.g. 1000" />
                    </div>

                    <button type="submit" class="btn btn-warning btn-lg w-100">
                        <i class="fa fa-paper-plane"></i> Send Units
                    </button>
                    
                    <div class="mt-3 text-center">
                        <a href="/MisMassComm/Platform/Wallet/Index" class="text-muted">Cancel and return</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
