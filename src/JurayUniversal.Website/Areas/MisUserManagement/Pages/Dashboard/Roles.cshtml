@page "{id?}"
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.RolesModel
@{
    ViewData["Title"] = "Manage Feature Permissions";
    ViewData["Subtitle"] = "Overview and management of all records.";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "Users";
}

@section HeaderActions {
    <a asp-page="/Dashboard/Detail" asp-route-id="@Model.UserProfile.Id" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Detail
            </a>
}

<div class="page-content">
    
    <!-- User Profile Summary Card -->
    <div class="card border-0 shadow-sm mb-4 rounded-4">
        <div class="card-body d-flex align-items-center p-3">
            <div class="bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center rounded-circle" style="width: 50px; height: 50px; font-size: 1.2rem; font-weight: 800;">
                @(string.IsNullOrEmpty(Model.UserProfile.GetFullName()) ? "U" : Model.UserProfile.GetFullName().Substring(0, 1).ToUpper())
            </div>
            <div class="ms-3">
                <h5 class="mb-0 fw-bold text-dark">@Model.UserProfile.GetFullName()</h5>
                <div class="text-muted fs-14px mt-1 d-flex gap-3">
                    <span><i class="bi bi-envelope me-1"></i> @Model.UserProfile.Email</span>
                    @if(!string.IsNullOrEmpty(Model.UserProfile.PhoneNumber))
                    {
                        <span><i class="bi bi-telephone me-1"></i> @Model.UserProfile.PhoneNumber</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Assign Feature Form -->
        <div class="col-12 col-md-4">
            @if (!Model.IsReadOnly)
            {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header border-bottom bg-transparent py-3">
                    <h5 class="mb-0 text-dark"><i class="bi bi-shield-plus me-1 text-primary"></i> Assign Permission</h5>
                </div>
                <div class="card-body py-4">
                    <form method="post" asp-page-handler="Assign" asp-route-id="@Model.UserProfile.Id">
                        <div class="mb-3">
                            <label class="form-label text-muted fw-semibold">Select Feature Module</label>
                            <select asp-for="SelectedFeatureKey" class="form-select" required>
                                <option value="">-- Choose Module --</option>
                                @foreach (var feat in Model.SystemFeatures)
                                {
                                    <!-- Disable if already assigned -->
                                    bool isAssigned = Model.AssignedRoles.Any(r => r.FeatureAreaKey == feat);
                                    if (isAssigned)
                                    {
                                        <option value="@feat" disabled>@feat (Already Assigned)</option>
                                    }
                                    else
                                    {
                                        <option value="@feat">@feat</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted fw-semibold">Action Role Level</label>
                            <select asp-for="SelectedActionRole" class="form-select" asp-items="Html.GetEnumSelectList<JurayUniversal.Domain.Enum.Enum.MisActionRole>()"></select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-plus-circle me-1"></i> Assign Role
                        </button>
                    </form>
                </div>
            </div>
            }
            else
            {
            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body py-4 text-center">
                    <i class="bi bi-lock-fill fs-1 text-muted mb-2 d-block"></i>
                    <h5 class="text-dark">Read-Only Access</h5>
                    <p class="text-muted fs-13px mb-0">You do not have permission to assign or revoke roles.</p>
                </div>
            </div>
            }
        </div>

        <!-- Assigned Permissions Table -->
        <div class="col-12 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom bg-transparent py-3">
                    <h5 class="mb-0 text-dark"><i class="bi bi-shield-check me-1 text-success"></i> Active Permissions Matrix</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="rolesTable" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3">Feature Module</th>
                                    <th class="py-3">Role Level</th>
                                    <th class="py-3">Assigned By</th>
                                    <th class="py-3">Date</th>
                                    <th class="px-4 py-3 text-end" style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var role in Model.AssignedRoles)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light-primary text-primary rounded p-2 me-3">
                                                    <i class="bi bi-app-indicator"></i>
                                                </div>
                                                <span class="text-dark fw-bold">@role.FeatureAreaKey</span>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="badge bg-light-primary text-primary px-3 py-2">@role.ActionRole.ToString()</span>
                                        </td>
                                        <td class="py-3 text-muted fs-7">
                                            @role.AssignedBy
                                        </td>
                                        <td class="py-3 text-muted fs-7">
                                            @role.Date.ToString("yyyy-MM-dd")
                                        </td>
                                        <td class="px-4 py-3 text-end">
                                            @if (!Model.IsReadOnly)
                                            {
                                                <form method="post" asp-page-handler="Revoke" asp-route-id="@Model.UserProfile.Id" asp-route-roleId="@role.Id">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to revoke this feature permission?')">
                                                        Revoke
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic fs-12px">Read-only</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#rolesTable').DataTable({
                "pageLength": 10,
                "ordering": true, 
                "info": true,
                "lengthChange": false,
                "language": {
                    "emptyTable": "<div class='text-center py-4 text-muted'><i class='bi bi-shield-slash fs-2 d-block mb-2'></i>This user currently has no active custom feature permissions.</div>"
                }
            });
        });
    </script>
}


