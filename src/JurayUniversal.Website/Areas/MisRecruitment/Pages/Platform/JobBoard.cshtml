@page
@model JurayUniversal.Website.Areas.MisRecruitment.Pages.Platform.JobBoardModel
@{
    ViewData["Title"] = "Careers & Open Positions";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

@section HeaderActions {
    <a asp-page="./Track" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-search me-1"></i> Track My Application
        </a>
}

<div class="bg-primary text-white py-5 mb-5" style="background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold">Join Our Team</h1>
                <p class="lead mb-0 opacity-75">Discover your next career opportunity with us.</p>
                <div class="mt-3">
                    
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c.Type == "ApplicantRole"))
                {
                    <a asp-page="./Track" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm me-2">
                        <i class="bi bi-person-circle me-1"></i> My Dashboard
                    </a>
                    <form method="post" asp-page="./Auth/Logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-light rounded-pill px-4 fw-bold shadow-sm">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-page="./Auth/Login" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm me-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                    <a asp-page="./Auth/Register" class="btn btn-outline-light rounded-pill px-4 fw-bold shadow-sm">
                        Register
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 mb-5">

                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Right Column: Sticky Job Details -->
            <div class="col-md-7 col-lg-8">
                @if (Model.SelectedJob != null)
                {
                    <div class="card border-0 shadow rounded-4" style="position: sticky; top: 20px; max-height: 85vh; overflow-y: auto;">
                        <div class="card-body p-4 p-md-5">
                            <!-- Details Header -->
                            <h2 class="fw-bold mb-3" style="font-size: 2rem; letter-spacing: -0.5px;">@Model.SelectedJob.Title</h2>
                            
                            <div class="d-flex align-items-center text-muted mb-4 fs-6">
                                <span class="me-4"><i class="bi bi-briefcase me-1"></i> @Model.SelectedJob.JobType.ToString().Replace("FullTime", "Full-Time").Replace("PartTime", "Part-Time")</span>
                                @if (!string.IsNullOrEmpty(Model.SelectedJob.AmountOrSalary))
                                {
                                    <span><i class="bi bi-cash me-1"></i> @Model.SelectedJob.AmountOrSalary</span>
                                }
                            </div>
                            
                            <div class="mb-4">
                                <a asp-page="./Apply" asp-route-jobId="@Model.SelectedJob.Id" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                                    Apply Now <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>

                            <hr class="my-4" />

                            <!-- Description -->
                            <div style="font-size: 1.05rem; line-height: 1.8; color: #333;">
                                @Html.Raw(Model.SelectedJob.Description)
                                
                                @if (!string.IsNullOrEmpty(Model.SelectedJob.Benefits))
                                {
                                    <div class="mt-5">
                                        <h4 class="fw-bold mb-3">What We Offer</h4>
                                        @Html.Raw(Model.SelectedJob.Benefits)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>

