@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Platform.Leaves.CreateModel
@{
    ViewData["Title"] = "Submit Request";
    ViewData["Subtitle"] = "Fill out the form below to submit a leave or excuse request.";
    ViewData["ActiveMenu"] = "Leaves";
}
@using JurayUniversal.Domain.Enum

<div class="row">
    <div class="col-12">
        <div class="card premium-card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="LeaveRequest.Type" class="form-label fw-600">Request Type</label>
                        <select asp-for="LeaveRequest.Type" class="form-select" required asp-items="Html.GetEnumSelectList<JurayUniversal.Domain.Enum.Enum.LeaveRequestType>()">
                            <option value="">-- Select Type --</option>
                        </select>
                        <span asp-validation-for="LeaveRequest.Type" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="LeaveRequest.StartDate" class="form-label fw-600">Start Date</label>
                            <input asp-for="LeaveRequest.StartDate" type="date" class="form-control" required />
                            <span asp-validation-for="LeaveRequest.StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeaveRequest.EndDate" class="form-label fw-600">End Date (Optional)</label>
                            <input asp-for="LeaveRequest.EndDate" type="date" class="form-control" />
                            <div class="form-text text-muted">Leave blank if it's only a one-day excuse.</div>
                            <span asp-validation-for="LeaveRequest.EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LeaveRequest.Reason" class="form-label fw-600">Reason / Excuse Details</label>
                        <textarea asp-for="LeaveRequest.Reason" class="form-control" rows="4" required placeholder="Please provide specific details for your request..."></textarea>
                        <span asp-validation-for="LeaveRequest.Reason" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
