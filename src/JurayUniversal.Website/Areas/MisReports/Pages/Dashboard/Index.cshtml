@page
@model JurayUniversal.Website.Areas.MisReports.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Reports Dashboard";
    ViewData["Subtitle"] = "High-level overview and analytics.";
    ViewData["ActiveMenu"] = "MisReports";
    ViewData["ActiveSubMenu"] = "Dashboard";
    Layout = "/Pages/Shared/Layouts/MIS/_MisAdminLayout.cshtml";
}

@section HeaderActions {
    <a asp-page="./Submissions" class="btn btn-sm btn-light rounded-pill px-3 shadow-sm">View All</a>
}

<style>
    .premium-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.03);
        transition: all 0.3s ease;
        border-radius: 1rem;
    }
    .premium-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px 0 rgba(0, 0, 0, 0.08);
    }
    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .gradient-primary { background: linear-gradient(135deg, #4e54c8, #8f94fb); color: white; }
    .gradient-warning { background: linear-gradient(135deg, #ff9966, #ff5e62); color: white; }
    .gradient-success { background: linear-gradient(135deg, #11998e, #38ef7d); color: white; }
    .gradient-info { background: linear-gradient(135deg, #00c6ff, #0072ff); color: white; }
</style>

<div class="mis-page-header">
    
    <div class="d-flex gap-2">
        
        @if (await MisAuth.CanEditAsync(User, "MisReports"))
        {
            <a asp-page="./Schemas/Index" class="btn btn-primary btn-sm rounded-pill"><i class="bi bi-gear-fill me-1"></i> Manage Report Schemas</a>
        }
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">

    <!-- Date Range Filter -->
    <div class="card mb-4 border-0 shadow-sm rounded-4">
        <div class="card-body p-3">
            <form method="get" class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center fw-600 text-muted fs-14px">
                    <i class="bi bi-funnel-fill me-2 text-primary fs-5"></i>
                    Filter Analytics
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-3">
                        @(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "All Time")
                    </span>
                </div>
                
                <div class="d-flex align-items-stretch shadow-sm" style="max-width: 500px; flex-grow: 1; border-radius: 50px;">
                    <div class="d-flex align-items-center flex-grow-1 bg-white border border-primary border-opacity-25 border-end-0" style="border-radius: 50px 0 0 50px;">
                        <input type="hidden" name="DateRange" id="DateRangeValue" value="@Model.DateRange" />
                        <input type="text" id="DateRangeDisplay" value="@(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "")" class="border-0 shadow-none bg-transparent py-2 px-4 w-100" placeholder="Search by date range..." style="font-size: 14px; font-weight: 500; outline: none; cursor: pointer;" readonly="readonly" />
                        @if (!string.IsNullOrEmpty(Model.DateRange))
                        {
                            <a href="?DateRange=" class="text-danger px-3 d-flex align-items-center" title="Clear Date Filter" style="text-decoration: none;">
                                <i class="bi bi-x-circle-fill fs-5"></i>
                            </a>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary px-4 m-0 d-flex align-items-center justify-content-center" style="border-radius: 0 50px 50px 0 !important; font-weight: 600; border: 1px solid var(--md-primary); z-index: 1;">
                        <i class="bi bi-search me-2"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI Cards Row -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <a asp-page="./Schemas/Index" class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Active Schemas</h6>
                            <h2 class="fw-800 text-dark mb-0">@Model.TotalSchemas</h2>
                        </div>
                        <div class="icon-box gradient-primary shadow-sm">
                            <i class="bi bi-file-earmark-bar-graph"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a asp-page="./Submissions" class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Total Submissions</h6>
                            <h2 class="fw-800 text-info mb-0">@Model.TotalSubmissionsAllTime</h2>
                        </div>
                        <div class="icon-box gradient-info shadow-sm">
                            <i class="bi bi-files"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Submissions (7 Days)</h6>
                            <h2 class="fw-800 text-success mb-0">@Model.SubmissionsLast7Days</h2>
                        </div>
                        <div class="icon-box gradient-success shadow-sm">
                            <i class="bi bi-calendar-week"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">On-Time Rate (7 Days)</h6>
                            <h2 class="fw-800 text-warning mb-0">@Model.OnTimeRate7Days%</h2>
                        </div>
                        <div class="icon-box gradient-warning shadow-sm">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row g-4 mb-4">
        <!-- Submission Trend Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Submission Trends (Last 7 Days)</h5>
                    <div style="height: 300px;">
                        <canvas id="reportsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- Schema Distribution Pie -->
        <div class="col-xl-4 col-lg-5">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Submissions by Schema</h5>
                    <div style="height: 300px; display:flex; align-items:center; justify-content:center;">
                        <canvas id="schemaChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row g-4 mb-4">
        <!-- Top Reporters Bar Chart -->
        <div class="col-xl-6">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Top Active Reporters</h5>
                    <div style="height: 350px;">
                        <canvas id="reportersChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Recent Submissions Feed -->
        <div class="col-xl-6">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />

@section Scripts {
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(function() {
            $('#DateRangeDisplay').daterangepicker({
                autoUpdateInput: false,
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                    'All Time': [moment().subtract(10, 'years'), moment()]
                },
                @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                {
                    <text>
                    startDate: '@Model.StartDate.Value.ToString("yyyy-MM-dd")',
                    endDate: '@Model.EndDate.Value.ToString("yyyy-MM-dd")',
                    </text>
                }
                locale: {
                    cancelLabel: 'Clear',
                    format: 'dddd DD MMMM, YYYY'
                }
            });

            $('#DateRangeDisplay').on('apply.daterangepicker', function(ev, picker) {
                $(this).val(picker.startDate.format('dddd DD MMMM, YYYY') + ' - ' + picker.endDate.format('dddd DD MMMM, YYYY'));
                $('#DateRangeValue').val(picker.startDate.format('YYYY-MM-DD') + ' - ' + picker.endDate.format('YYYY-MM-DD'));
            });

            $('#DateRangeDisplay').on('cancel.daterangepicker', function(ev, picker) {
                $(this).val('');
                $('#DateRangeValue').val('');
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
            Chart.defaults.color = '#6c757d';
            
            // 1. Stacked Bar Chart for 7-Day Trend
            var ctx = document.getElementById('reportsChart').getContext('2d');
            
            var chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
            var onTimeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OnTimeData));
            var lateData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LateData));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [
                        {
                            label: 'On-Time Submissions',
                            data: onTimeData,
                            backgroundColor: 'rgba(17, 153, 142, 0.85)',
                            borderRadius: 4
                        },
                        {
                            label: 'Late Submissions',
                            data: lateData,
                            backgroundColor: 'rgba(255, 153, 102, 0.85)',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true, grid: { display: false } },
                        y: { stacked: true, beginAtZero: true, grid: { color: '#f0f0f0' }, border: { dash: [5, 5] }, ticks: { precision: 0 } }
                    },
                    plugins: { legend: { position: 'top' } }
                }
            });

            // 2. Schema Distribution Pie Chart
            var schemaCtx = document.getElementById('schemaChart').getContext('2d');
            new Chart(schemaCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SchemaLabels)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SchemaData)),
                        backgroundColor: ['#4e54c8', '#11998e', '#ff9966', '#00c6ff', '#dc3545'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 15 } }
                    }
                }
            });

            // 3. Top Reporters Bar Chart
            var topRepCtx = document.getElementById('reportersChart').getContext('2d');
            var repLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopReporters.Select(r => r.Name)));
            var repData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopReporters.Select(r => r.Count)));
            
            new Chart(topRepCtx, {
                type: 'bar',
                data: {
                    labels: repLabels,
                    datasets: [{
                        label: 'Total Submissions',
                        data: repData,
                        backgroundColor: 'rgba(0, 198, 255, 0.8)',
                        borderRadius: 6,
                        borderWidth: 0,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#f0f0f0' }, border: { dash: [5, 5] }, ticks: { stepSize: 1 } },
                        y: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}


