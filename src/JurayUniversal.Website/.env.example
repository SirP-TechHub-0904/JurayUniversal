# ==========================================
# JurayUniversal Environment Template (.env.example)
# ==========================================

# Master / Central Database Connection String
TenantConfiguration__ConnectionString="Server=YOUR_SERVER;Database=YOUR_CENTRAL_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"

# Active Tenant Connection (Name must match domain/port)
TenantConfiguration__Tenants__0__Name="juray.ng"
TenantConfiguration__Tenants__0__ConnectionString="Server=YOUR_SERVER;Database=YOUR_TENANT_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"

# AWS S3 Storage
AwsConfiguration__AWSAccessKey="YOUR_AWS_ACCESS_KEY"
AwsConfiguration__AWSSecretKey="YOUR_AWS_SECRET_KEY"

# Postmark Settings
PostmarkSettings__ServerToken="YOUR_POSTMARK_TOKEN"

# Kudi SMS API Key
KudiSmsApiKey="YOUR_KUDI_SMS_KEY"

# Paystack Payment Gateway
Paystack__SecretKey="YOUR_PAYSTACK_SECRET_KEY"

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5060