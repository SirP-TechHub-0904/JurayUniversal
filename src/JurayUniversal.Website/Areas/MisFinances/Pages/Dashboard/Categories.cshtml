@page
@model JurayUniversal.Website.Areas.MisFinances.Pages.Dashboard.CategoriesModel
@{
    ViewData["Title"] = "Payment Categories";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

@section HeaderActions {
    <a asp-page="./CreateCategory" class="btn btn-primary btn-sm rounded-pill">
        <i class="bi bi-plus-lg me-1"></i> New Category
    </a>
}

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-3" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" data-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            @if (Model.Categories.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle misTableList">
                        <thead class="table-light">
                            <tr>
                                <th class="mis-table-th">Category Title <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                                <th class="mis-table-th">Target Audience <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                                <th class="mis-table-th">Type <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                                <th class="mis-table-th">Frequency <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                                <th class="mis-table-th">Amount <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                                <th class="mis-table-th">Public Link</th>
                                <th class="mis-table-th">Status</th>
                                <th class="text-end mis-table-th" style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model.Categories)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@cat.Title</div>
                                        @if (!string.IsNullOrEmpty(cat.Description))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width: 220px;">@cat.Description</div>
                                        }
                                    </td>
                                    <td>
                                        @if (cat.MisGroup != null)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">
                                                <i class="bi bi-people-fill me-1"></i> @cat.MisGroup.Title
                                            </span>
                                        }
                                        else if (cat.UserCategory != null)
                                        {
                                            <span class="badge rounded-pill" style="background-color: #f3e8ff; color: #6b21a8;">
                                                <i class="bi bi-person-badge me-1"></i> @cat.UserCategory.Title
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill">
                                                All Members / Public
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (cat.IsCompulsory)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">
                                                <i class="bi bi-lock-fill me-1"></i> Compulsory Due
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill">
                                                <i class="bi bi-heart-fill me-1"></i> Optional Donation
                                            </span>
                                        }

                                        @if (cat.AllowGuestPayment)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info rounded-pill ms-1">
                                                <i class="bi bi-globe me-1"></i> Public
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill ms-1">
                                                <i class="bi bi-person-lock me-1"></i> Members Only
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted">@cat.Frequency</td>
                                    <td>
                                        @if (cat.FixedAmount.HasValue)
                                        {
                                            <span class="fw-bold text-dark">&#8358;@cat.FixedAmount.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">User chooses</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var domain = !string.IsNullOrEmpty(Model.SuperSetting?.CompanyWebsiteLink) 
                                                ? Model.SuperSetting.CompanyWebsiteLink.TrimEnd('/') 
                                                : $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}";
                                            var key = !string.IsNullOrEmpty(cat.Key) ? cat.Key : cat.Id.ToString();
                                            var payLink = $"{domain}/pay/{key}";
                                        }
                                        <div class="input-group input-group-sm border rounded-pill overflow-hidden bg-light" style="max-width: 240px;">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent ps-3 font-monospace fw-medium" value="@payLink" readonly id="paylink-@cat.Id" />
                                            <button class="btn btn-light border-0 px-3 text-primary d-flex align-items-center justify-content-center" type="button"
                                                    title="Copy Public Link"
                                                    onclick="navigator.clipboard.writeText('@payLink').then(()=> { var el=document.getElementById('paylink-@cat.Id'); el.classList.add('bg-success', 'bg-opacity-10'); setTimeout(()=>el.classList.remove('bg-success', 'bg-opacity-10'),1200); })">
                                                <i class="bi bi-copy fs-6"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(cat.IsActive ? "bg-success" : "bg-secondary") bg-opacity-10 @(cat.IsActive ? "text-success" : "text-secondary") rounded-pill">
                                            @(cat.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border rounded-pill dropdown-toggle px-3" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical me-1"></i> Actions
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                                <li>
                                                    <a asp-page="./EditCategory" asp-route-id="@cat.Id" class="dropdown-item py-2">
                                                        <i class="bi bi-pencil-square me-2 text-primary"></i> Edit Category
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-page="./Ledger" asp-route-id="@cat.Id" class="dropdown-item py-2">
                                                        <i class="bi bi-journal-text me-2 text-success"></i> Payment Ledger
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-wallet2 text-muted opacity-50 mb-3 d-block" style="font-size: 4rem;"></i>
                    <h4 class="fw-bold text-muted">No Payment Categories Yet</h4>
                    <p class="text-muted">Create your first payment category to start collecting dues or donations.</p>
                    <a asp-page="./CreateCategory" class="btn btn-primary rounded-pill px-4 mt-3">
                        <i class="bi bi-plus-lg me-1"></i> Create First Category
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />
