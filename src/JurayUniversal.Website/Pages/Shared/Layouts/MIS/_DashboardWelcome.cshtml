@using System.Security.Claims

@{
    string userFullName = User.Identity?.Name ?? "User";
    if (userFullName.Contains("@"))
    {
        userFullName = userFullName.Split('@')[0];
    }
}

<!-- WIDGET: Welcome / Quick Start -->
<div class="rounded-2xl shadow-sm text-white p-6 mb-6 position-relative overflow-hidden" id="welcome-widget" style="background: linear-gradient(135deg, #0069A1 0%, #004d77 100%) !important; border-radius: 16px;">
    <div class="d-flex items-start justify-between flex-row justify-content-between align-items-start mb-3">
        <div>
            <h4 class="text-xl sm:text-2xl font-bold text-white mb-1 fw-bold">Hi, @userFullName.</h4>
            <p class="text-xs sm:text-sm text-blue-100 mb-4 opacity-90">Here's what's happening across your workspace today.</p>
        </div>
        <button type="button" class="btn text-white opacity-75 hover-opacity-100 p-1 border-0" onclick="document.getElementById('welcome-widget').classList.add('hidden')" style="background: transparent;">
            <i class="fas fa-times fs-16px"></i>
        </button>
    </div>

    <div class="d-flex flex-column gap-3 mb-4">
        <a href="javascript:;" onclick="typeof openQuickGuide === 'function' ? openQuickGuide() : null" class="d-flex align-items-center gap-3 text-white text-decoration-none p-2 rounded-3 hover-bg-white-10 transition-colors" style="background: rgba(255,255,255,0.08);">
            <div class="rounded-circle bg-white bg-opacity-20 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; background: rgba(255,255,255,0.2);">
                <i class="fas fa-graduation-cap text-white fs-16px"></i>
            </div>
            <div>
                <div class="fw-bold text-sm text-white">Getting started with MIS</div>
                <div class="text-xs text-blue-100 opacity-80">Understand key administrative setup flows</div>
            </div>
        </a>
        <a href="javascript:;" onclick="typeof openQuickGuide === 'function' ? openQuickGuide() : null" class="d-flex align-items-center gap-3 text-white text-decoration-none p-2 rounded-3 hover-bg-white-10 transition-colors" style="background: rgba(255,255,255,0.08);">
            <div class="rounded-circle bg-white bg-opacity-20 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; background: rgba(255,255,255,0.2);">
                <i class="fas fa-user-shield text-white fs-16px"></i>
            </div>
            <div>
                <div class="fw-bold text-sm text-white">Permissions Roles Matrix</div>
                <div class="text-xs text-blue-100 opacity-80">Check what staff and members can access</div>
            </div>
        </a>
    </div>
    <button type="button" class="w-100 btn btn-warning text-dark font-bold text-sm shadow-sm border-0 py-2.5 px-4 rounded-xl fw-bold d-flex align-items-center justify-content-center gap-2" style="background-color: #ffc107 !important; border-radius: 12px; font-weight: 700; color: #111827 !important;" onclick="typeof openQuickGuide === 'function' ? openQuickGuide() : null">
        <i class="fas fa-magic me-1"></i> Open Onboarding Wizard
    </button>
</div>
