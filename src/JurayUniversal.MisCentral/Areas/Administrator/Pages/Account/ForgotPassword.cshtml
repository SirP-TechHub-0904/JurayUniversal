@page "/Administrator/Account/ForgotPassword"
@model JurayUniversal.MisCentral.Areas.Administrator.Pages.Account.ForgotPasswordModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Forgot Password - MIS Central";
}

<section class="min-h-screen pt-32 pb-20 flex items-center relative overflow-hidden bg-slate-900">
    <div class="container mx-auto px-4 max-w-md relative z-10">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-white tracking-tight">Reset Central Password</h1>
            <p class="text-slate-400 text-sm mt-2">Enter your verified administrator email address to reset access credentials.</p>
        </div>

        <div class="bg-slate-800/80 backdrop-blur-xl border border-slate-700/60 rounded-2xl shadow-2xl p-8">
            @if (Model.EmailSent)
            {
                <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm text-center">
                    <i class="bi bi-check-circle-fill text-2xl block mb-2"></i>
                    If an administrator account is registered under this email, recovery instructions have been dispatched. Alternatively, you may contact the Master Super Administrator.
                </div>
                <div class="mt-6 text-center">
                    <a href="/Administrator/Account/Login" class="text-xs font-semibold text-blue-400 hover:text-blue-300">&larr; Return to Login</a>
                </div>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="p-3 mb-4 rounded bg-red-500/10 text-red-400 text-xs"></div>
                    <div class="mb-5">
                        <label asp-for="Input.Email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Master Admin Email</label>
                        <input asp-for="Input.Email" class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700 text-white rounded-xl text-sm focus:outline-none focus:border-blue-500" placeholder="superadmin@jurayuniversal.com" />
                        <span asp-validation-for="Input.Email" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <button type="submit" class="w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all">
                        Request Recovery Email
                    </button>
                </form>
                <div class="mt-4 text-center">
                    <a href="/Administrator/Account/Login" class="text-xs text-slate-400 hover:text-slate-300">&larr; Back to Login</a>
                </div>
            }
        </div>
    </div>
</section>
