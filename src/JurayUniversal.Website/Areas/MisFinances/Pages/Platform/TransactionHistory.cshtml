@page "/MisFinances/Platform/TransactionHistory"
@model JurayUniversal.Website.Areas.MisFinances.Pages.Platform.TransactionHistoryModel
@{
    ViewData["Title"] = "Transaction History";
    ViewData["Subtitle"] = "A full record of all your payments and contributions.";
}

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            @if (Model.MyTransactions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Category / Purpose</th>
                                <th>Amount</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int row = 1; }
                            @foreach (var t in Model.MyTransactions)
                            {
                                <tr>
                                    <td class="text-muted">@(row++)</td>
                                    <td class="fw-semibold">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">
                                            @(t.Category?.Title ?? "General Payment")
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">&#8358;@t.Amount.ToString("N2")</td>
                                    <td><code class="fs-8">@t.TransactionReference</code></td>
                                    <td>
                                        @switch (t.Status)
                                        {
                                            case JurayUniversal.Domain.Enum.Enum.PaymentStatus.Success:
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Paid</span>
                                                break;
                                            case JurayUniversal.Domain.Enum.Enum.PaymentStatus.Pending:
                                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">Pending</span>
                                                break;
                                            case JurayUniversal.Domain.Enum.Enum.PaymentStatus.Failed:
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">Failed</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">@t.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-muted">
                                        @(t.PaidAt?.ToString("MMM dd, yyyy HH:mm") ?? t.CreatedAt.ToString("MMM dd, yyyy HH:mm"))
                                    </td>
                                    <td>
                                        @if (t.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Pending ||
                                             t.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Failed)
                                        {
                                            <a href="/pay/@t.MisFinanceCategoryId"
                                               class="btn btn-sm btn-outline-warning rounded-pill"
                                               title="Retry this payment">
                                                <i class="bi bi-arrow-repeat me-1"></i> Retry
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">â€”</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt text-muted opacity-50 mb-3 d-block" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold text-muted">No Payments Made Yet</h5>
                    <p class="text-muted fs-7">Your transaction history will appear here once you make a payment.</p>
                    <a href="/MisFinances/Platform/MyFinances" class="btn btn-primary rounded-pill mt-2">
                        <i class="bi bi-credit-card me-1"></i> View My Finances
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />


