@page "{id:long}"
@model JurayUniversal.Website.Areas.MisVoting.Pages.Platform.ResultsModel
@{
    ViewData["Title"] = "Election Results - " + Model.Election.Title;
    Layout = "~/Pages/Shared/Layouts/MIS/_MisVotingLayout.cshtml";
    int totalVotesCast = Model.Election.MisVoteCategories.SelectMany(x => x.MisCandidates).SelectMany(x => x.MisUserVotes).Count();
}

<div class="container max-w-1200 mt-4 mb-5">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-dark text-white rounded-top-4 p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="card-title fw-bold mb-1 text-white">Final Results</h4>
                <p class="mb-0 text-white-50">@Model.Election.Title</p>
            </div>
            <div class="text-end">
                <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3 py-2 fs-6 mb-2">
                    <i class="bi bi-check-circle-fill me-2"></i> Election Completed
                </span>
                <h3 class="mb-0 fw-bold">@totalVotesCast.ToString("N0") <span class="fs-6 text-white-50 fw-normal">Total Votes Cast</span></h3>
            </div>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="row g-4">
                @foreach (var category in Model.Election.MisVoteCategories.OrderBy(x => x.SortOrder))
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <h5 class="fw-bold text-uppercase mb-0 text-primary border-start border-4 border-primary ps-3">@category.Title</h5>
                            </div>
                            <div class="card-body p-4">
                                @{
                                    var categoryTotalVotes = category.MisCandidates.Sum(c => c.MisUserVotes?.Count() ?? 0);
                                    var sortedCandidates = category.MisCandidates.OrderByDescending(c => c.MisUserVotes?.Count() ?? 0).ToList();
                                    var maxVotes = sortedCandidates.FirstOrDefault()?.MisUserVotes?.Count() ?? 0;
                                }

                                <div class="d-flex flex-column gap-4 mt-3">
                                    @for (int i = 0; i < sortedCandidates.Count; i++)
                                    {
                                        var candidate = sortedCandidates[i];
                                        var candidateVotes = candidate.MisUserVotes?.Count() ?? 0;
                                        var percentage = categoryTotalVotes > 0 ? Math.Round((double)candidateVotes / categoryTotalVotes * 100, 1) : 0;
                                        var isWinner = i == 0 && candidateVotes > 0;
                                        var voteDifference = maxVotes - candidateVotes;
                                        
                                        // Colors
                                        var barColor = isWinner ? "bg-warning" : "bg-primary";
                                        if (i == 1) barColor = "bg-info";
                                        if (i > 1) barColor = "bg-secondary";

                                        <div class="d-flex align-items-center">
                                            <!-- Profile Image -->
                                            <div class="flex-shrink-0 position-relative me-4">
                                                @if (!string.IsNullOrEmpty(candidate.CandidateImageUrl))
                                                {
                                                    <img src="@candidate.CandidateImageUrl" alt="@candidate.Title" class="rounded-circle object-fit-cover border shadow-sm" style="width: 80px; height: 80px; @(isWinner ? "border: 4px solid #ffc107 !important;" : "")" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light text-secondary rounded-circle d-flex align-items-center justify-content-center border shadow-sm" style="width: 80px; height: 80px; @(isWinner ? "border: 4px solid #ffc107 !important;" : "")">
                                                        <i class="bi bi-person-fill fs-1"></i>
                                                    </div>
                                                }
                                                @if (isWinner)
                                                {
                                                    <div class="position-absolute top-0 start-100 translate-middle">
                                                        <i class="bi bi-star-fill text-warning fs-3" style="filter: drop-shadow(0px 2px 2px rgba(0,0,0,0.2));"></i>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Progress Bar and Details -->
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-end mb-1">
                                                    <div>
                                                        <h5 class="fw-bold mb-0">@candidate.Title</h5>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="fs-5 fw-bold">@percentage%</span>
                                                        <span class="text-muted ms-2">(@candidateVotes.ToString("N0") votes)</span>
                                                    </div>
                                                </div>
                                                
                                                <div class="progress" style="height: 12px; border-radius: 6px; background-color: #e9ecef;">
                                                    <div class="progress-bar @barColor rounded-pill" role="progressbar" style="width: @percentage%;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>

                                                <div class="mt-1 small fw-bold">
                                                    @if (isWinner)
                                                    {
                                                        <span class="text-warning"><i class="bi bi-trophy-fill me-1"></i> WINNER</span>
                                                    }
                                                    else if (candidateVotes > 0)
                                                    {
                                                        <span class="text-muted">Trailing -@voteDifference</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer bg-white border-top text-center py-4">
            <a asp-page="/Platform/Index" class="btn btn-outline-primary rounded-pill px-5 fw-bold"><i class="bi bi-arrow-left me-2"></i> Back to Elections Hub</a>
        </div>
    </div>
</div>
