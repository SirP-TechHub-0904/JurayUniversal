@page
@model JurayUniversal.Website.Areas.MisContent.Pages.IPages.Section.IndexModel

@{
    ViewData["Title"] = "PAGE SECTION ";
}

@section HeaderActions {
    <a asp-page="./Create" class="btn bg-gradient-warning btn-sm" style="float:right;">Add New</a>
}

<div class="card">
    
    <!-- /.card-header -->
    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>S/N</th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].VideoUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].VideoKey)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].ImageUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].ImageKey)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].FullDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].ButtonText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].ButtonLink)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].ShowInHome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].Disable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].HomePageSortOrder)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].PageSortOrder)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageSection[0].WebPage)
            </th>
            <th></th>
        </tr>
                </thead>

                @{
                    int sn = 0;
                }
    <tbody>
@foreach (var item in Model.PageSection) {
                        <tr>

                            <td>
                                @{
                                    sn++;
                                }
                                @sn
                            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VideoUrl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VideoKey)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImageUrl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImageKey)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FullDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ButtonText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ButtonLink)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ShowInHome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Disable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HomePageSortOrder)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PageSortOrder)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WebPage.Title)
            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-success">Action</button>

                                    <div class="btn-group">
                                        <button type="button" class="btn btn-success dropdown-toggle dropdown-icon" data-bs-toggle="dropdown" aria-expanded="false">
                                        </button>
                                        <div class="dropdown-menu" style="">

                                            <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.Id">Details</a>
                                            <a class="dropdown-item" asp-page="./Edit" asp-route-id="@item.Id">Edit</a>

                                        </div>
                                    </div>
                                </div>

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



