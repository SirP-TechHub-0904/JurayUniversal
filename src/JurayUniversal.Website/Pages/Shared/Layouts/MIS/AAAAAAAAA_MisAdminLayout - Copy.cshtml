@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context
@using System.Security.Claims

@{
    var superSetting = _context.SuperSettings.FirstOrDefault();
    var hasAdminRole = User.IsInRole("Admin") || User.IsInRole("mSuperAdmin") || User.IsInRole("Administrator") || User.IsInRole("Editor");
    
    // Identity fields
    string userFullName = User.Identity?.Name ?? "User";
    string userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "user@example.com";
    string userInitials = string.IsNullOrEmpty(userFullName) ? "U" : userFullName.Substring(0, 1).ToUpper();

    // Determine current sidebar context (User Platform vs Admin Dashboard)
    bool isPlatform = ViewContext.RouteData.Values["page"]?.ToString().Contains("/Platform/") == true;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light" data-app-sidebar="full" data-color-theme="blue" style="--footer-height: 51px;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <!-- Title & Icon -->
    <partial name="~/Pages/Shared/Layouts/MIS/_MisHeadTitle.cshtml" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
    <link href="~/Layout/mistemlate/css2" rel="stylesheet">

    <!-- CSS Stylesheets -->
    <link rel="stylesheet" href="~/Layout/mistemlate/all.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/lucide.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/all.min.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/simplebar.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/waves.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/bootstrap-select.min.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/flatpickr.min.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/datatables.min.css">
    <link rel="stylesheet" href="~/Layout/mistemlate/styles.css">

    <!-- Custom CSS Overrides -->
    <partial name="~/Pages/Shared/Layouts/MIS/_MisDashboardCSS.cshtml" />
    
    @RenderSection("Styles", required: false)

    <style>
        /* CSS Overrides for Option B: Stacked Labels in Left Tab Strip */
        :root {
            --app-menubar-tabs: 330px !important;
            --app-sidebar-width: 250px !important;
        }
        .app-menubar-tabs .app-navbar-brand {
            width: 90px !important;
            min-width: 90px !important;
            padding: 15px 5px !important;
        }
        .app-menubar-tabs .app-tab-content {
            left: 90px !important;
            width: calc(var(--app-menubar-tabs) - 90px) !important;
        }
        .app-navbar-tabs {
            width: 90px !important;
            padding: 10px 5px 16px 5px !important;
        }
        .app-navbar-tabs .nav-item .menu-link {
            padding: 8px 4px !important;
        }
        .app-navbar-tabs .nav-item .menu-link span {
            display: block !important;
            font-size: 8px !important;
            line-height: 1.1 !important;
            word-break: keep-all;
        }
        .app-navbar-tabs .nav-item-hr {
            margin: 10px auto !important;
        }
        
        /* Form element and select spacing fixes */
        .bootstrap-select .dropdown-toggle:focus {
            outline: none !important;
        }
        
        /* Page content wrapper minimal alignment */
        .app-wrapper {
            background-color: var(--bs-body-bg-subtle) !important;
            min-height: calc(100vh - var(--app-header-height) - 51px) !important;
        }
    </style>
</head>

<body>

    <div class="page-layout">

        <!-- ==================== PAGE HEADER ==================== -->
        <header class="app-header">
            <div class="app-header-inner d-flex justify-content-between align-items-center w-100">
                
                <!-- Toggle Menu Button -->
                <div class="d-flex align-items-center gap-3">
                    <button class="app-toggler" type="button" aria-label="app toggler">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    
                    <div class="app-header-start d-none d-md-flex align-items-center">
                        <div class="badge bg-primary-subtle text-primary border-0 rounded-pill px-3 py-2">
                            <i class="fi fi-rr-info me-1"></i> MIS Platform
                        </div>
                    </div>
                </div>

                <!-- Right Header Controls -->
                <div class="app-header-end d-flex align-items-center">
                    
                    <!-- Theme Mode Toggle -->
                    <div class="px-lg-4 px-2 ps-0 d-flex align-items-center">
                        <a href="javascript:void(0);" class="theme-btn" style="color: var(--bs-heading-color);">
                            <svg class="icon-light" width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M14.1663 10.5002C14.1663 12.8013 12.3008 14.6668 9.99967 14.6668C7.69849 14.6668 5.83301 12.8013 5.83301 10.5002C5.83301 8.19898 7.69849 6.3335 9.99967 6.3335C12.3008 6.3335 14.1663 8.19898 14.1663 10.5002Z" fill="currentColor"></path>
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.0003 1.5415C10.3455 1.5415 10.6253 1.82133 10.6253 2.1665V3.83317C10.6253 4.17834 10.3455 4.45817 10.0003 4.45817C9.65516 4.45817 9.37532 4.17834 9.37532 3.83317V2.1665C9.37532 1.82133 9.65516 1.5415 10.0003 1.5415ZM1.04199 10.4998C1.04199 10.1547 1.32182 9.87484 1.66699 9.87484H3.33366C3.67883 9.87484 3.95866 10.1547 3.95866 10.4998C3.95866 10.845 3.67883 11.1248 3.33366 11.1248H1.66699C1.32182 11.1248 1.04199 10.845 1.04199 10.4998ZM16.042 10.4998C16.042 10.1547 16.3218 9.87484 16.667 9.87484H18.3337C18.6788 9.87484 18.9587 10.1547 18.9587 10.4998C18.9587 10.845 18.6788 11.1248 18.3337 11.1248H16.667C16.3218 11.1248 16.042 10.845 16.042 10.4998ZM10.0003 16.5415C10.3455 16.5415 10.6253 16.8213 10.6253 17.1665V18.8332C10.6253 19.1783 10.3455 19.4582 10.0003 19.4582C9.65516 19.4582 9.37532 19.1783 9.37532 18.8332V17.1665C9.37532 16.8213 9.65516 16.5415 10.0003 16.5415Z" fill="currentColor"></path>
                            </svg>
                            <svg class="icon-dark d-none" width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M16.5835 2.4225C16.4495 2.08117 15.9681 2.08117 15.834 2.4225L15.4754 3.33523C15.4345 3.43944 15.3523 3.52193 15.2485 3.56303L14.339 3.92301C13.999 4.05762 13.999 4.54067 14.339 4.67529L15.2485 5.03527C15.3523 5.07637 15.4345 5.15886 15.4754 5.26306L15.834 6.1758C15.9681 6.51712 16.4495 6.51712 16.5835 6.17581L16.9422 5.26306C16.9831 5.15886 17.0653 5.07637 17.1691 5.03527L18.0785 4.67529C18.4186 4.54067 18.4186 4.05762 18.0785 3.92301L17.1691 3.56303C17.0653 3.52193 16.9831 3.43944 16.9422 3.33523L16.5835 2.4225Z" fill="currentColor"></path>
                                <path opacity="0.5" d="M10.0003 18.8332C14.6027 18.8332 18.3337 15.1022 18.3337 10.4998C18.3337 10.1143 17.7557 10.0505 17.5563 10.3805C16.6077 11.9503 14.8849 12.9998 12.917 12.9998C9.92541 12.9998 7.50032 10.5748 7.50032 7.58317C7.50032 5.61521 8.54982 3.89238 10.1197 2.9438C10.4497 2.7444 10.3859 2.1665 10.0003 2.1665C5.39795 2.1665 1.66699 5.89746 1.66699 10.4998C1.66699 15.1022 5.39795 18.8332 10.0003 18.8332Z" fill="currentColor"></path>
                            </svg>
                        </a>
                    </div>

                    <!-- Context Toggle for Admins (Admin view <-> User view) -->
                    @if (hasAdminRole)
                    {
                        <div class="px-2">
                            @if (isPlatform)
                            {
                                <a asp-area="MIS" asp-page="/Dashboard/Index" class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="fi fi-rr-arrow-left-right me-1"></i> Admin View
                                </a>
                            }
                            else
                            {
                                <a asp-area="MIS" asp-page="/Platform/Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                                    <i class="fi fi-rr-arrow-left-right me-1"></i> User View
                                </a>
                            }
                        </div>
                    }

                    <div class="vr my-3 mx-2"></div>

                    <!-- Profile Dropdown -->
                    <div class="dropdown text-end ms-sm-2 ms-1">
                        <a href="#" class="d-flex align-items-center py-2" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <div class="text-end me-2 d-none d-lg-inline-block">
                                <div class="fw-bold text-dark" style="font-size: 13px;">@userFullName</div>
                                <small class="text-muted d-block lh-sm" style="font-size: 11px;">
                                    <i class="fi fi-rr-angle-down text-3xs me-1"></i> Member
                                </small>
                            </div>
                            <div class="avatar avatar-sm rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                                @userInitials
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end w-225px mt-1 shadow border-0">
                            <li class="d-flex align-items-center p-3 border-bottom">
                                <div class="avatar avatar-sm rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                    @userInitials
                                </div>
                                <div class="ms-2">
                                    <div class="fw-bold text-dark" style="font-size: 13px;">@userFullName</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 140px; font-size: 11px;">@userEmail</small>
                                </div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-area="MisUserManagement" asp-page="/Platform/MyProfile">
                                    <i class="fi fi-rr-user me-2 text-muted"></i> My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-area="MisUserManagement" asp-page="/Platform/ChangePassword">
                                    <i class="fi fi-rr-key me-2 text-muted"></i> Change Password
                                </a>
                            </li>
                            <li class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger py-2" asp-area="V2" asp-page="/AuthV2/Logout">
                                    <i class="fi fi-rr-sign-out me-2"></i> Logout
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>

            </div>
        </header>

        <!-- ==================== SIDEBAR (DYNAMIC) ==================== -->
        @if (isPlatform)
        {
            <partial name="~/Pages/Shared/Layouts/MIS/_MisUserSidebar.cshtml" />
        }
        else
        {
            <partial name="~/Pages/Shared/Layouts/MIS/_MisAdminSidebar.cshtml" />
        }

        <!-- ==================== MAIN CONTENT WRAPPER ==================== -->
        <div class="app-wrapper">
            <div class="app-content-inner px-4 py-3">
                @RenderBody()
            </div>
        </div>

        <!-- ==================== FOOTER ==================== -->
        <footer class="footer-wrapper">
            <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 12px;">
                <div>
                    <p class="mb-0">@DateTime.Now.Year &copy; @(superSetting?.CompanyName ?? "MIS Platform")</p>
                </div>
                <div>
                    <p class="mb-0">Crafted with <span class="text-danger"><i class="bi bi-heart-fill"></i></span> by JurayUniversal</p>
                </div>
            </div>
        </footer>

    </div>

    <!-- ==================== SCRIPTS ==================== -->
    <script src="~/dashboard/plugins/jquery/jquery.min.js"></script>
    <script src="~/Layout/mistemlate/global.min.js"></script>
    <script src="~/Layout/mistemlate/Sortable.min.js"></script>
    <script src="~/Layout/mistemlate/chart.js"></script>
    <script src="~/Layout/mistemlate/flatpickr.min.js"></script>
    <script src="~/Layout/mistemlate/apexcharts.min.js"></script>
    <script src="~/Layout/mistemlate/datatables.min.js"></script>
    <script src="~/Layout/mistemlate/dashboard.js"></script>
    <script src="~/Layout/mistemlate/todolist.js"></script>
    <script src="~/Layout/mistemlate/appSettings.js"></script>
    <script src="~/Layout/mistemlate/main.js"></script>

    <!-- Global Plugins (Ported plugins & toastr scripts) -->
    <partial name="~/Pages/Shared/Layouts/MIS/_MisScript.cshtml" />

    @RenderSection("Scripts", required: false)

    <script>
        // Custom dark/light mode toggle helper
        $(document).ready(function() {
            var docEl = document.documentElement;
            
            // Sync initial svg display state
            function syncThemeSvg() {
                var theme = docEl.getAttribute('data-bs-theme');
                if (theme === 'dark') {
                    $('.icon-light').addClass('d-none');
                    $('.icon-dark').removeClass('d-none');
                } else {
                    $('.icon-dark').addClass('d-none');
                    $('.icon-light').removeClass('d-none');
                }
            }
            
            syncThemeSvg();

            $('.theme-btn').on('click', function() {
                setTimeout(function() {
                    syncThemeSvg();
                }, 100);
            });
        });
    </script>
</body>
</html>
