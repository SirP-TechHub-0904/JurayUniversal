                                    @Html.Raw(item.Description)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="section-content">
                    <div class="client-grid m-b40">
                        <div class="row justify-content-center no-gutters">
                            @foreach (var list in item.PageSectionLists)
                            {

                                <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                                    @{
                                        string url = "";
                                        if (list.ButtonLink == "0")
                                        {
                                            url = "";

                                        }
                                        else if (list.ButtonLink == "Direct")
                                        {
                                            url = list.DirectUrl;

                                        }
                                        else if (list.ButtonLink == "00")
                                        {
                                            url = "/Contact";
                                        }
                                        else
                                        {
                                            url = Url.Page("/Source", new { id = list.ButtonLink, title = regex.Replace(list.Title, "-") });
                                        }
                                    }
                                    <a class="client-logo-pic" href="@url">
                                        <img alt="" src="@list.ImageUrl">
                                        <div>
                                            <span class="site-button-link">@list.ButtonText</span>
                                        </div>
                                    </a>
                                </div>
                            }

