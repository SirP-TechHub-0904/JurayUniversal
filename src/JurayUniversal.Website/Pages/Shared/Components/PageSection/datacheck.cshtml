                                            @foreach (var list in item.PageSectionLists)
                                            {
                                                <div class="owl-item">
                                                    <div class="col-one fadingcol item overflow-hide">
                                                        <div class="box-animation-one">
                                                            <img alt="" src="@list.ImageUrl">
                                                            <div class="box-inner-content">
                                                                <h4 class="sx-tilte">
                                                                    <a href="javascript:void();">@list.Title</a>
                                                                </h4>
                                                                <p class="m-b0">@list.MiniTitle</p>
                                                                <a class="elem" href="@list.ImageUrl" title="@list.Title" data-lcl-txt="@list.MiniTitle" data-lcl-author="@list.Title" data-lcl-thumb="@list.ImageUrl"><i></i></a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                        </div>
                                    </div>
                                    <div class="owl-nav">
                                        <button type="button" role="presentation" class="owl-prev disabled">
                                            <i class="fa fa-angle-left"></i>
                                        </button>
                                        <button type="button" role="presentation" class="owl-next">
                                            <i class="fa fa-angle-right"></i>
                                        </button>
                                    </div>
                                    <div class="owl-dots disabled"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (item.TemplateKey == "39")
    {
        <div class="section-full mobile-page-padding p-t100 p-b70 sx-bg-light @item.CustomClass">
            <div class="container">
                <div class="large-title-block">
                    <div class="row">
                        <div class="col-lg-7 col-md-6">
                            <div class="large-title">
                                <div class="section-head">
                                    <div class="sx-separator-outer separator-left">
                                        <div data-title="04" class="sx-separator">
                                            <h2 data-period="2000" class="sep-line-one typewrite" data-type="[ '@item.Title']">
                                                <span class="wrap">@item.Title</span>
                                            </h2>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5 col-md-6">
                            <div class="large-title-info">
                                <p>
                                    @Html.Raw(item.Description)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="section-content">
                    <div class="client-grid m-b40">
                        <div class="row justify-content-center no-gutters">
                            @foreach (var list in item.PageSectionLists)
                            {

                                <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                                    @{
                                        string url = "";
                                        if (list.ButtonLink == "0")
                                        {
                                            url = "";

                                        }
                                        else if (list.ButtonLink == "Direct")
                                        {
                                            url = list.DirectUrl;

                                        }
                                        else if (list.ButtonLink == "00")
                                        {
                                            url = "/Contact";
                                        }
                                        else
                                        {
                                            url = Url.Page("/Source", new { id = list.ButtonLink, title = regex.Replace(list.Title, "-") });
                                        }
                                    }
                                    <a class="client-logo-pic" href="@url">
                                        <img alt="" src="@list.ImageUrl">
                                        <div>
                                            <span class="site-button-link">@list.ButtonText</span>
                                        </div>
                                    </a>
                                </div>
                            }

                        </div>
                    </div>
                    <div class="two-part-b-section d-flex justify-content-between">
                        @if (item.ButtonLink == "0")
                        {
                            <a href="#" class="site-button-secondry btn-half outline m-r15">
                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>
                        }
                        else if (item.ButtonLink == "Direct")
                        {
                            <a href="@item.DirectUrl" class="site-button-secondry btn-half outline m-r15">
                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>

                        }
                        else if (item.ButtonLink == "00")
                        {
                            <a asp-page="/Contact" class="site-button-secondry btn-half outline m-r15">
                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Source" asp-route-id="@item.ButtonLink" asp-route-title="@regex.Replace(item.Title, "-")" class="site-button-secondry btn-half outline m-r15">
                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>
                        }


                    </div>
                </div>
            </div>

        </div>

    }
    else if (item.TemplateKey == "40")
    {

        <section class="@item.CustomClass">
            <div class="container">
                <div class="prg-amt">


                    <h2 class="title">@item.Title</h2>
                    <p class="lead text-black">@item.Description</p>
                    <div class="">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="road-map-main">
                                    @foreach (var list in item.PageSectionLists)
                                    {
                                        <div class="road-map-wrapper">
                                            <div class="road-map-circle">
                                                <span class="road-map-circle-text d-flex align-items-center justify-content-center">@list.ButtonText</span>
                                            </div>
                                            <div class="road-map-card">
                                                <h4 class="card-head">@list.Title</h4>
                                                <p class="card-text">
                                                    @list.Description
                                                </p>
                                            </div>
                                        </div>
                                    }



                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <link href="~/customcss/progress.css" rel="stylesheet" />
            <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
        </section>


    }


}

@section Scripts {


}
