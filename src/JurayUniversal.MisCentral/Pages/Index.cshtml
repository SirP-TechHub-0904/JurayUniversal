@page
@model JurayUniversal.MisCentral.Pages.IndexModel
@{
    ViewData["Title"] = "Exwhyzee MIS Cloud Architecture";
    Layout = "_PublicLayout";
}

<!-- slider-area -->
<section class="slider__area fix">
    <div class="swiper-container slider__active" id="heroSlider" data-swiper-options='{
        "loop": true,
        "effect": "fade",
        "autoplay": { "delay": 5000 },
        "breakpoints": {
            "0": { "spaceBetween": 0, "slidesPerView": 1 },
            "375": { "spaceBetween": 0, "slidesPerView": 1 },
            "575": { "spaceBetween": 0, "slidesPerView": 1 },
            "768": { "spaceBetween": 0, "slidesPerView": 1 },
            "992": { "spaceBetween": 0, "slidesPerView": 1 },
            "1400": { "spaceBetween": 0, "slidesPerView": 1 }
        },
        "pagination": {
            "el": ".slider-pagination",
            "clickable": true
        }}'>
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <div class="slider__bg">
                    <div class="slider__bg-img" data-background="/xyz-mis/assets/img/slider/slider_bg01.jpg"></div>
                    <div class="container">
                        <div class="row">
                            <div class="col-xl-6 col-lg-7">
                                <div class="slider__content">
                                    <span class="sub-title">Smart Cloud System</span>
                                    <h2 class="title">Simple Management Software For Your Organization</h2>
                                    <p>Easily manage schools, businesses, hospitals, staff records, payroll, and finances in one secure and easy-to-use platform.</p>
                                    <div class="slider__btn">
                                        <a asp-page="/Features" class="tg-btn">See All Features
                                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </a>
                                        <a asp-page="/Contact" class="tg-btn white-btn">Request a Demo
                                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="slider__shape">
                        <img src="~/xyz-mis/assets/img/slider/slider_shape.svg" alt="shape">
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="slider__bg">
                    <div class="slider__bg-img" data-background="/xyz-mis/assets/img/slider/slider_bg02.jpg"></div>
                    <div class="container">
                        <div class="row">
                            <div class="col-xl-6 col-lg-7">
                                <div class="slider__content">
                                    <span class="sub-title">Safe &amp; Private</span>
                                    <h2 class="title">100% Private, Secure &amp; Lightning Fast</h2>
                                    <p>Every organization gets its own completely private, dedicated workspace. Your records and confidential files are protected and never mixed with anyone else.</p>
                                    <div class="slider__btn">
                                        <a asp-page="/About" class="tg-btn">Learn More
                                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </a>
                                        <a asp-page="/Pricing" class="tg-btn white-btn">View Pricing
                                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="slider__shape">
                        <img src="~/xyz-mis/assets/img/slider/slider_shape.svg" alt="shape">
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="slider__bg">
                    <div class="slider__bg-img" data-background="/xyz-mis/assets/img/slider/slider_bg03.jpg"></div>
                    <div class="container">
                        <div class="row">
                            <div class="col-xl-6 col-lg-7">
                                <div class="slider__content">
                                    <span class="sub-title">16 Ready-to-Use Features</span>
                                    <h2 class="title">From School Portals to Staff Payroll &amp; Exams</h2>
                                    <p>Get everything you need: Student Records, Payroll, Accounts &amp; Billing, Online Exams, Digital Voting, and SMS Alerts.</p>
                                    <div class="slider__btn">
                                        <a asp-page="/Contact" class="tg-btn">Request a Demo
                                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </a>
                                        <a href="/Administrator/Account/Login" class="tg-btn white-btn">Admin Portal
                                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="slider__shape">
                        <img src="~/xyz-mis/assets/img/slider/slider_shape.svg" alt="shape">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="slider-pagination"></div>
</section>
<!-- slider-area-end -->

<!-- brand-area -->
<div class="brand__area fix">
    <div class="brand__active swiper-container fix" id="brandSlider" data-swiper-options='{
        "loop": true,
        "autoplay": { "delay": 2000 },
        "breakpoints": {
            "0": { "spaceBetween": 10, "slidesPerView": 2 },
            "375": { "spaceBetween": 20, "slidesPerView": 2 },
            "575": { "spaceBetween": 20, "slidesPerView": 3 },
            "768": { "spaceBetween": 10, "slidesPerView": 4 },
            "992": { "spaceBetween": 20, "slidesPerView": 6 },
            "1200": { "spaceBetween": 20, "slidesPerView": 7 },
            "1400": { "spaceBetween": 20, "slidesPerView": 9 }
        }}'>
        <div class="swiper-wrapper">
            <div class="swiper-slide"><div class="brand__item"><img src="~/xyz-mis/assets/img/brand/brand_01.png" alt="Federal Ministry of Health Nigeria"></div></div>
            <div class="swiper-slide"><div class="brand__item"><img src="~/xyz-mis/assets/img/brand/brand_02.png" alt="Federal Ministry of Budget and Economic Planning"></div></div>
            <div class="swiper-slide"><div class="brand__item"><img src="~/xyz-mis/assets/img/brand/brand_03.png" alt="NIPSS Kuru"></div></div>
            <div class="swiper-slide"><div class="brand__item"><img src="~/xyz-mis/assets/img/brand/brand_04.png" alt="Urualla.ng Community Portal"></div></div>
            <div class="swiper-slide"><div class="brand__item"><img src="~/xyz-mis/assets/img/brand/brand_05.png" alt="Ekefin Financial Services"></div></div>
            <div class="swiper-slide"><div class="brand__item"><img src="~/xyz-mis/assets/img/brand/brand_06.png" alt="Juray Smart Technologies"></div></div>
            <div class="swiper-slide"><div class="brand__item"><img src="~/xyz-mis/assets/img/brand/brand_07.png" alt="Exwhyzee Technologies"></div></div>
        </div>
    </div>
</div>
<!-- brand-area-end -->

<!-- about-area -->
<section class="about__area section-pt-120 section-pb-100 fix">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Column: Single Image -->
            <div class="col-lg-5 col-md-10 mx-auto">
                <div class="about__img" data-sal="slide-right" data-sal-duration="700" data-sal-delay="100">
                    <img src="~/xyz-mis/assets/img/images/about_img.jpg" alt="Exwhyzee MIS Cloud Workspace" class="main-img rounded-4 shadow-sm" style="width: 100%; object-fit: cover; max-height: 480px;">
                    <div class="experience__wrap">
                        <h2 class="count">16 <span>+</span></h2>
                        <span class="text">Powerful <br> System Features</span>
                    </div>
                    <img src="~/xyz-mis/assets/img/images/about_shape.svg" alt="shape" class="shape rotateme">
                </div>
            </div>

            <!-- Right Column: Clean Content -->
            <div class="col-lg-7">
                <div class="about__content ps-lg-4" data-sal="slide-left" data-sal-duration="700" data-sal-delay="100">
                    <div class="section__title mb-20">
                        <span class="sub-title text-primary fw-bold text-uppercase">Built For Growth</span>
                        <h2 class="title fw-bold">Manage Your Entire Organization With Total Peace of Mind</h2>
                    </div>
                    <p class="text-muted fs-6 leading-relaxed mb-4">
                        Exwhyzee MIS gives every school, hospital, and business their own private, secure system. Your student, financial, and staff records are completely private, always protected, and easy to access anytime, on any device.
                    </p>
                    
                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-light-subtle border">
                            <div class="w-12 h-12 rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fs-4 flex-shrink-0" style="width: 48px; height: 48px;">
                                <i class="flaticon-technical-support"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark fs-6 mb-1">100% Private Workspace</h5>
                                <p class="text-muted text-xs mb-0">Your records, accounts, and student files are completely private and exclusively accessible only to your authorized staff.</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-light-subtle border">
                            <div class="w-12 h-12 rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fs-4 flex-shrink-0" style="width: 48px; height: 48px;">
                                <i class="flaticon-settings"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark fs-6 mb-1">Pick What You Need</h5>
                                <p class="text-muted text-xs mb-0">Easily enable the features you want: School Portal, Payroll, Accounts, Online Exams, or E-Voting.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <a asp-page="/Contact" class="tg-btn">
                            Get Started Today
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                        <a asp-page="/Features" class="tg-btn white-btn">
                            Explore All Features
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- about-area-end -->

<!-- counter-area -->
<section class="counter__area section-pb-140 fix">
    <div class="container">
        <div class="counter__item-wrap">
            <div class="row gutter-y-40">
                <div class="col-lg-4 col-md-4 col-6">
                    <div class="counter__item">
                        <h2 class="count"><span class="counter-number">100</span>%</h2>
                        <p>Private &amp; Secure Data</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-6">
                    <div class="counter__item">
                        <h2 class="count"><span class="counter-number">99</span>.99%</h2>
                        <p>Reliable Uptime</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-6">
                    <div class="counter__item">
                        <h2 class="count"><span class="counter-number">16</span></h2>
                        <p>All-in-One Features</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- counter-area-end -->

<!-- services-area -->
<section class="services__area section-bg section-py-140 fix">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7">
                <div class="section__title text-center mb-45" data-sal="slide-up" data-sal-duration="700" data-sal-delay="100">
                    <span class="sub-title">What You Can Do</span>
                    <h2 class="title">16 Ready-to-Use Features For All Your Operations</h2>
                </div>
            </div>
        </div>
        <div class="row gutter-y-30">
            <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="700" data-sal-delay="100">
                <div class="services__item">
                    <div class="services__icon-wrap">
                        <div class="services__icon">
                            <i class="flaticon-it-service"></i>
                        </div>
                    </div>
                    <div class="services__content">
                        <h2 class="title"><a asp-page="/Features">School &amp; Student Portal</a></h2>
                        <p>Admissions, student records, class attendance, timetables, report cards, and parent access.</p>
                        <a asp-page="/Features" class="tg-text-btn">See Details
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="700" data-sal-delay="200">
                <div class="services__item">
                    <div class="services__icon-wrap">
                        <div class="services__icon">
                            <i class="flaticon-data-access"></i>
                        </div>
                    </div>
                    <div class="services__content">
                        <h2 class="title"><a asp-page="/Features">Accounting &amp; Invoicing</a></h2>
                        <p>Track school fees, generate invoices, accept online card payments, and monitor expenses.</p>
                        <a asp-page="/Features" class="tg-text-btn">See Details
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="700" data-sal-delay="300">
                <div class="services__item">
                    <div class="services__icon-wrap">
                        <div class="services__icon">
                            <i class="flaticon-coding"></i>
                        </div>
                    </div>
                    <div class="services__content">
                        <h2 class="title"><a asp-page="/Features">Staff &amp; Payroll</a></h2>
                        <p>Automate monthly staff salary calculations, tax deductions, allowances, and payslips.</p>
                        <a asp-page="/Features" class="tg-text-btn">See Details
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="700" data-sal-delay="100">
                <div class="services__item">
                    <div class="services__icon-wrap">
                        <div class="services__icon">
                            <i class="flaticon-technical-support"></i>
                        </div>
                    </div>
                    <div class="services__content">
                        <h2 class="title"><a asp-page="/Features">Digital Voting &amp; Elections</a></h2>
                        <p>Simple and transparent electronic voting for alumni, associations, and student unions.</p>
                        <a asp-page="/Features" class="tg-text-btn">See Details
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="700" data-sal-delay="200">
                <div class="services__item">
                    <div class="services__icon-wrap">
                        <div class="services__icon">
                            <i class="flaticon-inspiration"></i>
                        </div>
                    </div>
                    <div class="services__content">
                        <h2 class="title"><a asp-page="/Features">Online CBT Exams</a></h2>
                        <p>Computer-based testing with question banks, automatic scoring, and instant result publishing.</p>
                        <a asp-page="/Features" class="tg-text-btn">See Details
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="700" data-sal-delay="300">
                <div class="services__item">
                    <div class="services__icon-wrap">
                        <div class="services__icon">
                            <i class="flaticon-technology"></i>
                        </div>
                    </div>
                    <div class="services__content">
                        <h2 class="title"><a asp-page="/Features">SMS &amp; Email Alerts</a></h2>
                        <p>Instantly send notifications, receipts, exam results, and bulk announcements to parents &amp; staff.</p>
                        <a asp-page="/Features" class="tg-text-btn">See Details
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M1 11L11 1M11 1H1M11 1V11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row justify-content-center mt-50">
            <div class="col-12 text-center" data-sal="slide-up" data-sal-duration="700" data-sal-delay="300">
                <a asp-page="/Features" class="tg-btn" style="padding: 16px 38px; font-size: 1rem; border-radius: 50px;">
                    Explore All 16 Features
                    <svg width="12" height="12" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" class="ms-2">
                        <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
