@page
@model JurayUniversal.Website.Areas.MisNewsletter.Pages.Platform.Campaigns.IndexModel
@{
    ViewData["Title"] = "Email Campaigns";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
    ViewData["ActiveMenu"] = "MisNewsletter";
    ViewData["ActiveSubMenu"] = "Campaigns";
}

@section HeaderActions {
    <a asp-page="./Create" class="btn btn-primary rounded-pill fw-bold">
                <i class="bi bi-plus-circle me-1"></i> New Campaign
            </a>
}

<div class="page-heading">
    
</div>

<div class="page-content">
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger border-0 d-flex align-items-center mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>@TempData["error"]</div>
        </div>
    }
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success border-0 d-flex align-items-center mb-4">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div>@TempData["success"]</div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Subject</th>
                            <th>Status</th>
                            <th>Recipients</th>
                            <th>Scheduled For</th>
                            <th>Created On</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var campaign in Model.Campaigns)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    @campaign.Subject
                                </td>
                                <td>
                                    @switch (campaign.Status)
                                    {
                                        case JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Draft:
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">Draft</span>
                                            break;
                                        case JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Scheduled:
                                            <span class="badge bg-info bg-opacity-10 text-info">Scheduled</span>
                                            break;
                                        case JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Pending:
                                            <span class="badge bg-warning bg-opacity-10 text-warning">Pending</span>
                                            break;
                                        case JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Sending:
                                            <span class="badge bg-primary bg-opacity-10 text-primary">Sending...</span>
                                            break;
                                        case JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Completed:
                                            <span class="badge bg-success bg-opacity-10 text-success">Completed</span>
                                            break;
                                        case JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Failed:
                                            <span class="badge bg-danger bg-opacity-10 text-danger">Failed</span>
                                            break;
                                    }
                                </td>
                                <td>@campaign.TotalRecipients</td>
                                <td>
                                    @(campaign.ScheduledDate.HasValue ? campaign.ScheduledDate.Value.ToString("MMM dd, yyyy HH:mm") : "N/A")
                                </td>
                                <td>@campaign.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end pe-4">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-light rounded-pill" type="button" data-bs-toggle="dropdown">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            @if (campaign.Status == JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Draft || campaign.Status == JurayUniversal.Domain.Enum.Enum.MisNewsletterCampaignStatus.Scheduled)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-page="./Create" asp-route-id="@campaign.Id">
                                                        <i class="bi bi-pencil me-2 text-primary"></i> Edit Campaign
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                            }
                                            <li>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@campaign.Id" onsubmit="return confirm('Are you sure you want to delete this campaign?');">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i> Delete
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                        
                        @if (!Model.Campaigns.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-megaphone fs-1 d-block mb-3"></i>
                                    <h5>No Campaigns Found</h5>
                                    <p>Create your first email newsletter campaign to get started.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

