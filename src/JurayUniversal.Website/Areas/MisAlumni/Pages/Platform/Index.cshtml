@page
@model JurayUniversal.Website.Areas.MisAlumni.Pages.Platform.IndexModel
@{
    ViewData["Title"] = Model.AlumniAlias + " Network";
    ViewData["ActiveMenu"] = "MisAlumni";
}

<div class="mis-page-header">
    <h3 class="mis-page-title">The @Model.AlumniAlias Network</h3>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-info btn-sm rounded-pill" type="button" data-bs-toggle="offcanvas" data-bs-target="#misHelpOffcanvas">
            <i class="bi bi-question-circle me-1"></i> Help & Guide
        </button>
        @if (Model.IsAlumni)
        {
            <a asp-page="./MyProfile" class="btn btn-primary btn-sm rounded-pill"><i class="bi bi-person-badge me-1"></i> My Profile</a>
        }
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <!-- Welcome Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white overflow-hidden">
        <div class="row g-0">
            <div class="col-md-8 p-5">
                <h2 class="fw-bold mb-3">Welcome to the @Model.AlumniAlias Network</h2>
                <p class="lead mb-4 opacity-75">Reconnect with past colleagues, find mentorship, and explore exclusive career opportunities shared by our global network.</p>
                <div class="d-flex gap-3">
                    <a asp-page="./Directory" class="btn btn-light rounded-pill px-4 fw-bold text-primary">Browse Directory</a>
                    <a asp-page="./Opportunities" class="btn btn-outline-light rounded-pill px-4 fw-bold">View Opportunities</a>
                </div>
            </div>
            <div class="col-md-4 d-none d-md-flex align-items-center justify-content-center bg-white bg-opacity-10">
                <i class="bi bi-globe2 text-white opacity-50" style="font-size: 8rem;"></i>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Mentors Column -->
        <div class="col-lg-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0">Featured Mentors</h5>
                <a asp-page="./Directory" asp-route-mentorOnly="true" class="text-decoration-none fs-8 fw-bold">View All</a>
            </div>
            
            <div class="row g-3">
                @foreach (var mentor in Model.FeaturedMentors)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4 text-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                                    <span class="fw-bold fs-4">@mentor.UserProfile?.FirstName?.Substring(0, 1)</span>
                                </div>
                                <h6 class="fw-bold mb-1">@mentor.UserProfile?.FirstName @mentor.UserProfile?.LastName</h6>
                                <p class="text-muted fs-8 mb-2">@mentor.CurrentProfession at @mentor.Company</p>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 mb-3"><i class="bi bi-check-circle me-1"></i> Available</span>
                                
                                @if (!string.IsNullOrEmpty(mentor.LinkedInUrl))
                                {
                                    <div>
                                        <a href="@mentor.LinkedInUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill w-100"><i class="bi bi-linkedin me-1"></i> Connect</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                @if (!Model.FeaturedMentors.Any())
                {
                    <div class="col-12 text-center py-4">
                        <i class="bi bi-person-x text-muted fs-3 mb-2 d-block"></i>
                        <p class="text-muted fs-8 mb-0">No mentors available yet.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Opportunities Column -->
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0">Recent Opportunities</h5>
                <a asp-page="./Opportunities" class="text-decoration-none fs-8 fw-bold">View Board</a>
            </div>

            <div class="row g-3">
                @foreach (var post in Model.RecentPosts)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-bold mb-0">@post.Title</h6>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@post.PostType</span>
                                </div>
                                <p class="text-muted fs-8 mb-3">Posted by @post.UserProfile?.FirstName @post.UserProfile?.LastName on @post.CreatedAt.ToString("MMM dd, yyyy")</p>
                                <p class="mb-0 text-dark">
                                    @(post.Content.Length > 150 ? post.Content.Substring(0, 150) + "..." : post.Content)
                                </p>
                            </div>
                        </div>
                    </div>
                }
                @if (!Model.RecentPosts.Any())
                {
                    <div class="col-12 text-center py-5 card border-0 shadow-sm rounded-4">
                        <i class="bi bi-chat-square-text text-muted fs-1 mb-3 d-block"></i>
                        <h6 class="fw-bold text-muted">No opportunities posted yet.</h6>
                    </div>
                }
            </div>
        </div>
    </div>
</div>