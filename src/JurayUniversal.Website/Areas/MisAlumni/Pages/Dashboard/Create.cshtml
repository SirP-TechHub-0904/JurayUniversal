@page
@model JurayUniversal.Website.Areas.MisAlumni.Pages.Dashboard.CreateModel
@{
    ViewData["Title"] = "Add New " + Model.AlumniAlias;
    ViewData["ActiveMenu"] = "MisAlumni";
    ViewData["ActiveSubMenu"] = "Dashboard";
    Layout = "/Pages/Shared/Layouts/MIS/_MisAdminLayout.cshtml";
}

<div class="page-heading">
    <div class="row align-items-center">
        <div class="col-md-6 col-12">
            <h3>Add New @Model.AlumniAlias</h3>
            <p class="text-subtitle text-muted">Flag an existing user as an Alumni to grant them access to the network.</p>
        </div>
        <div class="col-md-6 col-12 text-md-end">
            <button class="btn btn-outline-info btn-sm rounded-pill me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#misHelpOffcanvas">
                <i class="bi bi-question-circle me-1"></i> Help & Guide
            </button>
            <a asp-page="./List" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<section class="section">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row g-4">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="MisAlumniProfile.UserProfileId" class="form-label fw-bold">Select User Account</label>
                            <select asp-for="MisAlumniProfile.UserProfileId" class="form-select select2" asp-items="ViewBag.UserProfileId" required>
                                <option value="">-- Choose User --</option>
                            </select>
                            <span asp-validation-for="MisAlumniProfile.UserProfileId" class="text-danger"></span>
                            <div class="form-text">The user must already have a platform account.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MisAlumniProfile.ExitYear" class="form-label fw-bold">Exit / Graduation Year</label>
                            <input asp-for="MisAlumniProfile.ExitYear" class="form-control" type="number" min="1900" max="2100" required />
                            <span asp-validation-for="MisAlumniProfile.ExitYear" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MisAlumniProfile.CurrentProfession" class="form-label fw-bold">Current Profession</label>
                            <input asp-for="MisAlumniProfile.CurrentProfession" class="form-control" />
                            <span asp-validation-for="MisAlumniProfile.CurrentProfession" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MisAlumniProfile.Company" class="form-label fw-bold">Current Company</label>
                            <input asp-for="MisAlumniProfile.Company" class="form-control" />
                            <span asp-validation-for="MisAlumniProfile.Company" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MisAlumniProfile.LinkedInUrl" class="form-label fw-bold">LinkedIn URL</label>
                            <input asp-for="MisAlumniProfile.LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/..." />
                            <span asp-validation-for="MisAlumniProfile.LinkedInUrl" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="MisAlumniProfile.IsAvailableForMentorship" class="form-check-input" type="checkbox" role="switch" id="mentorSwitch">
                            <label asp-for="MisAlumniProfile.IsAvailableForMentorship" class="form-check-label ms-2" for="mentorSwitch">
                                User is open to mentoring other staff/alumni
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save @Model.AlumniAlias</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
