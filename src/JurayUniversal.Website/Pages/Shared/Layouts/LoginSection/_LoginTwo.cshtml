<!DOCTYPE html>
<html lang="en">
<head>
    @await Component.InvokeAsync("WebTitle")
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Core Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    @await Component.InvokeAsync("LoginCSS")

    <style>
        /* THEME 2: SLEEK CYBER SLATE (DARK MODE) */
        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        body, html {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-color: #0b0f19;
            color: #e2e8f0;
        }
        .login-dark-wrapper {
            min-height: 100vh;
            background: #0b0f19;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 15px;
            overflow: hidden;
        }
        .login-dark-wrapper::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(0, 105, 161, 0.15) 0%, rgba(0, 0, 0, 0) 70%);
            top: -100px;
            right: -100px;
            pointer-events: none;
        }
        .login-dark-wrapper::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, rgba(0, 0, 0, 0) 70%);
            bottom: -100px;
            left: -100px;
            pointer-events: none;
        }
        .login-dark-card {
            background: #111827;
            border: 1px solid #1f2937;
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05);
            padding: 45px 40px;
            max-width: 460px;
            width: 100%;
            position: relative;
            z-index: 10;
        }
        @@media (max-width: 576px) {
            .login-dark-card {
                padding: 30px 20px;
            }
        }
        .login-dark-card .form-control {
            background: #1f2937;
            border: 1px solid #374151;
            color: #f8fafc !important;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 0.95rem;
        }
        .login-dark-card .form-control::placeholder {
            color: #6b7280;
        }
        .login-dark-card .form-control:focus {
            background: #1f2937;
            border-color: #0069A1;
            box-shadow: 0 0 0 3px rgba(0, 105, 161, 0.35);
        }
        .login-dark-card label {
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 6px;
        }
        .login-dark-card .btn-primary {
            background: #0069A1;
            border: 1px solid #0077b6;
            border-radius: 10px;
            padding: 12px 24px;
            font-weight: 600;
            color: #ffffff;
            transition: all 0.2s ease;
        }
        .login-dark-card .btn-primary:hover {
            background: #0077b6;
            box-shadow: 0 0 20px rgba(0, 105, 161, 0.5);
            transform: translateY(-1px);
        }
        .login-dark-card a {
            color: #38bdf8;
            text-decoration: none;
        }
        .login-dark-card a:hover {
            color: #7dd3fc;
            text-decoration: underline;
        }
        .url-chip-dark {
            background: #0b0f19;
            border: 1px solid #1f2937;
            border-radius: 8px;
            padding: 6px 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: #10b981;
        }
        .logo-box-dark {
            display: inline-flex;
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="login-dark-wrapper">
        <div class="login-dark-card">
            <div class="text-center mb-4">
                <div class="logo-box-dark">
                    @if (Model.SuperSetting.UseNormalLogoInLogin == true)
                    {
                        <img src="@Model.SuperSetting.CompanyLogoUrl" alt="Logo" style="max-height: 50px;" />
                    }
                    else
                    {
                        <img src="@Model.SuperSetting.CompanyWhiteLogoUrl" alt="Logo" style="max-height: 50px;" />
                    }
                </div>
                <h4 class="fw-bold text-white mb-1">
                    @await Component.InvokeAsync("CompanyName")
                </h4>
                <p class="text-muted small mb-3">
                    @await Component.InvokeAsync("LoginNote")
                </p>
                <div class="url-chip-dark">
                    <i class="bi bi-shield-check"></i>
                    <span>https://@await Component.InvokeAsync("CompanyUrl")</span>
                </div>
            </div>

            @RenderBody()

            <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                <p class="text-muted small mb-0">
                    @await Component.InvokeAsync("LoginNoteFooter")
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function myFunction() {
            var x = document.getElementById("myInput");
            if (x) {
                x.type = x.type === "password" ? "text" : "password";
            }
        }
    </script>
</body>
</html>