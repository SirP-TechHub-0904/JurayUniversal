@page
@model JurayUniversal.Website.Areas.MisRecruitment.Pages.Dashboard.Jobs.IndexModel
@{
    ViewData["Title"] = "Job Postings";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

@section HeaderActions {
    <a asp-page="./Manage" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> Post New Job
            </a>
}

<div class="container-fluid max-w-1200 mx-auto">

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            @if (Model.MisJobPostings.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-briefcase text-muted display-4 d-block mb-3 opacity-50"></i>
                    <h5 class="fw-bold">No Job Postings Yet</h5>
                    <p class="text-muted mb-4">Create your first job posting to start recruiting.</p>
                    <a asp-page="./Manage" class="btn btn-outline-primary rounded-pill">Create Posting</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Applicants</th>
                                <th>Closing Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MisJobPostings)
                            {
                                <tr>
                                    <td class="fw-600">@item.Title</td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.JobType</span>
                                    </td>
                                    <td>
                                        @if (item.Status == JurayUniversal.Domain.Enum.Enum.JobStatus.Published)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">Published</span>
                                        }
                                        else if (item.Status == JurayUniversal.Domain.Enum.Enum.JobStatus.Closed)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2">Closed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2">Draft</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-page="../Applicants/Index" asp-route-jobId="@item.Id" class="badge bg-primary rounded-pill text-decoration-none">
                                            @item.Applicants.Count Applicants
                                        </a>
                                    </td>
                                    <td class="small">@(item.ClosingDate?.ToString("MMM dd, yyyy") ?? "Open")</td>
                                    <td class="text-end">
                                        <a asp-page="./Manage" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
