@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context
@inject JurayUniversal.Website.Services.IMisAuthorizationService MisAuth
@{
    var misSetting = _context.MisSettings.FirstOrDefault();
    string categoryAlias = misSetting?.CategoryAlias ?? "Category";
    string alumniAlias = misSetting?.AlumniAlias ?? "Alumni";

    string activeMenu = ViewData["ActiveMenu"] as string ?? "";
    string activeSubMenu = ViewData["ActiveSubMenu"] as string ?? "";

    string GetActiveMenu(string menu) => activeMenu == menu ? "active" : "";
    string GetActiveSubMenu(string subMenu) => activeSubMenu == subMenu ? "active" : "";
    string GetSubMenuIcon(string subMenu) => activeSubMenu == subMenu ? "<i class=\"fa fa-play text-primary\" style=\"font-size: 10px; margin-right: 8px;\"></i>" : "";

    var activeFeatures = _context.MisFeatures.Where(x => x.Status != JurayUniversal.Domain.Enum.Enum.FeatureBillingStatus.Disabled).Select(x => x.ModuleFolder).ToList();

    async Task<bool> ShouldShow(string featureKey)
    {
        if (activeFeatures.Contains(featureKey))
        {
            return await MisAuth.HasAccessAsync(User, featureKey);
        }
        return false;
    }

    bool showUserMgmt = await ShouldShow("MisUserManagement");
    bool showCommittees = await ShouldShow("MisGroups");
    bool showAlumni = await ShouldShow("MisAlumni");
    bool showReports = await ShouldShow("MisReports");
    bool showForms = await ShouldShow("MisForms");
    bool showSurveys = await ShouldShow("MisSurveys");
    bool showManual = await ShouldShow("MisManual");
    bool showDues = await ShouldShow("MisDues");
    bool showTicketing = await ShouldShow("MisTicketing");
    bool showDonations = await ShouldShow("MisDonations");
    bool showGrants = await ShouldShow("MisGrants");
    bool showRecruitment = await ShouldShow("MisRecruitment");
    bool showVoting = await ShouldShow("MisVoting");
    bool showAssets = await ShouldShow("MisAssets");
    bool showProjects = await ShouldShow("MisProjects");
    bool showChat = await ShouldShow("MisChat");
    bool showMassComm = await ShouldShow("MisMassComm");
    bool showAI = await ShouldShow("MisAI");
    bool showHelpdesk = await ShouldShow("MisHelpdesk");
    bool showWhistleblowing = await ShouldShow("MisWhistleblowing");
    bool showDMS = await ShouldShow("MisDMS");
    bool showLMS = await ShouldShow("MisLMS");
    bool showVisitor = await ShouldShow("MisVisitorManagement");
}
<!-- CORE & ADMINISTRATION CATEGORY -->
<div class="menu-header">Core & Administration</div>

<div class="menu-item @(string.IsNullOrEmpty(activeMenu) || activeMenu == "ConsoleHome" ? "active" : "")">
    <a href="/MIS/Dashboard/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-laptop text-primary"></i></span>
        <span class="menu-text">Console Home</span>
    </a>
</div>

<div class="menu-item @GetActiveMenu("MisSettings")">
    <a href="/MisSetting/Dashboard/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-cogs text-primary"></i></span>
        <span class="menu-text">MIS Settings</span>
    </a>
</div>

@if (User.IsInRole("mSuperAdmin"))
{
    <div class="menu-item @GetActiveMenu("MisManagement")">
        <a href="/MisManagement/Index" class="menu-link">
            <span class="menu-icon"><i class="fa fa-layer-group text-primary"></i></span>
            <span class="menu-text">Features & Billing Mgmt</span>
        </a>
    </div>
}

@if (showUserMgmt)
{
<div class="menu-item has-sub @GetActiveMenu("UserManagement")">
    <a href="javascript:;" class="menu-link">
        <span class="menu-icon"><i class="fa fa-users text-primary"></i></span>
        <span class="menu-text">User Directory & KPIs</span>
        <span class="menu-caret"><b class="caret"></b></span>
    </a>
    <div class="menu-submenu">
        <div class="menu-item @GetActiveSubMenu("Dashboard")">
            <a href="/MisUserManagement/Dashboard/Index" class="menu-link">
                @Html.Raw(GetSubMenuIcon("Dashboard"))
                <span class="menu-text">User Management Hub</span>
            </a>
        </div>
        <div class="menu-item @GetActiveSubMenu("Categories")">
            <a href="/MisUserManagement/Dashboard/Categories/Index" class="menu-link">
                @Html.Raw(GetSubMenuIcon("Categories"))
                <span class="menu-text">Manage @(categoryAlias)s</span>
            </a>
        </div>
        <div class="menu-item @GetActiveSubMenu("KpiSettings")">
            <a href="/MisUserManagement/Dashboard/KpiSettings" class="menu-link">
                @Html.Raw(GetSubMenuIcon("KpiSettings"))
                <span class="menu-text">KPI Setup & Parameters</span>
            </a>
        </div>
        <div class="menu-item @GetActiveSubMenu("KpiResults")">
            <a href="/MisUserManagement/Dashboard/KpiResults" class="menu-link">
                @Html.Raw(GetSubMenuIcon("KpiResults"))
                <span class="menu-text">KPI Ranks & Best Staff</span>
            </a>
        </div>
    </div>
</div>
}

