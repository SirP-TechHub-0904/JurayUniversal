<!DOCTYPE html>
<html lang="en">
<head>
    @await Component.InvokeAsync("WebTitle")
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Core Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    @await Component.InvokeAsync("LoginCSS")

    <style>
        /* THEME 1: RADIAL GLASSMORPHISM */
        * {
            box-sizing: border-box;
            font-family: 'Outfit', sans-serif;
        }
        body, html {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-color: hsl(218, 41%, 15%);
        }
        .login-radial-wrapper {
            min-height: 100vh;
            background-color: hsl(218, 41%, 15%);
            background-image: radial-gradient(650px circle at 0% 0%,
                hsl(218, 41%, 35%) 15%,
                hsl(218, 41%, 30%) 35%,
                hsl(218, 41%, 20%) 75%,
                hsl(218, 41%, 19%) 80%,
                transparent 100%),
            radial-gradient(1250px circle at 100% 100%,
                hsl(218, 41%, 45%) 15%,
                hsl(218, 41%, 30%) 35%,
                hsl(218, 41%, 20%) 75%,
                hsl(218, 41%, 19%) 80%,
                transparent 100%);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 15px;
        }
        .login-glass-card {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            padding: 45px 40px;
            color: #ffffff;
        }
        @@media (max-width: 576px) {
            .login-glass-card {
                padding: 30px 20px;
            }
        }
        .login-glass-card .form-control {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #ffffff !important;
            border-radius: 12px;
            padding: 12px 16px;
        }
        .login-glass-card .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }
        .login-glass-card .form-control:focus {
            background: rgba(255, 255, 255, 0.25);
            border-color: #38bdf8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.2);
        }
        .login-glass-card label {
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 6px;
        }
        .login-glass-card .btn-primary {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            letter-spacing: 0.3px;
            box-shadow: 0 10px 20px -5px rgba(2, 132, 199, 0.4);
            transition: all 0.2s ease;
        }
        .login-glass-card .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -5px rgba(2, 132, 199, 0.6);
        }
        .login-glass-card a {
            color: #7dd3fc;
            text-decoration: none;
        }
        .login-glass-card a:hover {
            color: #ffffff;
            text-decoration: underline;
        }
        .url-chip-glass {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 999px;
            padding: 5px 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #e2e8f0;
        }
    </style>
</head>
<body>

    <div class="login-radial-wrapper">
        <div class="container" style="max-width: 1100px;">
            <div class="row align-items-center g-5">
                <!-- Left Brand Showcase -->
                <div class="col-lg-6 text-white text-center text-lg-start">
                    <div class="mb-4">
                        @if (Model.SuperSetting.UseNormalLogoInLogin == true)
                        {
                            <img src="@Model.SuperSetting.CompanyLogoUrl" alt="Logo" class="img-fluid" style="max-height: 70px;" />
                        }
                        else
                        {
                            <img src="@Model.SuperSetting.CompanyWhiteLogoUrl" alt="Logo" class="img-fluid" style="max-height: 70px;" />
                        }
                    </div>
                    <h1 class="display-5 fw-bold text-white mb-3" style="letter-spacing: -0.5px;">
                        @Html.Raw(Model.SuperSetting.LoginNoteTitle ?? Model.SuperSetting.CompanyName)
                    </h1>
                    <p class="lead opacity-80 mb-4" style="line-height: 1.6; font-size: 1.1rem;">
                        @Html.Raw(Model.SuperSetting.LoginNote ?? "Secure access to platform resources, records, and member services.")
                    </p>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white bg-opacity-10 border border-white-50">
                        <i class="bi bi-shield-lock text-info"></i>
                        <span class="small">End-to-End SSL Encrypted</span>
                    </div>
                </div>

                <!-- Right Glass Form -->
                <div class="col-lg-6">
                    <div class="login-glass-card">
                        <div class="text-center mb-4">
                            <div class="url-chip-glass mb-2">
                                <i class="bi bi-lock-fill text-success"></i>
                                <span>https://@await Component.InvokeAsync("CompanyUrl")</span>
                            </div>
                        </div>

                        @RenderBody()

                        <div class="text-center mt-4 pt-3 border-top border-white-50">
                            <p class="small opacity-70 mb-0">
                                @await Component.InvokeAsync("LoginNoteFooter")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function myFunction() {
            var x = document.getElementById("myInput");
            if (x) {
                x.type = x.type === "password" ? "text" : "password";
            }
        }
    </script>
</body>
</html>