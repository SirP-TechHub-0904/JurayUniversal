    <div class="choose__img" data-background="/xyz-mis/assets/img/slider/slider_bg03.jpg"></div>
    <div class="choose__shape">
        <img src="~/xyz-mis/assets/img/images/choose_shape.png" alt="shape">
    </div>
</section>
<!-- choose-area-end -->

<!-- counter-area-two -->
<section class="counter__area-two">
    <div class="container">
        <div class="row gutter-y-30 justify-content-center">
