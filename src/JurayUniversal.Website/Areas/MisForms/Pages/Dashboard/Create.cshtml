@page
@model JurayUniversal.Website.Areas.MisForms.Pages.Dashboard.CreateModel
@{
    ViewData["Title"] = "Create New Form";
    ViewData["Subtitle"] = "Fill out the form below to add a new record.";
    ViewData["ShowBackButton"] = false;
}

@section HeaderActions {
    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Forms</a>
}

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Title" class="form-label fw-bold"></label>
                            <input asp-for="Input.Title" class="form-control form-control-lg bg-light" placeholder="e.g. End of Year Staff Survey" />
                            <span asp-validation-for="Input.Title" class="text-danger fs-8"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Input.Description" class="form-control bg-light" rows="3" placeholder="Briefly describe the purpose of this form..."></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger fs-8"></span>
                        </div>

                        <div class="mb-5 bg-light p-4 rounded-3 border">
                            <h5 class="fw-bold mb-3">Survey & Form Settings</h5>

                            <div class="form-check form-switch d-flex align-items-center gap-3 mb-3">
                                <input asp-for="Input.RequireLogin" class="form-check-input" type="checkbox" role="switch" style="width: 3rem; height: 1.5rem;" />
                                <div>
                                    <label asp-for="Input.RequireLogin" class="form-check-label fw-bold d-block">Require User Login</label>
                                    <small class="text-muted">If checked, only logged-in users can fill out this form. If unchecked, it will be fully public.</small>
                                </div>
                            </div>

                            <div class="form-check form-switch d-flex align-items-center gap-3 mb-3">
                                <input asp-for="Input.AllowMultipleSubmissions" class="form-check-input" type="checkbox" role="switch" style="width: 3rem; height: 1.5rem;" />
                                <div>
                                    <label asp-for="Input.AllowMultipleSubmissions" class="form-check-label fw-bold d-block">Allow Multiple Submissions</label>
                                    <small class="text-muted">If unchecked, logged-in users can only submit this form once.</small>
                                </div>
                            </div>

                            <div class="form-check form-switch d-flex align-items-center gap-3">
                                <input asp-for="Input.AllowUserToViewResponses" class="form-check-input" type="checkbox" role="switch" style="width: 3rem; height: 1.5rem;" />
                                <div>
                                    <label asp-for="Input.AllowUserToViewResponses" class="form-check-label fw-bold d-block">Allow User to View Responses</label>
                                    <small class="text-muted">If checked, logged-in users will be able to see a copy of their own responses on their dashboard.</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold py-3">Create & Continue to Builder <i class="bi bi-arrow-right ms-1"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


