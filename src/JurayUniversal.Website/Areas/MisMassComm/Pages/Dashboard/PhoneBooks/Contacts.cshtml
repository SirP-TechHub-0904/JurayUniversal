@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Dashboard.PhoneBooks.ContactsModel
@{
    ViewData["Title"] = $"Contacts - {Model.PhoneBook.Name}";
}

@section HeaderActions {
    <a href="/MisMassComm/Dashboard/PhoneBooks/Import?id=@Model.PhoneBook.Id" class="btn btn-success"><i class="fa fa-upload"></i> Import Contacts</a>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="fa fa-user-plus text-primary"></i> Add Single Contact</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Add" asp-route-id="@Model.PhoneBook.Id">
                    <div class="form-group mb-3">
                        <label asp-for="NewContact.Name" class="form-label">Contact Name (Optional)</label>
                        <input asp-for="NewContact.Name" class="form-control" placeholder="e.g. John Doe" />
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="NewContact.PhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="NewContact.PhoneNumber" class="form-control" required placeholder="e.g. 08012345678" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="fa fa-plus"></i> Add Contact</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa fa-users text-info"></i> All Contacts (@Model.Contacts.Count)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Phone Number</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Contacts.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No contacts added yet.</td>
                                </tr>
                            }
                            @foreach (var item in Model.Contacts)
                            {
                                <tr>
                                    <td>@(string.IsNullOrEmpty(item.Name) ? "--" : item.Name)</td>
                                    <td class="font-weight-bold">@item.PhoneNumber</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form method="post" style="display:inline;">
                                            <input type="hidden" name="contactId" value="@item.Id" />
                                            @if (item.IsActive)
                                            {
                                                <button type="submit" asp-page-handler="ToggleStatus" asp-route-id="@Model.PhoneBook.Id" class="btn btn-sm btn-outline-warning" title="Deactivate"><i class="fa fa-ban"></i></button>
                                            }
                                            else
                                            {
                                                <button type="submit" asp-page-handler="ToggleStatus" asp-route-id="@Model.PhoneBook.Id" class="btn btn-sm btn-outline-success" title="Activate"><i class="fa fa-check"></i></button>
                                            }
                                            <button type="submit" asp-page-handler="Delete" asp-route-id="@Model.PhoneBook.Id" class="btn btn-sm btn-outline-danger ms-1" title="Delete" onclick="return confirm('Are you sure you want to delete this contact?');"><i class="fa fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



