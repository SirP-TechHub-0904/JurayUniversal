@page
@model JurayUniversal.Website.Areas.MisAlumni.Pages.Platform.JoinModel
@{
    ViewData["Title"] = "Join " + Model.AlumniAlias + " Network";
    ViewData["ActiveMenu"] = "MisAlumni";
}

<div class="mis-page-header d-flex justify-content-between align-items-center">
    
    <div class="d-flex gap-2">
        <a asp-page="/Platform/Index" asp-area="MIS" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
        
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <div class="container max-w-3xl mx-auto">
        

        @if (Model.ExistingProfile != null)
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-5">
                <div class="card-body p-5 text-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                        <i class="bi bi-hourglass-split fs-1"></i>
                    </div>
                    <h2 class="fw-bold mb-3">Application Pending</h2>
                    <p class="lead text-muted mb-4">You have already applied to join the @Model.AlumniAlias Network. Your application is currently under review by our administrators.</p>
                    <p class="text-muted">You will be granted access to the directory and opportunities board as soon as your account is verified.</p>
                    <a asp-page="/Platform/Index" asp-area="MIS" class="btn btn-primary rounded-pill px-4 mt-3">Back to Main Dashboard</a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="bg-primary text-white p-4 p-md-5">
                    <h2 class="fw-bold mb-2">Reconnect & Grow</h2>
                    <p class="mb-0 opacity-75">Fill out the form below to apply for access to our exclusive @Model.AlumniAlias Network.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        
                        <div class="mb-4">
                            <label asp-for="Input.ExitYear" class="form-label fw-bold"></label>
                            <input asp-for="Input.ExitYear" class="form-control form-control-lg bg-light" placeholder="e.g. 2022" />
                            <span asp-validation-for="Input.ExitYear" class="text-danger fs-8"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Input.CurrentProfession" class="form-label fw-bold"></label>
                            <input asp-for="Input.CurrentProfession" class="form-control form-control-lg bg-light" placeholder="e.g. Product Manager" />
                            <span asp-validation-for="Input.CurrentProfession" class="text-danger fs-8"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Company" class="form-label fw-bold"></label>
                            <input asp-for="Input.Company" class="form-control form-control-lg bg-light" placeholder="e.g. Google" />
                            <span asp-validation-for="Input.Company" class="text-danger fs-8"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Input.LinkedInUrl" class="form-label fw-bold"></label>
                            <input asp-for="Input.LinkedInUrl" class="form-control form-control-lg bg-light" placeholder="https://linkedin.com/in/..." />
                            <span asp-validation-for="Input.LinkedInUrl" class="text-danger fs-8"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Bio" class="form-label fw-bold"></label>
                            <textarea asp-for="Input.Bio" class="form-control bg-light" rows="4" placeholder="Tell us briefly what you've been up to..."></textarea>
                            <span asp-validation-for="Input.Bio" class="text-danger fs-8"></span>
                        </div>

                        <div class="mb-5 bg-light p-4 rounded-3 border">
                            <div class="form-check form-switch d-flex align-items-center gap-3">
                                <input asp-for="Input.IsAvailableForMentorship" class="form-check-input" type="checkbox" role="switch" style="width: 3rem; height: 1.5rem;" />
                                <div>
                                    <label asp-for="Input.IsAvailableForMentorship" class="form-check-label fw-bold d-block">Open to Mentorship</label>
                                    <small class="text-muted">Check this box if you are willing to mentor other staff and alumni.</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold py-3">Submit Application</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

