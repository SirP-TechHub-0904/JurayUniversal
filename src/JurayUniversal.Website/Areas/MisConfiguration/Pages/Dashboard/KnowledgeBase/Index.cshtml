@page
@model JurayUniversal.Website.Areas.MisConfiguration.Pages.Dashboard.KnowledgeBase.IndexModel
@{
    ViewData["Title"] = "Unified Knowledge Base Manager";
}

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-default shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="card-title mb-0 fw-bold">@ViewData["Title"]</h4>
        <button type="button" class="btn btn-primary" onclick="openManualModal()">
            <i class="bi bi-plus-lg me-1"></i> Add Manual Module
        </button>
    </div>
    <div class="card-body p-4">

        @if (!Model.Manuals.Any())
        {
            <div class="text-center text-muted p-5">
                <i class="bi bi-journal-x fs-1 d-block mb-3"></i>
                <h5>No Manual Modules Found</h5>
                <p>Click "Add Manual Module" to create your first knowledge base section.</p>
            </div>
        }
        else
        {
            <div class="accordion" id="manualsAccordion">
                @foreach (var manual in Model.Manuals)
                {
                    <div class="accordion-item mb-3 border rounded shadow-sm">
                        <h2 class="accordion-header" id="heading-manual-@manual.Id">
                            <button class="accordion-button collapsed fw-bold text-primary bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-manual-@manual.Id">
                                <i class="bi bi-journal-bookmark-fill me-2"></i> @manual.Title (@manual.ModuleFolder)
                            </button>
                        </h2>
                        <div id="collapse-manual-@manual.Id" class="accordion-collapse collapse" data-bs-parent="#manualsAccordion">
                            <div class="accordion-body bg-white">
                                <div class="d-flex justify-content-between align-items-start mb-4 pb-3 border-bottom">
                                    <div>
                                        <p class="mb-1 text-muted"><strong>Overview:</strong> @(string.IsNullOrWhiteSpace(manual.Overview) ? "No overview provided." : manual.Overview)</p>
                                    </div>
                                    <div class="btn-group btn-group-sm ms-3">
                                        <button class="btn btn-outline-primary" onclick="openManualModal(@manual.Id, '@Html.Raw(manual.ModuleFolder)', '@Html.Raw(manual.Title)', '@Html.Raw(manual.Overview?.Replace("\n", "\\n").Replace("'", "\\'"))')"><i class="bi bi-pencil"></i> Edit Manual</button>
                                        <button class="btn btn-outline-danger" onclick="deleteItem('Manual', @manual.Id)"><i class="bi bi-trash"></i> Delete</button>
                                        <button class="btn btn-primary" onclick="openPageModal(0, @manual.Id, '', '', '')"><i class="bi bi-file-earmark-plus"></i> Add Page</button>
                                    </div>
                                </div>

                                @if (!manual.MisManualPages.Any())
                                {
                                    <div class="alert alert-secondary mb-0">No pages added to this manual yet.</div>
                                }
                                else
                                {
                                    <div class="accordion accordion-flush border rounded" id="pagesAccordion-@manual.Id">
                                        @foreach (var pageItem in manual.MisManualPages.OrderBy(p => p.PageTitle))
                                        {
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="heading-page-@pageItem.Id">
                                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-page-@pageItem.Id">
                                                        <i class="bi bi-file-text me-2 text-secondary"></i> @pageItem.PageTitle 
                                                        <small class="text-muted ms-2 fw-normal">(/@pageItem.RouteKey)</small>
                                                    </button>
                                                </h2>
                                                <div id="collapse-page-@pageItem.Id" class="accordion-collapse collapse" data-bs-parent="#pagesAccordion-@manual.Id">
                                                    <div class="accordion-body bg-light pt-3">
                                                        <div class="d-flex justify-content-between mb-3">
                                                            <div class="text-muted small">@pageItem.PageDescription</div>
                                                            <div class="btn-group btn-group-sm">
                                                                <button class="btn btn-outline-secondary" onclick="openPageModal(@pageItem.Id, @manual.Id, '@Html.Raw(pageItem.RouteKey)', '@Html.Raw(pageItem.PageTitle)', '@Html.Raw(pageItem.PageDescription?.Replace("\n", "\\n").Replace("'", "\\'"))')"><i class="bi bi-pencil"></i> Edit Page</button>
                                                                <button class="btn btn-outline-danger" onclick="deleteItem('Page', @pageItem.Id)"><i class="bi bi-trash"></i></button>
                                                                <button class="btn btn-secondary" onclick="openElementModal(0, @pageItem.Id, '', 'Button', '', '')"><i class="bi bi-puzzle"></i> Add Element</button>
                                                            </div>
                                                        </div>

                                                        @if (pageItem.MisManualElements != null && pageItem.MisManualElements.Any())
                                                        {
                                                            <div class="list-group list-group-flush border rounded">
                                                                @foreach (var element in pageItem.MisManualElements.OrderBy(e => e.ElementName))
                                                                {
                                                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                                                        <div>
                                                                            <strong>@element.ElementName</strong> <span class="badge bg-secondary ms-2">@element.ElementType</span>
                                                                            @if(!string.IsNullOrEmpty(element.RequiredRole)){ <span class="badge bg-info">@element.RequiredRole</span> }
                                                                            <p class="mb-0 small text-muted">@element.Description</p>
                                                                        </div>
                                                                        <div class="btn-group btn-group-sm">
                                                                            <button class="btn btn-link text-primary p-0 me-2" onclick="openElementModal(@element.Id, @pageItem.Id, '@Html.Raw(element.ElementName)', '@Html.Raw(element.ElementType)', '@Html.Raw(element.Description?.Replace("\n", "\\n").Replace("'", "\\'"))', '@Html.Raw(element.RequiredRole)')">Edit</button>
                                                                            <button class="btn btn-link text-danger p-0" onclick="deleteItem('Element', @element.Id)">Delete</button>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted small italic">No elements documented on this page.</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modals -->

<!-- Manual Modal -->
<div class="modal fade" id="manualModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="SaveManual">
                <div class="modal-header">
                    <h5 class="modal-title" id="manualModalTitle">Add Manual</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="manual_id" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Title</label>
                        <input type="text" class="form-control" name="title" id="manual_title" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Module Folder <small class="text-muted fw-normal">(e.g. MisNewsletter)</small></label>
                        <input type="text" class="form-control" name="moduleFolder" id="manual_folder" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Overview</label>
                        <textarea class="form-control" name="overview" id="manual_overview" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Manual</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Page Modal -->
<div class="modal fade" id="pageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="SavePage">
                <div class="modal-header">
                    <h5 class="modal-title" id="pageModalTitle">Add Page</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="page_id" value="0" />
                    <input type="hidden" name="misManualId" id="page_manual_id" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Page Title</label>
                        <input type="text" class="form-control" name="pageTitle" id="page_title" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Route Key <small class="text-muted fw-normal">(e.g. /Dashboard/Campaigns)</small></label>
                        <input type="text" class="form-control" name="routeKey" id="page_route" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Page Description</label>
                        <textarea class="form-control" name="pageDescription" id="page_desc" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Page</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Element Modal -->
<div class="modal fade" id="elementModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="SaveElement">
                <div class="modal-header">
                    <h5 class="modal-title" id="elementModalTitle">Add Element</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="elem_id" value="0" />
                    <input type="hidden" name="misManualPageId" id="elem_page_id" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Element Name</label>
                        <input type="text" class="form-control" name="elementName" id="elem_name" required />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Element Type</label>
                            <select class="form-select" name="elementType" id="elem_type">
                                <option value="Button">Button</option>
                                <option value="Table">Table</option>
                                <option value="Form">Form</option>
                                <option value="Section">Section</option>
                                <option value="Feature">Feature</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Required Role <small class="text-muted fw-normal">(Optional)</small></label>
                            <input type="text" class="form-control" name="requiredRole" id="elem_role" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description / Documentation</label>
                        <textarea class="form-control" name="description" id="elem_desc" rows="4"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Element</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Form (Hidden) -->
<form id="deleteForm" method="post" asp-page-handler="Delete" style="display:none;">
    <input type="hidden" name="type" id="delete_type" />
    <input type="hidden" name="id" id="delete_id" />
</form>

@section Scripts {
    <script>
        const manualModal = new bootstrap.Modal(document.getElementById('manualModal'));
        const pageModal = new bootstrap.Modal(document.getElementById('pageModal'));
        const elementModal = new bootstrap.Modal(document.getElementById('elementModal'));

        function openManualModal(id = 0, folder = '', title = '', overview = '') {
            document.getElementById('manual_id').value = id;
            document.getElementById('manual_folder').value = folder;
            document.getElementById('manual_title').value = title;
            document.getElementById('manual_overview').value = overview;
            document.getElementById('manualModalTitle').innerText = id > 0 ? "Edit Manual" : "Add Manual";
            manualModal.show();
        }

        function openPageModal(id = 0, manualId = 0, route = '', title = '', desc = '') {
            document.getElementById('page_id').value = id;
            if(manualId > 0) document.getElementById('page_manual_id').value = manualId;
            document.getElementById('page_route').value = route;
            document.getElementById('page_title').value = title;
            document.getElementById('page_desc').value = desc;
            document.getElementById('pageModalTitle').innerText = id > 0 ? "Edit Page" : "Add Page";
            pageModal.show();
        }

        function openElementModal(id = 0, pageId = 0, name = '', type = 'Button', desc = '', role = '') {
            document.getElementById('elem_id').value = id;
            if(pageId > 0) document.getElementById('elem_page_id').value = pageId;
            document.getElementById('elem_name').value = name;
            document.getElementById('elem_type').value = type;
            document.getElementById('elem_desc').value = desc;
            document.getElementById('elem_role').value = role;
            document.getElementById('elementModalTitle').innerText = id > 0 ? "Edit Element" : "Add Element";
            elementModal.show();
        }

        function deleteItem(type, id) {
            if(confirm(`Are you sure you want to delete this ${type}? This action cannot be undone.`)) {
                document.getElementById('delete_type').value = type;
                document.getElementById('delete_id').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
