@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Platform.PhoneBooks.ImportModel
@{
    ViewData["Title"] = "Import Contacts";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <a href="/MisMassComm/Platform/PhoneBooks/Contacts?id=@Model.PhoneBook.Id" class="btn btn-outline-secondary btn-sm mb-2"><i class="fa fa-arrow-left"></i> Back to Contacts</a>
            <h3 class="page-header mb-0">Import into @Model.PhoneBook.Name</h3>
        </div>
    
            
        </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="fa fa-paste text-info"></i> Bulk Copy & Paste</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="BulkPaste" asp-route-id="@Model.PhoneBook.Id">
                    <div class="form-group mb-3">
                        <label class="form-label">Paste Numbers (comma, space, or newline separated)</label>
                        <textarea asp-for="BulkNumbers" class="form-control" rows="8" placeholder="08012345678&#10;08123456789&#10;09087654321"></textarea>
                    </div>
                    <button type="submit" class="btn btn-info w-100"><i class="fa fa-upload"></i> Import Pasted Contacts</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="fa fa-file-csv text-success"></i> Upload CSV File</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Csv" asp-route-id="@Model.PhoneBook.Id" enctype="multipart/form-data">
                    <div class="alert alert-secondary">
                        <small><strong>Format:</strong> Ensure your CSV file has no header row. Column 1 must be the Phone Number. Column 2 (optional) can be the Name.</small>
                    </div>
                    <div class="form-group mb-4">
                        <label class="form-label font-weight-bold">Select File (.csv)</label>
                        <input asp-for="CsvFile" type="file" class="form-control" accept=".csv" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100"><i class="fa fa-upload"></i> Upload CSV</button>
                </form>
                
                <div class="mt-4 pt-4 border-top">
                    <h5 class="mb-3 text-muted"><i class="fa fa-file-excel text-success"></i> Excel / vCard Upload</h5>
                    <p class="text-muted small">Excel and vCard imports are temporarily processed manually. Please contact support or export your files to CSV to use the uploader above.</p>
                </div>
            </div>
        </div>
    </div>
</div>


