@section Scripts {
    <script>
        let currentStep = 1;
        const totalSteps = 5;
        let autoSaveTimer = null;

        // Initialize on page load
        document.addEventListener("DOMContentLoaded", function () {
            // Restore from localStorage if available
            restoreFromLocalStorage();

            // Track changes on all inputs for realtime auto-save
            document.querySelectorAll(".track-input").forEach(function (el) {
                el.addEventListener("input", scheduleAutoSave);
                el.addEventListener("change", scheduleAutoSave);
            });

            updateStepUI();
        });

        // Tab Navigation
        function updateStepUI() {
            for (let i = 1; i <= totalSteps; i++) {
                const pane = document.getElementById("step-" + i);
                const tabBtn = document.getElementById("tabBtn-" + i);
                if (pane) pane.classList.toggle("active", i === currentStep);
                if (tabBtn) {
                    tabBtn.classList.toggle("active", i === currentStep);
                    if (i < currentStep) {
                        tabBtn.classList.add("completed");
                    }
                }
            }

            // Progress bar
            const percent = (currentStep / totalSteps) * 100;
            document.getElementById("progressFill").style.width = percent + "%";

            // Prev / Next / Submit buttons
            document.getElementById("prevBtn").style.display = currentStep > 1 ? "inline-block" : "none";
            document.getElementById("nextBtn").style.display = currentStep < totalSteps ? "inline-block" : "none";
            document.getElementById("submitBtn").style.display = currentStep === totalSteps ? "inline-block" : "none";

            window.scrollTo({ top: 120, behavior: "smooth" });
        }

        function nextStep() {
            if (currentStep === 1) {
                const fullName = document.querySelector("[name='Input.FullName']");
                const phone = document.querySelector("[name='Input.PhoneNumber']");
                if (!fullName.value.trim() || !phone.value.trim()) {
                    alert("Please provide at least your Full Name and Phone Number to continue.");
                    if (!fullName.value.trim()) fullName.focus();
                    else phone.focus();
                    return;
                }
            }

            if (currentStep < totalSteps) {
                currentStep++;
                updateStepUI();
                saveToLocalStorage();
                triggerServerSave();
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                updateStepUI();
            }
        }

        function jumpToStep(step) {
            currentStep = step;
            updateStepUI();
        }

        // ═════════════ REALTIME LOCAL STORAGE & SERVER AUTO-SAVE ═════════════

        function collectFormData() {
            const form = document.getElementById("communityProfilingForm");
            if (!form) return null;

            const data = {};
            const inputs = form.querySelectorAll(".track-input");
            inputs.forEach(function (inp) {
                const name = inp.getAttribute("name");
                if (!name) return;
                const cleanName = name.replace("Input.", "");

                if (inp.type === "checkbox") {
                    if (name === "SelectedExpertise") {
                        if (!data["SelectedExpertise"]) data["SelectedExpertise"] = [];
                        if (inp.checked) data["SelectedExpertise"].push(inp.value);
                    } else {
                        data[cleanName] = inp.checked;
                    }
                } else if (inp.type === "radio") {
                    if (inp.checked) data[cleanName] = inp.value;
                } else {
                    data[cleanName] = inp.value;
                }
            });

            return data;
        }

        function saveToLocalStorage() {
            const data = collectFormData();
            if (data) {
                localStorage.setItem("misCommunityForm_draft", JSON.stringify({
                    step: currentStep,
                    savedAt: new Date().toISOString(),
                    data: data
                }));
            }
        }

        function restoreFromLocalStorage() {
            const raw = localStorage.getItem("misCommunityForm_draft");
            if (!raw) return;
            try {
                const parsed = JSON.parse(raw);
                if (parsed && parsed.data) {
                    populateFormFields(parsed.data);
                    if (parsed.step) currentStep = parsed.step;
                    showAutoSaveBadge("Draft restored from your last session (" + new Date(parsed.savedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ")");
                }
            } catch (e) {
                console.error("Failed to restore draft:", e);
            }
        }

        function scheduleAutoSave() {
            saveToLocalStorage();
            showAutoSaveBadge("Saving changes...");

            if (autoSaveTimer) clearTimeout(autoSaveTimer);
            autoSaveTimer = setTimeout(function () {
                triggerServerSave();
            }, 3000);
        }

        function triggerManualSave() {
            saveToLocalStorage();
            triggerServerSave(true);
        }

        function triggerServerSave(showPrompt) {
            const formData = collectFormData();
            if (!formData || !formData.FullName || !formData.PhoneNumber) {
                showAutoSaveBadge("Draft saved locally");
                return;
            }

            const refNum = document.getElementById("hiddenReferenceNumber").value;
            const password = document.getElementById("hiddenAccessPassword").value;

            fetch("/CommunityForm?handler=SaveDraft", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    referenceNumber: refNum,
                    password: password,
                    step: currentStep,
                    data: formData,
                    selectedExpertise: formData.SelectedExpertise || []
                })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    if (res.referenceNumber) {
                        document.getElementById("hiddenReferenceNumber").value = res.referenceNumber;
                    }
                    showAutoSaveBadge("Auto-saved to server at " + (res.lastSaved || new Date().toLocaleTimeString()));
                    if (showPrompt) {
                        alert("Your application draft has been securely saved!\nReference: " + (res.referenceNumber || "Draft"));
                    }
                }
            })
            .catch(err => {
                showAutoSaveBadge("Saved locally (offline)");
            });
        }

        function showAutoSaveBadge(text) {
            const el = document.getElementById("autoSaveText");
            if (el) el.innerText = text;
        }

        function populateFormFields(data) {
            for (let key in data) {
                const val = data[key];
                if (val === null || val === undefined) continue;

                if (key === "SelectedExpertise" && Array.isArray(val)) {
                    document.querySelectorAll("input[name='SelectedExpertise']").forEach(function (cb) {
                        cb.checked = val.includes(cb.value);
                    });
                    continue;
                }

                const field = document.querySelector(`[name='Input.${key}']`);
                if (!field) continue;

                if (field.type === "checkbox") {
                    field.checked = Boolean(val);
                } else if (field.type === "radio") {
                    const r = document.querySelector(`[name='Input.${key}'][value='${val}']`);
                    if (r) r.checked = true;
                } else {
                    field.value = val;
                }
            }
        }

        // ═════════════ RESUME EXISTING APPLICATION ═════════════

        function executeResumeDraft() {
            const identifier = document.getElementById("resumeIdentifier").value.trim();
            const password = document.getElementById("resumePassword").value;
            const alertEl = document.getElementById("resumeAlert");

            alertEl.classList.add("d-none");
            alertEl.innerText = "";

            if (!identifier) {
                alertEl.innerText = "Please enter your Phone, Email, or Reference Code.";
                alertEl.classList.remove("d-none");
                return;
            }

            fetch("/CommunityForm?handler=ResumeDraft", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ identifier: identifier, password: password })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success && res.data) {
                    populateFormFields(res.data);
                    if (res.selectedExpertise) {
                        document.querySelectorAll("input[name='SelectedExpertise']").forEach(function (cb) {
                            cb.checked = res.selectedExpertise.includes(cb.value);
                        });
                    }
                    if (res.referenceNumber) {
                        document.getElementById("hiddenReferenceNumber").value = res.referenceNumber;
                    }
                    if (password) {
                        document.getElementById("hiddenAccessPassword").value = password;
                    }

                    jumpToStep(res.step || 1);
                    saveToLocalStorage();

                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById("resumeModal"));
                    if (modal) modal.hide();

                    alert(res.message || "Draft loaded successfully!");
                } else {
                    alertEl.innerText = res.message || "Could not load draft.";
                    alertEl.classList.remove("d-none");
                }
            })
            .catch(err => {
                alertEl.innerText = "Error contacting server. Please try again.";
                alertEl.classList.remove("d-none");
            });
        }

        // ═════════════ SAVE DRAFT WITH PASSWORD ═════════════

        function executeSaveDraftWithPassword() {
            const password = document.getElementById("draftPasswordInput").value.trim();
            const formData = collectFormData();

            if (!formData || !formData.FullName || !formData.PhoneNumber) {
                alert("Please fill at least your Full Name and Phone Number before saving.");
                return;
            }

            const refNum = document.getElementById("hiddenReferenceNumber").value;

            fetch("/CommunityForm?handler=SaveDraft", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    referenceNumber: refNum,
                    password: password,
                    step: currentStep,
                    data: formData,
                    selectedExpertise: formData.SelectedExpertise || []
                })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    if (res.referenceNumber) {
                        document.getElementById("hiddenReferenceNumber").value = res.referenceNumber;
                        document.getElementById("generatedDraftCode").innerText = res.referenceNumber;
                    }
                    if (password) {
                        document.getElementById("hiddenAccessPassword").value = password;
                    }

                    document.getElementById("saveResultBox").classList.remove("d-none");
                    const alertEl = document.getElementById("saveModalAlert");
                    alertEl.innerText = "Application draft saved successfully!";
                    alertEl.classList.remove("d-none");

                    saveToLocalStorage();
                } else {
                    alert(res.message || "Failed to save draft.");
                }
            });
        }
    </script>
}
