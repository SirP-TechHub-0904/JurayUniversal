@page
@model JurayUniversal.MisCentral.Pages.PricingModel
@{
    ViewData["Title"] = "Simple & Transparent Pricing Plans";
    Layout = "_PublicLayout";
}

<!-- breadcrumb-area -->
<section class="breadcrumb__area breadcrumb__bg fix" data-background="/xyz-mis/assets/img/bg/breadcrumb_bg.jpg">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb__content">
                    <h2 class="title">Simple Pricing Plans</h2>
                    <nav class="breadcrumb">
                        <span property="itemListElement" typeof="ListItem">
                            <a asp-page="/Index">Home</a>
                        </span>
                        <span class="breadcrumb-separator">/</span>
                        <span property="itemListElement" typeof="ListItem">Pricing</span>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- breadcrumb-area-end -->

<!-- pricing-area -->
<section class="pricing__area section-py-120 section-bg-two">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 col-md-6" data-sal="slide-right" data-sal-duration="700" data-sal-delay="100">
                <div class="section__title mb-50">
                    <span class="sub-title">Fair &amp; Transparent</span>
                    <h2 class="title">Choose the Plan That Fits Your Organization</h2>
                </div>
            </div>
            <div class="col-lg-5 col-md-6" data-sal="slide-left" data-sal-duration="700" data-sal-delay="100">
                <div class="section__content mb-50">
                    <p>Every plan includes a 100% private workspace, automatic daily backups, high security, and access to all the features you need.</p>
                </div>
            </div>
        </div>
        <div class="row gutter-50 gutter-y-40 justify-content-center">
            @for (int i = 0; i < Model.Plans.Count; i++)
            {
                var plan = Model.Plans[i];
                <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="700" data-sal-delay="@((i + 1) * 100)">
                    <div class="pricing__box h-100 d-flex flex-column justify-content-between position-relative">
                        @if (plan.IsPopular)
                        {
                            <span class="tg-badge">Most Popular</span>
                        }
                        <div>
                            <div class="pricing__content">
                                <h2 class="title">@plan.Name</h2>
                                <p>@plan.Subtitle</p>
                                <h3 class="price my-3 fw-bolder text-primary">
                                    @plan.Currency@plan.MonthlyPrice.ToString("N0") <small class="fs-6 text-muted fw-normal">/ @plan.BillingCycle</small>
                                </h3>
                            </div>
                            <div class="pricing__list">
                                <ul class="list-wrap">
                                    @foreach (var feat in plan.FeaturesList)
                                    {
                                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i> @feat</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="pricing__btn pt-3 mt-3 border-top">
                            <a asp-page="/Contact" asp-route-plan="@plan.CtaPlanKey" class="tg-btn black-btn w-100 text-center">@plan.CtaText
                                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1 9L9 1M9 1H1M9 1V9" stroke="CurrentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M1 9L9 1M9 1H1M9 1V9" stroke="CurrentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- pricing-area-end -->

<!-- cta-banner -->
<section class="section-pb-120 position-relative">
    <div class="container">
        <div class="rounded-5 p-4 p-md-5 p-xl-5 position-relative overflow-hidden shadow-lg border border-white border-opacity-15" style="background: linear-gradient(135deg, #07132c 0%, #0c244d 50%, #083b8a 100%);">
            <!-- Decorative Ambient Glows -->
            <div class="position-absolute top-0 end-0 translate-middle-y pointer-events-none" style="width: 450px; height: 450px; background: radial-gradient(circle, rgba(13, 110, 253, 0.35) 0%, rgba(0, 210, 255, 0) 70%); filter: blur(50px);"></div>
            <div class="position-absolute bottom-0 start-0 translate-middle-x pointer-events-none" style="width: 350px; height: 350px; background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, rgba(0, 0, 0, 0) 70%); filter: blur(45px);"></div>

            <div class="row align-items-center justify-content-between position-relative" style="z-index: 2;">
                <!-- Left Column: Content -->
                <div class="col-lg-7 text-center text-lg-start mb-4 mb-lg-0">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 text-white border border-white border-opacity-20 fw-bold text-uppercase mb-3" style="font-size: 0.78rem; letter-spacing: 0.8px;">
                        <span class="d-inline-block rounded-circle bg-success" style="width: 8px; height: 8px; box-shadow: 0 0 8px #10b981;"></span>
                        <span>Custom Institutional Quotations</span>
                    </div>

                    <h2 class="text-white fw-bold display-6 mb-3" style="letter-spacing: -0.5px;">
                        Need Custom Pricing For Multi-Campus Institutions?
                    </h2>
                    
                    <p class="text-white text-opacity-80 fs-6 mb-4 mx-auto mx-lg-0" style="max-width: 580px; line-height: 1.7;">
                        We provide flexible, customized packages for state education boards, hospital chains, and large enterprise networks.
                    </p>

                    <!-- Trust Chips -->
                    <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start">
                        <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-15 py-2 px-3 fw-normal" style="font-size: 0.82rem;">
                            <i class="bi bi-shield-check text-primary me-1"></i> Transparent Pricing
                        </span>
                        <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-15 py-2 px-3 fw-normal" style="font-size: 0.82rem;">
                            <i class="bi bi-speedometer2 text-info me-1"></i> Multi-Currency Support
                        </span>
                        <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-15 py-2 px-3 fw-normal" style="font-size: 0.82rem;">
                            <i class="bi bi-headset text-success me-1"></i> 24/7 Dedicated Account Manager
                        </span>
                    </div>
                </div>

                <!-- Right Column: Action Buttons Card -->
                <div class="col-lg-5 col-xl-4 text-center text-lg-end">
                    <div class="p-4 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-15 shadow-sm backdrop-blur d-flex flex-column gap-3">
                        <a asp-page="/Contact" class="btn btn-lg py-3 px-4 fw-bold rounded-pill shadow-lg d-flex align-items-center justify-content-center gap-2 text-white border-0 transition-all hover-scale" style="background: linear-gradient(135deg, #00d2ff 0%, #0d6efd 100%); font-size: 1.02rem;">
                            <span>Request Custom Quote</span>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </a>

                        <a href="https://wa.me/2348165680904" target="_blank" class="btn btn-lg py-3 px-4 fw-bold rounded-pill d-flex align-items-center justify-content-center gap-2 text-white border border-white border-opacity-25 transition-all hover-scale" style="background: rgba(37, 211, 102, 0.2); font-size: 0.95rem;">
                            <i class="bi bi-whatsapp text-success fs-5"></i>
                            <span>WhatsApp (+234 816 568 0904)</span>
                        </a>

                        <div class="text-center pt-1">
                            <span class="text-white text-opacity-70" style="font-size: 0.76rem;">
                                <i class="bi bi-patch-check-fill text-info me-1"></i> Free proposal &bull; Zero commitment
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- cta-banner-end -->
