@page "/pay/callback"
@model JurayUniversal.Website.Pages.Pay.CallbackModel
@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context
@{
    var isSuccess = Model.IsSuccess;
    var title = Model.Transaction?.Category?.Title ?? (Model.SmsTransaction != null ? "SMS Wallet Top-up" : "Payment");
    var amount = Model.Transaction?.Amount ?? Model.SmsTransaction?.Amount ?? 0m;
    var reference = Model.Transaction?.TransactionReference ?? Model.SmsTransaction?.Reference ?? "";
    var providerName = Model.Transaction?.PaymentProvider ?? Model.SmsTransaction?.PaymentProvider ?? "Paystack";
    var paidDate = Model.Transaction?.PaidAt ?? DateTime.UtcNow;

    var superSetting = _context.SuperSettings.FirstOrDefault();
    var orgName = superSetting?.CompanyName ?? "Universal";
    var iconUrl = superSetting?.CompanyIconUrl;
    var logoUrl = superSetting?.CompanyLogoUrl;
    var noteText = !string.IsNullOrWhiteSpace(Model.Transaction?.Notes) ? Model.Transaction.Notes : "Nill";

    ViewData["Title"] = isSuccess ? "Payment Confirmed" : "Payment Status";
    if (Model.SuperSetting?.TemplateLayoutKey == "Layout1111")
    {
        Layout = "/Pages/Shared/Layouts/Theme/RedbizTheme/_RedbizLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout2222")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Carspot/_CarspotLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout3333")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Alina/_AlinaLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout4444")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Archo/_ArchoLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout5555")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Bizup/_BizupLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout6666")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Industry/_IndustryLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout7777")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Lawnella/_LawnellaLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout8888")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Mistro/_MistroLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout9999")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Senatory/_SenatoryLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout11111111")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Education/_EducationLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout12121212")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Streamlab/_StreamlabLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout13131313")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Judge/_JudgeLayout.cshtml";
    }
}

@await Component.InvokeAsync("BreadcrumOthers", new { data = "PAYMENT CONFIRMATION" })

<!-- FontAwesome & Bootstrap Icons for Payment Confirmation -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="universal-payment-portal-wrapper py-5">
    <div class="container" style="max-width: 620px;">
        <div class="card pay-card shadow-sm p-4 p-md-5 mb-5">

    @if (Model.Transaction == null && Model.SmsTransaction == null)
    {
        <div class="text-center py-4">
            <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex p-3 mb-3 align-items-center justify-content-center" style="width:72px; height:72px;">
                <i class="bi bi-exclamation-circle text-danger fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Transaction Not Found</h3>
            <p class="text-muted mb-4">This payment reference is invalid or has expired.</p>
            <a href="/pay" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm">Browse Categories</a>
        </div>
    }
    else if (isSuccess)
    {
        <!-- Complete Printable / Downloadable Receipt Area -->
        <div id="receiptDownloadArea" class="p-2">
            <!-- Organization Header Branding -->
            <div class="text-center mb-3 pb-2 border-bottom">
                <div class="d-inline-flex align-items-center justify-content-center gap-2">
                    @if (!string.IsNullOrEmpty(iconUrl))
                    {
                        <img src="@iconUrl" alt="Icon" class="rounded-2 object-contain" style="height:36px; width:36px;" />
                    }
                    @if (!string.IsNullOrEmpty(logoUrl))
                    {
                        <img src="@logoUrl" alt="Logo" class="object-contain" style="max-height:45px; max-width:180px;" />
                    }
                    else
                    {
                        <span class="fs-4 fw-bold text-dark text-uppercase tracking-tight">@orgName</span>
                    }
                </div>
            </div>

            <!-- Success State -->
            <div class="text-center mb-4">
                <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex p-3 mb-3 align-items-center justify-content-center" style="width:80px; height:80px;">
                    <i class="bi bi-check-circle-fill text-success fs-1"></i>
                </div>
                <h2 class="h3 fw-bold text-dark mb-1">Payment Successful!</h2>
                <p class="text-muted mb-0">Your contribution has been received and verified.</p>
            </div>

            <!-- Premium Receipt Card -->
            <div id="receiptCardArea" class="card bg-slate-50 border border-slate-200 rounded-4 p-4 mb-4">
                <div class="d-flex align-items-center justify-content-between pb-3 border-bottom">
                    <span class="text-muted small uppercase fw-bold">Receipt Reference</span>
                    <span class="badge bg-white text-primary border rounded-pill px-3 py-1.5 font-monospace fs-12px shadow-2xs">@reference</span>
                </div>

                <div class="receipt-row d-flex align-items-center justify-content-between py-2.5">
                    <span class="text-muted small">Category / Purpose</span>
                    <span class="fw-bold text-dark text-end ms-3">@title</span>
                </div>

                <div class="receipt-row d-flex align-items-center justify-content-between py-2.5">
                    <span class="text-muted small">Paid Date</span>
                    <span class="fw-medium text-dark">@paidDate.ToString("dd/MM/yyyy hh:mm tt")</span>
                </div>

                <div class="receipt-row d-flex align-items-center justify-content-between py-2.5">
                    <span class="text-muted small">Payment Gateway</span>
                    <span class="badge bg-light text-dark border px-2.5 py-1">
                        <i class="bi bi-shield-check me-1 text-success"></i> @providerName
                    </span>
                </div>

                <div class="receipt-row d-flex align-items-center justify-content-between py-2.5">
                    <span class="text-muted small">Note / Remark</span>
                    <span class="fw-medium text-dark text-end ms-3">@noteText</span>
                </div>

                <div class="receipt-row d-flex align-items-center justify-content-between pt-3 border-top mt-2">
                    <span class="fw-bold text-dark">Amount Paid</span>
                    <span class="fs-4 fw-bold text-success">&#8358;@amount.ToString("N2")</span>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-grid gap-2 no-print">
            @if (Model.SmsTransaction != null)
            {
                <a href="/MisMassComm/Dashboard/Wallet/Index" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm">
                    <i class="bi bi-wallet2 me-2"></i> View Wallet Balance
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/MIS/Dashboard/Index" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm">
                    <i class="bi bi-speedometer2 me-2"></i> Return to Dashboard
                </a>
            }
            else
            {
                <a href="/pay" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i> Make Another Payment
                </a>
            }

            <div class="d-flex flex-wrap gap-2 justify-content-center mt-2 no-print">
                <button type="button" onclick="window.print()" class="btn btn-outline-dark rounded-pill px-4 py-2">
                    <i class="bi bi-printer me-1"></i> Print Receipt
                </button>
                <button type="button" onclick="downloadReceiptPdf()" class="btn btn-dark rounded-pill px-4 py-2">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF
                </button>
            </div>
        </div>
    }
    else if ((Model.Transaction != null && Model.Transaction.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Failed) ||
             (Model.SmsTransaction != null && Model.SmsTransaction.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Failed))
    {
        <!-- Failed State -->
        <div class="text-center py-3">
            <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex p-3 mb-3 align-items-center justify-content-center" style="width:72px; height:72px;">
                <i class="bi bi-x-circle-fill text-danger fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Payment Failed</h3>
            <p class="text-muted mb-4">Your transaction was declined or cancelled. No funds were charged.</p>

            <div class="bg-light rounded-4 p-3 mb-4 text-start font-monospace small">
                <div class="text-muted mb-1">Reference: <code>@reference</code></div>
                <div class="text-muted">Gateway: @providerName</div>
            </div>

            <div class="d-grid gap-2">
                @if (Model.SmsTransaction != null)
                {
                    <a href="/MisMassComm/Dashboard/Wallet/Fund" class="btn btn-danger btn-lg rounded-pill fw-bold py-3 shadow-sm">
                        <i class="bi bi-arrow-clockwise me-2"></i> Try Again
                    </a>
                }
                else
                {
                    <a href="/pay/@(Model.Transaction?.Category?.Key ?? Model.Transaction?.MisFinanceCategoryId.ToString())" class="btn btn-danger btn-lg rounded-pill fw-bold py-3 shadow-sm">
                        <i class="bi bi-arrow-clockwise me-2"></i> Try Again
                    </a>
                }
                <a href="/pay" class="btn btn-outline-secondary rounded-pill py-2.5">Back to Categories</a>
            </div>
        </div>
    }
    else
    {
        <!-- Pending State -->
        <div class="text-center py-4">
            <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex p-3 mb-3 align-items-center justify-content-center" style="width:72px; height:72px;">
                <i class="bi bi-hourglass-split text-warning fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Confirming Payment...</h3>
            <p class="text-muted mb-4">We are verifying your transaction with @providerName. This page will update automatically.</p>

            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>

            <div class="text-muted small mb-4">Reference: <code class="bg-light border px-2 py-1 rounded">@reference</code></div>

            <a href="/pay" class="btn btn-outline-secondary rounded-pill px-4 py-2">Back to Payments</a>
        </div>
    }

</div>

    </div> <!-- /.container -->
</div> <!-- /.universal-payment-portal-wrapper -->

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function downloadReceiptPdf() {
            var element = document.getElementById('receiptDownloadArea') || document.getElementById('receiptCardArea');
            if (!element) return;
            var opt = {
                margin:       0.4,
                filename:     'Receipt_@(reference).pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }

        @if (!isSuccess && (Model.Transaction == null || Model.Transaction.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Pending))
        {
            <text>
            setTimeout(() => location.reload(), 5000);
            </text>
        }
    </script>
}
