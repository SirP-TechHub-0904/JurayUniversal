@page
@model JurayUniversal.MisCentral.Pages.TermsModel
@{
    ViewData["Title"] = "Terms and Conditions";
    Layout = "_PublicLayout";
}

<!-- breadcrumb-area -->
<section class="breadcrumb__area breadcrumb__bg fix" data-background="/xyz-mis/assets/img/bg/breadcrumb_bg.jpg">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb__content">
                    <h2 class="title">Terms &amp; Conditions</h2>
                    <nav class="breadcrumb">
                        <span property="itemListElement" typeof="ListItem">
                            <a asp-page="/Index">Home</a>
                        </span>
                        <span class="breadcrumb-separator">/</span>
                        <span property="itemListElement" typeof="ListItem">Terms &amp; Conditions</span>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- breadcrumb-area-end -->

<!-- terms-content-area -->
<section class="section-py-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill font-semibold mb-3">Service Agreement</span>
                    <h1 class="fw-bold text-gray-900 mb-4">Terms &amp; Conditions of Service</h1>

                    <p class="lead text-muted mb-4">Welcome to Exwhyzee MIS. By subscribing to or using our cloud platform, your organization agrees to the following friendly terms and operational conditions.</p>

                    <hr class="my-4" />

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">1. Provision of Service &amp; Uptime Commitment</h4>
                    <p class="text-gray-600 leading-relaxed">Exwhyzee MIS agrees to provide high-availability cloud software with a target 99.9% uptime. System updates and feature enhancements are delivered continuously with zero disruptive downtime.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">2. User Accounts &amp; Access Controls</h4>
                    <p class="text-gray-600 leading-relaxed">Your organization is responsible for managing staff logins, student portals, and parent access accounts. Administrators must ensure passwords and two-factor credentials are kept confidential.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">3. Subscription &amp; Billing</h4>
                    <p class="text-gray-600 leading-relaxed">Subscriptions are billed termly or annually depending on your chosen plan and active features. Organizations may add new features or adjust their user tier at any time.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">4. Intellectual Property &amp; Tenant Ownership</h4>
                    <p class="text-gray-600 leading-relaxed">The Exwhyzee MIS platform, proprietary software engines, and logos remain the intellectual property of Exwhyzee Technologies. All data, reports, student files, and institution branding remain the exclusive property of your organization.</p>

                    <h4 class="fw-bold text-gray-900 mt-4 mb-3">5. Technical Support &amp; SLA</h4>
                    <p class="text-gray-600 leading-relaxed">Every plan includes 24/7 technical assistance via WhatsApp (<a href="https://wa.me/2348165680904" target="_blank" class="text-primary fw-bold">+234 816 568 0904</a>), phone, and email (<a href="mailto:support@exwhyzee.ng" class="text-primary fw-bold">support@exwhyzee.ng</a>).</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- terms-content-area-end -->
