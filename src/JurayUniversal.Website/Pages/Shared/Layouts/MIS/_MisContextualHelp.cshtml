@using JurayUniversal.Persistence.EF.SQL
@using Microsoft.EntityFrameworkCore
@inject DashboardDbContext _context

@{
    var currentPath = Context.Request.Path.Value;
    // Strip trailing numeric ID if present
    var segments = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
    if (segments.Length > 0 && long.TryParse(segments[^1], out _))
    {
        currentPath = "/" + string.Join("/", segments.Take(segments.Length - 1));
    }

    // Find a matching manual page for this route
    var manualPage = await _context.MisManualPages
        .Include(p => p.MisManualElements)
        .Include(p => p.MisManual)
        .FirstOrDefaultAsync(p => p.RouteKey == currentPath);

    // If not found, try appending /Index (common convention for Razor Pages routing)
    if (manualPage == null && !string.IsNullOrEmpty(currentPath) && !currentPath.EndsWith("/Index", StringComparison.OrdinalIgnoreCase))
    {
        string fallbackPath = currentPath.TrimEnd('/') + "/Index";
        manualPage = await _context.MisManualPages
            .Include(p => p.MisManualElements)
            .Include(p => p.MisManual)
            .FirstOrDefaultAsync(p => p.RouteKey == fallbackPath);
    }

    bool isSuperAdmin = User.IsInRole("mSuperAdmin");
}

<div class="offcanvas offcanvas-end border-0 shadow-2xl rounded-l-2xl overflow-hidden bg-white" tabindex="-1" id="misHelpOffcanvas" aria-labelledby="misHelpOffcanvasLabel">
    <div class="offcanvas-header bg-white border-b border-gray-100 pb-3 pt-4 px-6 flex items-center justify-between">
        <h5 class="text-lg font-bold text-gray-900 flex items-center gap-2" id="misHelpOffcanvasLabel">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" color="currentColor" class="text-[#0069A1]"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Page Guide
        </h5>
        <button type="button" class="text-gray-400 hover:text-gray-600 p-1" data-bs-dismiss="offcanvas" aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" color="currentColor"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
    </div>
    <div class="offcanvas-body px-6 pt-4 pb-6 overflow-y-auto">
        @if (manualPage != null)
        {
            <div class="mb-4">
                <span class="inline-block bg-blue-50 text-[#0069A1] font-semibold text-xs mb-2 rounded-full px-3 py-1">@(manualPage.MisManual?.Title ?? "Platform Guide")</span>
                <h4 class="text-xl font-bold text-gray-900 mb-1">@manualPage.PageTitle</h4>
                <p class="text-sm text-gray-600">@manualPage.PageDescription</p>
            </div>

            @if (manualPage.MisManualElements != null && manualPage.MisManualElements.Any())
            {
                <div class="border-t border-gray-100 my-4"></div>
                <h6 class="text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">Page Elements</h6>
                <div class="flex flex-col gap-3">
                    @foreach (var element in manualPage.MisManualElements.OrderBy(e => e.Id))
                    {
                        bool hasAccess = isSuperAdmin || string.IsNullOrEmpty(element.RequiredRole) || User.IsInRole(element.RequiredRole);

                        if (hasAccess)
                        {
                            string bgClass = "bg-gray-50";
                            string textClass = "text-gray-900";

                            switch (element.ElementType?.ToLower())
                            {
                                case "button":
                                    bgClass = "bg-blue-50";
                                    textClass = "text-[#0069A1]";
                                    break;
                                case "form":
                                    bgClass = "bg-emerald-50";
                                    textClass = "text-emerald-700";
                                    break;
                                case "card":
                                    bgClass = "bg-cyan-50";
                                    textClass = "text-cyan-700";
                                    break;
                                case "toggle":
                                    bgClass = "bg-amber-50";
                                    textClass = "text-amber-700";
                                    break;
                                default:
                                    bgClass = "bg-gray-50";
                                    textClass = "text-gray-700";
                                    break;
                            }

                            <div class="@bgClass rounded-xl p-4 mb-0 border border-gray-100">
                                <h6 class="font-bold text-sm @textClass mb-1">@element.ElementName</h6>
                                <div class="text-sm text-gray-700 leading-relaxed">
                                    @Html.Raw(element.Description)
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 mt-4">
                    <div class="w-16 h-16 bg-amber-50 rounded-full flex items-center justify-center mx-auto mb-3 text-amber-500">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" color="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.2L12 16.6l-6.3 4.6 2.3-7.2-6-4.6h7.6z" stroke="currentColor" stroke-width="1.5"/></svg>
                    </div>
                    <h6 class="font-bold text-gray-900 mb-1">Ready to Explore</h6>
                    <p class="text-xs text-gray-500">This page doesn't have specific interactive elements documented yet, but it's designed to be intuitive!</p>
                </div>
            }
        }
        else
        {
            <div class="text-center py-8 mt-4">
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" color="currentColor"><path d="M9 20l-6-3V4l6 3m0 13l6-3m-6 3V7m6 13l6-3V4l-6 3m0 13V7m0 0L9 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h6 class="font-bold text-gray-900 mb-1">No Guide Found</h6>
                <p class="text-xs text-gray-500">There is currently no specific documentation configured for this exact page route (@currentPath).</p>
            </div>
        }
        
        <div class="mt-6 pt-4 text-center border-t border-gray-100">
            <a href="/kb" target="_blank" class="inline-flex items-center justify-center font-medium rounded-xl bg-[#0069A1] hover:bg-[#005b8b] text-white px-4 py-2.5 text-sm transition-colors shadow-sm no-underline">
                View Full Knowledge Base
            </a>
        </div>
    </div>
</div>
