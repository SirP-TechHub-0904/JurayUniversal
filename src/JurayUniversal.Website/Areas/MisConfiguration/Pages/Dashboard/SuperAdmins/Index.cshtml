@page
@model JurayUniversal.Website.Areas.MisConfiguration.Pages.Dashboard.SuperAdmins.IndexModel
@{
    ViewData["Title"] = "Super Admins Management";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fa fa-user-secret text-dark me-2"></i> Super Admins</h5>
        <a asp-page="./Create" class="btn btn-dark btn-sm rounded-pill"><i class="fa fa-plus me-1"></i> Add Super Admin</a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.SuperAdmins)
                    {
                        <tr>
                            <td class="fw-bold">
                                @user.FirstName @user.LastName
                                @if (user.Email == User.Identity.Name)
                                {
                                    <span class="badge bg-secondary ms-1">You</span>
                                }
                            </td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>
                                <span class="badge bg-success">Active</span>
                            </td>
                            <td class="text-end">
                                @if (user.Email != User.Identity.Name)
                                {
                                    <form method="post" asp-page-handler="Remove" asp-route-id="@user.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to revoke Super Admin access for this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Revoke Access</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.SuperAdmins.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No super admins found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
