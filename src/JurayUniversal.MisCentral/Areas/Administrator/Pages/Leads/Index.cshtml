@page
@model JurayUniversal.MisCentral.Areas.Administrator.Pages.Leads.IndexModel
@{
    ViewData["Title"] = "Prospective Inquiries & Demo Leads";
    Layout = "_MisMasterLayout";
}

<div class="space-y-6">
    <!-- Top Header Banner -->
    <div class="bg-gradient-to-r from-[#0069A1] to-[#0A2540] p-6 rounded-2xl text-white shadow-lg flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-semibold uppercase tracking-wider mb-2">
                <i class="bi bi-inbox-fill"></i> Prospective Client Pipeline
            </div>
            <h1 class="text-2xl md:text-3xl font-bold tracking-tight">Prospective Inquiries &amp; Demo Requests</h1>
            <p class="text-blue-100 text-sm mt-1">Review contact questionnaire responses, desired feature sets, and schedule follow-ups.</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Contact" target="_blank" class="inline-flex items-center px-4 py-2.5 bg-white text-[#0069A1] hover:bg-blue-50 text-sm font-bold rounded-xl shadow transition-colors text-decoration-none">
                <i class="bi bi-box-arrow-up-right me-2"></i> Open Public Form
            </a>
        </div>
    </div>

    <!-- Metric Counter Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center space-x-4">
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-2xl">
                <i class="bi bi-inboxes"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Submissions</p>
                <p class="text-2xl font-bold text-gray-900">@Model.TotalCount</p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center space-x-4">
            <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-2xl">
                <i class="bi bi-bell-fill"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">New Inquiries</p>
                <p class="text-2xl font-bold text-amber-600">@Model.NewCount</p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center space-x-4">
            <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-2xl">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Demos Scheduled</p>
                <p class="text-2xl font-bold text-gray-900">@Model.DemoCount</p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center space-x-4">
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-2xl">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Converted Clients</p>
                <p class="text-2xl font-bold text-emerald-600">@Model.ConvertedCount</p>
            </div>
        </div>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center gap-2">
        <a asp-page="/Leads/Index" asp-route-FilterStatus="All" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors @(string.IsNullOrEmpty(Model.FilterStatus) || Model.FilterStatus == "All" ? "bg-slate-900 text-white" : "bg-white text-slate-700 hover:bg-slate-100 border")">
            All Inquiries
        </a>
        <a asp-page="/Leads/Index" asp-route-FilterStatus="New" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors @(Model.FilterStatus == "New" ? "bg-amber-600 text-white" : "bg-white text-slate-700 hover:bg-slate-100 border")">
            New Only
        </a>
        <a asp-page="/Leads/Index" asp-route-FilterStatus="Demo Scheduled" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors @(Model.FilterStatus == "Demo Scheduled" ? "bg-purple-600 text-white" : "bg-white text-slate-700 hover:bg-slate-100 border")">
            Demo Scheduled
        </a>
        <a asp-page="/Leads/Index" asp-route-FilterStatus="Won/Converted" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors @(Model.FilterStatus == "Won/Converted" ? "bg-emerald-600 text-white" : "bg-white text-slate-700 hover:bg-slate-100 border")">
            Converted
        </a>
    </div>

    <!-- Leads List -->
    <div class="space-y-4">
        @if (!Model.Leads.Any())
        {
            <div class="bg-white rounded-2xl border border-gray-200 p-12 text-center">
                <i class="bi bi-inbox text-4xl text-gray-400 mb-3 d-block"></i>
                <h3 class="font-bold text-gray-800 text-lg">No Inquiries Found</h3>
                <p class="text-gray-500 text-sm mt-1">There are no prospective client submissions matching this filter.</p>
            </div>
        }
        else
        {
            @foreach (var lead in Model.Leads)
            {
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 hover:border-blue-300 transition-colors">
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-gray-100 pb-4 mb-4">
                        <div>
                            <div class="flex items-center gap-3">
                                <h3 class="font-bold text-gray-900 text-xl">@lead.OrganizationName</h3>
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold @(lead.Status == "New" ? "bg-amber-100 text-amber-800" : lead.Status == "Demo Scheduled" ? "bg-purple-100 text-purple-800" : lead.Status == "Won/Converted" ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-800")">
                                    @lead.Status
                                </span>
                            </div>
                            <p class="text-gray-500 text-xs mt-1">
                                <i class="bi bi-building me-1"></i> @lead.OrganizationType &bull; 
                                <i class="bi bi-people me-1"></i> @lead.EstimatedSize &bull; 
                                <i class="bi bi-geo-alt me-1"></i> @lead.StateOrCity &bull; 
                                <i class="bi bi-clock me-1"></i> Submitted @lead.CreatedAtUtc.ToString("MMM dd, yyyy h:mm tt")
                            </p>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <!-- WhatsApp Quick Action -->
                            <a href="https://wa.me/@(lead.Phone.Replace("+", "").Replace(" ", ""))?text=Hello%20@(Uri.EscapeDataString(lead.ContactPersonName)),%20thank%20you%20for%20contacting%20Exwhyzee%20MIS%20regarding%20@(Uri.EscapeDataString(lead.OrganizationName))." target="_blank" class="inline-flex items-center px-3 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg text-xs font-bold transition-colors">
                                <i class="bi bi-whatsapp me-1.5"></i> WhatsApp
                            </a>
                            <!-- Email Quick Action -->
                            <a href="mailto:@lead.Email?subject=Exwhyzee%20MIS%20Demo%20Request%20-%20@(Uri.EscapeDataString(lead.OrganizationName))" class="inline-flex items-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition-colors">
                                <i class="bi bi-envelope-fill me-1.5"></i> Email
                            </a>
                            <!-- Provision Direct -->
                            <a asp-page="/Tenants/Create" asp-route-orgName="@lead.OrganizationName" class="inline-flex items-center px-3 py-1.5 bg-slate-900 hover:bg-black text-white rounded-lg text-xs font-bold transition-colors">
                                <i class="bi bi-plus-circle me-1.5"></i> Provision Workspace
                            </a>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
                        <div>
                            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Contact Person</span>
                            <p class="font-bold text-gray-900">@lead.ContactPersonName</p>
                            <p class="text-gray-500 text-xs">@lead.JobTitle</p>
                            <p class="text-gray-600 text-xs mt-1"><i class="bi bi-telephone me-1"></i> @lead.Phone</p>
                            <p class="text-gray-600 text-xs"><i class="bi bi-envelope me-1"></i> @lead.Email</p>
                        </div>

                        <div>
                            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Requested Features</span>
                            <div class="flex flex-wrap gap-1.5 mt-1">
                                @if (lead.FeaturesOfInterest != null && lead.FeaturesOfInterest.Any())
                                {
                                    @foreach (var feat in lead.FeaturesOfInterest)
                                    {
                                        <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 text-xs font-medium border border-blue-100">
                                            @feat
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-gray-400 text-xs italic">All-in-One Standard Suite</span>
                                }
                            </div>
                            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mt-3 mb-0.5">Rollout Timeline</span>
                            <span class="badge bg-slate-100 text-slate-800 text-xs">@lead.RolloutTimeline</span>
                        </div>

                        <div>
                            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Operational Goals &amp; Challenges</span>
                            <p class="text-gray-700 bg-slate-50 p-3 rounded-xl border text-xs leading-relaxed">
                                "@lead.PrimaryGoal"
                            </p>
                            @if (!string.IsNullOrEmpty(lead.AdditionalNotes))
                            {
                                <p class="text-gray-500 text-xs mt-2 italic">Notes: @lead.AdditionalNotes</p>
                            }
                        </div>
                    </div>

                    <!-- Status Update & Admin Followup Footer -->
                    <div class="mt-4 pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3 text-xs">
                        <form method="post" asp-page-handler="UpdateStatus" class="flex items-center gap-2">
                            <input type="hidden" name="id" value="@lead.Id" />
                            <span class="text-gray-500 font-semibold">Change Status:</span>
                            <select name="status" class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg p-1.5 text-xs focus:ring-blue-500 focus:border-blue-500">
                                <option value="New" selected="@(lead.Status == "New")">New</option>
                                <option value="Contacted" selected="@(lead.Status == "Contacted")">Contacted</option>
                                <option value="Demo Scheduled" selected="@(lead.Status == "Demo Scheduled")">Demo Scheduled</option>
                                <option value="Won/Converted" selected="@(lead.Status == "Won/Converted")">Won/Converted</option>
                                <option value="Closed" selected="@(lead.Status == "Closed")">Closed</option>
                            </select>
                            <input type="text" name="adminNotes" value="@lead.AdminNotes" placeholder="Add follow-up notes..." class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg p-1.5 text-xs w-48" />
                            <button type="submit" class="px-2.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold transition-colors">Save</button>
                        </form>

                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this inquiry?');">
                            <input type="hidden" name="id" value="@lead.Id" />
                            <button type="submit" class="text-rose-600 hover:text-rose-800 text-xs font-medium">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>
