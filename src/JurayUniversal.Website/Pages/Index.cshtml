<style>
    @@media (min-width: 768px) {
        .lightgallery .col-md-4 {
            width: 33.33333333% !important;
        }
    }

    .lightgallery .lg-sub-html h4 {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .lightgallery .lg-sub-html p {
        font-size: 14px;
        color: #ccc;
    }
</style>
<style>
    .image-box {
        height: 200px;
        background-size: cover;
        background-position: center;
        border-radius: 8px;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
    }

    .image-title {
        width: 100%;
        text-align: center;
        background: rgba(255, 255, 255, 0.95);
        font-weight: bold;
        font-size: 14px;
        padding: 5px;
        color: #1a73e8;
    }

    /* Ensure img used only for LightGallery thumbnail plugin */
    .hidden-thumb {
        position: absolute;
        width: 0;
        height: 0;
        opacity: 0;
        pointer-events: none;
    }

    .lightgallery-item {
        text-decoration: none;
    }
</style>


