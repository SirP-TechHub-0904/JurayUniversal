        <script>


            if ($(".marquee_mode").length) {
                $('.marquee_mode').marquee({
                    speed: 30,
                    gap: 0,
                    delayBeforeStart: 0,
                    direction: 'left',
                    duplicated: true,
                    pauseOnHover: true,
                    startVisible: true
                });
            }

        </script>
        <script>
            $(document).ready(function () {
                $('.team-one__carousel').owlCarousel({
                    loop: true,
                    margin: 30,
                    nav: true,
                    dots: false,
                    autoplay: true,
                    autoplayTimeout: 4000,
                    smartSpeed: 800,
                    responsive: {
                        0: { items: 1 },
                        600: { items: 2 },
                        1000: { items: 5 }   // ✅ show 5 items
                    }
                });
            });
