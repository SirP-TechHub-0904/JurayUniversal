@page
@model JurayUniversal.Website.Areas.MisGrants.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Grant Ledger & Funding Tracking";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

@section HeaderActions {
    <a asp-page="./Manage" class="btn btn-primary d-flex align-items-center rounded-pill px-4 py-2 fw-600 shadow-sm" style="transition: all 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                <i class="bi bi-plus-lg me-2"></i> New Grant
            </a>
}

<div class="container-fluid">

    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Total Grants</h6>
                        <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-journal-text fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-primary mb-0">@Model.TotalGrants</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Active Grants</h6>
                        <div class="bg-success bg-opacity-10 text-success rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-activity fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-success mb-0">@Model.ActiveGrantsCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Total Funding Awarded</h6>
                        <div class="bg-info bg-opacity-10 text-info rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-cash-coin fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-info mb-0">@Model.TotalAwardAmount.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-700 mb-0">6-Month Funding Trend</h5>
                </div>
                <div class="card-body p-4">
                    <div id="fundingTrendChart" style="height: 300px;"></div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-700 mb-0">Grant Status</h5>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center">
                    <div id="statusChart" class="w-100"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Recent Grants</h5>
                    <a asp-page="./History" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All History</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Title</th>
                                    <th>Donor</th>
                                    <th>Award</th>
                                    <th class="pe-4 text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Grants.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            No grants recorded yet.
                                        </td>
                                    </tr>
                                }
                                @foreach (var grant in Model.Grants.Take(5))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@grant.Title</div>
                                            <div class="small text-muted">@grant.StartDate.ToString("MMM yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="fw-600 text-muted">@(grant.MisDonor?.Name ?? "Unknown")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-success">@grant.Currency @grant.TotalAwardAmount.ToString("N2")</div>
                                        </td>
                                        <td class="pe-4 text-end">
                                            @if (grant.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Closed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Upcoming Milestones</h5>
                </div>
                <div class="card-body p-4">
                    @{
                        var upcomingMilestones = Model.Grants
                            .Where(g => g.IsActive)
                            .SelectMany(g => g.Milestones)
                            .Where(m => !m.AmountReceived.HasValue || m.AmountReceived < m.ExpectedAmount)
                            .OrderBy(m => m.ExpectedDate)
                            .Take(5)
                            .ToList();
                    }
                    
                    @if (!upcomingMilestones.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-check display-6 d-block mb-3 opacity-50"></i>
                            No pending milestones.
                        </div>
                    }
                    else
                    {
                        <div class="position-relative">
                            @foreach (var milestone in upcomingMilestones)
                            {
                                var daysUntil = (milestone.ExpectedDate - DateTime.UtcNow).TotalDays;
                                var statusColor = daysUntil < 0 ? "danger" : (daysUntil <= 7 ? "warning" : "primary");
                                
                                <div class="d-flex mb-4">
                                    <div class="flex-shrink-0">
                                        <div class="bg-@statusColor bg-opacity-10 text-@statusColor rounded d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                                            <i class="bi bi-flag fs-5"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="fw-bold mb-1">@milestone.Title</h6>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="small text-muted">@milestone.ExpectedDate.ToString("dd MMM yyyy")</span>
                                            <span class="fw-600 text-dark">@milestone.ExpectedAmount.ToString("N2")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Bar Chart for 6-Month Funding Trend
            var optionsBar = {
                series: [{
                    name: 'Funding Awarded',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData))
                }],
                chart: {
                    height: 300,
                    type: 'bar',
                    fontFamily: 'Inter, sans-serif',
                    toolbar: { show: false }
                },
                plotOptions: {
                    bar: {
                        borderRadius: 4,
                        horizontal: false,
                        columnWidth: '55%',
                    }
                },
                dataLabels: { enabled: false },
                stroke: { show: true, width: 2, colors: ['transparent'] },
                colors: ['#0d6efd'],
                xaxis: {
                    categories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                },
                yaxis: {
                    labels: {
                        formatter: function (value) {
                            if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                            if (value >= 1000) return (value / 1000).toFixed(1) + 'k';
                            return value;
                        }
                    }
                },
                fill: { opacity: 1 },
                tooltip: {
                    y: {
                        formatter: function (val) {
                            return val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    }
                }
            };
            var fundingChart = new ApexCharts(document.querySelector("#fundingTrendChart"), optionsBar);
            fundingChart.render();

            // Donut Chart for Status Distribution
            var hasData = @Model.TotalGrants > 0;
            var optionsDonut = {
                series: hasData ? [@Model.ActiveGrantsCount, @Model.ClosedGrantsCount] : [1],
                labels: hasData ? ['Active Grants', 'Closed Grants'] : ['No Data'],
                chart: {
                    type: 'donut',
                    fontFamily: 'Inter, sans-serif',
                    height: 280
                },
                colors: hasData ? ['#198754', '#6c757d'] : ['#e9ecef'],
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                name: { show: true },
                                value: { show: true }
                            }
                        }
                    }
                },
                dataLabels: { enabled: false },
                legend: { position: 'bottom' },
                tooltip: {
                    enabled: hasData
                }
            };
            var statusChart = new ApexCharts(document.querySelector("#statusChart"), optionsDonut);
            statusChart.render();
        });
    </script>
}
