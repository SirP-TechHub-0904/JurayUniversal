@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.ListModel
@{
    ViewData["Title"] = "User Directory";
    ViewData["Subtitle"] = "Overview and management of all records.";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "Users";
}



@section HeaderActions {
    @if (!Model.IsReadOnly)
    {
        <a asp-page="./Create" class="btn btn-primary rounded-pill px-4"><i class="bi bi-person-plus me-1"></i> Add New User</a>
    }
}



<div class="page-content bg-light p-0 p-md-4 mt-4" style="min-height: 100vh;">

    <!-- Bulk Action Toolbar (Hidden by default) -->
    <div id="bulkActionToolbar" class="mis-bulk-toolbar d-none">
        <span class="me-auto fw-bold text-primary">
            <span id="selectedCount" class="badge bg-primary rounded-pill me-2 px-3 py-2">0</span> Selected
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-warning text-dark mis-submit-button" onclick="submitBulkAction('Suspend')">
                <i class="bi bi-pause-circle"></i> Suspend
            </button>
            <button class="btn btn-success mis-submit-button" onclick="submitBulkAction('Activate')">
                <i class="bi bi-play-circle"></i> Activate
            </button>
        </div>
    </div>

    <!-- Export Dropdown (injected into DOM beside search pill, shown via JS) -->
    <div id="exportDropdownWrapper" class="d-none">
        <div class="dropdown d-inline-block">
            <button class="btn btn-outline-dark rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1 dropdown-toggle"
                    type="button" id="exportDropdownBtn"
                    data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false"
                    style="border-color: #334155 !important; color: #334155; font-size: 0.875rem; font-weight: 500;">
                <i class="bi bi-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu shadow border-0 rounded-3" aria-labelledby="exportDropdownBtn">
                <li>
                    <a class="dropdown-item py-2" href="#" onclick="triggerExport('excel'); return false;">
                        <i class="bi bi-file-earmark-excel text-success me-2"></i> Excel (.xlsx)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" onclick="triggerExport('pdf'); return false;">
                        <i class="bi bi-file-earmark-pdf text-danger me-2"></i> PDF (.pdf)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" onclick="triggerExport('word'); return false;">
                        <i class="bi bi-file-earmark-word text-primary me-2"></i> Word (.docx)
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- User Directory List Card -->
    <div class="card mis-card mis-table-card">
        <div class="card-body mis-card-body">
            <div class="table-responsive" style="overflow: visible;">
                <table id="userDirectoryTable" class="table table-bordered align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 50px;">s/n</th>
                            <th>Customer Name</th>
                            <th>Email / Phone</th>
                            <th>@Model.CategoryAlias</th>
                            <th>Status</th>
                            <th>Registration Date</th>
                            <th>Gender</th>
                            <th class="text-center" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody style="border-top: 0;">
                        @{ int sn = 0; }
                        @foreach (var user in Model.Users)
                        {
                            sn++;
                            var isAct = user.UserStatus == JurayUniversal.Domain.Enum.Enum.UserStatus.Active;
                            var isPend = user.UserStatus == JurayUniversal.Domain.Enum.Enum.UserStatus.Pending;
                            var badgeClass = isAct ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" :
                                             isPend ? "bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25" :
                                             "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25";
                            <tr>
                                <td class="text-muted text-center fw-medium">@sn</td>
                                <td>
                                    <a asp-page="./Roles" asp-route-id="@user.Id" class="text-decoration-none">
                                        <span class="fw-bold text-dark" style="font-size: 0.9rem;">@user.GetFullName()</span>
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark font-monospace" style="font-size: 0.85rem;">@user.Email</span>
                                        <span class="text-muted" style="font-size: 0.75rem;">@(user.PhoneNumber ?? "N/A")</span>
                                    </div>
                                </td>
                                <td><span class="fw-medium text-secondary">@(user.UserCategory?.Title ?? "None")</span></td>
                                <td>
                                    <span class="badge @badgeClass rounded-pill px-3 py-1 fw-medium" style="font-size: 0.75rem;">@user.UserStatus</span>
                                </td>
                                <td class="text-muted" style="font-size: 0.85rem;">@user.Date.ToString("yyyy-MM-dd")</td>
                                <td class="text-muted" style="font-size: 0.85rem;">@user.Gender</td>
                                <td class="text-center">
                                    @if (!Model.IsReadOnly)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border rounded-pill px-3 shadow-none dropdown-toggle" type="button" data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false" style="font-size: 0.8rem; font-weight: 500;">
                                                Actions
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" style="font-size: 0.85rem; z-index: 1050;">
                                                <li>
                                                    <a class="dropdown-item py-2" asp-page="./Detail" asp-route-id="@user.Id">
                                                        <i class="bi bi-file-earmark-person me-2 text-primary"></i> View Detail
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-2" asp-page="./Edit" asp-route-id="@user.Id">
                                                        <i class="bi bi-pencil-square me-2 text-warning"></i> Edit Profile
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-2" asp-page="./Roles" asp-route-id="@user.Id">
                                                        <i class="bi bi-shield-check me-2 text-info"></i> Feature Roles
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-2" asp-page="./KpiAssign" asp-route-id="@user.Id">
                                                        <i class="bi bi-clipboard-check-fill me-2 text-success"></i> Evaluate KPIs
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="bi bi-lock"></i></span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var table = $('#userDirectoryTable').DataTable({
                "pageLength": 10,
                "lengthMenu": [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "targets": [7], "orderable": false }
                ],
                "language": {
                    "search": "_INPUT_",
                    "searchPlaceholder": "Search records..."
                },
                "initComplete": function() {
                    // Scope changes to this table's wrapper to avoid affecting other DataTables on the site
                    var filter = $('#userDirectoryTable_wrapper .dataTables_filter');
                    var exportWrapper = $('#exportDropdownWrapper').removeClass('d-none');
                    var label = filter.find('label');

                    filter.addClass('d-flex align-items-center gap-2 justify-content-end'); // container -> flex
                    label.addClass('m-0 d-flex align-items-center gap-2');                   // label -> flex row
                    var search = label.find('input[type="search"]');

                    // make sure export sits left of the search
                    if (filter.length) {
                        exportWrapper.prependTo(filter);
                    }
                }
            });
        });
    </script>
}



