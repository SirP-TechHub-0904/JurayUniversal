        { id: 22, name: "Helpdesk & IT Tickets", icon: "fa-life-ring", category: "tech", status: "Active", desc: "Support ticket registry, SLA clocks, and technical resolution boards.", link: "/MIS/Helpdesk" },
        
        { id: 23, name: "Document Vault (DMS)", icon: "fa-folder-open", category: "compliance", status: "Active", desc: "Version-controlled official documents, policies, protocols, and access audit logs.", link: "/MIS/DMS" },
        { id: 24, name: "Learning Management (LMS)", icon: "fa-university", category: "compliance", status: "Active", desc: "Hosting compliance videos, course slides, dynamic quizzes, and completion certificates.", link: "/MIS/LMS" },
        { id: 25, name: "Visitor & Gate Control", icon: "fa-id-badge", category: "compliance", status: "Active", desc: "Register reception arrivals, logs badges, photos, and triggers host notifications.", link: "/MIS/VisitorManagement" }
    ];

    let currentCategory = 'all';
    let starredIds = [];
    let recentlyVisitedIds = [];

    // Initialize Page State
    document.addEventListener("DOMContentLoaded", function () {
        // Load settings from localStorage
        initSettings();
        
        // Render Widgets
        renderRecentlyVisited();
        renderFeatures();
        
        // Initialize ApexCharts
        initRevenueChart();
    });

    function initSettings() {
        // Starred IDs defaults
        const storedStars = localStorage.getItem('mis_starred_ids');
        if (storedStars) {
            starredIds = JSON.parse(storedStars);
        } else {
            starredIds = [1, 4, 8, 17, 23]; // Default Favorites
            localStorage.setItem('mis_starred_ids', JSON.stringify(starredIds));
        }

        // Recently Visited defaults
        const storedVisited = localStorage.getItem('mis_recent_ids');
        if (storedVisited) {
            recentlyVisitedIds = JSON.parse(storedVisited);
        } else {
            recentlyVisitedIds = [1, 8, 17, 9, 23, 13]; // Default presets
            localStorage.setItem('mis_recent_ids', JSON.stringify(recentlyVisitedIds));
        }

        // Load hidden widgets states
        const widgetStates = localStorage.getItem('mis_widget_states');
        if (widgetStates) {
            const states = JSON.parse(widgetStates);
            for (const [widgetId, visible] of Object.entries(states)) {
                toggleWidgetElement(widgetId, visible);
            }
        }
    }

    // Toggle widget view
    function toggleWidget(widgetId, visible) {
        toggleWidgetElement(widgetId, visible);

        // Store configuration state
        let states = {};
        const storedStates = localStorage.getItem('mis_widget_states');
        if (storedStates) states = JSON.parse(storedStates);
        states[widgetId] = visible;
        localStorage.setItem('mis_widget_states', JSON.stringify(states));
    }

    function toggleWidgetElement(widgetId, visible) {
        const el = document.getElementById(widgetId);
        if (el) {
            if (visible) {
                el.classList.remove('d-none');
            } else {
                el.classList.add('d-none');
            }
        }
    }

    function resetLayout() {
        localStorage.removeItem('mis_starred_ids');
        localStorage.removeItem('mis_recent_ids');
        localStorage.removeItem('mis_widget_states');
        
        // Reset local variables
        starredIds = [1, 4, 8, 17, 23];
        recentlyVisitedIds = [1, 8, 17, 9, 23, 13];
        
        // Make all widgets visible
        const allWidgets = ['recent-visited-widget', 'applications-widget', 'financials-widget', 'health-widget', 'ai-widget', 'welcome-widget', 'solutions-widget'];
        allWidgets.forEach(w => toggleWidgetElement(w, true));

        // Re-render
        renderRecentlyVisited();
        renderFeatures();
        
        showToast("Dashboard widgets reset to default settings.");
    }

    // Render Recently Visited List
    function renderRecentlyVisited() {
        const container = document.getElementById('recent-list-container');
        if (!container) return;

        container.innerHTML = '';
        
        if (recentlyVisitedIds.length === 0) {
            container.innerHTML = '<div class="col-12 py-3 text-center text-muted fs-13px">No features visited yet. Start launching modules below!</div>';
            return;
        }

        const itemsToRender = initialModules.filter(m => recentlyVisitedIds.includes(m.id));
        
        // Maintain the order of recentlyVisitedIds
        itemsToRender.sort((a, b) => recentlyVisitedIds.indexOf(a.id) - recentlyVisitedIds.indexOf(b.id));

        itemsToRender.forEach(m => {
            const cardHtml = `
                <div class="col-6 col-md-4">
                    <a href="${m.link}" onclick="visitModule(${m.id})" class="recent-service-link border">
                        <div class="d-flex align-items-center gap-2 text-truncate">
                            <span class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                                <i class="fas ${m.icon} fs-16px"></i>
                            </span>
                            <span class="fw-700 fs-13px text-dark text-truncate">${m.name}</span>
                        </div>
                    </a>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', cardHtml);
        });
    }

    // Render All Features list
    function renderFeatures() {
        const grid = document.getElementById('features-grid');
        if (!grid) return;

        grid.innerHTML = '';

        // Filter and Search parameters
        const searchQuery = document.getElementById('searchFeatures').value.toLowerCase();
        const statusQuery = document.getElementById('statusFilter').value;

        // Apply filters
        let filtered = initialModules.filter(m => {
            // Category match
            const matchesCategory = currentCategory === 'all' || m.category === currentCategory;
            // Search match
            const matchesSearch = m.name.toLowerCase().includes(searchQuery) || m.desc.toLowerCase().includes(searchQuery);
            // Status match
            const matchesStatus = statusQuery === 'all' || m.status === statusQuery;

            return matchesCategory && matchesSearch && matchesStatus;
        });

        // Sort starred items to front, then name
        filtered.sort((a, b) => {
            const isAStarred = starredIds.includes(a.id);
            const isBStarred = starredIds.includes(b.id);
            if (isAStarred && !isBStarred) return -1;
            if (!isAStarred && isBStarred) return 1;
            return a.name.localeCompare(b.name);
        });

        // Update count summaries
        document.getElementById('modules-count').innerText = `(${filtered.length})`;
        document.getElementById('showing-summary').innerText = `Showing ${filtered.length} of 25 features`;

        if (filtered.length === 0) {
            grid.innerHTML = '<div class="col-12 py-5 text-center text-muted fs-14px"><i class="fas fa-search-minus fa-3x mb-3 text-muted text-opacity-50"></i><br>No modules match your filter settings.</div>';
            return;
        }

        filtered.forEach(m => {
            const isStarred = starredIds.includes(m.id);
            const statusClass = m.status === 'Active' ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning';
            
            const cardHtml = `
                <div class="col-12 col-md-6 col-xl-4 feature-item" data-category="${m.category}">
                    <div class="card feature-card h-100">
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <!-- Header: Icon + Star -->
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                            <i class="fas ${m.icon} fs-16px"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-800 text-dark mb-0 fs-13px">${m.name}</h6>
                                            <span class="badge badge-status ${statusClass}">${m.status}</span>
                                        </div>
                                    </div>
                                    <i class="fas fa-star fav-star ${isStarred ? 'active' : ''}" onclick="toggleStar(${m.id}, event)"></i>
                                </div>
                                <p class="text-muted fs-12px mb-3 line-clamp-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 36px;">
                                    ${m.desc}
                                </p>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="${m.link}" onclick="visitModule(${m.id})" class="btn btn-primary btn-sm flex-fill rounded-pill py-1 fs-11px text-center">Dashboard</a>
                                <a href="javascript:;" onclick="configureModule('${m.name}')" class="btn btn-outline-secondary btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                                    <i class="fas fa-cog"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            grid.insertAdjacentHTML('beforeend', cardHtml);
        });
    }

    function visitModule(id) {
        // Move to top of recently visited
        recentlyVisitedIds = recentlyVisitedIds.filter(x => x !== id);
        recentlyVisitedIds.unshift(id);
        
        // Cap at 6 items
        if (recentlyVisitedIds.length > 6) {
            recentlyVisitedIds = recentlyVisitedIds.slice(0, 6);
        }

        localStorage.setItem('mis_recent_ids', JSON.stringify(recentlyVisitedIds));
        renderRecentlyVisited();
    }

    function toggleStar(id, event) {
        event.stopPropagation();
        event.preventDefault();

        if (starredIds.includes(id)) {
            starredIds = starredIds.filter(x => x !== id);
        } else {
            starredIds.push(id);
        }

        localStorage.setItem('mis_starred_ids', JSON.stringify(starredIds));
        renderFeatures();
        showToast("Favorites checklist updated successfully.");
    }

    function clearRecentlyVisited() {
        recentlyVisitedIds = [];
        localStorage.setItem('mis_recent_ids', JSON.stringify(recentlyVisitedIds));
        renderRecentlyVisited();
        showToast("Visited services history cleared.");
    }

    function setCategory(category) {
        currentCategory = category;
        
        // Remove active class from all tabs
        const tabs = document.querySelectorAll('#category-tabs-container .nav-link');
        tabs.forEach(t => t.classList.remove('active'));

        // Add to current tab
        document.getElementById(`tab-${category}`).classList.add('active');

        renderFeatures();
    }

    function filterFeatures() {
        renderFeatures();
    }

    // ApexCharts Financial Setup
    function initRevenueChart() {
        const chartElement = document.querySelector("#revenue-chart");
        if (!chartElement) return;

        const options = {
            series: [{
                name: 'Dues Collected',
                data: [12400, 14900, 17800, 13900, 21500, 24800]
            }, {
                name: 'Ticket Sales',
                data: [4800, 8100, 11400, 6900, 14800, 18500]
            }, {
                name: 'Donations',
                data: [2900, 3900, 5800, 4900, 7800, 10200]
            }],
            chart: {
                type: 'bar',
                height: 250,
                stacked: true,
                toolbar: {
                    show: false
                },
                fontFamily: 'Inter, sans-serif'
            },
            colors: ['#6750A4', '#009688', '#FF9800'],
            plotOptions: {
                bar: {
                    horizontal: false,
                    borderRadius: 6
                },
            },
            xaxis: {
                categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                labels: {
                    style: {
                        colors: 'rgba(0,0,0,0.6)',
                        fontSize: '11px',
                        fontWeight: 500
                    }
                }
            },
            yaxis: {
                labels: {
                    style: {
                        colors: 'rgba(0,0,0,0.6)',
                        fontSize: '11px'
                    }
                }
            },
            fill: {
                opacity: 1
            },
            legend: {
                position: 'bottom',
                horizontalAlign: 'center',
                fontSize: '11px',
                labels: {
                    colors: 'rgba(0,0,0,0.7)'
                }
            },
            dataLabels: {
                enabled: false
            },
            tooltip: {
                theme: 'light',
                y: {
                    formatter: function (val) {
                        return "$" + val.toLocaleString();
                    }
                }
            }
        };

        const chart = new ApexCharts(chartElement, options);
        chart.render();
    }

    // Event Handler Placeholders for interactive UI alerts
    function configureModule(name) {
        showToast(`Configuration panel for [${name}] Area is opening...`);
    }

    function triggerCreateFeature() {
        showToast("Module initialization wizard launched.");
    }

    function runActionRecipe(recipeName) {
        showToast(`Action recipe [${recipeName}] launched successfully in dry run mode!`);
    }

    function openAIConfig() {
        showToast("BYOK AI billing configurations loaded.");
    }

    function openQuickGuide() {
        showToast("Onboarding wizard loaded.");
    }

    // Helper Toast notification simulator
    function showToast(message) {
        // Check if toast container exists, if not create one
        let container = document.getElementById('toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'position-fixed bottom-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
        }

        const toastId = 'toast_' + Date.now();
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-white bg-dark border-0 shadow-lg show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body fs-13px fw-500">
                        <i class="fas fa-check-circle text-success me-2"></i> ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', toastHtml);

        // Remove toast automatically after 3 seconds
        setTimeout(() => {
            const toastEl = document.getElementById(toastId);
            if (toastEl) {
                toastEl.classList.remove('show');
                setTimeout(() => toastEl.remove(), 300);
            }
        }, 3000);
    }
</script>
