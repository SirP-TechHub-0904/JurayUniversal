@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.ListModel
@{
    ViewData["Title"] = "User Directory";
    ViewData["Subtitle"] = "Overview and management of all records.";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "Users";
}



<div class="mis-page-header d-flex justify-content-between align-items-center">
    
    <div class="d-flex gap-2">
        
        @if (Model.EnableListDownload)
        {
            <!-- Action button can go here if needed -->
        }
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <!-- Filter Card -->
    <div class="card mis-card mis-filter-card">
        <div class="card-body mis-card-body">
            @Html.AntiForgeryToken()
            <form method="get" class="row gx-4 gy-3 align-items-end" id="filterForm">
                <div class="col-12 col-md-4">
                    <label class="mis-filter-label">Search User</label>
                    <input type="text" asp-for="SearchString" class="form-control mis-search-input" placeholder="Search by name or email...">
                </div>

                <div class="col-12 col-md-4">
                    <label class="mis-filter-label">@Model.CategoryAlias</label>
                    <select asp-for="CategoryId" class="form-select mis-select-input">
                        <option value="">All @(Model.CategoryAlias)s</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Title</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="mis-filter-label">Status Filter</label>
                    <select asp-for="Status" class="form-select mis-select-input" asp-items="Html.GetEnumSelectList<JurayUniversal.Domain.Enum.Enum.UserStatus>()">
                        <option value="">All Statuses</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Bulk Action Toolbar (Hidden by default) -->
    <div id="bulkActionToolbar" class="mis-bulk-toolbar d-none">
        <span class="me-auto fw-bold text-primary">
            <span id="selectedCount" class="badge bg-primary rounded-pill me-2 px-3 py-2">0</span> Selected
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-warning text-dark mis-submit-button" onclick="submitBulkAction('Suspend')">
                <i class="bi bi-pause-circle"></i> Suspend
            </button>
            <button class="btn btn-success mis-submit-button" onclick="submitBulkAction('Activate')">
                <i class="bi bi-play-circle"></i> Activate
            </button>
        </div>
    </div>

    @if (Model.EnableListDownload)
    {
        <!-- Export Dropdown (injected into DOM before DataTables renders, shown via JS) -->
        <div id="exportDropdownWrapper" class="d-none">
            <div class="dropdown">
                <button class="btn btn-light shadow-none border px-3 custom-ctrl-height dropdown-toggle"
                        type="button" id="exportDropdownBtn"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        style="border-color: #cbd5e1 !important; color: #1e293b; border-radius: 50px;">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <ul class="dropdown-menu shadow border-0 rounded-3" aria-labelledby="exportDropdownBtn">
                    <li>
                        <a class="dropdown-item py-2" href="#" onclick="triggerExport('excel'); return false;">
                            <i class="bi bi-file-earmark-excel text-success me-2"></i> Excel (.xlsx)
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" href="#" onclick="triggerExport('pdf'); return false;">
                            <i class="bi bi-file-earmark-pdf text-danger me-2"></i> PDF (.pdf)
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" href="#" onclick="triggerExport('word'); return false;">
                            <i class="bi bi-file-earmark-word text-primary me-2"></i> Word (.docx)
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    }

    <!-- User Directory List Card -->
    <div class="card mis-card mis-table-card">
        <div class="card-body mis-card-body">
            <div class="table-responsive">
                <table id="userDirectoryTable" class="table table-borderless align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th class="text-center mis-table-th" style="width: 50px;">
                                <div class="d-flex align-items-center justify-content-center">
                                    <input type="checkbox" class="form-check-input shadow-none m-0" id="selectAll">
                                    <label for="selectAll" class="mis-checkbox-label">all</label>
                                </div>
                            </th>
                            <th class="mis-table-th" style="width: 50px;">s/n</th>
                            <th class="mis-table-th">name & role <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                            <th class="mis-table-th">email / phone <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                            <th class="mis-table-th">@Model.CategoryAlias <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                            <th class="mis-table-th">status <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                            <!-- Optional / Generic Columns (Hidden by default via JS) -->
                            <th class="mis-table-th">date registered</th>
                            <th class="mis-table-th">date of birth</th>
                            <th class="mis-table-th">gender</th>
                            <th class="mis-table-th">nationality</th>
                            <th class="mis-table-th">position / rank</th>
                            <th class="text-center mis-table-th" style="width: 100px;">manage</th>
                        </tr>
                    </thead>
                    <tbody style="border-top: 0;">
                        <!-- Data will be populated by DataTables -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables Bootstrap 5 & Material UI Dependencies -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/select/1.7.0/css/select.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/1.7.0/css/colReorder.bootstrap5.min.css" />

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/select/1.7.0/js/dataTables.select.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/1.7.0/js/dataTables.colReorder.min.js"></script>

    <script>
        $(document).ready(function() {
            var selectedIds = new Set();
            
            var table = $('#userDirectoryTable').DataTable(getMisTableConfig({
                "ajax": {
                    "url": "?handler=Data",
                    "type": "POST",
                    "headers": {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    "data": function (d) {
                        d.SearchString = $('#SearchString').val();
                        d.CategoryId = $('#CategoryId').val();
                        d.Status = $('#Status').val();
                    }
                },
                "columns": [
                    { "data": "checkbox", "className": "text-center", "orderable": false },
                    { "data": "sn", "className": "text-muted", "orderable": false, "searchable": false },
                    { "data": "name" },
                    { "data": "contact" },
                    { "data": "category" },
                    { "data": "status" },
                    { "data": "dob", "className": "text-muted fs-13px" },
                    { "data": "dateRegistered", "className": "text-muted fs-13px" },
                    { "data": "gender", "className": "text-muted fs-13px" },
                    { "data": "nationality", "className": "text-muted fs-13px" },
                    { "data": "position", "className": "text-muted fs-13px" },
                    { "data": "manage", "className": "text-center", "orderable": false, "searchable": false }
                ],
                "order": [[2, "asc"]],
                "lengthMenu": [[10, 25, 50, 100, 300, -1], [10, 25, 50, 100, 300, "All"]],
                "pageLength": 10,
                "columnDefs": [
                    { "targets": [0, 6, 7, 8, 9, 10], "visible": false },
                    { "targets": [0, 11], "orderable": false }
                ],
                "buttons": {
                    buttons: [
                        {
                            text: '<i class="bi bi-check2-square me-1"></i> Multi Select',
                            className: 'btn btn-light shadow-none border px-3 custom-ctrl-height',
                            attr: {
                                style: 'color: #3b82f6; border-color: #cbd5e1 !important; border-radius: 50px;'
                            },
                            action: function ( e, dt, node, config ) {
                                var col = dt.column(0);
                                var isVisible = !col.visible();
                                col.visible(isVisible);
                                if (isVisible) {
                                    node.css('background-color', '#dbeafe'); // Highlight active
                                    node.css('font-weight', '600');
                                } else {
                                    node.css('background-color', ''); // Reset
                                    node.css('font-weight', 'normal');
                                    selectedIds.clear();
                                    $('.row-checkbox').prop('checked', false);
                                    $('#selectAll').prop('checked', false);
                                    updateBulkToolbar();
                                }
                            }
                        }
                    ]
                }
            }));

            // Handle Select All Checkbox
            $(document).on('change', '#selectAll', function() {
                var isChecked = $(this).is(':checked');
                
                if (isChecked) {
                    $('#selectAll').prop('disabled', true); // Temporarily disable while loading
                    var data = {
                        "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val(),
                        "SearchString": $('#SearchString').val(),
                        "CategoryId": $('#CategoryId').val(),
                        "Status": $('#Status').val(),
                        "search[value]": table.search()
                    };
                    
                    $.post('?handler=AllIds', data, function(ids) {
                        selectedIds = new Set(ids);
                        $('.row-checkbox').prop('checked', true);
                        updateBulkToolbar();
                        $('#selectAll').prop('disabled', false);
                    }).fail(function() {
                        $('#selectAll').prop('checked', false);
                        $('#selectAll').prop('disabled', false);
                        alert("Failed to select all records.");
                    });
                } else {
                    selectedIds.clear();
                    $('.row-checkbox').prop('checked', false);
                    updateBulkToolbar();
                }
            });

            // Handle individual row checkbox click
            $('#userDirectoryTable tbody').on('change', 'input[type="checkbox"]', function(){
                var id = $(this).val();
                if(this.checked){
                    selectedIds.add(id);
                } else {
                    selectedIds.delete(id);
                    var el = $('#selectAll').get(0);
                    if(el && el.checked && ('indeterminate' in el)){
                       el.indeterminate = true;
                    }
                }
                updateBulkToolbar();
            });

            // Re-bind click events for bulk toolbar on pagination redraws
            table.on('draw', function () {
                var isAllChecked = $('#selectAll').is(':checked');
                $('.row-checkbox').each(function() {
                    if (isAllChecked) {
                        $(this).prop('checked', true);
                        selectedIds.add($(this).val());
                    } else {
                        if (selectedIds.has($(this).val())) {
                            $(this).prop('checked', true);
                        }
                    }
                });
                updateBulkToolbar();
            });

            let searchTimeout = null;
            $('#SearchString').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    selectedIds.clear();
                    $('#selectAll').prop('checked', false);
                    updateBulkToolbar();
                    table.ajax.reload();
                }, 400);
            });

            $('#CategoryId, #Status').on('change', function() {
                selectedIds.clear();
                $('#selectAll').prop('checked', false);
                updateBulkToolbar();
                table.ajax.reload();
            });

            $('#filterForm').on('submit', function(e) {
                e.preventDefault(); // Prevent full page reload on Enter
            });

            function updateBulkToolbar() {
                // Count how many checkboxes are actually checked
                var selectedCount = selectedIds.size;
                if (selectedCount > 0) {
                    $('#bulkActionToolbar').removeClass('d-none').addClass('d-flex');
                    $('#selectedCount').text(selectedCount);
                } else {
                    $('#bulkActionToolbar').addClass('d-none').removeClass('d-flex');
                }
            }
            
            window.submitBulkAction = function(actionType) {
                var count = selectedIds.size;
                if (count === 0) return;
                
                var actionLabel = actionType === 'Suspend' ? 'Suspend' : 'Activate';
                if (!confirm('Are you sure you want to ' + actionLabel + ' ' + count + ' users?')) {
                    return;
                }
                
                var idArray = Array.from(selectedIds);
                
                // Disable toolbar buttons to prevent double submission
                $('#bulkActionToolbar button').prop('disabled', true);
                
                $.ajax({
                    url: '?handler=BulkAction',
                    type: 'POST',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: {
                        action: actionType,
                        ids: idArray
                    },
                    success: function (res) {
                        // Restore buttons
                        $('#bulkActionToolbar button').prop('disabled', false);
                        
                        // Clear selection
                        selectedIds.clear();
                        $('.row-checkbox').prop('checked', false);
                        $('#selectAll').prop('checked', false);
                        updateBulkToolbar();
                        
                        // Reload table
                        table.draw(false);
                    },
                    error: function () {
                        $('#bulkActionToolbar button').prop('disabled', false);
                        alert('An error occurred while performing the bulk action.');
                    }
                });
            };

            // â”€â”€ Column Name Map for Export â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            var columnNameMap = {
                0: 'checkbox',
                1: 'sn',
                2: 'name',
                3: 'contact',
                4: 'category',
                5: 'status',
                6: 'dob',
                7: 'datereg',
                8: 'gender',
                9: 'nationality',
                10: 'position',
                11: 'manage'
            };

            // Move Export dropdown into the DataTables button bar after init
            @if (Model.EnableListDownload)
            {
                <text>
                $('.dt-buttons').append($('#exportDropdownWrapper').html());
                $('#exportDropdownWrapper').remove();
                </text>
            }

            window.triggerExport = function(format) {
                var baseParams = {
                    handler: 'Export',
                    SearchString: $('#SearchString').val() || '',
                    CategoryId: $('#CategoryId').val() || '',
                    Status: $('#Status').val() || ''
                };
                triggerMisExport(table, format, baseParams, columnNameMap);
            };

        });
    </script>
}


