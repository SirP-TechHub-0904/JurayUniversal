@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context
@using System.Security.Claims
@inject Microsoft.AspNetCore.Identity.UserManager<JurayUniversal.Domain.Models.Profile> _userManager

@{
    var superSetting = _context.SuperSettings.FirstOrDefault();
    
    // Identity fields
    string userFullName = User.Identity?.Name ?? "User";
    string userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "user@example.com";
    string userInitials = string.IsNullOrEmpty(userFullName) ? "U" : userFullName.Substring(0, 1).ToUpper();

    var appUser = await _userManager.GetUserAsync(User);
    var userRoles = appUser != null ? await _userManager.GetRolesAsync(appUser) : new List<string>();

    var pendingNotifications = new List<JurayUniversal.Domain.Models.MisNotification>();
    if (appUser != null)
    {
        pendingNotifications = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(_context.MisNotifications.Where(n => n.UserId == appUser.Id && !n.IsRead).OrderByDescending(n => n.CreatedAt));
    }

    var hasAdminRole = User.IsInRole("Admin") || User.IsInRole("mSuperAdmin") || User.IsInRole("Administrator") || User.IsInRole("Editor");
    
    if (!hasAdminRole && appUser != null)
    {
        hasAdminRole = Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AnyAsync(_context.MisUserFeatureRoles, r => r.ProfileId == appUser.Id && r.IsActive).Result;
    }

    // Determine current sidebar context (User Platform vs Admin Dashboard)
    string currentPagePath = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isPlatform = currentPagePath.Contains("/Platform/") || currentPagePath.Contains("/User/");
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

	<partial name="~/Pages/Shared/Layouts/MIS/_MisHeadTitle.cshtml" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

	<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
	<!-- DataTables Stylesheets -->
	<link rel="stylesheet" href="~/dashboard/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
	<link rel="stylesheet" href="~/dashboard/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" />
	<link rel="stylesheet" href="~/dashboard/plugins/datatables-buttons/css/buttons.bootstrap4.min.css" />
	<script src="https://cdn.tailwindcss.com"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
	<link href="~/css/index-lz42kh8m.css" rel="stylesheet" />
	<link href="~/css/mis-design-bridge.css" rel="stylesheet" />

	<style>
		/* Global Typography - Space Grotesk Matching Live Site */
		html, body {
			font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
		}

		/* Force Identical Border Radius across All DataTables Export Buttons */
		div.dt-buttons,
		div.dt-buttons.btn-group,
		.dt-buttons.btn-group {
			display: flex !important;
			flex-wrap: wrap !important;
			gap: 6px !important;
		}

		div.dt-buttons .btn,
		div.dt-buttons.btn-group .btn,
		div.dt-buttons.btn-group > .btn,
		div.dt-buttons.btn-group > button,
		div.dt-buttons.btn-group > a,
		.dt-buttons .btn:not(:last-child),
		.dt-buttons .btn:not(:first-child),
		.dt-buttons.btn-group > .btn:not(:last-child):not(.dropdown-toggle),
		.dt-buttons.btn-group > .btn:not(:first-child),
		.btn-group > .btn:not(:last-child):not(.dropdown-toggle),
		.btn-group > .btn:not(:first-child),
		button.dt-button,
		div.dt-button,
		a.dt-button {
			background-color: #ffffff !important;
			background-image: none !important;
			color: #212529 !important;
			border: 1px solid #212529 !important;
			border-radius: 8px !important;
			border-top-left-radius: 8px !important;
			border-top-right-radius: 8px !important;
			border-bottom-left-radius: 8px !important;
			border-bottom-right-radius: 8px !important;
			border-start-start-radius: 8px !important;
			border-start-end-radius: 8px !important;
			border-end-start-radius: 8px !important;
			border-end-end-radius: 8px !important;
			padding: 6px 16px !important;
			font-size: 14px !important;
			font-weight: 500 !important;
			box-shadow: none !important;
			margin: 0 !important;
			float: none !important;
		}

		div.dt-buttons .btn:hover,
		div.dt-buttons.btn-group .btn:hover,
		button.dt-button:hover,
		div.dt-button:hover,
		a.dt-button:hover {
			background-color: #212529 !important;
			border-color: #212529 !important;
			color: #ffffff !important;
		}

		/* Offcanvas Drawer Hide Rule when Not Active */
		.offcanvas:not(.show) {
			display: none !important;
			visibility: hidden !important;
		}
	</style>

	<style>
		/* Scoped styles for the User Directory DataTable controls (only affects this table) */
		#userDirectoryTable_wrapper .dataTables_filter {
			gap: .5rem;
			display: flex;
			align-items: center;
			justify-content: flex-end;
		}

		#userDirectoryTable_wrapper .dataTables_filter label {
			display: flex;
			align-items: center;
			gap: .5rem;
			margin: 0;
		}

		#userDirectoryTable_wrapper .dataTables_filter .btn,
		#userDirectoryTable_wrapper .dataTables_filter input[type="search"] {
			border-color: #334155 !important;
			border-radius: 999px !important;
			box-shadow: none !important;
			height: 38px !important;
			background-clip: padding-box;
		}

		#userDirectoryTable_wrapper .dataTables_filter input[type="search"] {
			width: 280px;
			max-width: 40%;
			padding: .375rem .75rem;
		}

		#userDirectoryTable_wrapper .dataTables_filter .dropdown { display: inline-block; }

		@@media (max-width: 768px) {
			#userDirectoryTable_wrapper .dataTables_filter { flex-direction: column; align-items: flex-start; gap: .5rem; }
			#userDirectoryTable_wrapper .dataTables_filter input[type="search"] { width: 100%; max-width: 100%; }
		}
	</style>
	<link href="~/css/mis-datatables.css" rel="stylesheet">
	<link href="~/dashboard/plugins/summernote/summernote-lite.min.css" rel="stylesheet">
	<partial name="~/Pages/Shared/Layouts/MIS/_MisDashboardCSS.cshtml" />
</head>
<body class="bg-gray-50">
	<div id="root">
		<div class="min-h-screen flex flex-col">
			<!-- Topbar Layout Component for MisConfiguration -->
			<div id="topbar" class="fixed top-0 left-0 right-0 h-16 bg-white border-b border-gray-100 flex items-center justify-between z-50 px-4 lg:px-6">
				<div class="flex items-center space-x-3 lg:space-x-6">
					<a href="/MisConfiguration/Dashboard/Index" class="flex items-center space-x-3">
						<partial name="~/Pages/Shared/Layouts/MIS/_MisLogo.cshtml" />
						<span class="text-xs font-bold text-[#0069A1] bg-blue-50 px-2 py-1 rounded-md uppercase tracking-wider">CONFIG</span>
					</a>
				</div>
				<div class="flex items-center space-x-3 lg:space-x-4">
					<a asp-area="MisConfiguration" asp-page="/Dashboard/Index" class="hidden sm:inline-flex items-center px-3 py-1.5 text-xs font-semibold text-gray-700 hover:text-[#0069A1] hover:bg-gray-50 rounded-lg transition-colors">
						Dashboard
					</a>
					<a asp-area="MisConfiguration" asp-page="/Themes/Index" class="hidden sm:inline-flex items-center px-3 py-1.5 text-xs font-semibold text-gray-700 hover:text-[#0069A1] hover:bg-gray-50 rounded-lg transition-colors">
						Themes
					</a>
					<a href="/MIS/Dashboard/Index" class="inline-flex items-center px-3.5 py-2 text-xs font-semibold text-white bg-[#0069A1] hover:bg-[#005b8b] rounded-lg shadow-sm transition-colors">
						Return to Console
					</a>

					<!-- User Profile Dropdown Menu -->
					<div class="relative ms-2">
						<button id="profile-menu-btn" class="flex items-center space-x-2 p-1.5 rounded-lg hover:bg-gray-50 border border-transparent hover:border-gray-200 transition-all duration-200">
							<div class="w-8 h-8 bg-[#0069A1] rounded-full flex items-center justify-center shadow-sm">
								<span class="text-xs font-semibold text-white">@userInitials</span>
							</div>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" color="currentColor" class="text-gray-400">
								<path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
							</svg>
						</button>
						<div id="profile-menu-dropdown" class="absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-xl border border-gray-100 py-2 hidden z-50 transition-all duration-200">
							<div class="px-4 py-2.5 border-b border-gray-100 flex items-center space-x-3">
								<div class="w-9 h-9 bg-[#0069A1] rounded-full flex items-center justify-center text-white font-semibold text-sm shadow-sm">@userInitials</div>
								<div class="min-w-0 flex-1">
									<p class="text-sm font-semibold text-gray-900 leading-tight truncate">@userFullName</p>
									<p class="text-xs text-gray-500 truncate mt-0.5">@userEmail</p>
								</div>
							</div>
							<div class="py-1">
								<a asp-area="MIS" asp-page="/Dashboard/Index" class="flex items-center px-4 py-2 text-xs text-gray-700 hover:bg-gray-50 hover:text-[#0069A1] font-medium transition-colors">
									Admin Dashboard
								</a>
								<div class="border-t border-gray-100 my-1"></div>
								<form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
									<button type="submit" class="w-full text-left flex items-center px-4 py-2 text-xs text-red-600 hover:bg-red-50 font-medium transition-colors">
										Log Out
									</button>
								</form>
							</div>
						</div>
					</div>

				</div>
			</div>

			<!-- Main Content Container with Balanced Top, Bottom & Side Margins -->
			<main id="main-content" class="transition-all duration-300 main-content-scroll flex-1 mt-16 pt-8 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
				@if (ViewData["Title"] != null)
				{
					<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 gap-4">
						<div>
							<h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-1">@ViewData["Title"]</h1>
							@if (ViewData["Subtitle"] != null)
							{
								<p class="text-sm text-gray-600">@ViewData["Subtitle"]</p>
							}
						</div>
						<div class="flex items-center space-x-3">
							@{
								string currentRoutePage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
								bool isRootPage = currentRoutePage.Equals("/Dashboard/Index", StringComparison.OrdinalIgnoreCase);
							}
							@if (!isRootPage)
							{
								<a href="/MisConfiguration/Dashboard/Index" class="px-3.5 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors">
									Back to Dashboard
								</a>
							}
							<button type="button" data-bs-toggle="offcanvas" data-bs-target="#misHelpOffcanvas" class="px-3.5 py-2 text-sm font-medium text-[#0069A1] bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
								Help &amp; Guide
							</button>
							@RenderSection("HeaderActions", required: false)
						</div>
					</div>
				}

				@RenderBody()
			</main>
		</div>
	</div>

    <!-- Interactive User Manual Offcanvas -->
    <partial name="Layouts/MIS/_MisContextualHelp" />
    <partial name="Layouts/MIS/_MisScript" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>