@page "/Administrator/Account/Logout"
@model JurayUniversal.MisCentral.Areas.Administrator.Pages.Account.LogoutModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Logged Out - MIS Central";
}

<section class="min-h-[70vh] pt-36 pb-20 flex items-center justify-center bg-slate-900">
    <div class="text-center max-w-md mx-auto px-4">
        <div class="w-16 h-16 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mx-auto text-2xl mb-6 shadow-lg">
            <i class="bi bi-box-arrow-right"></i>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2">You Have Been Signed Out</h1>
        <p class="text-slate-400 text-sm mb-6">Your Central Master Session has been securely terminated.</p>
        <a href="/Administrator/Account/Login" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all shadow-lg shadow-blue-500/25">
            <i class="bi bi-shield-lock"></i> Sign In Again
        </a>
    </div>
</section>
