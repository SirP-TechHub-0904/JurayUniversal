@page
@model JurayUniversal.Website.Areas.MisNewsletter.Pages.Dashboard.Lists.IndexModel
@{
    ViewData["Title"] = "Mailing Lists";
    ViewData["Subtitle"] = "Overview and management of all records.";
    ViewData["ActiveMenu"] = "MisNewsletter";
    ViewData["ActiveSubMenu"] = "Lists";
}

@section HeaderActions {
    <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary rounded-pill fw-bold me-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
    <a asp-page="./Create" class="btn btn-primary rounded-pill fw-bold">
        <i class="bi bi-plus-circle me-1"></i> Create List
    </a>
}

<div class="page-heading">
    
</div>

<div class="page-content">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">List Name</th>
                            <th>Description</th>
                            <th>Subscribers</th>
                            <th>Created On</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var list in Model.Lists)
                        {
                            <tr>
                                <td class="ps-4">
                                    <h6 class="mb-0 fw-bold text-dark">@list.Name</h6>
                                </td>
                                <td><span class="text-muted fs-14px">@(list.Description ?? "No description")</span></td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill fs-13px">
                                        @(list.Contacts?.Count ?? 0) Contacts
                                    </span>
                                </td>
                                <td>@list.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end pe-4">
                                    <a asp-page="./Details" asp-route-id="@list.Id" class="btn btn-sm btn-outline-primary rounded-pill fw-bold me-2">
                                        <i class="bi bi-eye"></i> Manage Contacts
                                    </a>
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-light rounded-pill" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li>
                                                <a class="dropdown-item" asp-page="./Edit" asp-route-id="@list.Id">
                                                    <i class="bi bi-pencil me-2 text-primary"></i> Edit Details
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@list.Id" onsubmit="return confirm('Are you sure you want to delete this list and ALL its contacts? This cannot be undone.');">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i> Delete List
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                        
                        @if (!Model.Lists.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-3"></i>
                                    <h5>No Mailing Lists Found</h5>
                                    <p>Create a mailing list to start adding subscribers.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
