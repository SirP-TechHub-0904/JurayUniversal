@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Platform.IndexModel
@{
    ViewData["Title"] = "My Account Dashboard";
    ViewData["Subtitle"] = "High-level overview and analytics.";
    ViewData["ActiveMenu"] = "UserManagement";
}

<div class="page-heading d-flex justify-content-between align-items-center">
    <div>
        <h3>Account Directory</h3>
        <p class="text-subtitle text-muted">Manage your profile, view KPI performance logs, check access roles, and change password.</p>
    </div>
    
</div>

<div class="page-content">
    <div class="row mb-4">
        <div class="col-12">
            <partial name="~/Pages/Shared/Layouts/MIS/_DashboardWelcome.cshtml" />
        </div>
    </div>
    <div class="row">
        <!-- Welcome Card -->
        <div class="col-12 col-lg-4 mb-4">
            <div class="card shadow-sm border-0 text-center py-4 h-100">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    @if (!string.IsNullOrEmpty(Model.UserProfile.PassportFilePathUrl))
                    {
                        <img src="@Model.UserProfile.PassportFilePathUrl" class="rounded-circle border border-4 border-primary shadow mb-3" style="width: 110px; height: 110px; object-fit: cover;" alt="Avatar">
                    }
                    else
                    {
                        <div class="rounded-circle bg-light-primary text-primary d-flex align-items-center justify-content-center fw-bold shadow mb-3" style="width: 110px; height: 110px; font-size: 2.5rem;">
                            @((Model.UserProfile.FirstName?[0].ToString() ?? ""))
                        </div>
                    }
                    <h5 class="mb-1 text-dark fw-bold">@Model.UserProfile.GetFullName()</h5>
                    <p class="text-muted mb-0 fs-7">@Model.UserProfile.Email</p>
                </div>
            </div>
        </div>

        <!-- Action Cards Grid -->
        <div class="col-12 col-lg-8">
            <div class="row g-4">
                <div class="col-12 col-sm-6">
                    <div class="card shadow-sm border-0 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="bg-light-primary text-primary p-3 rounded-3 d-inline-block mb-3">
                                    <i class="bi bi-person-circle fs-4"></i>
                                </div>
                                <h5 class="text-dark fw-bold">My Profile</h5>
                                <p class="text-muted fs-7">View and update your personal details, contact address, and biological details.</p>
                            </div>
                            <a asp-page="/Platform/MyProfile" class="btn btn-outline-primary w-100 mt-3 rounded-pill">View Details</a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6">
                    <div class="card shadow-sm border-0 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="bg-light-success text-success p-3 rounded-3 d-inline-block mb-3">
                                    <i class="bi bi-activity fs-4"></i>
                                </div>
                                <h5 class="text-dark fw-bold">My KPI Scores</h5>
                                <p class="text-muted fs-7">Track your performance evaluations and remarks from evaluators over time.</p>
                            </div>
                            <a asp-page="/Platform/MyKpis" class="btn btn-outline-success w-100 mt-3 rounded-pill">Track Scores</a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6">
                    <div class="card shadow-sm border-0 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="bg-light-info text-info p-3 rounded-3 d-inline-block mb-3">
                                    <i class="bi bi-shield-lock-fill fs-4"></i>
                                </div>
                                <h5 class="text-dark fw-bold">My Access Roles</h5>
                                <p class="text-muted fs-7">Check which parts of the organization system you have authorization to edit or read.</p>
                            </div>
                            <a asp-page="/Platform/MyRoles" class="btn btn-outline-info w-100 mt-3 rounded-pill">Check Access</a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6">
                    <div class="card shadow-sm border-0 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="bg-light-danger text-danger p-3 rounded-3 d-inline-block mb-3">
                                    <i class="bi bi-key-fill fs-4"></i>
                                </div>
                                <h5 class="text-dark fw-bold">Change Password</h5>
                                <p class="text-muted fs-7">Change your login credentials or update password settings for security.</p>
                            </div>
                            <a asp-page="/Platform/ChangePassword" class="btn btn-outline-danger w-100 mt-3 rounded-pill">Change Password</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

