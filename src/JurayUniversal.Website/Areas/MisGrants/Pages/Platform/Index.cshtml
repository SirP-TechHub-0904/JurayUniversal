@page
@model JurayUniversal.Website.Areas.MisGrants.Pages.Platform.IndexModel
@{
    ViewData["Title"] = "Grant Ledger";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

<div class="container-fluid">

    <div class="row g-4 mb-5">
        @if (!Model.ActiveGrants.Any())
        {
            <div class="col-12">
                <div class="alert alert-light text-center py-5 border rounded-4 shadow-sm">
                    <i class="bi bi-briefcase display-4 text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No active grants at the moment.</h5>
                </div>
            </div>
        }
        
        @foreach (var grant in Model.ActiveGrants)
        {
            var totalReceived = grant.Milestones.Sum(m => m.AmountReceived ?? 0);
            var progress = grant.TotalAwardAmount > 0 ? (totalReceived / grant.TotalAwardAmount) * 100 : 0;
            
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@(grant.MisDonor?.Name ?? "Unknown Donor")</span>
                            <span class="text-muted small fw-600"><i class="bi bi-calendar me-1"></i> @grant.StartDate.ToString("MMM yyyy")</span>
                        </div>
                        
                        <h5 class="fw-bold mb-3">@grant.Title</h5>
                        
                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <div>
                                <small class="text-muted fw-600 d-block">Received</small>
                                <span class="fw-bold text-success fs-5">@grant.Currency @totalReceived.ToString("N0")</span>
                            </div>
                            <div class="text-end">
                                <small class="text-muted fw-600 d-block">Total Award</small>
                                <span class="fw-bold">@grant.Currency @grant.TotalAwardAmount.ToString("N0")</span>
                            </div>
                        </div>
                        
                        <div class="progress rounded-pill bg-light mb-4" style="height: 10px;">
                            <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">@grant.Milestones.Count(m => m.AmountReceived.HasValue) of @grant.Milestones.Count Milestones</span>
                            <a asp-page="./Details" asp-route-id="@grant.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
