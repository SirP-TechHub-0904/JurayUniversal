@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Leaves.IndexModel
@inject JurayUniversal.Website.Services.IMisAuthorizationService MisAuth
@{
    ViewData["Title"] = "Leaves & Excuses Management";
    ViewData["Subtitle"] = "Review all leave requests and excuses submitted by platform users.";
    ViewData["ActiveMenu"] = "Leaves";
    bool canEdit = await MisAuth.CanEditAsync(User, "MisUserManagement");
}
@using JurayUniversal.Domain.Enum
@using Humanizer

<div class="row">
    <div class="col-12">
        <div class="card premium-card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="leaves-table">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Type</th>
                                <th>Date Submitted</th>
                                <th>Period</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LeaveRequests.Any())
                            {
                                @foreach (var req in Model.LeaveRequests)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="ms-2">
                                                    <h6 class="mb-0 fw-bold">@req.User?.FullName</h6>
                                                    <span class="text-muted small">@req.User?.Email</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-600">@req.Type.Humanize()</span>
                                        </td>
                                        <td>@req.DateSubmitted.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            @req.StartDate.ToString("MMM dd, yyyy") 
                                            @if (req.EndDate.HasValue && req.EndDate.Value.Date != req.StartDate.Date)
                                            {
                                                <span> - @req.EndDate.Value.ToString("MMM dd, yyyy")</span>
                                            }
                                        </td>
                                        <td>
                                            @if (req.Status == JurayUniversal.Domain.Enum.Enum.LeaveRequestStatus.Approved)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">Approved</span>
                                            }
                                            else if (req.Status == JurayUniversal.Domain.Enum.Enum.LeaveRequestStatus.Denied)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill">Denied</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 rounded-pill">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <a asp-page="./Review" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary rounded-pill">Review</a>
                                            }
                                            else
                                            {
                                                <a asp-page="./Review" asp-route-id="@req.Id" class="btn btn-sm btn-outline-secondary rounded-pill">View Details</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="fas fa-file-alt fa-3x mb-3 text-muted text-opacity-25"></i>
                                            <h5>No Requests Found</h5>
                                            <p>There are no leave or excuse requests in the system.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
