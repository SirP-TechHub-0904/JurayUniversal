@page
@model JurayUniversal.Website.Areas.MisContent.Pages.IBlogs.Category.EditModel

@{
    ViewData["Title"] = "BLOG CATEGORY Edit";
    ViewData["BackUrl"] = "./Index";
    @if (User.Identity.IsAuthenticated && User.IsInRole("SubAdmin") || User.IsInRole("mSuperAdmin"))
    {
        

    }
    else
    {
        

    }
}

<div class="card card-default">
    
    <!-- /.card-header -->

    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="BlogCategory.Id" />
                    <div class="form-group mb-4">
                        <label asp-for="BlogCategory.Title" class="control-label"></label>
                        <input asp-for="BlogCategory.Title" class="form-control" />
                        <span asp-validation-for="BlogCategory.Title" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="BlogCategory.Publish" /> @Html.DisplayNameFor(model => model.BlogCategory.Publish)
                        </label>
                    </div>
                    <div class="form-group mb-4">
                        <input type="submit" value="Submit" class="btn btn-primary" />
                        

                    </div>
                </form>
            </div>
        </div>


        <!-- /.row -->
    </div>
    <!-- /.card-body -->
    <div class="card-footer">
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}




