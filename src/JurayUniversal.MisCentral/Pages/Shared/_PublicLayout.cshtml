@{
    var titleVal = ViewData["Title"]?.ToString();
    var fullTitle = !string.IsNullOrWhiteSpace(titleVal)
        ? $"{titleVal} | Exwhyzee MIS"
        : "Exwhyzee MIS | All-in-One Cloud Management Platform";
    var descVal = ViewData["MetaDescription"]?.ToString() 
        ?? "Exwhyzee MIS is an all-in-one cloud management software for schools, businesses, and organizations. Manage staff, payroll, accounts, student records, inventory, and operations with ease.";
    var keywordsVal = ViewData["MetaKeywords"]?.ToString() 
        ?? "Exwhyzee MIS, School Management System, Business ERP, Payroll Software, Hospital Management, Online Exam Software, Accounting Software, Nigeria ERP";
    var requestUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}";
    var ogImage = $"{baseUrl}/xyz-mis/assets/img/slider/slider_bg01.jpg";
}
<!doctype html>
<html class="no-js" lang="en" dir="ltr" prefix="og: https://ogp.me/ns#">

<head>
    <!-- Core Technical Meta Tags -->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">

    <!-- SEO & Indexing Directives -->
    <title>@fullTitle</title>
    <meta name="title" content="@fullTitle">
    <meta name="description" content="@descVal">
    <meta name="keywords" content="@keywordsVal">
    <meta name="author" content="Exwhyzee Technologies">
    <meta name="publisher" content="Exwhyzee MIS">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <link rel="canonical" href="@requestUrl">

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="Exwhyzee MIS">
    <meta property="og:url" content="@requestUrl">
    <meta property="og:title" content="@fullTitle">
    <meta property="og:description" content="@descVal">
    <meta property="og:image" content="@ogImage">
    <meta property="og:image:secure_url" content="@ogImage">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Exwhyzee MIS Management Platform">
    <meta property="og:image:type" content="image/jpeg">

    <!-- Twitter / X Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@@ExwhyzeeMIS">
    <meta name="twitter:creator" content="@@ExwhyzeeMIS">
    <meta name="twitter:url" content="@requestUrl">
    <meta name="twitter:title" content="@fullTitle">
    <meta name="twitter:description" content="@descVal">
    <meta name="twitter:image" content="@ogImage">
    <meta name="twitter:image:alt" content="Exwhyzee MIS Platform Preview">

    <!-- Mobile, PWA & UX Meta Tags -->
    <meta name="application-name" content="Exwhyzee MIS">
    <meta name="apple-mobile-web-app-title" content="Exwhyzee MIS">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0a1229">
    <meta name="msapplication-TileColor" content="#0a1229">
    <meta name="format-detection" content="telephone=no">
    <meta name="color-scheme" content="dark light">

    <!-- Favicon & Touch Icons -->
    <link rel="shortcut icon" type="image/x-icon" href="~/xyz-mis/assets/img/favicon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/xyz-mis/assets/img/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/xyz-mis/assets/img/favicon.png">

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "Organization",
          "@@id": "@baseUrl/#organization",
          "name": "Exwhyzee MIS Technologies",
          "url": "@baseUrl",
          "logo": {
            "@@type": "ImageObject",
            "url": "@baseUrl/xyz-mis/assets/img/logo/logo.svg"
          },
          "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+2348000000000",
            "contactType": "customer service",
            "email": "support@exwhyzee.ng",
            "areaServed": "Global",
            "availableLanguage": ["English"]
          }
        },
        {
          "@@type": "WebSite",
          "@@id": "@baseUrl/#website",
          "url": "@baseUrl",
          "name": "Exwhyzee MIS",
          "publisher": {
            "@@id": "@baseUrl/#organization"
          }
        },
        {
          "@@type": "SoftwareApplication",
          "name": "Exwhyzee MIS",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web-based",
          "offers": {
            "@@type": "AggregateOffer",
            "priceCurrency": "NGN",
            "lowPrice": "150000",
            "offerCount": "3"
          },
          "featureList": [
            "School & Student Management",
            "Human Resources & Payroll",
            "Accounting & Invoicing",
            "Online Computer-Based Exams",
            "Hospital & Clinic Operations",
            "Inventory & Asset Tracking"
          ]
        }
      ]
    }
    </script>

    @await RenderSectionAsync("Meta", required: false)

    <!-- XYZ MIS Stylesheets -->
    <link rel="stylesheet" href="~/xyz-mis/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/xyz-mis/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/xyz-mis/assets/css/default-icons.css">
    <link rel="stylesheet" href="~/xyz-mis/assets/css/default.css">
    <link rel="stylesheet" href="~/xyz-mis/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/xyz-mis/assets/css/sal.css">
    <link rel="stylesheet" href="~/xyz-mis/assets/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="~/xyz-mis/assets/css/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        html, body {
            overflow-x: hidden !important;
            max-width: 100vw;
            width: 100%;
            margin: 0;
            padding: 0;
        }

        .main-area, header, footer, section, .footer-area {
            max-width: 100%;
            width: 100%;
        }

        /* Enforce Proper Responsive Container Widths & Centering */
        .container, .custom-container {
            width: 100%;
            margin-left: auto !important;
            margin-right: auto !important;
            padding-left: 15px;
            padding-right: 15px;
        }

        .container {
            max-width: 1320px !important;
        }

        .custom-container {
            max-width: 1390px !important;
        }

        @@media (max-width: 1400px) {
            .container, .custom-container {
                max-width: 1140px !important;
            }
        }

        @@media (max-width: 1200px) {
            .container, .custom-container {
                max-width: 960px !important;
            }
        }

        @@media (max-width: 992px) {
            .container, .custom-container {
                max-width: 720px !important;
            }
        }

        @@media (max-width: 768px) {
            .container, .custom-container {
                max-width: 540px !important;
            }
        }

        @@media (max-width: 576px) {
            .container, .custom-container {
                max-width: 100% !important;
                padding-left: 12px;
                padding-right: 12px;
            }
        }

        /* Scroll Top Button: Float ABOVE WhatsApp Widget */
        .scroll__top {
            right: 24px !important;
            z-index: 9990 !important;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2) !important;
        }

        .scroll__top.open {
            bottom: 96px !important;
        }

        /* Floating Widgets & Footer Clearance */
        #whatsappWidgetWrap {
            bottom: 24px !important;
            right: 24px !important;
            z-index: 9995 !important;
        }

        #whatsappChatBox {
            position: fixed !important;
            bottom: 92px !important;
            right: 24px !important;
            z-index: 10000 !important;
        }

        #cookieConsentBanner {
            bottom: 28px !important;
            left: 24px !important;
            z-index: 9998 !important;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35) !important;
        }

        @@media (max-width: 768px) {
            .scroll__top.open {
                bottom: 84px !important;
                right: 18px !important;
            }

            #whatsappWidgetWrap {
                bottom: 18px !important;
                right: 18px !important;
            }

            #whatsappChatBox {
                bottom: 84px !important;
                right: 12px !important;
                left: 12px !important;
                width: auto !important;
            }

            #cookieConsentBanner {
                bottom: 86px !important;
                left: 12px !important;
                right: 12px !important;
                max-width: calc(100% - 24px) !important;
            }
        }

        /* Solid high-contrast Top Header Bar */
        .tg-header__top {
            background: #07132c !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            padding: 8px 0 !important;
            position: relative;
            z-index: 20;
        }

        .tg-header__top-menu .list-wrap li,
        .tg-header__top-menu .list-wrap li a {
            color: #e2e8f0 !important;
            font-size: 13px !important;
            font-weight: 500 !important;
        }

        .tg-header__top-menu .list-wrap li a:hover {
            color: #00d2ff !important;
        }

        .tg-header__top-menu .list-wrap li::before {
            background: rgba(255, 255, 255, 0.25) !important;
        }

        .tg-header__area {
            border: 1px solid transparent !important;
            box-shadow: none !important;
        }

        .tg-header__area.sticky-menu {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10) !important;
        }

        /* Header: logo left | menu centred | actions right */
        .tgmenu__nav {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            flex-wrap: nowrap !important;
            gap: 16px;
        }

        .tgmenu__nav .logo {
            flex: 0 0 auto;
            margin: 0 !important;
        }

        .tgmenu__nav .tgmenu__main-menu {
            flex: 1 1 auto;
            justify-content: center !important;
            margin: 0 !important;
        }

        .tgmenu__nav .tgmenu__main-menu .navigation {
            margin: 0 auto !important;
            justify-content: center;
        }

        .xyz-header-actions {
            flex: 0 0 auto;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        .xyz-btn-login,
        .xyz-btn-demo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 11px 22px;
            border-radius: 50px;
            font-size: 0.92rem;
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .xyz-btn-login {
            color: #1e40af;
            background: #ffffff;
            border: 1.5px solid #c7d2fe;
        }

        .xyz-btn-login:hover {
            color: #1d4ed8;
            border-color: #2563eb;
            background: #eff6ff;
        }

        .xyz-btn-demo {
            color: #ffffff;
            background: #2246ef;
            border: 1.5px solid #2246ef;
            box-shadow: 0 6px 16px rgba(34, 70, 239, 0.25);
        }

        .xyz-btn-demo:hover {
            color: #ffffff;
            background: #1a37c9;
            transform: translateY(-1px);
        }

        .tgmenu__nav .mobile-nav-toggler {
            flex: 0 0 auto;
            margin: 0 0 0 auto !important;
        }

        @@media (min-width: 1200px) {
            .tgmenu__nav .mobile-nav-toggler {
                display: none !important;
            }
        }

        /* Mobile drawer buttons on one row */
        .xyz-mobile-actions {
            display: flex;
            gap: 10px;
            padding: 20px 16px;
        }

        .xyz-mobile-actions a {
            flex: 1 1 0;
            padding: 12px 10px;
            font-size: 0.88rem;
        }

        .footer__bottom {
            padding-bottom: 50px !important;
        }

        .slider__area, .brand__area, .about__area, .counter__area, .services__area, .choose__area, .marquee__area, .testimonial__area, .contact__area, .footer-area {
            overflow-x: clip;
        }

        .exwhyzee-badge {
            background: linear-gradient(135deg, #0d6efd 0%, #00d2ff 100%);
            color: #fff;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!--Preloader-->
    <div id="preloader">
        <div class="loader"></div>
    </div>
    <!--Preloader-end -->

    <!-- Scroll-top -->
    <button class="scroll__top scroll-to-target" data-target="html">
        <svg width="22" height="21" viewBox="0 0 22 21" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 19.3848V0.999995M11 0.999995L1.80762 10.1924M11 0.999995L20.1924 10.1924" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>
    <!-- Scroll-top-end-->

    <!-- header-area -->
    <header class="transparent-header">
        <div class="tg-header__top">
            <div class="container custom-container">
                <div class="row align-items-center">
