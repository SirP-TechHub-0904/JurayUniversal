@page "{id:long}"
@model JurayUniversal.Website.Areas.MisTicketing.Pages.Dashboard.ManageModel
@{
    ViewData["Title"] = "Manage Event & Tickets";
    ViewData["Subtitle"] = "Overview and management of all records.";
}

<div class="container-fluid">

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Event Details Summary -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                @if (!string.IsNullOrEmpty(Model.MisEvent.BannerImageUrl))
                {
                    <img src="@Model.MisEvent.BannerImageUrl" class="card-img-top rounded-top-4" style="height: 150px; object-fit: cover;">
                }
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Event Details</h5>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill text-danger me-2"></i> @Model.MisEvent.Venue</li>
                        <li class="mb-2"><i class="bi bi-clock-fill text-primary me-2"></i> @Model.MisEvent.StartDate.ToString("f")</li>
                        <li>
                            <i class="bi bi-circle-fill text-success me-2" style="font-size: 8px;"></i> 
                            @(Model.MisEvent.IsActive ? "Active & Visible" : "Hidden")
                        </li>
                    </ul>
                </div>
            </div>
            
            <a asp-page="./Scan" asp-route-id="@Model.MisEvent.Id" class="btn btn-dark w-100 rounded-pill py-3 fw-bold shadow-sm">
                <i class="bi bi-qr-code-scan me-2"></i> Open Ticket Scanner
            </a>
        </div>

        <!-- Ticket Types -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Ticket Types</h5>
                        <button type="button" class="btn btn-primary rounded-pill btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addTicketModal">
                            <i class="bi bi-plus-lg me-1"></i> Add Tier
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tier Name</th>
                                    <th>Price (₦)</th>
                                    <th>Capacity</th>
                                    <th>Sold</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TicketTypes.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted fst-italic">
                                            No ticket types created yet. Click 'Add Tier' to create one.
                                        </td>
                                    </tr>
                                }
                                @foreach (var ticket in Model.TicketTypes)
                                {
                                    <tr>
                                        <td class="fw-bold">@ticket.Name</td>
                                        <td>
                                            @if (ticket.Price == 0)
                                            {
                                                <span class="badge bg-success">FREE</span>
                                            }
                                            else
                                            {
                                                @ticket.Price.ToString("N2")
                                            }
                                        </td>
                                        <td>@(ticket.TotalCapacity.HasValue ? ticket.TotalCapacity.Value.ToString() : "Unlimited")</td>
                                        <td>@ticket.SoldCount</td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DeleteTicket" class="d-inline">
                                                <input type="hidden" name="ticketId" value="@ticket.Id" />
                                                <input type="hidden" name="eventId" value="@Model.MisEvent.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this ticket type?');" @(ticket.SoldCount > 0 ? "disabled" : "")>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Ticket Modal -->
<div class="modal fade" id="addTicketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">New Ticket Tier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="AddTicket" asp-route-id="@Model.MisEvent.Id">
                <div class="modal-body p-4 pt-0">
                    <div class="mb-3">
                        <label asp-for="NewTicket.Name" class="form-label fw-semibold">Tier Name</label>
                        <input asp-for="NewTicket.Name" class="form-control" placeholder="e.g. VIP, Regular, Early Bird" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewTicket.Price" class="form-label fw-semibold">Price (₦)</label>
                        <input asp-for="NewTicket.Price" type="number" step="0.01" class="form-control" placeholder="0 for Free" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewTicket.TotalCapacity" class="form-label fw-semibold">Capacity (Optional)</label>
                        <input asp-for="NewTicket.TotalCapacity" type="number" class="form-control" placeholder="Leave blank for unlimited" />
                        <div class="form-text">Maximum number of this ticket type available.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewTicket.Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="NewTicket.Description" class="form-control" rows="2" placeholder="What does this ticket include?"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>
