@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.CommunityForms.IndexModel
@inject JurayUniversal.Website.Services.IMisAuthorizationService MisAuth
@{
    ViewData["Title"] = "Community Form Applications";
    ViewData["Subtitle"] = "Review, manage, and verify clan & community profile submissions.";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "CommunityForms";
    bool canEdit = await MisAuth.CanEditAsync(User, "MisUserManagement");
}

<div class="container-fluid px-0">
    <!-- Header Banner / Info -->
    <div class="card mb-4 border-0 shadow-sm rounded-4 bg-primary text-white" style="background: linear-gradient(135deg, #005280 0%, #0077b6 100%) !important;">
        <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-white"><i class="bi bi-ui-checks-grid me-2"></i>Community Profiling Applications (misCommunityForm)</h4>
                <p class="mb-0 text-white-50 small">Public link for applicants: <code class="bg-dark bg-opacity-25 text-white px-2 py-1 rounded">/CommunityForm</code></p>
            </div>
            <div class="d-flex gap-2">
                <a href="/CommunityForm" target="_blank" class="btn btn-light btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Public Form
                </a>
                <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3" onclick="copyPublicLink()">
                    <i class="bi bi-link-45deg me-1"></i> Copy URL
                </button>
            </div>
        </div>
    </div>

    <!-- Status Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <a asp-page="./Index" asp-route-StatusFilter="" class="card border-0 shadow-sm rounded-4 text-decoration-none @(string.IsNullOrEmpty(Model.StatusFilter) ? "border-primary border-2" : "")">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">All Applications</span>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalCount</h4>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                        <i class="bi bi-folder2-open fs-4"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-page="./Index" asp-route-StatusFilter="Pending" class="card border-0 shadow-sm rounded-4 text-decoration-none @(Model.StatusFilter == "Pending" ? "border-warning border-2" : "")">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Pending Review</span>
                        <h4 class="fw-bold mb-0 text-warning">@Model.PendingCount</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-page="./Index" asp-route-StatusFilter="Approved" class="card border-0 shadow-sm rounded-4 text-decoration-none @(Model.StatusFilter == "Approved" ? "border-success border-2" : "")">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Approved</span>
                        <h4 class="fw-bold mb-0 text-success">@Model.ApprovedCount</h4>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-page="./Index" asp-route-StatusFilter="Rejected" class="card border-0 shadow-sm rounded-4 text-decoration-none @(Model.StatusFilter == "Rejected" ? "border-danger border-2" : "")">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Rejected</span>
                        <h4 class="fw-bold mb-0 text-danger">@Model.RejectedCount</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card mb-4 border-0 shadow-sm rounded-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchString" value="@Model.SearchString" class="form-control bg-light border-0" placeholder="Search by name, phone, email, clan, ref..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="StatusFilter" class="form-select bg-light border-0">
                        <option value="">-- All Statuses --</option>
                        <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                        <option value="Approved" selected="@(Model.StatusFilter == "Approved")">Approved</option>
                        <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Rejected</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1">Filter</button>
                    @if (!string.IsNullOrEmpty(Model.SearchString) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                        <a asp-page="./Index" class="btn btn-light rounded-pill px-3" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Submissions Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Applicant</th>
                            <th>Clan &amp; Kindred</th>
                            <th>Contact</th>
                            <th>Expertise</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Submissions.Any())
                        {
                            @foreach (var sub in Model.Submissions)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(sub.PassportPhotoUrl))
                                            {
                                                <img src="@sub.PassportPhotoUrl" alt="" class="rounded-circle object-fit-cover" style="width: 42px; height: 42px;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px;">
                                                    @(string.IsNullOrEmpty(sub.FullName) ? "?" : sub.FullName.Substring(0, 1).ToUpper())
                                                </div>
                                            }
                                            <div>
                                                <a asp-page="./Details" asp-route-id="@sub.Id" class="fw-bold text-dark text-decoration-none d-block">
                                                    @sub.FullName
                                                </a>
                                                <span class="badge bg-light text-muted border font-monospace small">@(sub.ReferenceNumber ?? $"#CF-{sub.Id}")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@(sub.ClanName ?? "-")</div>
                                        <div class="small text-muted">@(sub.FamilyKindredName ?? "-")</div>
                                    </td>
                                    <td>
                                        <div class="small text-dark"><i class="bi bi-telephone me-1 text-muted"></i>@sub.PhoneNumber</div>
                                        @if (!string.IsNullOrEmpty(sub.Email))
                                        {
                                            <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@sub.Email</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="small text-truncate" style="max-width: 200px;" title="@sub.ExpertiseAreas">
                                            @(sub.ExpertiseAreas ?? sub.CurrentOccupation ?? "-")
                                        </div>
                                        @if (!string.IsNullOrEmpty(sub.WillingToOfferSkills))
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info small">Volunteer: @sub.WillingToOfferSkills</span>
                                        }
                                    </td>
                                    <td>
                                        @if (sub.Status == "Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill">Approved</span>
                                        }
                                        else if (sub.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-1 rounded-pill">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-muted">@sub.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="dropdown">
                                            <a asp-page="./Details" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                View Form
                                            </a>
                                            <button type="button" class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                <li><a asp-page="./Details" asp-route-id="@sub.Id" class="dropdown-item"><i class="bi bi-eye me-2 text-primary"></i>View Full Profile</a></li>
                                                @if (canEdit)
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    @if (sub.Status != "Approved")
                                                    {
                                                        <li>
                                                            <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@sub.Id" asp-route-status="Approved">
                                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i>Mark as Approved</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    @if (sub.Status != "Rejected")
                                                    {
                                                        <li>
                                                            <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@sub.Id" asp-route-status="Rejected">
                                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-2"></i>Mark as Rejected</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form method="post" asp-page-handler="Delete" asp-route-id="@sub.Id" onsubmit="return confirm('Are you sure you want to permanently delete this application record?');">
                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete Record</button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-clipboard2-x fs-1 text-muted text-opacity-50 mb-3 d-block"></i>
                                        <h6 class="fw-bold">No Applications Found</h6>
                                        <p class="small text-muted mb-3">There are no profiling applications matching the current criteria.</p>
                                        <a href="/CommunityForm" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="bi bi-plus-lg me-1"></i> Open Application Form
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyPublicLink() {
            var url = window.location.origin + "/CommunityForm";
            navigator.clipboard.writeText(url).then(function () {
                alert("Copied public form URL: " + url);
            });
        }
    </script>
}
