@page
@model JurayUniversal.Website.Areas.MisConfiguration.Pages.Dashboard.FileReconciliation.EditFileModel
@{
    ViewData["Title"] = "Edit S3 Key & URL Reference";
    ViewData["Subtitle"] = "Manually update the database file reference or override S3 location keys.";
}

<div class="container-fluid pt-2 pb-5 mb-8">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="d-flex align-items-center justify-content-between mb-3">
                <a asp-page="./Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to File Reconciliation
                </a>
            </div>

            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold text-slate-800 mb-0">
                        <i class="bi bi-pencil-square text-warning me-2"></i> Edit S3 Key & URL Reference
                    </h5>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>
                            Updating references for <strong>@Model.Entity #@Model.Id</strong> (<code>@Model.Property</code>).
                        </div>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Entity" />
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Property" />

                        <div class="form-group mb-4">
                            <label class="form-label fw-semibold">S3 Object Key <span class="text-danger">*</span></label>
                            <input asp-for="Key" class="form-control" placeholder="e.g. 7c9e6679-7425-40de-944b-e07f1f90ae2c.png" required />
                            <span class="text-xs text-muted">The exact unique identifier stored in your AWS S3 bucket.</span>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-semibold">Target File URL <span class="text-danger">*</span></label>
                            <textarea asp-for="Url" rows="4" class="form-control" placeholder="https://..." required></textarea>
                            <span class="text-xs text-muted">The full publicly accessible or pre-signed AWS S3 URL.</span>
                        </div>

                        <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                            <a asp-page="./Index" class="btn btn-light border rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-warning text-dark fw-semibold rounded-pill px-4">
                                <i class="bi bi-check2-circle me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
