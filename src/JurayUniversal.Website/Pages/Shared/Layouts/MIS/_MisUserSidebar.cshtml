@using JurayUniversal.Persistence.EF.SQL
@using JurayUniversal.Domain.Enum
@using Microsoft.AspNetCore.Identity
@inject DashboardDbContext _context
@inject UserManager<JurayUniversal.Domain.Models.Profile> UserManager
@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value?.ToLower() ?? "";
    var activeFeatures = _context.MisFeatures
        .Where(x => x.Status != JurayUniversal.Domain.Enum.Enum.FeatureBillingStatus.Disabled)
        .Select(x => x.ModuleFolder).ToList();
    var settings = _context.MisSettings.FirstOrDefault();
    string groupAlias = settings?.GroupAlias ?? "Committees & Groups";
    string alumniAlias = settings?.AlumniAlias ?? "Alumni";

    bool showUserMgmt    = activeFeatures.Contains("MisUserManagement");
    bool showCommittees  = activeFeatures.Contains("MisGroups");
    bool showAlumni      = activeFeatures.Contains("MisAlumni");
    bool showReports     = activeFeatures.Contains("MisReports");
    bool showForms       = activeFeatures.Contains("MisForms") || activeFeatures.Contains("MisSurveys");
    bool showManual      = activeFeatures.Contains("MisManual");
    bool showFinances    = activeFeatures.Contains("MisFinances");
    bool showTicketing   = activeFeatures.Contains("MisTicketing");
    bool showRecruitment = activeFeatures.Contains("MisRecruitment");
    bool showVoting      = activeFeatures.Contains("MisVoting");
    bool showAssets      = activeFeatures.Contains("MisFleet");
    var currentUserId    = UserManager.GetUserId(User);
    bool showProjects    = activeFeatures.Contains("MisProjects") && _context.MisProjectUsers.Any(x => x.UserId == currentUserId);
    bool showGrants      = activeFeatures.Contains("MisGrants");
    bool showProposals   = activeFeatures.Contains("MisProposals");
    bool showMassComm    = activeFeatures.Contains("MisMassComm");
    bool showNewsletter  = activeFeatures.Contains("MisNewsletter");

    string linkActive   = "flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent bg-[#0069A1] text-white border-[#0069A1]";
    string linkDefault  = "flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent text-gray-700 hover:bg-gray-50 hover:text-black hover:border-gray-200";
    string btnDefault   = "w-full flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent text-gray-700 hover:bg-gray-50 hover:text-black hover:border-gray-200";
    string btnActive    = "w-full flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent bg-[#0069A1] text-white border-[#0069A1]";
    string subLinkActive  = "flex items-center px-3 py-2 rounded-md transition-all duration-200 group border border-gray-200 text-sm bg-gray-100 text-black font-medium";
    string subLinkDefault = "flex items-center px-3 py-2 rounded-md transition-all duration-200 group border border-transparent text-sm text-gray-600 hover:bg-gray-50 hover:text-black hover:border-gray-100";

    bool isProfileSection = currentPath.Contains("/platform/my");
    bool isNewsletterSection = currentPath.Contains("/misnewsletter");
}

<!-- ── CORE & USER SPACE ──────────────────────────────────────── -->
<li class="pt-4 pb-1">
    <div class="px-3">
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Core &amp; User Space</h3>
    </div>
</li>

<li>
    <a asp-area="mis" asp-page="/Platform/Index"
       class="@(currentPath.EndsWith("/mis/platform/index") || currentPath.EndsWith("/mis/platform") ? linkActive : linkDefault)">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" color="currentColor" class="flex-shrink-0 transition-colors duration-200 @(currentPath.EndsWith("/mis/platform/index") || currentPath.EndsWith("/mis/platform") ? "text-white" : "text-gray-500 group-hover:text-gray-900")">
            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/>
            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
        </svg>
        <span class="ml-3 font-medium transition-all duration-200 whitespace-nowrap opacity-100">Platform Home</span>
    </a>
</li>

@if (showUserMgmt)
{
<li>
    <div class="relative">
        <button type="button" onclick="toggleSubMenu('sub-user-profile')"
                class="@(isProfileSection ? btnActive : btnDefault)">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" color="currentColor" class="flex-shrink-0 transition-colors duration-200 @(isProfileSection ? "text-white" : "text-gray-500 group-hover:text-gray-900")">
                <path d="M13 7C13 9.20914 11.2091 11 9 11C6.79086 11 5 9.20914 5 7C5 4.79086 6.79086 3 9 3C11.2091 3 13 4.79086 13 7Z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M11 14H7C4.23858 14 2 16.2386 2 19C2 20.1046 2.89543 21 4 21H14C16.1046 21 16 20.1046 16 19C16 16.2386 13.7614 14 11 14Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/>
            </svg>
            <span class="ml-3 font-medium transition-all duration-200 whitespace-nowrap opacity-100">My Profile &amp; Account</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" class="ml-auto transition-all duration-200 text-gray-400" id="caret-sub-user-profile">
                <path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
            </svg>
        </button>
        <ul id="sub-user-profile" class="border-l border-gray-200 ml-4 pl-3 space-y-1 mt-1 submenu-list @(isProfileSection ? "" : "hidden")">
            <li>
                <a asp-area="MisUserManagement" asp-page="/Platform/MyProfile"
                   class="@(currentPath.Contains("/myprofile") ? subLinkActive : subLinkDefault)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-2 text-gray-400 flex-shrink-0"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/></svg>
                    <span>My Profile Info</span>
                </a>
            </li>
            <li>
                <a asp-area="MisUserManagement" asp-page="/Platform/ChangePassword"
                   class="@(currentPath.Contains("/changepassword") ? subLinkActive : subLinkDefault)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-2 text-gray-400 flex-shrink-0"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z" stroke="currentColor" stroke-width="1.5"/></svg>
                    <span>Change Password &amp; 2FA</span>
                </a>
            </li>
            <li>
                <a asp-area="MisUserManagement" asp-page="/Platform/MyLeaves"
                   class="@(currentPath.Contains("/myleaves") ? subLinkActive : subLinkDefault)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-2 text-gray-400 flex-shrink-0"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5"/></svg>
                    <span>My Leave Requests</span>
                </a>
            </li>
            <li>
                <a asp-area="MisUserManagement" asp-page="/Platform/MyKpi"
                   class="@(currentPath.Contains("/mykpi") ? subLinkActive : subLinkDefault)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-2 text-gray-400 flex-shrink-0"><path d="M12 15l-2 5l-3-2l-3 2l1-5.5L1 10.5l5.5-.8L9 4.5l2.5 5.2l5.5.8l-4 4z" stroke="currentColor" stroke-width="1.5"/></svg>
                    <span>My Performance KPI</span>
                </a>
            </li>
        </ul>
    </div>
</li>
}

@if (showCommittees)
{
<li>
    <a asp-area="MisGroups" asp-page="/Platform/Index"
       class="@(currentPath.Contains("/misgroups/platform") ? linkActive : linkDefault)">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" color="currentColor" class="flex-shrink-0 transition-colors duration-200 @(currentPath.Contains("/misgroups/platform") ? "text-white" : "text-gray-500 group-hover:text-gray-900")">
            <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="ml-3 font-medium transition-all duration-200 whitespace-nowrap opacity-100">@groupAlias</span>
    </a>
</li>
}

