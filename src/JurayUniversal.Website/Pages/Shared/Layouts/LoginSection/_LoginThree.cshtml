<!DOCTYPE html>
<html lang="en">
<head>
    @await Component.InvokeAsync("WebTitle")
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Core Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    @await Component.InvokeAsync("LoginCSS")

    <style>
        /* THEME 3: NORDIC MINIMALIST CLEAN */
        * {
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        body, html {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-color: #f1f5f9;
            color: #0f172a;
        }
        .login-minimal-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 40px 15px 24px;
            background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
        }
        .login-minimal-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
            padding: 45px 40px;
            max-width: 450px;
            width: 100%;
            margin: auto;
        }
        @@media (max-width: 576px) {
            .login-minimal-card {
                padding: 30px 20px;
                border-radius: 18px;
            }
        }
        .login-minimal-card .form-control {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            color: #0f172a !important;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .login-minimal-card .form-control:focus {
            background: #ffffff;
            border-color: #0069A1;
            box-shadow: 0 0 0 4px rgba(0, 105, 161, 0.12);
        }
        .login-minimal-card label {
            color: #334155;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 6px;
        }
        .login-minimal-card .btn-primary {
            background: #0f172a;
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.2s ease;
        }
        .login-minimal-card .btn-primary:hover {
            background: #1e293b;
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.15);
        }
        .url-chip-minimal {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px 12px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #475569;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <div class="login-minimal-wrapper">
        <div class="text-center pt-2">
            <a href="/">
                @if (Model.SuperSetting.UseNormalLogoInLogin == true)
                {
                    <img src="@Model.SuperSetting.CompanyLogoUrl" alt="Logo" style="max-height: 55px;" />
                }
                else
                {
                    <img src="@Model.SuperSetting.CompanyWhiteLogoUrl" alt="Logo" style="max-height: 55px;" />
                }
            </a>
        </div>

        <div class="login-minimal-card my-auto">
            <div class="text-center mb-4">
                <h4 class="fw-bold text-dark mb-1" style="letter-spacing: -0.3px;">
                    @await Component.InvokeAsync("CompanyName")
                </h4>
                <p class="text-muted small mb-3">
                    @await Component.InvokeAsync("LoginNote")
                </p>
                <div class="url-chip-minimal">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>https://@await Component.InvokeAsync("CompanyUrl")</span>
                </div>
            </div>

            @RenderBody()
        </div>

        <div class="text-center py-3">
            <p class="text-muted small mb-0">
                @await Component.InvokeAsync("LoginNoteFooter")
            </p>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function myFunction() {
            var x = document.getElementById("myInput");
            if (x) {
                x.type = x.type === "password" ? "text" : "password";
            }
        }
    </script>
</body>
</html>