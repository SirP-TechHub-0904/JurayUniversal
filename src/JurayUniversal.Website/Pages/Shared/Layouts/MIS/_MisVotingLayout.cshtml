@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context
@using System.Security.Claims
@inject Microsoft.AspNetCore.Identity.UserManager<JurayUniversal.Domain.Models.Profile> _userManager

@{
    var dataConfig = _context.DataConfigs.FirstOrDefault();
    
    string userFullName = User.Identity?.Name ?? "Voter";
    string userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    string userInitials = string.IsNullOrEmpty(userFullName) ? "V" : userFullName.Substring(0, 1).ToUpper();
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

	<partial name="~/Pages/Shared/Layouts/MIS/_MisHeadTitle.cshtml" />
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<!-- ================== BEGIN core-css ================== -->
	<link href="~/layout/misasset/vendor.min.css" rel="stylesheet">
	<link href="~/layout/misasset/app.min.css" rel="stylesheet">
	<link rel="stylesheet" href="~/dashboard/plugins/toastr/toastr.min.css">
	<link rel="stylesheet" href="~/dashboard/plugins/sweetalert2-theme-bootstrap-4/bootstrap-4.min.css">
	<!-- ================== END core-css ================== -->

	<!-- FontAwesome, Bootstrap Icons, Material Design Icons and Google Fonts (Inter) -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@mdi/font@7.4.47/css/materialdesignicons.min.css">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

	<style>
		:root {
			/* Material Design 3 CSS Theme Variables */
			--md-primary: #4F46E5;
			--md-surface: #F9FAFB;
			--md-surface-container: #F3F4F6;
			--md-on-surface: #111827;
			--md-shadow-1: 0px 1px 3px 1px rgba(0, 0, 0, 0.15), 0px 1px 2px 0px rgba(0, 0, 0, 0.3);
			--md-shadow-2: 0px 2px 6px 2px rgba(0, 0, 0, 0.15), 0px 1.5px 3px 0px rgba(0, 0, 0, 0.3);
			--md-shadow-3: 0px 4px 8px 3px rgba(0, 0, 0, 0.15), 0px 1px 3px 0px rgba(0, 0, 0, 0.3);
		}

		/* Global Typography */
		body, .app, .form-control, .btn, .card, .dropdown-item, .table {
			font-family: 'Inter', sans-serif !important;
		}

		/* Material Design Cards & Widgets */
		.card {
			border: none !important;
			border-radius: 16px !important;
			box-shadow: var(--md-shadow-1) !important;
			transition: transform 0.22s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.22s cubic-bezier(0.2, 0, 0, 1) !important;
		}

		.btn:not(.btn-link) {
			border-radius: 100px !important; /* Material pill shape */
			padding: 0.5rem 1.5rem !important;
			font-weight: 500 !important;
			transition: background-color 0.15s, box-shadow 0.15s !important;
		}
		.btn:not(.btn-link):hover {
			box-shadow: var(--md-shadow-1) !important;
		}
		.form-control {
			border-radius: 8px !important;
			padding: 0.6rem 1rem !important;
			border: 1px solid rgba(0, 0, 0, 0.12) !important;
		}
        
        /* Inject the dynamic overrides from DataConfig */
        @if (dataConfig != null && !string.IsNullOrEmpty(dataConfig.ElectionCustomCss))
        {
            @Html.Raw(dataConfig.ElectionCustomCss)
        }
	</style>
	<link href="~/css/mis-datatables.css" rel="stylesheet">
	<link href="~/dashboard/plugins/summernote/summernote-lite.min.css" rel="stylesheet">
	<partial name="~/Pages/Shared/Layouts/MIS/_MisDashboardCSS.cshtml" />
    
    <!-- Include the base voting structure styles -->
    <link href="~/css/mis-voting.css" rel="stylesheet" />
</head>
<body class="pace-done voting-booth-app">
	<div class="pace pace-inactive">
		<div class="pace-progress" data-progress-text="100%" data-progress="99" style="transform: translate3d(100%, 0px, 0px);">
			<div class="pace-progress-inner"></div>
		</div>
		<div class="pace-activity"></div>
	</div>
	
	<!-- BEGIN #app -->
	<div id="app" class="app app-header-fixed app-without-sidebar">
		
        <!-- BEGIN #header -->
		<div id="header" class="app-header voting-header d-flex justify-content-between align-items-center">
			
			<!-- Left: Logo -->
			<div class="voting-brand-logo">
				<a href="~/" class="text-decoration-none">
					<partial name="~/Pages/Shared/Layouts/MIS/_MisLogo.cshtml" />
				</a>
			</div>
            
            <!-- Center: Secure Indicator -->
            <div class="secure-badge mx-auto d-none d-md-flex shadow-sm border border-success border-opacity-25">
                <i class="bi bi-shield-lock-fill fs-5"></i> Secure Voting Booth
            </div>

			<!-- Right: User Menu -->
			<div class="menu ms-auto">
				<div class="menu-item dropdown d-flex align-items-center">
					<a href="#" data-bs-toggle="dropdown" data-display="static" class="btn btn-light btn-sm rounded-pill d-flex align-items-center fw-bold text-dark border shadow-sm" aria-expanded="false" style="height: 38px; padding: 0.25rem 0.75rem 0.25rem 0.25rem;">
						<div class="me-2 d-flex align-items-center justify-content-center bg-primary text-white rounded-circle" style="width: 28px; height: 28px; font-size: 0.8rem;">
							@userInitials
						</div>
						<span class="fs-7">@userEmail</span>
                        <i class="fa fa-chevron-down ms-2 text-muted" style="font-size: 0.65rem;"></i>
					</a>
					<div class="dropdown-menu dropdown-menu-end mt-2 shadow-lg rounded-4 border-0 p-2">
                        <div class="px-3 py-2">
                            <span class="d-block text-muted small">Signed in as</span>
                            <strong class="d-block text-dark">@userFullName</strong>
                        </div>
						<div class="dropdown-divider"></div>
						<form class="m-0 p-0" asp-area="V2" asp-page="/AuthV2/Account/Logout" method="get">
							<button type="submit" class="dropdown-item d-flex align-items-center text-danger rounded-3 py-2">Leave Booth & Log Out <i class="fa fa-sign-out-alt fa-fw ms-auto text-danger text-opacity-50"></i></button>
						</form>
					</div>
				</div>
			</div>
		</div>
		<!-- END #header -->

  		<!-- BEGIN #content -->
  		<div id="content" class="app-content voting-content">
            @RenderBody()
  		</div>
		<!-- END #content -->
		
	</div>
	<!-- END #app -->

	<!-- ================== BEGIN core-js ================== -->
 	<script src="~/layout/misasset/vendor.min.js" type="text/javascript"></script>
	<script src="~/layout/misasset/app.min.js" type="text/javascript"></script>
	<!-- ================== END core-js ================== -->

    <partial name="Layouts/MIS/_MisScript" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
