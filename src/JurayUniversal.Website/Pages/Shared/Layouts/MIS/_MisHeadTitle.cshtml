@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context

@{
    var superSetting = _context.SuperSettings.FirstOrDefault();
    string title = ViewData["Title"]?.ToString();
    string uppercaseTitle = title?.ToUpper();
    var isUserPlatform = Context.Request.Path.Value?.Contains("/Platform/", StringComparison.OrdinalIgnoreCase) == true;
    string category = isUserPlatform ? "PLATFORM" : "DASHBOARD";
}

<title id="page-title-j">@uppercaseTitle | @category | @(superSetting?.CompanyName)</title>
<link rel="shortcut icon" href="@(!string.IsNullOrEmpty(superSetting?.CompanyIconUrl) ? superSetting.CompanyIconUrl : superSetting?.CompanyLogoUrl)" type="image/x-icon" />
<meta name="description" content="@(superSetting?.CompanyDescription ?? "")">
<meta name="author" content="@(superSetting?.CompanyName ?? "")">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">