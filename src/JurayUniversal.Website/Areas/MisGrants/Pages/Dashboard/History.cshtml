@page
@model JurayUniversal.Website.Areas.MisGrants.Pages.Dashboard.HistoryModel
@{
    ViewData["Title"] = "Grant History";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

@section HeaderActions {
    <a asp-page="./Manage" class="btn btn-primary d-flex align-items-center rounded-pill px-4 py-2 fw-600 shadow-sm" style="transition: all 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                <i class="bi bi-plus-lg me-2"></i> New Grant
            </a>
}

<div class="container-fluid">

    <!-- Grants Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="grantsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Donor</th>
                            <th>Total Award</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Grants.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-4 d-block mb-3 opacity-50"></i>
                                    No grants recorded yet.
                                </td>
                            </tr>
                        }
                        @foreach (var grant in Model.Grants)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@grant.Title</div>
                                    <div class="small text-muted">@grant.Milestones.Count milestones</div>
                                </td>
                                <td>
                                    <div class="fw-600">@(grant.MisDonor?.Name ?? "Unknown Donor")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-success">@grant.Currency @grant.TotalAwardAmount.ToString("N2")</div>
                                    <div class="small text-muted">@grant.Milestones.Sum(m => m.AmountReceived ?? 0).ToString("N2") Received</div>
                                </td>
                                <td>
                                    <div>@grant.StartDate.ToString("MMM yyyy") - @(grant.EndDate.HasValue ? grant.EndDate.Value.ToString("MMM yyyy") : "Ongoing")</div>
                                </td>
                                <td>
                                    @if (grant.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Closed</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group">
                                        <a asp-page="./Details" asp-route-id="@grant.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-page="./Manage" asp-route-id="@grant.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#grantsTable tbody tr').length > 0 && !$('#grantsTable tbody tr td').hasClass('dataTables_empty')) {
                $('#grantsTable').DataTable({
                    "pageLength": 25,
                    "language": {
                        "search": "",
                        "searchPlaceholder": "Search grants..."
                    },
                    "dom": "<'row mb-3'<'col-sm-12 col-md-6 d-flex align-items-center'f><'col-sm-12 col-md-6 d-flex justify-content-end'B>>" +
                           "<'row'<'col-sm-12'tr>>" +
                           "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                    "buttons": ['csv', 'excel', 'pdf']
                });
            }
        });
    </script>
}
