    <!-- WhatsApp & Cookie Consent Scripts -->
    <script>
        const WA_PHONE = "2348165680904";

        function toggleWhatsAppChat() {
            const box = document.getElementById("whatsappChatBox");
            if (box.style.display === "none" || !box.style.display) {
                box.style.display = "block";
            } else {
                box.style.display = "none";
            }
        }

        function sendWhatsAppTemplate(text) {
            const url = "https://wa.me/" + WA_PHONE + "?text=" + encodeURIComponent(text);
            window.open(url, "_blank");
        }

        function sendCustomWhatsApp() {
            const input = document.getElementById("whatsappCustomInput");
            const text = input.value.trim() || "Hello Exwhyzee MIS, I would like to inquire about your platform.";
            sendWhatsAppTemplate(text);
            input.value = "";
        }

        // Cookie Consent Logic
        document.addEventListener("DOMContentLoaded", function () {
            const consent = localStorage.getItem("exwhyzee_cookie_consent");
            if (!consent) {
                setTimeout(function () {
                    const banner = document.getElementById("cookieConsentBanner");
                    if (banner) banner.style.display = "block";
                }, 1500);
            }
        });

        function acceptAllCookies() {
            localStorage.setItem("exwhyzee_cookie_consent", "all");
            document.getElementById("cookieConsentBanner").style.display = "none";
        }

        function acceptEssentialCookies() {
            localStorage.setItem("exwhyzee_cookie_consent", "essential");
            document.getElementById("cookieConsentBanner").style.display = "none";
        }

        function showCookieModal() {
            const banner = document.getElementById("cookieConsentBanner");
            if (banner) banner.style.display = "block";
        }

        function resetCookieConsent() {
            localStorage.removeItem("exwhyzee_cookie_consent");
            showCookieModal();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
