@page
@model JurayUniversal.Website.Areas.MisTicketing.Pages.Dashboard.CreateModel
@{
    ViewData["Title"] = "Create New Event";
    ViewData["Subtitle"] = "Fill out the form below to add a new record.";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0 rounded-4 max-w-700 mx-auto">
        <div class="card-header bg-transparent border-bottom p-4">
            <h5 class="mb-0 fw-bold">Event Details</h5>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="MisEvent.Title" class="form-label fw-bold"></label>
                    <input asp-for="MisEvent.Title" class="form-control" placeholder="e.g. Annual Tech Conference" />
                    <span asp-validation-for="MisEvent.Title" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MisEvent.Venue" class="form-label fw-bold"></label>
                    <input asp-for="MisEvent.Venue" class="form-control" placeholder="e.g. Main Auditorium" />
                    <span asp-validation-for="MisEvent.Venue" class="text-danger"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="MisEvent.StartDate" class="form-label fw-bold"></label>
                        <input asp-for="MisEvent.StartDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="MisEvent.StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MisEvent.EndDate" class="form-label fw-bold"></label>
                        <input asp-for="MisEvent.EndDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="MisEvent.EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="MisEvent.Description" class="form-label fw-bold"></label>
                    <textarea asp-for="MisEvent.Description" class="form-control" rows="4" placeholder="Briefly describe what the event is about..."></textarea>
                    <span asp-validation-for="MisEvent.Description" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="MisEvent.IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="MisEvent.IsActive" class="form-check-label fw-semibold">Publish Event Immediately</label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-page="./Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">
                        <i class="bi bi-save me-1"></i> Save & Continue
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
