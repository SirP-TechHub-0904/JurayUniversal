@page
@model JurayUniversal.Website.Areas.MisAuth.Pages.Auth.MisEnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
 }

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 800px;">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-qr-code-scan fs-3"></i>
                </div>
                <h3 class="fw-800 text-dark mb-0">@ViewData["Title"]</h3>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />
            
            <p class="text-muted mb-4 fs-15px">To use an authenticator app, go through the following steps:</p>
            
            <ol class="list-group list-group-numbered list-group-flush mb-4 rounded-4 shadow-sm border">
                <li class="list-group-item p-4 border-bottom">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold mb-2">Download an Authenticator App</div>
                        <p class="mb-0 text-muted fs-14px">
                            Download a two-factor authenticator app like Google Authenticator for
                            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" class="text-decoration-none fw-600" target="_blank">Android <i class="bi bi-box-arrow-up-right fs-12px"></i></a> or
                            <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" class="text-decoration-none fw-600" target="_blank">iOS <i class="bi bi-box-arrow-up-right fs-12px"></i></a>.
                        </p>
                    </div>
                </li>
                <li class="list-group-item p-4 border-bottom bg-light">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold mb-3">Scan the QR Code</div>
                        <p class="text-muted fs-14px mb-3">Scan the QR Code below or manually enter this key into your authenticator app. Spaces and casing do not matter.</p>
                        
                        <div class="d-flex align-items-center mb-4">
                            <kbd class="px-3 py-2 fs-5 bg-dark rounded-pill shadow-sm me-3">@Model.SharedKey</kbd>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2"><i class="bi bi-key-fill me-1"></i> Setup Key</span>
                        </div>
                        
                        <div class="bg-white p-3 rounded-4 shadow-sm d-inline-block border">
                            <input id="text" type="hidden" value="@Html.Raw(Model.AuthenticatorUri)" />
                            <div id="qrCode"></div>
                        </div>
                    </div>
                </li>
                <li class="list-group-item p-4">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold mb-3">Verify the Code</div>
                        <p class="text-muted fs-14px mb-3">
                            Once you have scanned the QR code or input the key above, your app will provide you with a unique code. Enter that code in the confirmation box below.
                        </p>
                        
                        <div class="row">
                            <div class="col-md-8 col-lg-6">
                                <form method="post" class="bg-white p-4 rounded-4 shadow-sm border border-primary border-opacity-10">
                                    <div class="form-group mb-3">
                                        <label asp-for="Input.Code" class="form-label fw-600 text-dark">Verification Code</label>
                                        <input asp-for="Input.Code" class="form-control form-control-lg bg-light border-0" autocomplete="off" placeholder="e.g. 123456" />
                                        <span asp-validation-for="Input.Code" class="text-danger fs-13px mt-1 d-block"></span>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-700 shadow-sm">Verify & Enable 2FA</button>
                                    <div asp-validation-summary="ModelOnly" class="text-danger mt-2 fs-14px"></div>
                                </form>
                            </div>
                        </div>
                    </div>
                </li>
            </ol>
            
            <div class="mt-4">
                <a asp-page="./MisTwoFactorAuthentication" class="text-decoration-none text-muted fw-600"><i class="bi bi-arrow-left me-1"></i> Back to 2FA Settings</a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcodejs/qrcode.js"></script>
    <script type="text/javascript">

        new QRCode(document.getElementById("qrCode"),
            { text: "@Html.Raw(Model.AuthenticatorUri)", width: 200, height: 200 });
    </script>
    @*<script type="text/javascript" src="~/qr/jquery.min.js"></script>*@
    <script src="~/dashboard/jquery.min.js"></script>

    <script type="text/javascript" src="~/qr/qrcode.js"></script>

    <script type="text/javascript">
        var qrcode = new QRCode(document.getElementById("qrcode"), {
            width: 100,
            height: 100
        });

        function makeCode() {
            var elText = document.getElementById("text");

            qrcode.makeCode(elText.value);
        }

        makeCode();

        $("#text").
            on("blur", function () {
                makeCode();
            }).
            on("keydown", function (e) {
                if (e.keyCode == 13) {
                    makeCode();
                }
            });
    </script>
}
