@page
@model JurayUniversal.Web.Areas.Staff.Pages.Dashboard.UserAttendanceModel

@{
    ViewData["Title"] = "UserAttendance";
}

<style>
    .input-group-sm > .custom-select, .input-group-sm > .form-control:not(textarea) {
        height: auto;
    }
   


</style>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h6 class="card-title">MY ATTENDANCE FOR THE WEEK</h6>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <div>
                            <div class="">
                                <div class="row align-items-center mb-3">

                                    <!-- Week Title -->
                                    <div class="col-md-2">
                                        <h6 class="mb-0 fw-bold">@Model.Title</h6>
                                    </div>

                                    <!-- Date Search -->
                                    <div class="col-md-4">
                                        <form method="get">
                                            <div class="input-group input-group-sm">
                                                <input type="date" name="searchdate" class="form-control" placeholder="@TempData["date"]">
                                                <button type="submit" class="btn btn-success">Search</button>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Prev Week -->
                                    <div class="col-md-3 text-end">
                                        <a asp-page="./UserAttendance"
                                           asp-route-searchdate="@Model.PreviousWeek"
                                           class="btn btn-success w-100">
                                            @Model.PreviousWeekTitle
                                        </a>
                                    </div>

                                    <!-- Next Week -->
                                    <div class="col-md-3 text-end">
                                        <a asp-page="./UserAttendance"
                                           asp-route-searchdate="@Model.NextWeek"
                                           class="btn btn-success w-100">
                                            @Model.NextWeekTitle
                                        </a>
                                    </div>

                                </div>
                                <div class="table-responsive">
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>S/N</th>
                                                <th>DAY/DATE</th>

                                                <th>ARRIVAL</th>
                                                <th>CLOSE</th>
                                                <th>STATUS</th>

                                            </tr>
                                        </thead>
                                        @{
                                            int sn = 0;
                                        }

                                        <tbody>
                                            @foreach (var item in Model.Attendance)
                                            {
                                                <tr>

                                                    <td>
                                                        @{
                                                            sn++;
                                                        }
                                                        @sn
                                                    </td>
                                                    <td>
                                                        <a asp-page="./AttendanceInfo" asp-route-id="@item.Id">
                                                            @item.Date.Date.ToString("ddd dd MMM, yyyy")
                                                        </a>
                                                    </td>

                                                    <td>
                                                        @if (item.StartTime != null)
                                                        {
                                                            @item.StartTime.Value.ToString("hh:mm tt")
                                                            <span class="btn btn-success btn-xs">
                                                                @Html.DisplayFor(modelItem => item.ArivalPeriodStatus)
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (item.CloseTime != null)
                                                        {
                                                            @item.CloseTime.Value.ToString("hh:mm tt")
                                                            <span class="btn btn-success btn-xs">
                                                                @Html.DisplayFor(modelItem => item.ClosePeriodStatus)
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.AttendanceStatus)
                                                    </td>

                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>


                        </div>

                    </div>


                </div>
            </div>
        </div>
    </div>


</div>
