@page
@model JurayUniversal.MisCentral.Pages.FeaturePricingModel
@{
    Layout = "~/Pages/Shared/Layouts/_MisMasterLayout.cshtml";
    ViewData["Title"] = "Feature Pricing & Duration Adjuster";
    ViewData["Subtitle"] = "Global & Instance-Specific Billing Management";
}

<div class="container-fluid p-0">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-sm" role="alert">
            <i class="fa fa-check-circle me-2"></i> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FEATURE PRICING TABLE BY WEBSITE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
            <div>
                <h6 class="fw-bold mb-0">Feature Pricing Ledger</h6>
                <small class="text-muted">Adjust pricing and billing duration per instance or globally</small>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Website Portal</th>
                            <th>Feature Name</th>
                            <th>Module Key</th>
                            <th>Current Cost (₦)</th>
                            <th>Billing Frequency</th>
                            <th>Grace Period</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in Model.Summary.Tenants)
                        {
                            @foreach (var feature in tenant.Features)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@tenant.PrimaryDomain</strong>
                                        <div class="small text-muted">@tenant.CatalogName</div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@feature.FeatureName</span>
                                    </td>
                                    <td>
                                        <code>@feature.ModuleFolder</code>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">₦@feature.CostPerDuration.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@feature.BillingDuration</span>
                                    </td>
                                    <td>
                                        @feature.GracePeriodDays Days
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editModal-@feature.Id-@tenant.CatalogName.Replace(" ", "_")">
                                            <i class="fa fa-edit me-1"></i> Edit Pricing
                                        </button>

                                        <!-- MODAL EDIT FEATURE PRICING -->
                                        <div class="modal fade text-start" id="editModal-@feature.Id-@tenant.CatalogName.Replace(" ", "_")" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="post" asp-page-handler="UpdateInstanceFeature">
                                                        <input type="hidden" name="connectionString" value="@tenant.ConnectionString" />
                                                        <input type="hidden" name="featureId" value="@feature.Id" />
                                                        
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">Edit Pricing: @feature.FeatureName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label font-bold">Portal Instance</label>
                                                                <input type="text" class="form-control" value="@tenant.PrimaryDomain (@tenant.CatalogName)" readonly />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label font-bold">Cost Per Duration (₦)</label>
                                                                <input type="number" step="0.01" name="costPerDuration" class="form-control" value="@feature.CostPerDuration" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label font-bold">Billing Duration</label>
                                                                <select name="billingDuration" class="form-select">
                                                                    <option value="0" selected="@(feature.BillingDuration == JurayUniversal.Domain.Enum.Enum.FeatureBillingDuration.Monthly)">Monthly</option>
                                                                    <option value="1" selected="@(feature.BillingDuration == JurayUniversal.Domain.Enum.Enum.FeatureBillingDuration.Yearly)">Yearly</option>
                                                                    <option value="2" selected="@(feature.BillingDuration == JurayUniversal.Domain.Enum.Enum.FeatureBillingDuration.OneTime)">OneTime</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label font-bold">Grace Period (Days)</label>
                                                                <input type="number" name="gracePeriodDays" class="form-control" value="@feature.GracePeriodDays" required />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
