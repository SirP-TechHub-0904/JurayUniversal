                                                    <div class="icon-count-2">
                                                        <div class="icon-xld inline-icon m-b30 scale-in-center">
                                                            <span class="icon-cell sx-text-primary"><i class="@list.IconText"></i></span>
                                                        </div>
                                                        <div class="icon-content">

                                                            <h4 class="sx-tilte">@list.Title</h4>
                                                            <p>
