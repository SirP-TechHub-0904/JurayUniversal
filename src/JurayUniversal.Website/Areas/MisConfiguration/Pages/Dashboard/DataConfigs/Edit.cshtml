@page
@model JurayUniversal.Website.Areas.MisConfiguration.Pages.Dashboard.DataConfigs.EditModel

@{
    ViewData["Title"] = "Edit Data & System Configuration";
    ViewData["Subtitle"] = "Update global stylesheet injections, mail server settings, and system redirects.";
    Layout = "~/Pages/Shared/Layouts/MIS/_MisConfigLayout.cshtml";
}

@section HeaderActions {
    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Details
    </a>
}

<form method="post" class="container-fluid p-0">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="DataConfig.Id" />

    <div class="row g-4">
        <!-- 1. STYLESHEET & JAVASCRIPT INJECTIONS -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-code-slash text-primary me-2"></i> Custom Stylesheets &amp; JavaScript Injections</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label asp-for="DataConfig.DashboardCSS" class="fw-bold text-dark fs-13px mb-2">MIS Dashboard CSS</label>
                                <textarea asp-for="DataConfig.DashboardCSS" class="form-control font-monospace" rows="8" placeholder="/* Custom CSS for MIS Admin Dashboard */"></textarea>
                                <span asp-validation-for="DataConfig.DashboardCSS" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label asp-for="DataConfig.LayoutCSS" class="fw-bold text-dark fs-13px mb-2">Public Website Layout CSS</label>
                                <textarea asp-for="DataConfig.LayoutCSS" class="form-control font-monospace" rows="8" placeholder="/* Custom CSS for Public Website Layout */"></textarea>
                                <span asp-validation-for="DataConfig.LayoutCSS" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label asp-for="DataConfig.LoginCSS" class="fw-bold text-dark fs-13px mb-2">Auth &amp; Login Custom CSS</label>
                                <textarea asp-for="DataConfig.LoginCSS" class="form-control font-monospace" rows="8" placeholder="/* Custom CSS for Login & Register Pages */"></textarea>
                                <span asp-validation-for="DataConfig.LoginCSS" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label asp-for="DataConfig.LayoutJavaScript" class="fw-bold text-dark fs-13px mb-2">Public Website Layout JavaScript</label>
                                <textarea asp-for="DataConfig.LayoutJavaScript" class="form-control font-monospace" rows="8" placeholder="// Custom JavaScript for Layout"></textarea>
                                <span asp-validation-for="DataConfig.LayoutJavaScript" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. SYSTEM SWITCHES & REDIRECTS -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-toggles text-info me-2"></i> System &amp; SSL Redirection Settings</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 d-flex align-items-center justify-content-between ps-4">
                                <label class="form-check-label fw-semibold text-dark fs-13px" for="redirectWww">Redirect to HTTPS WWW</label>
                                <input class="form-check-input" type="checkbox" asp-for="DataConfig.RedirectTohttpswww" id="redirectWww" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 d-flex align-items-center justify-content-between ps-4">
                                <label class="form-check-label fw-semibold text-dark fs-13px" for="redirectHttps">Redirect to HTTPS</label>
                                <input class="form-check-input" type="checkbox" asp-for="DataConfig.RedirectTohttps" id="redirectHttps" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="DataConfig.MailSender" class="fw-bold text-dark fs-13px mb-2">Active Mail Sender</label>
                                <input asp-for="DataConfig.MailSender" class="form-control" placeholder="e.g. Outlook, Google, Webmail" />
                                <span asp-validation-for="DataConfig.MailSender" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. MAIL SERVER SMTP SETTINGS -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-envelope-gear text-success me-2"></i> SMTP Mail Server Credentials</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Microsoft / Outlook -->
                        <div class="col-lg-4">
                            <div class="p-3 border rounded-3 bg-white h-100">
                                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-microsoft me-1"></i> Microsoft / Outlook</h6>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.OutlookServer" class="fs-12px text-muted fw-semibold">Host / Server</label>
                                    <input asp-for="DataConfig.OutlookServer" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.OutlookPort" class="fs-12px text-muted fw-semibold">Port</label>
                                    <input asp-for="DataConfig.OutlookPort" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.OutlookUsername" class="fs-12px text-muted fw-semibold">Username</label>
                                    <input asp-for="DataConfig.OutlookUsername" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.OutlookSenderEmail" class="fs-12px text-muted fw-semibold">Sender Email</label>
                                    <input asp-for="DataConfig.OutlookSenderEmail" class="form-control form-control-sm" />
                                </div>
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" asp-for="DataConfig.OutlookSSLEnable" id="outlookSsl" />
                                    <label class="form-check-label fs-12px text-dark fw-semibold" for="outlookSsl">Enable SSL</label>
                                </div>
                            </div>
                        </div>

                        <!-- Google / Gmail -->
                        <div class="col-lg-4">
                            <div class="p-3 border rounded-3 bg-white h-100">
                                <h6 class="fw-bold text-danger mb-3"><i class="bi bi-google me-1"></i> Google / Gmail</h6>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.GoogleServer" class="fs-12px text-muted fw-semibold">Host / Server</label>
                                    <input asp-for="DataConfig.GoogleServer" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.GooglePort" class="fs-12px text-muted fw-semibold">Port</label>
                                    <input asp-for="DataConfig.GooglePort" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.GoogleUsername" class="fs-12px text-muted fw-semibold">Username</label>
                                    <input asp-for="DataConfig.GoogleUsername" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.GoogleSenderEmail" class="fs-12px text-muted fw-semibold">Sender Email</label>
                                    <input asp-for="DataConfig.GoogleSenderEmail" class="form-control form-control-sm" />
                                </div>
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" asp-for="DataConfig.GoogleSSLEnable" id="googleSsl" />
                                    <label class="form-check-label fs-12px text-dark fw-semibold" for="googleSsl">Enable SSL</label>
                                </div>
                            </div>
                        </div>

                        <!-- Custom Webmail -->
                        <div class="col-lg-4">
                            <div class="p-3 border rounded-3 bg-white h-100">
                                <h6 class="fw-bold text-success mb-3"><i class="bi bi-globe me-1"></i> Custom Webmail</h6>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.WebmailServer" class="fs-12px text-muted fw-semibold">Host / Server</label>
                                    <input asp-for="DataConfig.WebmailServer" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.WebmailPort" class="fs-12px text-muted fw-semibold">Port</label>
                                    <input asp-for="DataConfig.WebmailPort" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.WebmailUsername" class="fs-12px text-muted fw-semibold">Username</label>
                                    <input asp-for="DataConfig.WebmailUsername" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group mb-2">
                                    <label asp-for="DataConfig.WebmailSenderEmail" class="fs-12px text-muted fw-semibold">Sender Email</label>
                                    <input asp-for="DataConfig.WebmailSenderEmail" class="form-control form-control-sm" />
                                </div>
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" asp-for="DataConfig.WebmailSSLEnable" id="webmailSsl" />
                                    <label class="form-check-label fs-12px text-dark fw-semibold" for="webmailSsl">Enable SSL</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAVE BUTTON -->
        <div class="col-12 text-end pb-5">
            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                <i class="bi bi-check2-circle me-1"></i> Save All Changes
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
