@page "{id?}"
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.DetailModel
@{
    ViewData["Title"] = "User Details";
    ViewData["Subtitle"] = "View profile, manage access roles, evaluate KPIs, and read private HR notes.";
    ViewData["ShowBackButton"] = false;
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "Users";
}

@section HeaderActions {
    <a asp-page="./List" class="px-3.5 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
    <a asp-page="./KpiAssign" asp-route-id="@Model.UserProfile.Id" class="px-3.5 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition-colors text-decoration-none">
        <i class="bi bi-clipboard-check me-1"></i> Evaluate KPIs
    </a>
    <a asp-page="./Roles" asp-route-id="@Model.UserProfile.Id" class="px-3.5 py-2 text-sm font-medium text-white bg-[#0069A1] hover:bg-[#004d77] rounded-lg transition-colors text-decoration-none">
        <i class="bi bi-shield-check me-1"></i> Manage Roles
    </a>
}

<div class="page-content">
    <div class="row">
        <!-- Profile Sidebar Card -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 text-center py-4 mb-4">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.UserProfile.PassportFilePathUrl))
                    {
                        <img src="@Model.UserProfile.PassportFilePathUrl" class="rounded-circle border border-4 border-primary shadow mb-3" style="width: 120px; height: 120px; object-fit: cover;" alt="Avatar">
                    }
                    else
                    {
                        string initials = "";
                        if (!string.IsNullOrEmpty(Model.UserProfile.FirstName) && !string.IsNullOrEmpty(Model.UserProfile.LastName))
                        {
                            initials = Model.UserProfile.FirstName[0].ToString() + Model.UserProfile.LastName[0].ToString();
                        }
                        else if (!string.IsNullOrEmpty(Model.UserProfile.FirstName))
                        {
                            initials = Model.UserProfile.FirstName[0].ToString();
                        }
                        else if (!string.IsNullOrEmpty(Model.UserProfile.LastName))
                        {
                            initials = Model.UserProfile.LastName[0].ToString();
                        }
                        else if (!string.IsNullOrEmpty(Model.UserProfile.Email))
                        {
                            initials = Model.UserProfile.Email[0].ToString().ToUpper();
                        }
                        else
                        {
                            initials = "?";
                        }
                        
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow mx-auto mb-3" style="width: 120px; height: 120px; font-size: 3rem;">
                            @initials
                        </div>
                    }
                    <h4 class="mb-1 text-dark fw-bold">@Model.UserProfile.GetFullName()</h4>
                    <p class="text-muted mb-3">@Model.UserProfile.Email</p>

                    <div class="d-flex justify-content-center gap-2 mb-3">
                        @if (Model.UserProfile.UserCategory != null)
                        {
                            <span class="badge bg-primary text-white px-3 py-2 rounded-pill fs-7">@Model.UserProfile.UserCategory.Title</span>
                        }
                        @if (Model.UserProfile.UserStatus == JurayUniversal.Domain.Enum.Enum.UserStatus.Active)
                        {
                            <span class="badge bg-success text-white px-3 py-2 rounded-pill fs-7">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger text-white px-3 py-2 rounded-pill fs-7">@Model.UserProfile.UserStatus.ToString()</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick Account Metadata -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header border-bottom bg-transparent py-3">
                    <h5 class="mb-0 text-dark">Metadata</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                            <span class="text-muted">Username</span>
                            <span class="fw-semibold text-dark">@Model.UserProfile.UserName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                            <span class="text-muted">Phone</span>
                            <span class="fw-semibold text-dark">@(Model.UserProfile.PhoneNumber ?? "None")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                            <span class="text-muted">Last Login</span>
                            <span class="fw-semibold text-dark">@(Model.UserProfile.LastLogin ?? "Never")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Detail Tabs -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom p-0">
                    <ul class="nav nav-tabs px-4 pt-3" id="detailTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="true">
                                <i class="bi bi-person-fill me-1"></i> Profile
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="roles-tab" data-bs-toggle="tab" data-toggle="tab" href="#roles" role="tab" aria-controls="roles" aria-selected="false">
                                <i class="bi bi-shield-lock-fill me-1"></i> Feature Access
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="kpi-tab" data-bs-toggle="tab" data-toggle="tab" href="#kpi" role="tab" aria-controls="kpi" aria-selected="false">
                                <i class="bi bi-bar-chart-fill me-1"></i> KPI History
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="notes-tab" data-bs-toggle="tab" data-toggle="tab" href="#notes" role="tab" aria-controls="notes" aria-selected="false">
                                <i class="bi bi-journal-text me-1"></i> Private Notes
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="security-tab" data-bs-toggle="tab" data-toggle="tab" href="#security" role="tab" aria-controls="security" aria-selected="false">
                                <i class="bi bi-shield-lock-fill me-1"></i> Security
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">
                    <div class="tab-content" id="detailTabsContent">
                        
                        <!-- TAB 1: Profile -->
                        <div class="tab-pane fade show active" id="profile" role="tabpanel">
                            <h5 class="mb-4 text-dark">Profile Details</h5>
                            <div class="row g-3">
                                <div class="col-md-6 col-12">
                                    <label class="text-muted d-block fs-7 mb-1">Title</label>
                                    <div class="text-dark fw-bold bg-light p-2 rounded">@(Model.UserProfile.Title ?? "N/A")</div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="text-muted d-block fs-7 mb-1">Gender</label>
                                    <div class="text-dark fw-bold bg-light p-2 rounded">@Model.UserProfile.Gender.ToString()</div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="text-muted d-block fs-7 mb-1">Position / Rank</label>
                                    <div class="text-dark fw-bold bg-light p-2 rounded">@(Model.UserProfile.PositionOrRank ?? "N/A")</div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="text-muted d-block fs-7 mb-1">Nationality</label>
                                    <div class="text-dark fw-bold bg-light p-2 rounded">@(Model.UserProfile.Nationality ?? "N/A")</div>
                                </div>
                                <div class="col-md-12 col-12">
                                    <label class="text-muted d-block fs-7 mb-1">Address</label>
                                    <div class="text-dark fw-bold bg-light p-2 rounded">@(Model.UserProfile.Address ?? "N/A")</div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: Feature Access -->
                        <div class="tab-pane fade" id="roles" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="mb-0 text-dark">Assigned Feature Permissions</h5>
                            </div>
                            @if (Model.FeatureRoles.Count == 0)
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-shield-slash fs-2 d-block mb-2"></i>
                                    No custom feature permissions assigned to this user yet.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Feature Key</th>
                                                <th>Role Level</th>
                                                <th>Assigned Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var role in Model.FeatureRoles)
                                            {
                                                <tr>
                                                    <td><strong>@role.FeatureAreaKey</strong></td>
                                                    <td><span class="badge bg-light-primary text-primary">@role.ActionRole.ToString()</span></td>
                                                    <td class="text-muted">@role.Date.ToString("yyyy-MM-dd")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <!-- TAB 3: KPI History -->
                        <div class="tab-pane fade" id="kpi" role="tabpanel">
                            <h5 class="mb-4 text-dark">KPI Evaluations Score History</h5>
                            @if (Model.KpiHistory.Count == 0)
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-graph-down fs-2 d-block mb-2"></i>
                                    No KPI evaluation scores recorded for this user yet.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Period</th>
                                                <th>Indicator</th>
                                                <th>Score</th>
                                                <th>Max Score</th>
                                                <th>Evaluator</th>
                                                <th>Remarks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var score in Model.KpiHistory)
                                            {
                                                <tr>
                                                    <td><span class="badge bg-light-success text-success fw-bold">@score.Period</span></td>
                                                    <td>@score.MisKpiIndicator?.Title</td>
                                                    <td class="fw-bold text-success">@score.Score</td>
                                                    <td class="text-muted">@score.MisKpiIndicator?.MaxScore</td>
                                                    <td class="fs-7 text-muted">@score.EvaluatedBy</td>
                                                    <td class="fs-7 text-dark">@score.Remarks</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <!-- TAB 4: Private Notes -->
                        <div class="tab-pane fade" id="notes" role="tabpanel">
                            <h5 class="mb-4 text-dark">Private HR Notes</h5>
                            
                            <!-- Notes Form -->
                            <form method="post" asp-page-handler="AddNote" asp-route-id="@Model.UserProfile.Id" class="mb-4">
                                <div class="mb-3">
                                    <label class="form-label text-muted fw-semibold">Add a New Note</label>
                                    <textarea asp-for="NewNoteText" class="form-control" rows="3" required placeholder="Type notes here..."></textarea>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="form-check">
                                        <input asp-for="NewNoteIsPrivate" type="checkbox" class="form-check-input" id="isPrivateCheck">
                                        <label class="form-check-label text-muted fs-7" for="isPrivateCheck">
                                            Admin Eyes Only (Private Note)
                                        </label>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Add Note
                                    </button>
                                </div>
                            </form>

                            <!-- Notes list -->
                            @if (Model.Notes.Count == 0)
                            {
                                <div class="text-center py-4 text-muted border-top pt-4">
                                    <i class="bi bi-chat-left-dots fs-2 d-block mb-2"></i>
                                    No notes added yet.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3 border-top pt-4">
                                    @foreach (var note in Model.Notes)
                                    {
                                        <div class="card border border-light-alt shadow-none mb-0">
                                            <div class="card-body p-3 bg-light-alt rounded">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <div class="d-flex align-items-center">
                                                        <span class="fw-bold text-dark fs-7">@note.CreatedBy</span>
                                                        <span class="text-muted mx-2">|</span>
                                                        <span class="text-muted fs-7">@note.Date.ToString("yyyy-MM-dd HH:mm")</span>
                                                        @if (note.IsPrivate)
                                                        {
                                                            <span class="badge bg-light-danger text-danger ms-2" style="font-size: 8px;">Private</span>
                                                        }
                                                    </div>
                                                    <form method="post" asp-page-handler="DeleteNote" asp-route-id="@Model.UserProfile.Id" asp-route-noteId="@note.Id">
                                                        <button type="submit" class="btn btn-link text-danger p-0 border-0" onclick="return confirm('Are you sure you want to delete this note?')">
                                                            <i class="bi bi-trash fs-6"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                                <p class="mb-0 text-dark fs-6" style="white-space: pre-line;">@note.Note</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- TAB 5: Security -->
                        <div class="tab-pane fade" id="security" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="mb-0 text-dark">Account Security &amp; Access Controls</h5>
                            </div>

                            <!-- Two-Factor Authentication (2FA) Card -->
                            <div class="card bg-light border-0 mb-4">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-bold mb-1">
                                                <i class="bi bi-shield-check me-1 text-primary"></i> Two-Factor Authentication (2FA)
                                            </h6>
                                            <p class="text-muted fs-7 mb-0">
                                                Status: 
                                                @if (Model.IsTwoFactorEnabled)
                                                {
                                                    <span class="badge bg-success text-white px-2 py-1 ms-1">Enabled / Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-white px-2 py-1 ms-1">Disabled</span>
                                                }
                                            </p>
                                        </div>
                                        @if (Model.IsTwoFactorEnabled)
                                        {
                                            <form method="post" asp-page-handler="Disable2fa">
                                                <input type="hidden" name="id" value="@Model.UserProfile.Id" />
                                                <button type="submit" class="btn btn-danger fw-bold" onclick="return confirm('Are you sure you want to disable 2FA for this user? They will need to re-configure their authenticator app.');">
                                                    <i class="bi bi-shield-x me-1"></i> Disable 2FA
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-13px fst-italic">2FA is not active on this account</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Password Reset Card -->
                            <div class="card bg-light border-0">
                                <div class="card-body p-4">
                                    <h6 class="fw-bold mb-3">
                                        <i class="bi bi-key-fill me-1 text-warning"></i> Reset User Password
                                    </h6>
                                    <form method="post" asp-page-handler="ResetPassword">
                                        <input type="hidden" name="id" value="@Model.UserProfile.Id" />
                                        <div class="mb-3">
                                            <label class="form-label text-muted fw-semibold">New Password</label>
                                            <div class="input-group">
                                                <input type="password" class="form-control" name="newPassword" id="newPasswordInput" required minlength="6" placeholder="Enter new secure password" />
                                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility()">
                                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                                </button>
                                            </div>
                                            <div class="form-text">Password must be at least 6 characters long.</div>
                                        </div>
                                        <button type="submit" class="btn btn-warning fw-bold">
                                            <i class="bi bi-key-fill"></i> Reset Password
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility() {
            var passwordInput = document.getElementById("newPasswordInput");
            var toggleIcon = document.getElementById("togglePasswordIcon");
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                toggleIcon.classList.remove("bi-eye");
                toggleIcon.classList.add("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                toggleIcon.classList.remove("bi-eye-slash");
                toggleIcon.classList.add("bi-eye");
            }
        }
    </script>
}
