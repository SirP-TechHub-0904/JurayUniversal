@page
@model JurayUniversal.Website.Areas.MisNewsletter.Pages.Dashboard.Users.IndexModel
@{
    ViewData["Title"] = "Staff Wallets";
    ViewData["Subtitle"] = "Manage staff members using the email service.";
    ViewData["ActiveMenu"] = "MisNewsletter";
    ViewData["ActiveSubMenu"] = "StaffWallets";
}

@section HeaderActions {
    <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary rounded-pill fw-bold">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
}

<div class="page-heading">
    
</div>

<div class="page-content">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i> Active Staff Wallets</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Staff Member</th>
                            <th>Current Balance</th>
                            <th>Expiry Date</th>
                            <th>Last Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var wallet in Model.UserWallets)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person fw-bold"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 text-dark fw-bold">@(wallet.User?.FullName ?? "Unknown User")</h6>
                                            <small class="text-muted">@wallet.User?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
                                        @wallet.EmailQuotaBalance.ToString("N0")
                                    </span>
                                </td>
                                <td>
                                    @if (wallet.ExpiryDate.HasValue)
                                    {
                                        if (wallet.ExpiryDate.Value < DateTime.UtcNow)
                                        {
                                            <span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i> Expired (@wallet.ExpiryDate.Value.ToString("MMM dd, yyyy"))</span>
                                        }
                                        else
                                        {
                                            <span>@wallet.ExpiryDate.Value.ToString("MMM dd, yyyy")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(wallet.User?.LastLogin))
                                    {
                                        <span>@wallet.User.LastLogin</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never Logged In</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.UserWallets.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    <h5>No Staff Wallets Found</h5>
                                    <p>Share quota with a staff member from the Wallet page to create their wallet.</p>
                                    <a asp-page="/Dashboard/Wallet/Index" class="btn btn-primary mt-2 rounded-pill px-4">Go to Wallet</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
