@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Platform.ChangePasswordModel
@{
    ViewData["Title"] = "Security & 2FA";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "ChangePassword";
}

@section HeaderActions {
    <a asp-page="/Platform/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
}

<div class="page-content">
    <div class="row g-4">
        <!-- Change Password Column -->
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header border-bottom bg-transparent py-3">
                    <h5 class="mb-0 text-dark"><i class="bi bi-key-fill text-danger me-1"></i> Update Password</h5>
                </div>
                <div class="card-body py-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fs-7"></div>

                        <div class="mb-3">
                            <label class="form-label text-muted fw-semibold" asp-for="OldPassword">Current Password</label>
                            <input type="password" asp-for="OldPassword" class="form-control" placeholder="Enter current password" required />
                            <span asp-validation-for="OldPassword" class="text-danger fs-7"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted fw-semibold" asp-for="NewPassword">New Password</label>
                            <input type="password" asp-for="NewPassword" class="form-control" placeholder="Minimum 6 characters" required />
                            <span asp-validation-for="NewPassword" class="text-danger fs-7"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted fw-semibold" asp-for="ConfirmPassword">Confirm New Password</label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger fs-7"></span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i> Update Account Password
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Two Factor Authentication Column -->
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header border-bottom bg-transparent py-3">
                    <h5 class="mb-0 text-dark"><i class="bi bi-shield-lock-fill text-success me-1"></i> Two-Factor Authentication (2FA)</h5>
                </div>
                <div class="card-body py-4">
                    @if (Model.Is2faEnabled)
                    {
                        <div class="text-center py-4">
                            <div class="bg-light-success text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-shield-check" style="font-size: 2.5rem;"></i>
                            </div>
                            <h5 class="fw-bold text-success">2FA is Currently Enabled</h5>
                            <p class="text-muted">Your account is secured with an authenticator app. You must enter a 6-digit code every time you log in.</p>
                            
                            <form method="post" asp-page-handler="Disable2FA" class="mt-4">
                                <button type="submit" class="btn btn-outline-danger px-4" onclick="return confirm('Are you sure you want to disable Two-Factor Authentication? Your account will be less secure.');">
                                    <i class="bi bi-x-circle me-1"></i> Disable 2FA
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light-warning border-warning text-dark mb-4">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                            <strong>2FA is not enabled.</strong> Add a second layer of security to your account by configuring an authenticator app like Google Authenticator or Authy.
                        </div>

                        <ol class="list-group list-group-numbered list-group-flush mb-4">
                            <li class="list-group-item bg-transparent border-0 px-0 text-muted">
                                Download a two-factor authenticator app on your phone.
                            </li>
                            <li class="list-group-item bg-transparent border-0 px-0 text-muted">
                                Scan the QR Code or enter the key below manually into your app.
                                <div class="text-center my-3">
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Html.Raw(System.Net.WebUtility.UrlEncode(Model.AuthenticatorUri))" alt="QR Code" class="img-fluid border p-2 rounded bg-white shadow-sm" />
                                </div>
                                <div class="bg-light p-2 rounded text-center font-monospace small text-dark fw-bold">
                                    @Model.SharedKey
                                </div>
                            </li>
                            <li class="list-group-item bg-transparent border-0 px-0 text-muted">
                                Once your app is configured, enter the generated 6-digit code below to verify and enable 2FA.
                            </li>
                        </ol>

                        <form method="post" asp-page-handler="Enable2FA">
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="bi bi-123"></i></span>
                                <input type="text" asp-for="VerificationCode" class="form-control" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" placeholder="Enter 6-digit code" autocomplete="off" required maxlength="6" />
                                <button type="submit" class="btn btn-success px-4 fw-bold" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">Verify & Enable</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>

    </div>
</div>


