@page "{id:long}"
@model JurayUniversal.Website.Areas.MisFinances.Pages.Dashboard.LedgerModel
@{
    ViewData["Title"] = $"Ledger â€“ {Model.Category?.Title}";
}

<div class="mis-page-header d-flex justify-content-between align-items-center">
    <div>
        
        <div class="text-muted fs-7">
            @if (Model.Category?.IsCompulsory == true)
            {
                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill me-1"><i class="bi bi-lock-fill me-1"></i>Compulsory</span>
            }
            else
            {
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill me-1"><i class="bi bi-heart-fill me-1"></i>Optional</span>
            }
            @Model.Category?.Frequency
            @if (Model.Category?.FixedAmount.HasValue == true)
            {
                <span class="ms-1">Â· Fixed: @Model.Category.FixedAmount.Value.ToString("N2")</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        
        <button class="btn btn-outline-success btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#recordPaymentModal">
            <i class="bi bi-cash-coin me-1"></i> Record Manual Payment
        </button>
        <a asp-page="./Categories" class="btn btn-light btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-3" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fs-1 fw-bold text-primary">@Model.TotalTransactions</div>
                <div class="text-muted fs-7">Total Payments</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fs-1 fw-bold text-success">&#8358;@Model.TotalRevenue.ToString("N2")</div>
                <div class="text-muted fs-7">Revenue Collected</div>
            </div>
        </div>
        @if (Model.Category?.IsCompulsory == true)
        {
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                    <div class="fs-1 fw-bold text-success">@Model.PaidUserCount</div>
                    <div class="text-muted fs-7">Users Paid</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                    <div class="fs-1 fw-bold text-danger">@Model.DefaulterCount</div>
                    <div class="text-muted fs-7">Defaulters</div>
                </div>
            </div>
        }
    </div>

    <!-- Tabs for Paid vs Defaulters -->
    @if (Model.Category?.IsCompulsory == true)
    {
        <ul class="nav nav-pills mb-3" id="ledgerTab">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="pill" href="#tab-paid">Paid (@Model.PaidUserCount)</a></li>
            <li class="nav-item"><a class="nav-link text-danger" data-bs-toggle="pill" href="#tab-defaulters">Defaulters (@Model.DefaulterCount)</a></li>
        </ul>
        @if (!string.IsNullOrEmpty(Model.CurrentPeriodLabel))
        {
            <div class="alert alert-warning bg-warning bg-opacity-10 border-warning rounded-3 py-2 px-3 mb-3 fs-7">
                <i class="bi bi-calendar-event me-1"></i> Showing compliance for period: <strong>@Model.CurrentPeriodLabel</strong>
            </div>
        }
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-paid">
                @await Html.PartialAsync("_LedgerUserTable", Model.PaidTransactions)
            </div>
            <div class="tab-pane fade" id="tab-defaulters">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        @if (Model.DefaulterUsers.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in Model.DefaulterUsers)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@u.FirstName @u.LastName</td>
                                                <td class="text-muted">@u.Email</td>
                                                <td><span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">Unpaid</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-success">
                                <i class="bi bi-check-circle-fill fs-1 mb-2 d-block"></i>
                                <h5 class="fw-bold">All users have paid!</h5>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                @if (Model.PaidTransactions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Donor</th>
                                    <th>Email</th>
                                    <th>Amount</th>
                                    <th>Reference</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.PaidTransactions)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @if (t.UserProfile != null)
                                            {
                                                @($"{t.UserProfile.FirstName} {t.UserProfile.LastName}")
                                            }
                                            else
                                            {
                                                @(t.DonorName ?? "Anonymous")
                                            }
                                        </td>
                                        <td class="text-muted">@(t.DonorEmail ?? t.UserProfile?.Email ?? "â€”")</td>
                                        <td class="fw-bold text-success">@t.Amount.ToString("N2")</td>
                                        <td><code class="fs-8">@t.TransactionReference</code></td>
                                        <td class="text-muted">@t.PaidAt?.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox text-muted opacity-50 mb-3 d-block" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold text-muted">No donations recorded yet</h5>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Record Manual Payment Modal -->
<div class="modal fade" id="recordPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <form method="post" asp-page-handler="RecordManual">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Record Manual Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CategoryId" value="@Model.Category?.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" class="form-control rounded-3" name="DonorName" placeholder="Payer's full name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" class="form-control rounded-3" name="DonorEmail" placeholder="Payer's email (optional)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount Paid</label>
                        <div class="input-group">
                            <span class="input-group-text">&#8358;</span>
                            <input type="number" step="0.01" min="0" class="form-control" name="Amount" required
                                   value="@Model.Category?.FixedAmount" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <input type="text" class="form-control rounded-3" name="Notes" placeholder="e.g. Cash payment received at office" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4"><i class="bi bi-check-lg me-1"></i> Record Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />


