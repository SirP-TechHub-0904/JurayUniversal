
<form method="get" asp-page="/IQuery/Search" asp-area="Content" class="search-form">
    <div class="search-box">
        <input type="search" name="query" placeholder="Search anything..." />
        <button type="submit">
            <i class="fa fa-search"></i>
        </button>
    </div>
</form>
<style>
    .search-form {
        width: 100%;
        display: flex;
        justify-content: center;
        margin: 20px 0;
        padding-top: 20px;
    }

    .search-box {
        position: relative;
        width: 100%;
        max-width: 700px;
    }

        .search-box input {
            width: 100%;
            height: 55px;
            padding: 0 55px 0 20px;
            border-radius: 999px;
            border: 1px solid #ddd;
            outline: none;
            font-size: 18px;
            background: #fff;
        }

            .search-box input::placeholder {
                color: #999;
            }

        .search-box button {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 40px;
            height: 40px;
            border: none;
            border-radius: 50%;
            background: #111;
            color: #fff;
            cursor: pointer;
        }

            .search-box button:hover {
                opacity: 0.9;
            }</style>