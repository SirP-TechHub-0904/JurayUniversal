@using JurayUniversal.Persistence.EF.SQL
@using Microsoft.EntityFrameworkCore
@inject DashboardDbContext _context

@{
    var currentPath = Context.Request.Path.Value;
    // Strip trailing numeric ID if present
    var segments = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
    if (segments.Length > 0 && long.TryParse(segments[^1], out _))
    {
        currentPath = "/" + string.Join("/", segments.Take(segments.Length - 1));
    }

    // Find a matching manual page for this route
    var manualPage = await _context.MisManualPages
        .Include(p => p.MisManualElements)
        .Include(p => p.MisManual)
        .FirstOrDefaultAsync(p => p.RouteKey == currentPath);

    bool isSuperAdmin = User.IsInRole("mSuperAdmin");
}

<div class="offcanvas offcanvas-end" tabindex="-1" id="misHelpOffcanvas" aria-labelledby="misHelpOffcanvasLabel">
    <div class="offcanvas-header bg-light border-bottom">
        <h5 class="offcanvas-title" id="misHelpOffcanvasLabel">
            <i class="bi bi-question-circle text-primary me-2"></i> Page Guide
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        @if (manualPage != null)
        {
            <div class="mb-4">
                <h6 class="fw-bold text-primary">@(manualPage.MisManual?.Title ?? "Platform Guide")</h6>
                <h4>@manualPage.PageTitle</h4>
                <p class="text-muted">@manualPage.PageDescription</p>
            </div>

            @if (manualPage.MisManualElements != null && manualPage.MisManualElements.Any())
            {
                <h6 class="border-bottom pb-2 mb-3 fw-bold">Page Elements</h6>
                <div class="accordion" id="helpElementsAccordion">
                    @foreach (var element in manualPage.MisManualElements)
                    {
                        // Check Role
                        bool hasAccess = isSuperAdmin || string.IsNullOrEmpty(element.RequiredRole) || User.IsInRole(element.RequiredRole);

                        if (hasAccess)
                        {
                            <div class="accordion-item border-0 mb-2 shadow-sm rounded">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed rounded fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#element-@element.Id">
                                        <i class="bi bi-cursor-fill me-2 text-info"></i> @element.ElementName
                                    </button>
                                </h2>
                                <div id="element-@element.Id" class="accordion-collapse collapse" data-bs-parent="#helpElementsAccordion">
                                    <div class="accordion-body bg-light rounded-bottom text-muted fs-14px">
                                        @element.Description
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                 <div class="alert alert-light text-muted">No specific elements documented for this page yet.</div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x text-muted fs-1 mb-3 d-block"></i>
                <h5>No Guide Found</h5>
                <p class="text-muted">There is currently no specific documentation configured for this exact page route (@currentPath).</p>
            </div>
        }
        
        <div class="mt-5 border-top pt-3 text-center">
            <a href="/MisManual/Index" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-book"></i> View Full Knowledge Base</a>
        </div>
    </div>
</div>
