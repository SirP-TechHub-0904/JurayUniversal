@page
@model JurayUniversal.Website.Areas.MisRecruitment.Pages.Platform.Auth.RegisterModel
@{
    ViewData["Title"] = "Create Applicant Account";
    ViewData["Subtitle"] = "Fill out the form below to add a new record.";
}

<div class="container py-5 max-w-700">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-badge display-4 text-primary mb-2"></i>
                <h2 class="fw-bold">Applicant Registration</h2>
                <p class="text-muted">Create an account to track your applications.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FirstName" class="form-label fw-bold"></label>
                        <input asp-for="Input.FirstName" class="form-control form-control-lg" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.LastName" class="form-label fw-bold"></label>
                        <input asp-for="Input.LastName" class="form-control form-control-lg" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-bold"></label>
                    <input asp-for="Input.Email" class="form-control form-control-lg" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Phone" class="form-label fw-bold"></label>
                    <input asp-for="Input.Phone" class="form-control form-control-lg" />
                    <span asp-validation-for="Input.Phone" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Password" class="form-label fw-bold"></label>
                        <input asp-for="Input.Password" class="form-control form-control-lg" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-bold"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">Register Account</button>
            </form>
            
            <div class="text-center mt-4">
                <p class="text-muted mb-0">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold">Sign In</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
