@page
@model JurayUniversal.Website.Areas.MisContent.Pages.IFaq.IndexModel

@{
    ViewData["Title"] = "FAQ ";
    @if (User.Identity.IsAuthenticated && User.IsInRole("SubAdmin") || User.IsInRole("mSuperAdmin"))
    {
        

    }


    else
    {
        

    }
}


@section HeaderActions {
    <a asp-page="./Create" class="btn bg-gradient-warning btn-sm" style="float:right;">Add New</a>
}
<div class="card">
    
    <!-- /.card-header -->
    
<div class="card-body p-4">
        <div class="table-responsive">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>
                            @Html.DisplayNameFor(model => model.FAQ[0].Title)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.FAQ[0].Message)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.FAQ[0].SortOrder)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.FAQ[0].Show)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                @{
                    int sn = 0;
                }
                <tbody>
                    @foreach (var item in Model.FAQ)
                    {
                        <tr>
                            <td>
                                @{
                                    sn++;
                                }
                                @sn
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Title)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Message)
                            </td>


                            <td>
                                @Html.DisplayFor(modelItem => item.SortOrder)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Show)
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-success">Action</button>

                                    <div class="btn-group">
                                        <button type="button" class="btn btn-success dropdown-toggle dropdown-icon" data-bs-toggle="dropdown" aria-expanded="false">
                                        </button>
                                        <div class="dropdown-menu" style="">

                                            <a class="dropdown-item" asp-page="./Edit" asp-route-id="@item.Id">Edit</a>
                                            <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.Id">Details</a>
                                        </div>
                                    </div>
                                </div>

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>





