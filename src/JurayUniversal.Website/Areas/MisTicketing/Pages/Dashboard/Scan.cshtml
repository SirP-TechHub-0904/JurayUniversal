@page "{id:long}"
@model JurayUniversal.Website.Areas.MisTicketing.Pages.Dashboard.ScanModel
@{
    ViewData["Title"] = "QR Scanner";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

<div class="container-fluid max-w-600 mx-auto mt-4 text-center">
    
    <div class="mb-4">
        <h4 class="fw-bold">@Model.MisEvent.Title</h4>
        <p class="text-muted">Ticket Check-In Terminal</p>
        
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 mb-4">
            <i class="bi bi-check-circle-fill display-1 text-success mb-3 d-block"></i>
            <h5 class="fw-bold mb-0">@TempData["success"]</h5>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 mb-4">
            <i class="bi bi-x-circle-fill display-1 text-danger mb-3 d-block"></i>
            <h5 class="fw-bold mb-0">@TempData["error"]</h5>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <i class="bi bi-qr-code-scan display-1 text-primary mb-4 d-block"></i>
            <h5 class="fw-bold mb-4">Scan Ticket QR Code</h5>
            
            <form method="post">
                <input type="hidden" name="id" value="@Model.MisEvent.Id" />
                <div class="input-group input-group-lg mb-3">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-upc-scan"></i></span>
                    <input asp-for="QrCode" class="form-control border-start-0 ps-0" placeholder="Focus scanner here or type code" autofocus autocomplete="off" />
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-lg rounded-pill fw-bold">
                    Verify Ticket
                </button>
            </form>
            
            <a asp-page="./Manage" asp-route-id="@Model.MisEvent.Id" class="btn btn-link text-muted mt-4 text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Back to Event Settings
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Keep focus on the input box automatically for physical barcode scanners
        document.addEventListener('DOMContentLoaded', function() {
            var input = document.getElementById('QrCode');
            if(input) {
                input.focus();
                // Refocus if user clicks away (helpful for dedicated scanning terminals)
                document.body.addEventListener('click', function(e) {
                    if(e.target.tagName !== 'INPUT' && e.target.tagName !== 'BUTTON' && e.target.tagName !== 'A') {
                        input.focus();
                    }
                });
            }
        });
    </script>
}

