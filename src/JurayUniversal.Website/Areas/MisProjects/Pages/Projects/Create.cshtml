@page
@model JurayUniversal.Website.Areas.MisProjects.Pages.Projects.CreateModel
@{
    ViewData["Title"] = "Create New Project";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="MisProject.Name" class="form-label fw-bold"></label>
                <input asp-for="MisProject.Name" class="form-control" required placeholder="e.g. Website Redesign 2026" />
                <span asp-validation-for="MisProject.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MisProject.Description" class="form-label fw-bold"></label>
                <textarea asp-for="MisProject.Description" class="form-control" rows="3" placeholder="Describe the goal of this project..."></textarea>
                <span asp-validation-for="MisProject.Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MisProject.StartDate" class="form-label fw-bold"></label>
                    <input asp-for="MisProject.StartDate" type="date" class="form-control" required />
                    <span asp-validation-for="MisProject.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MisProject.EndDate" class="form-label fw-bold"></label>
                    <input asp-for="MisProject.EndDate" type="date" class="form-control" />
                    <span asp-validation-for="MisProject.EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-page="./Index" class="btn btn-outline-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">Create Project</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
