@page "/CommunityForm"
@model JurayUniversal.Website.Pages.CommunityForm.IndexModel
@{
    ViewData["Title"] = "Community & Clan Profiling Application";
    ViewData["PageName"] = "Community Form";
    ViewData["Description"] = "Community and clan membership profiling questionnaire and digital pedigree registry.";
    ViewData["Image"] = Model.SuperSetting?.CompanyLogoUrl;

    if (Model.SuperSetting?.TemplateLayoutKey == "Layout1111")
    {
        Layout = "/Pages/Shared/Layouts/Theme/RedbizTheme/_RedbizLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout2222")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Carspot/_CarspotLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout3333")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Alina/_AlinaLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout4444")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Archo/_ArchoLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout5555")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Bizup/_BizupLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout6666")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Industry/_IndustryLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout7777")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Lawnella/_LawnellaLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout8888")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Mistro/_MistroLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout9999")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Senatory/_SenatoryLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout11111111")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Education/_EducationLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout12121212")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Streamlab/_StreamlabLayout.cshtml";
    }
    else if (Model.SuperSetting?.TemplateLayoutKey == "Layout13131313")
    {
        Layout = "/Pages/Shared/Layouts/Theme/Judge/_JudgeLayout.cshtml";
    }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .cf-app-wrapper {
        background: #f1f5f9;
        min-height: 90vh;
        padding: 40px 15px 90px;
    }
    .cf-shell {
        max-width: 1040px;
        margin: 0 auto;
    }

    /* Top Bar & Resume CTA */
    .cf-top-cta {
        background: #0f172a;
        color: #ffffff;
        border-radius: 16px;
        padding: 18px 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    /* Wizard Container Card */
    .cf-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 12px 36px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    /* Hero Header */
    .cf-hero {
        background: linear-gradient(135deg, #0b1e36 0%, #173b6c 50%, #0069a1 100%);
        color: #ffffff;
        padding: 38px 34px 28px;
        position: relative;
    }
    .cf-hero h1 {
        font-size: 1.85rem;
        font-weight: 800;
        margin: 0 0 8px;
        color: #ffffff;
        letter-spacing: -0.5px;
    }
    .cf-hero p {
        color: #cbd5e1;
        margin: 0;
        font-size: 0.96rem;
        max-width: 750px;
    }

    /* Interactive Steps Navigation (Tabs) */
    .cf-tabs-nav {
        display: flex;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        overflow-x: auto;
        scrollbar-width: thin;
    }
    .cf-tab-btn {
        flex: 1;
        min-width: 175px;
        padding: 16px 14px;
        border: none;
        background: transparent;
        border-bottom: 3px solid transparent;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: left;
    }
    .cf-tab-btn:hover {
        background: #f1f5f9;
    }
    .cf-tab-btn.active {
        background: #ffffff;
        border-bottom-color: #0069a1;
    }
    .cf-tab-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        flex-shrink: 0;
        transition: all 0.2s;
    }
    .cf-tab-btn.active .cf-tab-num {
        background: #0069a1;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 105, 161, 0.4);
    }
    .cf-tab-btn.completed .cf-tab-num {
        background: #10b981;
        color: #ffffff;
    }
    .cf-tab-text h6 {
        margin: 0;
        font-size: 0.88rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
    .cf-tab-btn.active .cf-tab-text h6 {
        color: #0069a1;
    }
    .cf-tab-text small {
        display: block;
        font-size: 0.72rem;
        color: #64748b;
        white-space: nowrap;
    }

    /* Progress Indicator Bar */
    .cf-progress-strip {
        height: 4px;
        background: #e2e8f0;
        width: 100%;
    }
    .cf-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #0069a1, #10b981);
        width: 20%;
        transition: width 0.35s ease;
    }

    /* Tab Content Area */
    .cf-tab-pane {
        display: none;
        padding: 34px 34px 24px;
        animation: fadeIn 0.25s ease-in-out;
    }
    .cf-tab-pane.active {
        display: block;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Detailed "Long Info" Explanatory Banners */
    .cf-info-banner {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-left: 5px solid #0284c7;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 26px;
    }
    .cf-info-banner h6 {
        color: #0369a1;
        font-weight: 700;
        margin: 0 0 4px;
        font-size: 0.95rem;
    }
    .cf-info-banner p {
        color: #334155;
        margin: 0;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    /* Form Fields Styling */
    .cf-section-heading {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .cf-section-subheading {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 20px;
    }
    .cf-label {
        font-size: 0.84rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }
    .cf-input {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        padding: 11px 14px;
        font-size: 0.92rem;
        transition: all 0.2s;
        width: 100%;
        background: #ffffff;
    }
    .cf-input:focus {
        border-color: #0069a1;
        box-shadow: 0 0 0 3px rgba(0, 105, 161, 0.15);
        outline: none;
    }

    /* Checkbox & Radio Cards */
    .cf-check-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 10px;
    }
    .cf-check-box {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 11px 13px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.15s;
        font-size: 0.88rem;
        font-weight: 500;
        color: #334155;
    }
    .cf-check-box:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
    }
    .cf-check-box input:checked + span {
        font-weight: 700;
        color: #0069a1;
    }

    /* Step Navigation Actions Footer */
    .cf-nav-footer {
        padding: 24px 34px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    /* Hero Header Badge */
    .cf-hero-badge {
        background: rgba(255, 255, 255, 0.16) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        font-size: 0.82rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.3px;
        padding: 6px 14px !important;
        border-radius: 30px !important;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Live Auto-Save Status Pill */
    .cf-autosave-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: #ffffff !important;
        background: rgba(15, 23, 42, 0.5) !important;
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        padding: 6px 14px;
        border-radius: 20px;
    }
    .cf-dot-live {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        display: inline-block;
        animation: pulseDot 2s infinite;
    }
    @@keyframes pulseDot {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.2); }
        100% { opacity: 1; transform: scale(1); }
    }

    .hp-field {
        position: absolute;
        left: -9999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }
</style>

<div class="cf-app-wrapper">
    <div class="cf-shell">

        @if (!string.IsNullOrEmpty(Model.Submitted))
        {
            <!-- Submission Success View -->
            <div class="cf-card text-center p-5">
                <div class="mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle" style="width: 88px; height: 88px;">
                        <i class="bi bi-check2-circle" style="font-size: 3rem;"></i>
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-2">Application Submitted Successfully!</h2>
                <p class="text-muted mb-4 fs-6" style="max-width: 600px; margin-left: auto; margin-right: auto;">
                    Thank you for submitting your profiling questionnaire for <strong>@Model.OrgName</strong>. Your records and clan lineage have been securely received.
                </p>
                <div class="d-inline-block bg-light border rounded-4 px-5 py-3 mb-4 shadow-sm">
                    <span class="text-muted small d-block text-uppercase fw-bold letter-spacing-1">Official Reference Code</span>
                    <strong class="fs-3 text-primary font-monospace">@Model.Submitted</strong>
                </div>
                <p class="small text-muted mb-4">Please keep this reference code for your records or future updates.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-outline-primary px-4 py-2 rounded-pill fw-semibold">Return Home</a>
                    <a href="/CommunityForm" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">New Profile Application</a>
                </div>
            </div>
        }
        else
        {
            <!-- Resume Existing Application CTA Top Bar -->
            <div class="cf-top-cta">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-20 text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-bookmark-check-fill fs-5 text-warning"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-white mb-0">Have an in-progress application?</h6>
                        <small class="text-white-50">Continue from where you stopped using your Phone, Email, or Reference Code.</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-warning btn-sm rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#resumeModal">
                        <i class="bi bi-arrow-clockwise me-1"></i> Continue From Where You Stopped
                    </button>
                    <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#saveDraftModal">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Save &amp; Set Password
                    </button>
                </div>
            </div>

            <!-- Main Wizard Card -->
            <div class="cf-card">
                <!-- Hero Header -->
                <div class="cf-hero">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                        <div class="cf-hero-badge">
                            <i class="bi bi-diagram-3-fill text-warning"></i>
                            <span>Official Clan &amp; Community Profiling</span>
                        </div>
                        <div class="cf-autosave-status" id="autoSaveIndicator">
                            <span class="cf-dot-live"></span>
                            <span id="autoSaveText">Real-time auto-saving active</span>
                        </div>
                    </div>
                    <h1>@Model.OrgName Community Profiling Form</h1>
                    <p>Complete this comprehensive profiling questionnaire to preserve family lineage, document community expertise, and foster unity.</p>
                </div>

                <!-- Tabs Navigation Header -->
                <div class="cf-tabs-nav" id="wizardTabs">
                    <button type="button" class="cf-tab-btn active" onclick="jumpToStep(1)" id="tabBtn-1">
                        <span class="cf-tab-num">1</span>
                        <div class="cf-tab-text">
                            <h6>Personal &amp; Family</h6>
                            <small>Basic &amp; Immediate</small>
                        </div>
                    </button>
                    <button type="button" class="cf-tab-btn" onclick="jumpToStep(2)" id="tabBtn-2">
                        <span class="cf-tab-num">2</span>
                        <div class="cf-tab-text">
                            <h6>Ancestral &amp; Lineage</h6>
                            <small>Compound &amp; Pedigree</small>
                        </div>
                    </button>
                    <button type="button" class="cf-tab-btn" onclick="jumpToStep(3)" id="tabBtn-3">
                        <span class="cf-tab-num">3</span>
                        <div class="cf-tab-text">
                            <h6>Education &amp; Career</h6>
                            <small>Academics &amp; Business</small>
                        </div>
                    </button>
                    <button type="button" class="cf-tab-btn" onclick="jumpToStep(4)" id="tabBtn-4">
                        <span class="cf-tab-num">4</span>
                        <div class="cf-tab-text">
                            <h6>Skills &amp; Community</h6>
                            <small>Talent &amp; Participation</small>
                        </div>
                    </button>
                    <button type="button" class="cf-tab-btn" onclick="jumpToStep(5)" id="tabBtn-5">
                        <span class="cf-tab-num">5</span>
                        <div class="cf-tab-text">
                            <h6>Contacts &amp; Consent</h6>
                            <small>Emergency &amp; Submit</small>
                        </div>
                    </button>
                </div>

                <div class="cf-progress-strip">
                    <div class="cf-progress-fill" id="progressFill"></div>
                </div>

                <form method="post" enctype="multipart/form-data" id="communityProfilingForm">
                    <!-- Honeypot -->
                    <div class="hp-field">
                        <input asp-for="Website" autocomplete="off" />
                        <input type="hidden" asp-for="Input.ReferenceNumber" id="hiddenReferenceNumber" />
                        <input type="hidden" asp-for="AccessPassword" id="hiddenAccessPassword" />
                    </div>

                    <!-- ═════════════ TAB 1: PERSONAL & FAMILY ═════════════ -->
                    <div class="cf-tab-pane active" id="step-1">
                        <div class="cf-info-banner">
                            <h6><i class="bi bi-info-circle-fill me-1"></i> Purpose of Personal &amp; Family Records</h6>
                            <p>This information registers your primary identity in the central clan roll, ensuring official recognition of yourself and immediate family members in ongoing community planning and welfare registers.</p>
                        </div>

                        <!-- 1. Basic Information -->
                        <div class="cf-section-heading"><i class="bi bi-person-badge text-primary"></i> 1. Basic Information</div>
                        <div class="cf-section-subheading">Personal identification and primary contact details.</div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="cf-label">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="Input.FullName" class="cf-input track-input" placeholder="Enter full name" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.PreferredName" class="cf-label">Preferred Name / Alias</label>
                                <input asp-for="Input.PreferredName" class="cf-input track-input" placeholder="Enter preferred name or nickname" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.Gender" class="cf-label">Gender</label>
                                <select asp-for="Input.Gender" class="cf-input track-input">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.DateOfBirth" class="cf-label">Date of Birth</label>
                                <input asp-for="Input.DateOfBirth" type="date" class="cf-input track-input" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.MaritalStatus" class="cf-label">Marital Status</label>
                                <select asp-for="Input.MaritalStatus" class="cf-input track-input">
                                    <option value="">-- Select Status --</option>
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Divorced">Divorced</option>
                                    <option value="Widowed">Widowed</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.PhoneNumber" class="cf-label">Phone Number <span class="text-danger">*</span></label>
                                <input asp-for="Input.PhoneNumber" class="cf-input track-input" placeholder="Enter phone number" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="cf-label">Email Address</label>
                                <input asp-for="Input.Email" type="email" class="cf-input track-input" placeholder="Enter email address" />
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Input.ResidentialAddress" class="cf-label">Current Residential Address</label>
                                <input asp-for="Input.ResidentialAddress" class="cf-input track-input" placeholder="Enter current residential address" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.StateCountryOfResidence" class="cf-label">State / Country of Residence</label>
                                <input asp-for="Input.StateCountryOfResidence" class="cf-input track-input" placeholder="Enter state / country of residence" />
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25">

                        <!-- 2. Family Information -->
                        <div class="cf-section-heading"><i class="bi bi-people text-primary"></i> 2. Immediate Family Information</div>
                        <div class="cf-section-subheading">Parents, spouse, and children relationships.</div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FatherFullName" class="cf-label">Father's Full Name</label>
                                <input asp-for="Input.FatherFullName" class="cf-input track-input" placeholder="Enter father's full name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.MotherFullName" class="cf-label">Mother's Full Name</label>
                                <input asp-for="Input.MotherFullName" class="cf-input track-input" placeholder="Enter mother's full name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.FamilyKindredName" class="cf-label">Name of Family / Kindred</label>
                                <input asp-for="Input.FamilyKindredName" class="cf-input track-input" placeholder="Enter family or kindred name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.ClanName" class="cf-label">Name of Clan</label>
                                <input asp-for="Input.ClanName" class="cf-input track-input" placeholder="Enter clan name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.SpouseName" class="cf-label">Spouse's Name (if applicable)</label>
                                <input asp-for="Input.SpouseName" class="cf-input track-input" placeholder="Enter spouse's name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.NumberOfChildren" class="cf-label">Number of Children</label>
                                <input asp-for="Input.NumberOfChildren" type="number" min="0" class="cf-input track-input" placeholder="Enter number of children" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.ChildrenNames" class="cf-label">Names of Children (if appropriate)</label>
                                <input asp-for="Input.ChildrenNames" class="cf-input track-input" placeholder="Enter children's names" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.RelationshipToCommunity" class="cf-label">Relationship to the Clan / Community</label>
                                <input asp-for="Input.RelationshipToCommunity" class="cf-input track-input" placeholder="Enter relationship to community" />
                            </div>
                        </div>
                    </div>

                    <!-- ═════════════ TAB 2: ANCESTRAL & LINEAGE ═════════════ -->
                    <div class="cf-tab-pane" id="step-2">
                        <div class="cf-info-banner">
                            <h6><i class="bi bi-diagram-3-fill me-1"></i> Clan Profiling &amp; Ancestral Pedigree</h6>
                            <p>This section is vital for historical preservation and establishing family trees across villages. Filling known ancestral roots helps connect separated generations, preserves oral history, and documents title holdings.</p>
                        </div>

                        <div class="cf-section-heading"><i class="bi bi-houses text-primary"></i> 3. Ancestral Information</div>
                        <div class="cf-section-subheading">Villages, family compounds, lineages, and historical heritage.</div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Input.FatherVillageTown" class="cf-label">Father's Village / Town</label>
                                <input asp-for="Input.FatherVillageTown" class="cf-input track-input" placeholder="Enter village or town" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.MotherVillageTown" class="cf-label">Mother's Village / Town</label>
                                <input asp-for="Input.MotherVillageTown" class="cf-input track-input" placeholder="Enter village or town" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.FamilyCompound" class="cf-label">Family Compound (Compound Name)</label>
                                <input asp-for="Input.FamilyCompound" class="cf-input track-input" placeholder="Enter family compound name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.KindredLineage" class="cf-label">Kindred / Lineage Branch</label>
                                <input asp-for="Input.KindredLineage" class="cf-input track-input" placeholder="Enter kindred or lineage branch" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.FamilyHeadName" class="cf-label">Name of Family Head</label>
                                <input asp-for="Input.FamilyHeadName" class="cf-input track-input" placeholder="Enter family head name" />
                            </div>
