@page
@model JurayUniversal.Website.Areas.MisFleet.Pages.Dashboard.Equipment.IndexModel
@{
    ViewData["Title"] = "Asset Ledger";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-600 text-muted mb-0">Total Asset Value</h6>
                    <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                        <i class="bi bi-cash-stack fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-800 text-primary mb-0">@Model.TotalAssetValue.ToString("C", new System.Globalization.CultureInfo("en-NG"))</h3>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-600 text-muted mb-0">Lifetime Maintenance</h6>
                    <div class="bg-danger bg-opacity-10 text-danger rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                        <i class="bi bi-wrench fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-800 text-danger mb-0">@Model.TotalMaintenanceCost.ToString("C", new System.Globalization.CultureInfo("en-NG"))</h3>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-600 text-muted mb-0">Total Depreciation</h6>
                    <div class="bg-warning bg-opacity-10 text-warning rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                        <i class="bi bi-graph-down-arrow fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-800 text-warning mb-0">@Model.TotalDepreciation.ToString("C", new System.Globalization.CultureInfo("en-NG"))</h3>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-600 text-muted mb-0">Active vs Repair</h6>
                    <div class="bg-success bg-opacity-10 text-success rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                        <i class="bi bi-activity fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-800 text-dark mb-0">@Model.ActiveAssetsCount <span class="fs-5 text-muted fw-normal">/ @Model.MaintenanceRequiredCount</span></h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <h5 class="fw-700 mb-0">Maintenance Cost Trend (6 Months)</h5>
            </div>
            <div class="card-body p-4">
                <div id="maintenanceChart" style="height: 350px;"></div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <h5 class="fw-700 mb-0">Asset Distribution</h5>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center">
                <div id="categoryChart" class="w-100"></div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center p-4">
        <h5 class="mb-0 fw-bold">Equipment Directory</h5>
        <div>
            
            <a asp-page="../Categories/Index" class="btn btn-outline-secondary rounded-pill me-2">Manage Categories</a>
            <a asp-page="./Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1"></i> Add Asset</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Asset Name</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Current Value</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model.Equipments)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.Name</div>
                                <div class="text-muted small">SN: @(item.SerialNumber ?? "N/A")</div>
                            </td>
                            <td><span class="badge bg-info text-dark">@item.MisEquipmentCategory?.Name</span></td>
                            <td>
                                @if(item.CurrentStatus == Domain.Enum.Enum.MisEquipmentStatus.Available) { <span class="badge bg-success">Available</span> }
                                else if(item.CurrentStatus == Domain.Enum.Enum.MisEquipmentStatus.InUse) { <span class="badge bg-primary">In Use</span> }
                                else if(item.CurrentStatus == Domain.Enum.Enum.MisEquipmentStatus.Maintenance) { <span class="badge bg-warning text-dark">Maintenance</span> }
                                else { <span class="badge bg-secondary">Retired</span> }
                            </td>
                            <td>
                                @if(item.AssignedToUser != null)
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-badge text-primary me-2 fs-5"></i>
                                        <span>@item.AssignedToUser.FirstName @item.AssignedToUser.LastName</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Unassigned</span>
                                }
                            </td>
                            <td class="fw-bold text-success">@item.CurrentValue().ToString("C", new System.Globalization.CultureInfo("en-NG"))</td>
                            <td>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill">Manage</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Maintenance Cost Trend Chart
            var maintenanceOptions = {
                series: [{
                    name: 'Maintenance Cost (NGN)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MaintenanceTrendData))
                }],
                chart: {
                    height: 350,
                    type: 'area',
                    fontFamily: 'Inter, sans-serif',
                    toolbar: { show: false }
                },
                colors: ['#f44336'],
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 2 },
                xaxis: {
                    categories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels)),
                },
                fill: {
                    type: "gradient",
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.4,
                        opacityTo: 0.05,
                        stops: [0, 90, 100]
                    }
                }
            };
            var maintenanceChart = new ApexCharts(document.querySelector("#maintenanceChart"), maintenanceOptions);
            maintenanceChart.render();

            // Category Distribution Chart
            var categoryOptions = {
                series: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryData)),
                chart: {
                    type: 'donut',
                    height: 350,
                    fontFamily: 'Inter, sans-serif',
                },
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels)),
                colors: ['#0d6efd', '#0dcaf0', '#198754', '#ffc107', '#6f42c1', '#d63384'],
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%'
                        }
                    }
                },
                dataLabels: { enabled: false },
                legend: {
                    position: 'bottom'
                }
            };
            var categoryChart = new ApexCharts(document.querySelector("#categoryChart"), categoryOptions);
            categoryChart.render();
        });
    </script>
}

