                                        <rect x="7.19995" width="4" height="4" rx="2" fill="currentColor" />
                                        <rect x="14.3999" width="4" height="4" rx="2" fill="currentColor" />
                                        <rect y="8" width="4" height="4" rx="2" fill="currentColor" />
                                        <rect x="7.19995" y="8" width="4" height="4" rx="2" fill="currentColor" />
