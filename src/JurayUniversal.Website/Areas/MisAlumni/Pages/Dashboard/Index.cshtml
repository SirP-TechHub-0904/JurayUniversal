@page
@model JurayUniversal.Website.Areas.MisAlumni.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = Model.AlumniAlias + " Dashboard";
    ViewData["ActiveMenu"] = "MisAlumni";
    ViewData["ActiveSubMenu"] = "Dashboard";
    Layout = "/Pages/Shared/Layouts/MIS/_MisAdminLayout.cshtml";
}

@section HeaderActions {
    @if (await MisAuth.CanEditAsync(User, "MisAlumni"))
    {
        <a asp-page="./List" class="btn btn-primary btn-sm rounded-pill me-2"><i class="bi bi-people-fill me-1"></i> Manage @Model.AlumniAlias</a>
    }
    <a asp-page="./List" class="btn btn-sm btn-light rounded-pill px-3 shadow-sm">View All</a>
}

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">

    <!-- Date Range Filter -->
    <div class="card mb-4 border-0 shadow-sm rounded-4">
        <div class="card-body p-3">
            <form method="get" class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center fw-600 text-muted fs-14px">
                    <i class="bi bi-funnel-fill me-2 text-primary fs-5"></i>
                    Filter Analytics
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-3">
                        @(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "All Time")
                    </span>
                </div>
                
                <div class="d-flex align-items-stretch shadow-sm" style="max-width: 500px; flex-grow: 1; border-radius: 50px;">
                    <div class="d-flex align-items-center flex-grow-1 bg-white border border-primary border-opacity-25 border-end-0" style="border-radius: 50px 0 0 50px;">
                        <input type="hidden" name="DateRange" id="DateRangeValue" value="@Model.DateRange" />
                        <input type="text" id="DateRangeDisplay" value="@(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "")" class="border-0 shadow-none bg-transparent py-2 px-4 w-100" placeholder="Search by date range..." style="font-size: 14px; font-weight: 500; outline: none; cursor: pointer;" readonly="readonly" />
                        @if (!string.IsNullOrEmpty(Model.DateRange))
                        {
                            <a href="?DateRange=" class="text-danger px-3 d-flex align-items-center" title="Clear Date Filter" style="text-decoration: none;">
                                <i class="bi bi-x-circle-fill fs-5"></i>
                            </a>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary px-4 m-0 d-flex align-items-center justify-content-center" style="border-radius: 0 50px 50px 0 !important; font-weight: 600; border: 1px solid var(--md-primary); z-index: 1;">
                        <i class="bi bi-search me-2"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI Cards Row -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <a asp-page="./List" class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Total @Model.AlumniAlias</h6>
                            <h2 class="fw-800 text-dark mb-0">@Model.TotalAlumni</h2>
                        </div>
                        <div class="icon-box gradient-primary shadow-sm">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a asp-page="./List" asp-route-status="Pending" class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Pending Approvals</h6>
                            <h2 class="fw-800 text-dark mb-0">@Model.PendingVerifications</h2>
                        </div>
                        <div class="icon-box gradient-warning shadow-sm">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Active Posts</h6>
                            <h2 class="fw-800 text-success mb-0">@Model.TotalPosts</h2>
                        </div>
                        <div class="icon-box gradient-success shadow-sm">
                            <i class="bi bi-chat-square-text"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Available Mentors</h6>
                            <h2 class="fw-800 text-info mb-0">@Model.AvailableMentors</h2>
                        </div>
                        <div class="icon-box gradient-info shadow-sm">
                            <i class="bi bi-stars"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row g-4 mb-4">
        <!-- Growth Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">@Model.AlumniAlias Growth (Last 6 Months)</h5>
                    <div style="height: 300px;">
                        <canvas id="growthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- Year Chart -->
        <div class="col-xl-4 col-lg-5">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Top @Model.AlumniAlias Classes</h5>
                    <div style="height: 300px; display:flex; align-items:center; justify-content:center;">
                        <canvas id="yearChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row g-4 mb-4">
        <!-- Status Chart (Half Donut) -->
        <div class="col-xl-6">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Mentorship Availability</h5>
                    <div style="height: 350px;">
                        <canvas id="mentorshipChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Recent Alumni Feed -->
        <div class="col-xl-6">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />

@section Scripts {
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(function() {
            $('#DateRangeDisplay').daterangepicker({
                autoUpdateInput: false,
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                    'All Time': [moment().subtract(10, 'years'), moment()]
                },
                @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                {
                    <text>
                    startDate: '@Model.StartDate.Value.ToString("yyyy-MM-dd")',
                    endDate: '@Model.EndDate.Value.ToString("yyyy-MM-dd")',
                    </text>
                }
                locale: {
                    cancelLabel: 'Clear',
                    format: 'dddd DD MMMM, YYYY'
                }
            });

            $('#DateRangeDisplay').on('apply.daterangepicker', function(ev, picker) {
                $(this).val(picker.startDate.format('dddd DD MMMM, YYYY') + ' - ' + picker.endDate.format('dddd DD MMMM, YYYY'));
                $('#DateRangeValue').val(picker.startDate.format('YYYY-MM-DD') + ' - ' + picker.endDate.format('YYYY-MM-DD'));
            });

            $('#DateRangeDisplay').on('cancel.daterangepicker', function(ev, picker) {
                $(this).val('');
                $('#DateRangeValue').val('');
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            // Shared Chart.js Defaults
            Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
            Chart.defaults.color = '#6c757d';
            
            // 1. Registration Growth Line Chart
            var growthCtx = document.getElementById('growthChart').getContext('2d');
            
            var gradientBlue = growthCtx.createLinearGradient(0, 0, 0, 400);
            gradientBlue.addColorStop(0, 'rgba(78, 84, 200, 0.4)');
            gradientBlue.addColorStop(1, 'rgba(78, 84, 200, 0.0)');

            new Chart(growthCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                    datasets: [{
                        label: 'New Profiles',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData)),
                        borderColor: '#4e54c8',
                        backgroundColor: gradientBlue,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#4e54c8',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, border: { dash: [5, 5] }, grid: { color: '#f0f0f0' }, ticks: { stepSize: 1 } }
                    }
                }
            });

            // 2. Class Year Pie Chart
            var yearCtx = document.getElementById('yearChart').getContext('2d');
            new Chart(yearCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.YearLabels)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.YearData)),
                        backgroundColor: ['#4e54c8', '#11998e', '#ff9966', '#00c6ff', '#dc3545'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 20 } }
                    }
                }
            });

            // 3. Mentorship Gauge Chart (Half-Donut)
            var mentorshipCtx = document.getElementById('mentorshipChart').getContext('2d');
            new Chart(mentorshipCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Available Mentors', 'Not Available'],
                    datasets: [{
                        data: [@Model.AvailableMentors, @(Model.TotalAlumni - Model.AvailableMentors)],
                        backgroundColor: ['#00c6ff', '#f0f0f0'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    rotation: -90,
                    circumference: 180,
                    cutout: '75%',
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 20 } }
                    }
                }
            });
        });
    </script>
}


