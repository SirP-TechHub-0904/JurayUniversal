@page
@model JurayUniversal.Website.Areas.MisGrants.Pages.Dashboard.DetailsModel
@{
    ViewData["Title"] = "Grant Details";
    ViewData["Subtitle"] = "View detailed information and associated records.";
}

@section HeaderActions {
    <a asp-page="./Manage" asp-route-id="@Model.MisGrant.Id" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
}

<div class="container-fluid">

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Grant Overview</h5>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block fw-600">Total Award</small>
                        <div class="fs-4 fw-bold text-success">@Model.MisGrant.Currency @Model.MisGrant.TotalAwardAmount.ToString("N2")</div>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block fw-600">Total Received</small>
                        <div class="fs-5 fw-bold text-primary">
                            @Model.MisGrant.Currency @Model.MisGrant.Milestones.Sum(m => m.AmountReceived ?? 0).ToString("N2")
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block fw-600">Duration</small>
                        <div class="fw-500">
                            @Model.MisGrant.StartDate.ToString("dd MMM yyyy") 
                            <i class="bi bi-arrow-right mx-1 text-muted"></i> 
                            @(Model.MisGrant.EndDate.HasValue ? Model.MisGrant.EndDate.Value.ToString("dd MMM yyyy") : "Ongoing")
                        </div>
                    </div>

                    <div>
                        <small class="text-muted d-block fw-600 mb-1">Status</small>
                        @if (Model.MisGrant.IsActive)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Closed</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Milestones & Tranches</h5>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addMilestoneModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Milestone
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Title</th>
                                    <th>Expected Date</th>
                                    <th>Expected Amt</th>
                                    <th>Status / Received</th>
                                    <th class="pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.MisGrant.Milestones.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            No milestones created yet.
                                        </td>
                                    </tr>
                                }
                                @foreach (var milestone in Model.MisGrant.Milestones.OrderBy(m => m.ExpectedDate))
                                {
                                    <tr>
                                        <td class="ps-4 fw-600">@milestone.Title</td>
                                        <td>@milestone.ExpectedDate.ToString("dd MMM yyyy")</td>
                                        <td>@Model.MisGrant.Currency @milestone.ExpectedAmount.ToString("N2")</td>
                                        <td>
                                            @if (milestone.AmountReceived.HasValue)
                                            {
                                                <div class="fw-bold text-success">@Model.MisGrant.Currency @milestone.AmountReceived.Value.ToString("N2")</div>
                                                <small class="text-muted">Rcvd: @milestone.ReceivedDate?.ToString("dd MMM yy")</small>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-2 rounded-pill">Pending</span>
                                            }
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#updateMilestoneModal-@milestone.Id">
                                                Update
                                            </button>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@foreach (var milestone in Model.MisGrant.Milestones)
{
    <!-- Update Milestone Modal -->
    <div class="modal fade text-start" id="updateMilestoneModal-@milestone.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold mb-0">Update Milestone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form method="post" asp-page-handler="UpdateMilestone">
                        <input type="hidden" name="milestoneId" value="@milestone.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-600">Amount Received (@Model.MisGrant.Currency)</label>
                            <input type="number" step="0.01" name="amountReceived" class="form-control" value="@(milestone.AmountReceived ?? milestone.ExpectedAmount)" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-600">Date Received</label>
                            <input type="date" name="dateReceived" class="form-control" value="@(milestone.ReceivedDate?.ToString("yyyy-MM-dd") ?? System.DateTime.UtcNow.ToString("yyyy-MM-dd"))" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-600">Notes (Optional)</label>
                            <textarea name="note" class="form-control" rows="2">@milestone.Note</textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Save Update</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Milestone Modal -->
<div class="modal fade" id="addMilestoneModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Add Milestone</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="AddMilestone">
                    <input type="hidden" name="grantId" value="@Model.MisGrant.Id" />
                    
                    <div class="mb-3">
                        <label asp-for="NewMilestone.Title" class="form-label fw-600">Milestone Title <span class="text-danger">*</span></label>
                        <input asp-for="NewMilestone.Title" class="form-control" placeholder="e.g., Tranche 1" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewMilestone.ExpectedAmount" class="form-label fw-600">Expected Amount (@Model.MisGrant.Currency) <span class="text-danger">*</span></label>
                        <input asp-for="NewMilestone.ExpectedAmount" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label asp-for="NewMilestone.ExpectedDate" class="form-label fw-600">Expected Date <span class="text-danger">*</span></label>
                        <input asp-for="NewMilestone.ExpectedDate" type="date" class="form-control" value="@System.DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Create Milestone</button>
                </form>
            </div>
        </div>
    </div>
</div>
