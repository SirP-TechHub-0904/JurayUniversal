@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context
@using System.Security.Claims
@inject Microsoft.AspNetCore.Identity.UserManager<JurayUniversal.Domain.Models.Profile> _userManager

@{
    var superSetting = _context.SuperSettings.FirstOrDefault();
    
    // Identity fields
    string userFullName = User.Identity?.Name ?? "User";
    string userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "user@example.com";
    string userInitials = string.IsNullOrEmpty(userFullName) ? "U" : userFullName.Substring(0, 1).ToUpper();

    var appUser = await _userManager.GetUserAsync(User);
    var userRoles = appUser != null ? await _userManager.GetRolesAsync(appUser) : new List<string>();

    var pendingNotifications = new List<JurayUniversal.Domain.Models.MisNotification>();
    if (appUser != null)
    {
        pendingNotifications = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(_context.MisNotifications.Where(n => n.UserId == appUser.Id && !n.IsRead).OrderByDescending(n => n.CreatedAt));
    }

    var hasAdminRole = User.IsInRole("Admin") || User.IsInRole("mSuperAdmin") || User.IsInRole("Administrator") || User.IsInRole("Editor");
    
    if (!hasAdminRole && appUser != null)
    {
        hasAdminRole = Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AnyAsync(_context.MisUserFeatureRoles, r => r.ProfileId == appUser.Id && r.IsActive).Result;
    }

    // Determine current sidebar context (User Platform vs Admin Dashboard)
    bool isPlatform = ViewContext.RouteData.Values["page"]?.ToString().Contains("/Platform/") == true;
}




