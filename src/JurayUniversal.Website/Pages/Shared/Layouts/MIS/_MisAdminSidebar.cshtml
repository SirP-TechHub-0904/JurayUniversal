@inject JurayUniversal.Persistence.EF.SQL.DashboardDbContext _context
@inject JurayUniversal.Website.Services.IMisAuthorizationService MisAuth
@{
    var misSetting = _context.MisSettings.FirstOrDefault();
    string categoryAlias = misSetting?.CategoryAlias ?? "Category";
    string alumniAlias = misSetting?.AlumniAlias ?? "Alumni";

    string activeMenu = ViewData["ActiveMenu"] as string ?? "";
    string activeSubMenu = ViewData["ActiveSubMenu"] as string ?? "";

    bool IsMenuActive(string menu) => activeMenu == menu;
    bool IsSubMenuActive(string subMenu) => activeSubMenu == subMenu;

    string linkActive   = "flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent bg-[#0069A1] text-white border-[#0069A1]";
    string linkDefault  = "flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent text-gray-700 hover:bg-gray-50 hover:text-black hover:border-gray-200";
    string btnDefault   = "w-full flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent text-gray-700 hover:bg-gray-50 hover:text-black hover:border-gray-200";
    string btnActive    = "w-full flex items-center px-3 py-3 rounded-lg transition-all duration-200 group border border-transparent bg-[#0069A1] text-white border-[#0069A1]";
    string subLinkActive  = "flex items-center px-3 py-2 rounded-md transition-all duration-200 group border border-gray-200 text-sm bg-gray-100 text-black font-medium";
    string subLinkDefault = "flex items-center px-3 py-2 rounded-md transition-all duration-200 group border border-transparent text-sm text-gray-600 hover:bg-gray-50 hover:text-black hover:border-gray-100";

    var activeFeatures = _context.MisFeatures
        .Where(x => x.Status != JurayUniversal.Domain.Enum.Enum.FeatureBillingStatus.Disabled)
        .Select(x => x.ModuleFolder).ToList();

    async Task<bool> ShouldShow(string featureKey)
    {
        if (activeFeatures.Contains(featureKey))
            return await MisAuth.HasAccessAsync(User, featureKey);
        return false;
    }

    bool showUserMgmt    = await ShouldShow("MisUserManagement");
    bool showCommittees  = await ShouldShow("MisGroups");
    bool showAlumni      = await ShouldShow("MisAlumni");
    bool showReports     = await ShouldShow("MisReports");
    bool showForms       = await ShouldShow("MisForms") || await ShouldShow("MisSurveys");
    bool showManual      = await ShouldShow("MisManual");
    bool showDues        = await ShouldShow("MisFinances");
    bool showTicketing   = await ShouldShow("MisTicketing");
    bool showGrants      = await ShouldShow("MisGrants");
    bool showProposals   = await ShouldShow("MisProposals");
    bool showRecruitment = await ShouldShow("MisRecruitment");
    bool showVoting      = await ShouldShow("MisVoting");
    bool showAssets      = await ShouldShow("MisFleet");
    bool showProjects    = await ShouldShow("MisProjects");
    bool showMassComm    = await ShouldShow("MisMassComm");
    bool showNewsletter  = await ShouldShow("MisNewsletter");
    bool showContent     = activeFeatures.Contains("MisContent")
        ? await ShouldShow("MisContent")
        : (User.IsInRole("Admin") || User.IsInRole("mSuperAdmin") || User.IsInRole("Administrator") || User.IsInRole("Editor"));

    var reqPath = ViewContext.HttpContext.Request.Path.Value ?? "";
}

