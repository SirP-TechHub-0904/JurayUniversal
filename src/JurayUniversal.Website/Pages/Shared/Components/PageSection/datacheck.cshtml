@model ICollection<JurayUniversal.Domain.Models.PageSection>
@using System.Text.RegularExpressions;

@{
    Regex regex = new Regex("[^a-zA-Z0-9]");
    int listcountforhome = 500;
    // Get the URL for the home page
    string homeUrl = Url.Page("/Index");

    // Get the current URL
    string currentUrl = Context.Request.Path;

    // Check if the current URL is the home page URL
    bool isHomePage = currentUrl.Equals(homeUrl, StringComparison.OrdinalIgnoreCase);
}
@foreach (var item in Model)
{

    if (item.TemplateKey == "1")
    {
        <section>
            <div class="container @item.CustomClass">
                <div class="row text-center">
                    <div class="col-lg-8 col-md-10 mx-auto">
                        <div class="section-title">
                            <h2 class="title">@item.Title</h2>
                            <p class="mb-0">@item.Description</p>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-lg-6 col-md-12">
                        <div class="row">
                            <div class="col-md-12 pe-12">
                                <div class="about-img mb-0">
                                    <img class="img-fluid" src="@item.ImageUrl" alt="@item.Title">
                                </div>

                            </div>

                        </div>
                    </div>
                    @foreach (var list in item.PageSectionLists)
                    {
                        <div class="col-lg-6 col-md-12 box-shadow white-bg p-md-4 p-3 mt-5 mt-lg-0">
                            <h5>@list.Title</h5>
                            <p class="line-h-3">@list.Description</p>


                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (item.TemplateKey == "24")
    {
        string buttonUrl = "#";

        if (item.ButtonLink == "0")
        {
            buttonUrl = "#";
        }
        else if (item.ButtonLink == "Direct")
        {
            buttonUrl = item.DirectUrl;
        }
        else if (item.ButtonLink == "00")
        {
            buttonUrl = Url.Page("/Contact");
        }
        else
        {
            buttonUrl = Url.Page("/Source", new { id = item.ButtonLink, title = regex.Replace(item.Title, "-") });
        }

        <section class="case-one @item.CustomClass">
            <div class="case-one__top">
                <div class="container">
                    <div class="case-one__top-inner">
                        <div class="section-title text-left sec-title-animation animation-style2">
                            <div class="section-title__tagline-box">
                                <span class="section-title__tagline">@item.MiniTitle</span>
                                <div class="section-title__tagline-shape"></div>
                            </div>
                            <h2 class="section-title__title">@item.Title</h2>
                            <p>@Html.Raw(item.Description)</p>
                        </div>
                        <div class="case-one__btn-box">
                            <a href="@buttonUrl" class="thm-btn">
                                <span class="thm-btn-text">@item.ButtonText</span>
                                <span class="thm-btn-icon-box"><i class="fas fa-arrow-right"></i></span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="case-one__bottom">
                <div class="container">
                    <div class="case-one__carousel owl-carousel owl-theme">
                        @foreach (var ps in item.PageSectionLists)
                        {
                            string buttonUrlList = "#";

                            if (ps.ButtonLink == "0")
                            {
                                buttonUrlList = "#";
                            }
                            else if (ps.ButtonLink == "Direct")
                            {
                                buttonUrlList = ps.DirectUrl;
                            }
                            else if (ps.ButtonLink == "00")
                            {
                                buttonUrlList = Url.Page("/Contact");
                            }
                            else
                            {
                                buttonUrlList = Url.Page("/Source", new { id = ps.ButtonLink, title = regex.Replace(ps.Title, "-") });
                            }

                            var videoUrl = ps.VideoUrl ?? "";
                            var isYouTube = videoUrl.Contains("youtube.com") || videoUrl.Contains("youtu.be");
                            var youtubeId = "";

                            if (isYouTube)
                            {
                                if (videoUrl.Contains("youtu.be/"))
                                {
                                    youtubeId = videoUrl.Split("youtu.be/").Last().Split("?").First();
                                }
                                else if (videoUrl.Contains("v="))
                                {
                                    youtubeId = videoUrl.Split("v=").Last().Split("&").First();
                                }
                                else if (videoUrl.Contains("embed/"))
                                {
                                    youtubeId = videoUrl.Split("embed/").Last().Split("?").First();
                                }
                            }

                            <div class="case-one__single">
                                <div class="case-one__single-inner">
                                    <div class="case-one__img-box">
                                        <div class="case-one__img" style="position: relative; overflow: hidden;">
                                            @if (isYouTube && !string.IsNullOrEmpty(youtubeId))
                                            {
                                                <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
                                                    <iframe src="https://www.youtube.com/embed/@youtubeId?rel=0"
                                                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                            allowfullscreen></iframe>
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(videoUrl))
                                            {
                                                <video controls preload="metadata" style="width: 100%; border-radius: 8px; display: block;">
                                                    <source src="@videoUrl" type="video/mp4" />
                                                    Your browser does not support the video tag.
                                                </video>
                                            }
                                            else
                                            {
                                                <img src="@ps.ImageUrl" alt="@ps.Title">
                                            }
                                        </div>
                                    </div>
                                    <div class="case-one__content">
                                        <div class="case-one__content-box">
                                            <h3><a href="@buttonUrlList">@ps.Title</a></h3>
                                            <p>@ps.MiniTitle</p>
                                        </div>
                                        <div class="case-one__icon-box">
                                            <a href="@buttonUrlList">
                                                <span class="icon-right-arrow-1"></span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                    </div><!-- /.case-one__carousel -->
                </div>
            </div>
        </section>
    }

    else if (item.TemplateKey == "40")
    {

        <section class="@item.CustomClass">
            <div class="container">
                <div class="prg-amt">


                    <h2 class="title">@item.Title</h2>
                    <p class="lead text-black">@item.Description</p>
                    <div class="">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="road-map-main">
                                    @foreach (var list in item.PageSectionLists)
                                    {
                                        <div class="road-map-wrapper">
                                            <div class="road-map-circle">
                                                <span class="road-map-circle-text d-flex align-items-center justify-content-center">@list.ButtonText</span>
                                            </div>
                                            <div class="road-map-card">
                                                <h4 class="card-head">@list.Title</h4>
                                                <p class="card-text">
                                                    @list.Description
                                                </p>
                                            </div>
                                        </div>
                                    }



                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <link href="~/customcss/progress.css" rel="stylesheet" />
            <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
        </section>


    }


}

@section Scripts {


}
