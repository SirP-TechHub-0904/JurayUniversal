@page
@model JurayUniversal.Website.Areas.MisForms.Pages.Dashboard.ResponsesModel
@using System.Text.Json
@{
    ViewData["Title"] = "Responses - " + Model.Form.Title;
}

<div class="mis-page-header d-flex justify-content-between align-items-center">
    <div>
        <h3 class="mis-page-title mb-0">Responses: @Model.Form.Title</h3>
        <span class="text-muted fs-8">Total Submissions: @Model.FormResponses.Count</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Forms</a>
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            
            @if (Model.FormResponses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Date Submitted</th>
                                @if (Model.Form.RequireLogin)
                                {
                                    <th>User</th>
                                }
                                @foreach (var header in Model.HeaderFields)
                                {
                                    <th>@(Model.FieldLabels.ContainsKey(header) ? Model.FieldLabels[header] : header)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var response in Model.FormResponses)
                            {
                                <tr>
                                    <td class="text-nowrap text-muted fs-8">
                                        @response.SubmittedAt.ToString("g")
                                    </td>
                                    @if (Model.Form.RequireLogin)
                                    {
                                        <td>
                                            @if (response.UserProfile != null)
                                            {
                                                <span class="fw-bold">@response.UserProfile.FirstName @response.UserProfile.LastName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Anonymous</span>
                                            }
                                        </td>
                                    }
                                    @{
                                        Dictionary<string, string> answers = new Dictionary<string, string>();
                                        try
                                        {
                                            var doc = JsonDocument.Parse(response.ResponsesJson);
                                            if (doc.RootElement.ValueKind == JsonValueKind.Array)
                                            {
                                                foreach(var item in doc.RootElement.EnumerateArray())
                                                {
                                                    if (item.TryGetProperty("name", out var nameProp))
                                                    {
                                                        var name = nameProp.GetString();
                                                        if (item.TryGetProperty("userData", out var userDataProp))
                                                        {
                                                            if (userDataProp.ValueKind == JsonValueKind.Array)
                                                            {
                                                                var vals = userDataProp.EnumerateArray().Select(x => x.GetString()).Where(x => !string.IsNullOrEmpty(x));
                                                                answers[name] = string.Join(", ", vals);
                                                            }
                                                            else
                                                            {
                                                                answers[name] = userDataProp.GetString();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        catch { }

                                        foreach (var header in Model.HeaderFields)
                                        {
                                            <td>
                                                @if (answers != null && answers.ContainsKey(header))
                                                {
                                                    @answers[header]
                                                }
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted opacity-50 mb-3 d-block" style="font-size: 4rem;"></i>
                    <h4 class="fw-bold text-muted">No Responses Yet</h4>
                    <p class="text-muted">Once users start filling out the form, their answers will appear here.</p>
                </div>
            }

        </div>
    </div>
</div>
