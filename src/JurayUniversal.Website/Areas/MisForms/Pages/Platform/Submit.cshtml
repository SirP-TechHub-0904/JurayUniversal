@page "{id:long}"
@model JurayUniversal.Website.Areas.MisForms.Pages.Platform.SubmitModel
@{
    ViewData["Title"] = Model.Form.Title;
    ViewData["ActiveMenu"] = "MisForms";
}

<style>
    /* Hide all formBuilder default field labels */
    .rendered-form label[class^="formbuilder-"][class$="-label"] {
        display: none !important;
    }
</style>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <div class="d-flex justify-content-end mb-3">
        
    </div>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    
                    <div class="text-center mb-5">
                        <h2 class="fw-bold mb-2">@Model.Form.Title</h2>
                        <p class="text-muted fs-6">@Model.Form.Description</p>
                    </div>

                    <form method="post" id="dynamicForm">
                        <input type="hidden" asp-for="ResponsesJson" id="ResponsesJson" />
                        
                        <div id="fb-render" class="mb-4"></div>

                        <div class="text-center mt-5 d-flex justify-content-center">
                            <button type="button" onclick="document.getElementById('dynamicForm').reset();" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-bold mr-3 me-3">
                                <i class="bi bi-eraser me-1 mr-1"></i> Clear Form
                            </button>
                            <button type="button" id="submitBtn" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm fw-bold">
                                <i class="bi bi-send me-2"></i> Submit Form
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://formbuilder.online/assets/js/form-render.min.js"></script>

    <script>
        $(document).ready(function() {
            var schemaData = '@Html.Raw(Model.Form.SchemaJson)';
            var parsedData = [];
            try {
                if (schemaData && schemaData !== '[]') {
                    parsedData = JSON.parse(schemaData);
                }
            } catch (e) {
                console.error("Failed to parse schema", e);
            }

            var formRenderInstance = $('#fb-render').formRender({
                formData: parsedData
            });

            $('#submitBtn').click(function() {
                var userData = formRenderInstance.userData;
                $('#ResponsesJson').val(JSON.stringify(userData));
                $('#dynamicForm').submit();
            });
        });
    </script>
}

