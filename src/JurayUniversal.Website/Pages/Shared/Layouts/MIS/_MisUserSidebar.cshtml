            <path d="M12 6.253V19.5m0-13.247C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13.247C4.168 18.723 5.754 18.246 7.5 18.246s3.332.477 4.5 1.253m0-13.247C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13.247C19.832 18.723 18.247 18.246 16.5 18.246c-1.746 0-3.332.477-4.5 1.253" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
