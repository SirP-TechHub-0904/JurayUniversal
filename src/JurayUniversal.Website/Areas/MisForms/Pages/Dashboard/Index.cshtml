@page
@model JurayUniversal.Website.Areas.MisForms.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Custom Forms & Surveys";
    ViewData["Subtitle"] = "Manage and configure settings for this module.";
}

@section HeaderActions {
    <a asp-page="./Create" class="btn btn-primary btn-sm rounded-pill"><i class="bi bi-plus-lg me-1"></i> Create New Form</a>
}

<!-- Date Range Filter -->
<div class="card mb-4 border-0 shadow-sm rounded-4">
    <div class="card-body p-3">
        <form method="get" class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center fw-600 text-muted fs-14px">
                <i class="bi bi-funnel-fill me-2 text-primary fs-5"></i>
                Filter Analytics
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-3">
                    @(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "All Time")
                </span>
            </div>
            
            <div class="d-flex align-items-stretch shadow-sm" style="max-width: 500px; flex-grow: 1; border-radius: 50px;">
                <div class="d-flex align-items-center flex-grow-1 bg-white border border-primary border-opacity-25 border-end-0" style="border-radius: 50px 0 0 50px;">
                    <input type="hidden" name="DateRange" id="DateRangeValue" value="@Model.DateRange" />
                    <input type="text" id="DateRangeDisplay" value="@(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "")" class="border-0 shadow-none bg-transparent py-2 px-4 w-100" placeholder="Search by date range..." style="font-size: 14px; font-weight: 500; outline: none; cursor: pointer;" readonly="readonly" />
                    @if (!string.IsNullOrEmpty(Model.DateRange))
                    {
                        <a href="?DateRange=" class="text-danger px-3 d-flex align-items-center" title="Clear Date Filter" style="text-decoration: none;">
                            <i class="bi bi-x-circle-fill fs-5"></i>
                        </a>
                    }
                </div>
                <button type="submit" class="btn btn-primary px-4 m-0 d-flex align-items-center justify-content-center" style="border-radius: 0 50px 50px 0 !important; font-weight: 600; border: 1px solid var(--md-primary); z-index: 1;">
                    <i class="bi bi-search me-2"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Total Forms</h6>
                        <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-file-earmark-text fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-dark mb-0">@Model.TotalForms</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Active Published</h6>
                        <div class="bg-success bg-opacity-10 text-success rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-check-circle fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-success mb-0">@Model.ActiveForms</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Total Submissions</h6>
                        <div class="bg-info bg-opacity-10 text-info rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-inboxes fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-info mb-0">@Model.TotalSubmissions</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Avg Responses</h6>
                        <div class="bg-warning bg-opacity-10 text-warning rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-bar-chart fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-warning mb-0">@Model.AvgResponses</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Submissions Trend Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-700 mb-0">30-Day Response Trend</h5>
                </div>
                <div class="card-body p-4">
                    <div id="responseChart" style="height: 350px;"></div>
                </div>
            </div>
        </div>

        <!-- Form Status Distribution Chart -->
        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-700 mb-0">Forms Distribution</h5>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center">
                    <div id="statusChart" class="w-100"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            @if (Model.Forms.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Form Title</th>
                                <th>Status</th>
                                <th>Short Link</th>
                                <th>Responses</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var form in Model.Forms)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@form.Title</div>
                                        <div class="text-muted fs-8">@form.Description</div>
                                    </td>
                                    <td>
                                        @if (form.IsPublished)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">Draft</span>
                                        }
                                    </td>
                                    <td>
                                        @if (form.IsPublished)
                                        {
                                            <a href="~/f/@form.ShortCode" target="_blank" class="btn btn-sm btn-outline-info rounded-pill">
                                                /f/@form.ShortCode <i class="bi bi-box-arrow-up-right ms-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-8">Not Published</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-page="./Responses" asp-route-id="@form.Id" class="badge bg-primary text-white rounded-pill text-decoration-none px-3 py-2">
                                            @(form.Responses?.Count ?? 0) Responses
                                        </a>
                                    </td>
                                    <td class="text-muted">
                                        @form.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-page="./Builder" asp-route-id="@form.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square"></i> Builder</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard-data text-muted opacity-50 mb-3 d-block" style="font-size: 4rem;"></i>
                    <h4 class="fw-bold text-muted">No Forms Created Yet</h4>
                    <p class="text-muted">Use the Form Builder to create surveys, questionnaires, and data collection forms.</p>
                    <a asp-page="./Create" class="btn btn-primary rounded-pill px-4 mt-3"><i class="bi bi-plus-lg me-1"></i> Create First Form</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>
        $(function() {
            $('#DateRangeDisplay').daterangepicker({
                autoUpdateInput: false,
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                    'All Time': [moment().subtract(10, 'years'), moment()]
                },
                @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                {
                    <text>
                    startDate: '@Model.StartDate.Value.ToString("yyyy-MM-dd")',
                    endDate: '@Model.EndDate.Value.ToString("yyyy-MM-dd")',
                    </text>
                }
                locale: {
                    cancelLabel: 'Clear',
                    format: 'dddd DD MMMM, YYYY'
                }
            });

            $('#DateRangeDisplay').on('apply.daterangepicker', function(ev, picker) {
                $(this).val(picker.startDate.format('dddd DD MMMM, YYYY') + ' - ' + picker.endDate.format('dddd DD MMMM, YYYY'));
                $('#DateRangeValue').val(picker.startDate.format('YYYY-MM-DD') + ' - ' + picker.endDate.format('YYYY-MM-DD'));
            });

            $('#DateRangeDisplay').on('cancel.daterangepicker', function(ev, picker) {
                $(this).val('');
                $('#DateRangeValue').val('');
            });
        });

        document.addEventListener("DOMContentLoaded", function() {
            // Line Chart for Responses Trend
            var optionsLine = {
                series: [{
                    name: 'Submissions',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData))
                }],
                chart: {
                    height: 350,
                    type: 'line',
                    fontFamily: 'Inter, sans-serif',
                    toolbar: { show: false }
                },
                colors: ['#3b82f6'],
                stroke: { width: 3, curve: 'smooth' },
                dataLabels: { enabled: false },
                xaxis: {
                    categories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                }
            };
            var responseChart = new ApexCharts(document.querySelector("#responseChart"), optionsLine);
            responseChart.render();

            // Donut Chart for Form Status
            var hasData = @Model.TotalForms > 0;
            var optionsDonut = {
                series: hasData ? [@Model.ActiveForms, @Model.DraftForms] : [1],
                labels: hasData ? ['Published', 'Draft'] : ['No Data'],
                chart: {
                    type: 'donut',
                    fontFamily: 'Inter, sans-serif',
                    height: 300
                },
                colors: hasData ? ['#198754', '#ffc107'] : ['#e9ecef'],
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                name: { show: true },
                                value: { show: true }
                            }
                        }
                    }
                },
                dataLabels: { enabled: false },
                legend: { position: 'bottom' },
                tooltip: {
                    enabled: hasData
                }
            };
            var statusChart = new ApexCharts(document.querySelector("#statusChart"), optionsDonut);
            statusChart.render();
        });
    </script>
}

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />


