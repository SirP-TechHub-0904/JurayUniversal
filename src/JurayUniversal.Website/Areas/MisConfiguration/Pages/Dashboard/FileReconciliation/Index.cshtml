@page
@model JurayUniversal.Website.Areas.MisConfiguration.Pages.Dashboard.FileReconciliation.IndexModel
@{
    ViewData["Title"] = "AWS Files Reconciliation & Storage Audit";
    ViewData["Subtitle"] = "Audit, verify, and reconcile all stored files, images, videos, and documents across AWS S3 buckets.";

    string GetFileTypeBadge(string propertyType, string url)
    {
        var ext = System.IO.Path.GetExtension(url ?? "")?.ToLower();
        if (propertyType.ToLower().Contains("video") || ext == ".mp4" || ext == ".mov" || ext == ".avi" || ext == ".webm")
            return "<span class=\"badge bg-purple-100 text-purple-800 border border-purple-200 px-2 py-1 rounded-pill\"><i class=\"bi bi-play-circle-fill me-1\"></i> Video</span>";
        if (propertyType.ToLower().Contains("image") || propertyType.ToLower().Contains("logo") || propertyType.ToLower().Contains("icon") || ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp")
            return "<span class=\"badge bg-blue-100 text-blue-800 border border-blue-200 px-2 py-1 rounded-pill\"><i class=\"bi bi-image-fill me-1\"></i> Image</span>";
        if (ext == ".pdf")
            return "<span class=\"badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 rounded-pill\"><i class=\"bi bi-file-earmark-pdf-fill me-1\"></i> PDF</span>";
        if (ext == ".docx" || ext == ".doc")
            return "<span class=\"badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 rounded-pill\"><i class=\"bi bi-file-earmark-word-fill me-1\"></i> Word</span>";
        return $"<span class=\"badge bg-gray-100 text-gray-800 border border-gray-200 px-2 py-1 rounded-pill\"><i class=\"bi bi-file-earmark-fill me-1\"></i> {propertyType}</span>";
    }

    string ExtractBucketName(string url)
    {
        if (string.IsNullOrEmpty(url)) return "N/A";
        try
        {
            var uri = new Uri(url);
            var host = uri.Host;
            if (host.Contains(".s3"))
            {
                return host.Substring(0, host.IndexOf(".s3"));
            }
            var segments = uri.Segments;
            if (segments.Length > 1) return segments[1].Trim('/');
        }
        catch { }
        return "Custom/CDN";
    }
}

<div class="container-fluid pt-2 pb-5 mb-8">

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <!-- Total Files -->
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Tracked Files</span>
                        <h3 class="fw-bold mb-0 text-slate-800 mt-1">@Model.TotalFiles</h3>
                        <span class="text-xs text-muted">Across 17+ system tables</span>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-folder-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Images -->
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Images & Graphics</span>
                        <h3 class="fw-bold mb-0 text-blue-600 mt-1">@Model.TotalImages</h3>
                        <span class="text-xs text-muted">Logos, banners, avatars</span>
                    </div>
                    <div class="bg-blue-50 text-blue-600 rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-images fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Videos -->
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Videos & Clips</span>
                        <h3 class="fw-bold mb-0 text-purple-600 mt-1">@Model.TotalVideos</h3>
                        <span class="text-xs text-muted">MP4 and media assets</span>
                    </div>
                    <div class="bg-purple-50 text-purple-600 rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-camera-video-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Target S3 Bucket -->
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 rounded-3 h-100 bg-white border-start border-4 border-emerald-500">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Active S3 Bucket</span>
                        <h5 class="fw-bold mb-0 text-emerald-600 mt-1 text-truncate" style="max-width: 160px;" title="@Model.CurrentBucket">
                            @Model.CurrentBucket
                        </h5>
                        <span class="text-xs text-muted">Configured Tenant Target</span>
                    </div>
                    <div class="bg-emerald-50 text-emerald-600 rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-cloud-check-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom">
            <div>
                <h5 class="fw-bold text-slate-800 mb-1">
                    <i class="bi bi-file-earmark-diff text-primary me-2"></i> File Reconciliation & S3 Storage Directory
                </h5>
                <p class="text-muted small mb-0">Review database references, cross-check S3 object keys, and trigger cloud migration or pre-signed URL renewals.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-area="MisConfiguration" asp-page="/Dashboard/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Settings Hub
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="example1" class="table table-hover align-middle w-100" style="font-size: 0.875rem;">
                    <thead class="table-light text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="text-center" style="width: 50px;">S/N</th>
                            <th style="width: 70px;">Preview</th>
                            <th>File Key</th>
                            <th>Current Bucket</th>
                            <th>Entity & ID</th>
                            <th>Property</th>
                            <th>Type</th>
                            <th class="text-end" style="width: 170px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sn = 0; }
                        @foreach (var entry in Model.FileEntries)
                        {
                            sn++;
                            var originBucket = ExtractBucketName(entry.Url);
                            var isTargetBucket = string.Equals(originBucket, Model.CurrentBucket, StringComparison.OrdinalIgnoreCase);
                            var ext = System.IO.Path.GetExtension(entry.Url ?? "")?.ToLower();
                            var isImage = entry.PropertyType.ToLower().Contains("image") || entry.PropertyType.ToLower().Contains("logo") || entry.PropertyType.ToLower().Contains("icon") || ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp";
                            var isVideo = entry.PropertyType.ToLower().Contains("video") || ext == ".mp4" || ext == ".mov" || ext == ".webm";

                            <tr>
                                <td class="text-center fw-semibold text-muted">@sn</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(entry.Url))
                                    {
                                        if (isImage)
                                        {
                                            <a href="@entry.Url" target="_blank" title="Click to view full image">
                                                <img src="@entry.Url" class="rounded shadow-sm border" style="width: 48px; height: 48px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/placeholder-image.png';" />
                                            </a>
                                        }
                                        else if (isVideo)
                                        {
                                            <a href="@entry.Url" target="_blank" class="d-inline-flex align-items-center justify-content-center bg-purple-100 text-purple-700 rounded border border-purple-200" style="width: 48px; height: 48px;" title="Play Video">
                                                <i class="bi bi-play-fill fs-4"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@entry.Url" target="_blank" class="d-inline-flex align-items-center justify-content-center bg-gray-100 text-slate-700 rounded border" style="width: 48px; height: 48px;" title="Open Document">
                                                <i class="bi bi-file-earmark-text fs-4"></i>
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-danger small"><i class="bi bi-x-circle"></i> None</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <code class="text-slate-800 bg-slate-100 px-2 py-1 rounded text-xs text-truncate" style="max-width: 180px;" title="@entry.Key">
                                            @entry.Key
                                        </code>
                                        <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-1 copy-key-btn" data-key="@entry.Key" title="Copy Key">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(entry.Url))
                                    {
                                        <a href="@entry.Url" target="_blank" class="text-xs text-primary text-decoration-none d-block mt-1 text-truncate" style="max-width: 180px;" title="@entry.Url">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Open URL
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (isTargetBucket)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> @originBucket
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2 py-1" title="Differs from target bucket: @Model.CurrentBucket">
                                            <i class="bi bi-exclamation-triangle me-1"></i> @originBucket
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-slate-800">@entry.EntityName</span>
                                    <span class="text-muted small">#@entry.EntityId</span>
                                </td>
                                <td>
                                    <span class="text-slate-700 fw-medium">@entry.PropertyName</span>
                                </td>
                                <td>
                                    @Html.Raw(GetFileTypeBadge(entry.PropertyType, entry.Url))
                                </td>
                                <td class="text-end">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-light border rounded-pill px-3 dropdown-toggle shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 p-2" style="font-size: 0.8125rem;">
                                            <li>
                                                <a class="dropdown-menu-item dropdown-item rounded-2 py-2" asp-page="./MoveFile" asp-route-entity="@entry.EntityName" asp-route-id="@entry.EntityId" asp-route-property="@entry.PropertyName" asp-route-key="@entry.Key">
                                                    <i class="bi bi-arrow-left-right text-primary me-2"></i> Move to Active Bucket
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-menu-item dropdown-item rounded-2 py-2" asp-page="./GetNewUrl" asp-route-entity="@entry.EntityName" asp-route-id="@entry.EntityId" asp-route-property="@entry.PropertyName" asp-route-key="@entry.Key">
                                                    <i class="bi bi-arrow-repeat text-success me-2"></i> Regenerate Presigned URL
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <a class="dropdown-menu-item dropdown-item rounded-2 py-2" asp-page="./EditFile" asp-route-entity="@entry.EntityName" asp-route-id="@entry.EntityId" asp-route-property="@entry.PropertyName" asp-route-key="@entry.Key" asp-route-newUrl="@entry.Url">
                                                    <i class="bi bi-pencil-square text-warning me-2"></i> Edit Key & URL
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Copy file key to clipboard
            $('.copy-key-btn').on('click', function () {
                var key = $(this).data('key');
                if (navigator.clipboard && key) {
                    navigator.clipboard.writeText(key).then(function () {
                        toastr.success('Key copied: ' + key);
                    });
                }
            });
        });
    </script>
}
