@page "{id:long}"
@model JurayUniversal.Website.Areas.MisFinances.Pages.Dashboard.EditCategoryModel
@{
    ViewData["Title"] = "Edit Payment Category";
    ViewData["Subtitle"] = "Update settings for this payment category.";
}

@section HeaderActions {
    <a asp-page="./Categories" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Back to Categories
    </a>
}

<div class="page-content bg-light p-0 p-md-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Category Details</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Category.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Category.Title" class="form-label fw-bold text-dark">Category Title <span class="text-danger">*</span></label>
                            <input asp-for="Category.Title" class="form-control form-control-lg rounded-3" required />
                            <span asp-validation-for="Category.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Category.Description" class="form-label fw-bold text-dark">Description</label>
                            <textarea asp-for="Category.Description" class="form-control rounded-3" rows="3"></textarea>
                            <span asp-validation-for="Category.Description" class="text-danger"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Category.IsCompulsory" class="form-label fw-bold text-dark">Payment Type <span class="text-danger">*</span></label>
                                <select asp-for="Category.IsCompulsory" class="form-select form-select-lg rounded-3">
                                    <option value="true">Compulsory Due (All users owe this)</option>
                                    <option value="false">Optional Donation (User's choice)</option>
                                </select>
                                <span asp-validation-for="Category.IsCompulsory" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Category.AllowGuestPayment" class="form-label fw-bold text-dark">Access Control <span class="text-danger">*</span></label>
                                <select asp-for="Category.AllowGuestPayment" class="form-select form-select-lg rounded-3">
                                    <option value="true">Allow External / Guest Payments (Anyone with link)</option>
                                    <option value="false">Members Only (Must log in to pay)</option>
                                </select>
                                <span asp-validation-for="Category.AllowGuestPayment" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Category.Frequency" class="form-label fw-bold text-dark">Frequency</label>
                            <select asp-for="Category.Frequency" class="form-select form-select-lg rounded-3" asp-items="Html.GetEnumSelectList<JurayUniversal.Domain.Enum.Enum.PaymentFrequency>()"></select>
                            <span asp-validation-for="Category.Frequency" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Category.FixedAmount" class="form-label fw-bold text-dark">Fixed Amount</label>
                            <div class="input-group input-group-lg rounded-3">
                                <span class="input-group-text bg-light">&#8358;</span>
                                <input asp-for="Category.FixedAmount" type="number" step="0.01" min="0" class="form-control" placeholder="Leave blank for voluntary amount" />
                            </div>
                            <small class="text-muted d-block mt-2">Leave blank for optional donations where users choose their own amount.</small>
                            <span asp-validation-for="Category.FixedAmount" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="Category.IsActive" class="form-check-input" type="checkbox" id="isActiveEditCheck" />
                            <label class="form-check-label fw-bold text-dark" for="isActiveEditCheck">
                                Active (Allow users to see and pay under this category)
                            </label>
                        </div>

                        <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                            <a asp-page="./Categories" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
