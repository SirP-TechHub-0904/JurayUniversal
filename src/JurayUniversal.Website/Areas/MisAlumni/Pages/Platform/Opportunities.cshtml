@page
@model JurayUniversal.Website.Areas.MisAlumni.Pages.Platform.OpportunitiesModel
@inject Microsoft.AspNetCore.Identity.UserManager<JurayUniversal.Domain.Models.Profile> _userManager
@{
    ViewData["Title"] = "Opportunities Board";
    ViewData["ActiveMenu"] = "MisAlumni";
}

<div class="mis-page-header">
    <h3 class="mis-page-title">Opportunities & Networking Board</h3>
    <div class="d-flex gap-2">
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Network</a>
        <button class="btn btn-outline-info btn-sm rounded-pill" type="button" data-bs-toggle="offcanvas" data-bs-target="#misHelpOffcanvas">
            <i class="bi bi-question-circle me-1"></i> Help & Guide
        </button>
        @if (Model.IsAlumni)
        {
            <button class="btn btn-primary btn-sm rounded-pill" type="button" data-bs-toggle="modal" data-bs-target="#createPostModal">
                <i class="bi bi-pencil-square me-1"></i> Create Post
            </button>
        }
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <!-- Filters -->
    <div class="mb-4 d-flex gap-2 flex-wrap">
        <a asp-page="./Opportunities" asp-route-filterType="" class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(Model.FilterType) ? "btn-primary" : "btn-outline-secondary bg-white")">All Posts</a>
        <a asp-page="./Opportunities" asp-route-filterType="Job Opening" class="btn btn-sm rounded-pill @(Model.FilterType == "Job Opening" ? "btn-primary" : "btn-outline-secondary bg-white")">Job Openings</a>
        <a asp-page="./Opportunities" asp-route-filterType="Business Opportunity" class="btn btn-sm rounded-pill @(Model.FilterType == "Business Opportunity" ? "btn-primary" : "btn-outline-secondary bg-white")">Business Networking</a>
        <a asp-page="./Opportunities" asp-route-filterType="Mentorship Request" class="btn btn-sm rounded-pill @(Model.FilterType == "Mentorship Request" ? "btn-primary" : "btn-outline-secondary bg-white")">Mentorship Requests</a>
        <a asp-page="./Opportunities" asp-route-filterType="Mentorship Offer" class="btn btn-sm rounded-pill @(Model.FilterType == "Mentorship Offer" ? "btn-primary" : "btn-outline-secondary bg-white")">Mentorship Offers</a>
        <a asp-page="./Opportunities" asp-route-filterType="General" class="btn btn-sm rounded-pill @(Model.FilterType == "General" ? "btn-primary" : "btn-outline-secondary bg-white")">General</a>
    </div>

    <div class="row g-4">
        @foreach (var post in Model.Posts)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                    <span class="fw-bold fs-5">@post.UserProfile?.FirstName?.Substring(0, 1)</span>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@post.UserProfile?.FirstName @post.UserProfile?.LastName</h6>
                                    <div class="text-muted fs-8">@post.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@post.PostType</span>
                        </div>
                        
                        <h5 class="fw-bold mb-3">@post.Title</h5>
                        <div class="text-dark bg-light rounded p-3 mb-3" style="white-space: pre-wrap;">@post.Content</div>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <a href="mailto:@post.UserProfile?.Email" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-envelope me-1"></i> Contact User</a>
                            
                            @if (User.Identity.IsAuthenticated && post.UserProfileId == _userManager.GetUserId(User))
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@post.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                    <button type="submit" class="btn btn-light btn-sm rounded-pill text-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @if (!Model.Posts.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 py-5 text-center">
                    <i class="bi bi-chat-square-text text-muted fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold text-muted">No posts found in this category.</h5>
                    @if (!Model.IsAlumni)
                    {
                        <p class="text-muted mt-2 mb-0">Only registered @Model.AlumniAlias can post opportunities.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Create Post Modal -->
@if (Model.IsAlumni)
{
    <div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Post an Opportunity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-page-handler="Create">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Post Category</label>
                            <select asp-for="NewPostType" class="form-select" required>
                                <option value="Job Opening">Job Opening</option>
                                <option value="Business Opportunity">Business Networking / Partnership</option>
                                <option value="Mentorship Request">Mentorship Request</option>
                                <option value="Mentorship Offer">Mentorship Offer</option>
                                <option value="General">General Announcement</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Title</label>
                            <input asp-for="NewPostTitle" class="form-control" placeholder="e.g. Hiring a Senior Dev, or Looking for a Mentor in Tech" required maxlength="200" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Description</label>
                            <textarea asp-for="NewPostContent" class="form-control" rows="5" placeholder="Provide details about the opportunity or request..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-send me-1"></i> Publish Post</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}