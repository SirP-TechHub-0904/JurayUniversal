@page
@model JurayUniversal.Website.Areas.MisAuth.Pages.Auth.MisGenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
 }

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-arrow-clockwise fs-3"></i>
                </div>
                <h3 class="fw-800 text-dark mb-0">Generate Recovery Codes</h3>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />
            
            <div class="alert alert-warning rounded-4 border-0 shadow-sm p-4 mb-4" role="alert">
                <div class="d-flex mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Put these codes in a safe place.</h5>
                        <p class="mb-0 fs-14px">If you lose your device and don't have the recovery codes you will lose access to your account.</p>
                    </div>
                </div>
                <hr class="border-warning opacity-25">
                <p class="mb-0 fs-13px">
                    Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
                    used in an authenticator app you should <a asp-page="./MisResetAuthenticator" class="fw-bold text-dark">reset your authenticator keys.</a>
                </p>
            </div>
            
            <form method="post" class="mt-4">
                <button class="btn btn-danger btn-lg w-100 rounded-pill fw-700 shadow-sm" type="submit">
                    <i class="bi bi-shield-lock me-2"></i> Generate Recovery Codes
                </button>
            </form>
            
            <div class="mt-4 text-center">
                <a asp-page="./MisTwoFactorAuthentication" class="text-decoration-none text-muted fw-600"><i class="bi bi-arrow-left me-1"></i> Back to 2FA Settings</a>
            </div>
        </div>
    </div>
</div>
