@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.Categories.IndexModel
@{
    ViewData["Title"] = Model.CategoryAlias + " Management";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "Categories";
}

@section HeaderActions {
    @if (await MisAuth.CanEditAsync(User, "MisUserManagement"))
    {
        <a asp-page="./Create" class="btn btn-primary rounded-pill px-4"><i class="bi bi-plus-circle me-1"></i> Add New @Model.CategoryAlias</a>
    }
}

<div class="container-fluid px-0">
    @Html.AntiForgeryToken()
    <!-- Category Directory List Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="categoryDirectoryTable" class="table table-hover align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th class="mis-table-th" style="width: 60px;">s/n</th>
                            <th class="mis-table-th">title <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                            <th class="mis-table-th">description <i class="bi bi-chevron-expand ms-1 opacity-25"></i></th>
                            <th class="mis-table-th">publish</th>
                            <th class="mis-table-th">show in menu</th>
                            <th class="mis-table-th">show in dashboard</th>
                            <th class="text-center mis-table-th" style="width: 100px;">action</th>
                        </tr>
                    </thead>
                    <tbody style="border-top: 0;">
                        <!-- Data will be populated by DataTables -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables Bootstrap 5 dependencies -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            var table = $('#categoryDirectoryTable').DataTable({
                "processing": true,
                "serverSide": true,
                "paging": false,
                "info": false,
                "searching": true,
                "responsive": true,
                "ajax": {
                    "url": "?handler=Data",
                    "type": "POST",
                    "headers": {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    }
                },
                "columns": [
                    { "data": "sn", "className": "text-muted align-middle", "orderable": false, "searchable": false },
                    { "data": "title", "className": "fw-bold align-middle" },
                    { "data": "description", "className": "text-muted align-middle" },
                    { "data": "publish", "className": "align-middle", "orderable": false },
                    { "data": "showinmenu", "className": "align-middle", "orderable": false },
                    { "data": "showindashboard", "className": "align-middle", "orderable": false },
                    { "data": "manage", "className": "text-center align-middle", "orderable": false, "searchable": false }
                ],
                "order": [[1, "asc"]],
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search @Model.CategoryAlias..."
                }
            });
        });
    </script>
}
