    <div class="services__shape">
        <img src="~/xyz-mis/assets/img/images/services_shape.svg" alt="shape" class="alltuchtopdown">
    </div>
</section>
<!-- services-area-end -->

<!-- choose-area -->
<section class="choose__area">
    <div class="container">
        <div class="row">
            <div class="col-xl-8">
                <div class="choose__inner-wrap">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="choose__content">
                                <div class="section__title white-title mb-15">
                                    <span class="sub-title">Why Choose Us</span>
                                    <h2 class="title">Built Simple, Fast &amp; Reliable For Your Team</h2>
                                </div>
                                <p>No complicated setups. We provide a clean interface, daily automated backups, and 24/7 technical support.</p>
                                <a asp-page="/About" class="tg-btn white-btn">Learn More
                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M1 9L9 1M9 1H1M9 1V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <ul class="choose__list list-wrap">
                                <li>
                                    <i class="bi bi-check-circle-fill text-info fs-4 me-2"></i>
                                    100% Private Workspace For Your Organization
                                </li>
                                <li>
                                    <i class="bi bi-check-circle-fill text-info fs-4 me-2"></i>
                                    Works Smoothly On Mobile Phones &amp; Laptops
                                </li>
                                <li>
                                    <i class="bi bi-check-circle-fill text-info fs-4 me-2"></i>
                                    Automatic Daily Backups &amp; Data Protection
                                </li>
                                <li>
                                    <i class="bi bi-check-circle-fill text-info fs-4 me-2"></i>
