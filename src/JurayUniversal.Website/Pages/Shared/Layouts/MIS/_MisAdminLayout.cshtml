<body class="bg-gray-50">
    <div id="root">
        <div class="min-h-screen flex flex-col">
            <!-- Sidebar Mobile Backdrop -->
            <div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden transition-opacity duration-300"></div>

            <!-- Sidebar Layout Component -->
            <div id="sidebar" class="fixed left-0 top-0 h-full bg-white border-r border-gray-200 transition-all duration-300 ease-in-out z-50 flex flex-col w-80 -translate-x-full lg:translate-x-0">
                <div class="h-16 flex items-center justify-start border-b border-gray-200 flex-shrink-0 px-6 py-2">
                    <partial name="~/Pages/Shared/Layouts/MIS/_MisLogo.cshtml" />
                </div>
                <nav class="flex-1 overflow-y-auto overflow-x-hidden px-4 py-6 sidebar-scroll">
                    <ul class="space-y-1">
                        @if (isPlatform)
                        {
                            <partial name="~/Pages/Shared/Layouts/MIS/_MisUserSidebar.cshtml" />
                        }
                        else
                        {
                            <partial name="~/Pages/Shared/Layouts/MIS/_MisAdminSidebar.cshtml" />
                        }
                    </ul>
                    <div class="h-14"></div>
                </nav>
            </div>

            <!-- Topbar Layout Component -->
            <div id="topbar" class="fixed top-0 h-16 bg-white border-b border-gray-100 flex items-center justify-between z-50 transition-all duration-300 left-0 right-0 lg:left-80 px-4 lg:px-6">
                <div class="flex items-center space-x-3 lg:space-x-6">
                    <button id="sidebar-toggle-btn" class="p-2 rounded-lg hover:bg-gray-50 transition-colors duration-200" title="Toggle Sidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" color="currentColor" class="text-black lg:w-6 lg:h-6">
                            <path d="M2 12C2 8.31087 2 6.4663 2.81382 5.15877C3.1149 4.67502 3.48891 4.25427 3.91891 3.91554C5.08116 3 6.72077 3 10 3H14C17.2792 3 18.9188 3 20.0811 3.91554C20.5111 4.25427 20.8851 4.67502 21.1862 5.15877C22 6.4663 22 8.31087 21.1862 18.8412C20.8851 19.325 20.5111 19.7457 20.0811 20.0845C18.9188 21 17.2792 21 14 21H10C6.72077 21 5.08116 21 3.91891 20.0845C3.48891 19.7457 3.1149 19.325 2.81382 18.8412C2 17.5337 2 15.6891 2 12Z" stroke="currentColor" stroke-width="1.5"></path>
                            <path d="M9.5 3L9.5 21" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path>
                            <path d="M5 7H6M5 10H6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                        </svg>
                    </button>
                </div>
                <div class="flex items-center space-x-2 lg:space-x-4">
                    <!-- Notifications Dropdown -->
                    <div class="relative">
                        <button id="notification-btn" class="relative p-2 rounded-lg hover:bg-gray-50 transition-colors duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" color="currentColor" class="text-black lg:w-5 lg:h-5">
                                <path d="M15.5 18C15.5 19.933 13.933 21.5 12 21.5C10.067 21.5 8.5 19.933 8.5 18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                                <path d="M19.2311 18H4.76887C3.79195 18 3 17.208 3 16.2311C3 15.762 3.18636 15.3121 3.51809 14.9803L4.12132 14.3771C4.68393 13.8145 5 13.0514 5 12.2558V9.5C5 5.63401 8.13401 2.5 12 2.5C15.866 2.5 19 5.634 19 9.5V12.2558C19 13.0514 19.3161 13.8145 19.8787 14.3771L20.4819 14.9803C20.8136 15.3121 21 15.762 21 16.2311C21 17.208 20.208 18 19.2311 18Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                            </svg>
                            @if (pendingNotifications.Any())
                            {
                                <span class="absolute -top-1 -right-1 h-4 w-4 bg-red-500 rounded-full text-[10px] text-white font-bold flex items-center justify-center">@pendingNotifications.Count</span>
                            }
                        </button>
                    </div>

                    @if (User.IsInRole("mSuperAdmin"))
                    {
                        <form action="/api/mis-toggle/toggle" method="post" class="inline-block">
                            <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-lg transition-colors">
                                Switch to Old MIS
                            </button>
                        </form>
                    }

                    <!-- User Profile Dropdown Menu -->
                    <div class="relative">
                        <button id="profile-menu-btn" class="flex items-center space-x-2 lg:space-x-3 p-2 rounded-lg hover:bg-gray-50 border border-transparent hover:border-gray-200 transition-all duration-200">
                            <div class="w-8 h-8 lg:w-10 lg:h-10 bg-[#0069A1] rounded-full flex items-center justify-center shadow-sm">
                                <span class="text-sm lg:text-base font-semibold text-white">@userInitials</span>
                            </div>
                            <div class="hidden lg:block text-left">
                                <p class="text-sm font-medium text-gray-900 leading-tight">@userFullName</p>
                                <p class="text-xs text-gray-500 uppercase truncate max-w-[120px]">@roleDisplayBadge</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor" class="text-gray-400 transition-transform duration-200 chevron-icon">
                                <path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                            </svg>
                        </button>
                        <div id="profile-menu-dropdown" class="absolute right-0 mt-2 w-72 bg-white rounded-xl shadow-xl border border-gray-100 py-2 hidden z-50 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-gray-100 flex items-center space-x-3">
                                <div class="w-10 h-10 bg-[#0069A1] rounded-full flex items-center justify-center text-white font-semibold text-base shadow-sm">@userInitials</div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-semibold text-gray-900 leading-tight truncate">@userFullName</p>
                                    <p class="text-xs text-gray-500 truncate mt-0.5">@userEmail</p>
                                    <span class="inline-block mt-1 text-[10px] font-bold text-[#0069A1] bg-blue-50 px-2 py-0.5 rounded uppercase tracking-wider">@roleDisplayBadge</span>
                                </div>
                            </div>
                            <div class="py-1">
                                @if (hasAdminRole)
                                {
                                    if (isPlatform)
                                    {
                                        <a asp-area="MIS" asp-page="/Dashboard/Index" class="flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#0069A1] font-medium transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-3 text-gray-400"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            Switch to Admin View
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-area="MIS" asp-page="/Platform/Index" class="flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#0069A1] font-medium transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-3 text-gray-400"><path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/><path d="M2 17L12 22L22 17" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M2 12L12 17L22 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
                                            Switch to Member View
                                        </a>
                                    }
                                    <div class="border-t border-gray-100 my-1"></div>
                                }

                                <a asp-area="MisUserManagement" asp-page="/Platform/MyProfile" class="flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#0069A1] font-medium transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-3 text-gray-400">
                                        <path d="M13 7C13 9.20914 11.2091 11 9 11C6.79086 11 5 9.20914 5 7C5 4.79086 6.79086 3 9 3C11.2091 3 13 4.79086 13 7Z" stroke="currentColor" stroke-width="1.5"></path>
                                        <path d="M11 14H7C4.23858 14 2 16.2386 2 19C2 20.1046 2.89543 21 4 21H14C16.1046 21 16 20.1046 16 19C16 16.2386 13.7614 14 11 14Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path>
                                    </svg>
                                    My Profile
                                </a>
                                <a asp-area="MisUserManagement" asp-page="/Platform/ChangePassword" class="flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#0069A1] font-medium transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-3 text-gray-400">
                                        <path d="M15.5 12C15.5 13.933 13.933 15.5 12 15.5C10.067 15.5 8.5 13.933 8.5 12C8.5 10.067 10.067 8.5 12 8.5C13.933 8.5 15.5 10.067 15.5 12Z" stroke="currentColor" stroke-width="1.5"></path>
                                    </svg>
                                    Security &amp; 2FA
                                </a>
                                <div class="border-t border-gray-100 my-1"></div>

                                <form asp-area="V2" asp-page="/AuthV2/Account/Logout" method="get">
                                    <button type="submit" class="w-full text-left flex items-center px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 font-medium transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" color="currentColor" class="mr-3 text-red-500">
                                            <path d="M15 12H3M3 12L7 8M3 12L7 16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                                            <path d="M9 4.5H16.5C18.433 4.5 20 6.067 20 8V16C20 17.933 18.433 19.5 16.5 19.5H9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                                        </svg>
                                        Log Out
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Container -->
            <main id="main-content" class="transition-all duration-300 main-content-scroll flex-1 ml-0 lg:ml-80 mt-16 p-4 sm:p-6">
                @if (ViewData["Title"] != null)
                {
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 gap-4">
                        <div>
                            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-1">@ViewData["Title"]</h1>
                            @if (ViewData["Subtitle"] != null)
                            {
                                <p class="text-sm text-gray-600">@ViewData["Subtitle"]</p>
                            }
                        </div>
                        <div class="flex items-center space-x-3">
                            @{
                                string currentRoutePage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                                bool isIndexPage = currentRoutePage.EndsWith("/Index", StringComparison.OrdinalIgnoreCase);
                                bool showBackButton = ViewData["ShowBackButton"] as bool? ?? !isIndexPage;
                                string backUrl = ViewData["BackUrl"] as string ?? "javascript:history.back()";
                            }
                            @if (showBackButton)
                            {
                                <a href="@backUrl" class="px-3.5 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors">
                                    Back
                                </a>
                            }
                            <button type="button" data-bs-toggle="offcanvas" data-bs-target="#misHelpOffcanvas" class="px-3.5 py-2 text-sm font-medium text-[#0069A1] bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
                                Help &amp; Guide
                            </button>
                            @RenderSection("HeaderActions", required: false)
                        </div>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Floating Scroll Widget -->
            <div id="scroll-widget" class="fixed right-3 top-1/2 -translate-y-1/2 z-40 transition-all duration-300 opacity-0 translate-x-4 pointer-events-none">
                <div class="flex flex-col items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-200 rounded-full px-1.5 py-2 shadow-md">
                    <button id="btn-scroll-top" class="w-7 h-7 rounded-full flex items-center justify-center text-gray-400 hover:text-[#0069A1] hover:bg-[#0069A1]/10 transition-colors duration-200" title="Scroll to top">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" color="currentColor">
                            <path d="M17.9998 15C17.9998 15 13.5809 9.00001 11.9998 9C10.4187 8.99999 5.99985 15 5.99985 15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                        </svg>
                    </button>
                    <div class="w-1 h-24 bg-gray-200 rounded-full relative overflow-hidden">
                        <div id="scroll-progress-bar" class="absolute top-0 left-0 w-full bg-[#0069A1] rounded-full transition-all duration-150 ease-out" style="height: 0%;"></div>
                    </div>
                    <button id="btn-scroll-bottom" class="w-7 h-7 rounded-full flex items-center justify-center text-gray-400 hover:text-[#0069A1] hover:bg-[#0069A1]/10 transition-colors duration-200" title="Scroll to bottom">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" color="currentColor">
                            <path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <partial name="Layouts/MIS/_MisContextualHelp" />
    <partial name="Layouts/MIS/_MisScript" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
