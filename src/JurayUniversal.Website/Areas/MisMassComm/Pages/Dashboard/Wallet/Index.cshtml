@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Dashboard.Wallet.IndexModel
@{
    ViewData["Title"] = "SMS Wallet Transactions";
    ViewData["Subtitle"] = "Ledger history of all deposits and deductions for SMS campaigns.";
}

@section HeaderActions {
    <a asp-page="./Fund" class="btn btn-success rounded-pill px-4">
        <i class="bi bi-cash-stack me-1"></i> Add Funds
    </a>
}

<div class="row mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm bg-primary text-white rounded-4 overflow-hidden position-relative">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-white-50">CURRENT BALANCE</h6>
                    <i class="bi bi-wallet2 fs-4 opacity-50"></i>
                </div>
                <h3 class="mb-0 fw-bold">&#8358;@Model.CurrentBalance.ToString("N2")</h3>
            </div>
            <!-- Decorative circle -->
            <div class="position-absolute rounded-circle bg-white opacity-10" style="width: 100px; height: 100px; top: -20px; right: -20px;"></div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Description</th>
                        <th class="pe-4">Reference</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transactions.Any())
                    {
                        foreach (var tx in Model.Transactions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@tx.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@tx.CreatedAt.ToString("hh:mm tt")</small>
                                </td>
                                <td>
                                    @if (tx.TransactionType == JurayUniversal.Domain.Enum.Enum.MisWalletTransactionType.Credit)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2"><i class="bi bi-arrow-down-left me-1"></i> Deposit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2"><i class="bi bi-arrow-up-right me-1"></i> Deduction</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold @(tx.TransactionType == JurayUniversal.Domain.Enum.Enum.MisWalletTransactionType.Credit ? "text-success" : "")">
                                        @(tx.TransactionType == JurayUniversal.Domain.Enum.Enum.MisWalletTransactionType.Credit ? "+" : "-")&#8358;@tx.Amount.ToString("N2")
                                    </span>
                                </td>
                                <td>
                                    @if (tx.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Success)
                                    {
                                        <span class="badge bg-success">Success</span>
                                    }
                                    else if (tx.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (tx.Status == JurayUniversal.Domain.Enum.Enum.PaymentStatus.Failed)
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@tx.Status</span>
                                    }
                                </td>
                                <td>@tx.Description</td>
                                <td class="pe-4"><code class="text-secondary bg-light px-2 py-1 rounded">@tx.Reference</code></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-receipt display-4 d-block mb-3 opacity-50"></i>
                                    <h5>No Transactions Found</h5>
                                    <p>Your SMS wallet ledger is currently empty.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
