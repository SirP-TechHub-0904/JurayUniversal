@page
@model JurayUniversal.Website.Areas.MisGroups.Pages.Dashboard.DetailModel
@using JurayUniversal.Website.Areas.MisGroups.Pages.Platform
@inject JurayUniversal.Website.Services.IMisAuthorizationService MisAuth
@{
    ViewData["Title"] = "Manage " + Model.GroupAlias;
    ViewData["ActiveMenu"] = "MisGroups";
    var groupToken = WorkspaceModel.GetGroupToken(Model.MisGroup.Id);
}

@section HeaderActions {
    <a asp-page="/Platform/Workspace" asp-route-token="@groupToken" class="btn btn-success rounded-pill px-4 me-2">
        <i class="bi bi-chat-dots me-1"></i> Open Chat Workspace
    </a>
    <a asp-page="./List" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to @Model.GroupAlias List
    </a>
}

<div class="page-content bg-light p-0 p-md-4 mt-4" style="min-height: 100vh;">
    <div class="row g-4">
        <!-- Members List -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i> Members & Invites</h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">
                        Total: @Model.Members.Count
                    </span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="membersTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="py-3">Member</th>
                                    <th class="py-3">Role</th>
                                    <th class="py-3">Status</th>
                                    <th class="py-3 text-nowrap">Date Joined</th>
                                    <th class="py-3 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Members)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold flex-shrink-0" style="width:40px; height:40px;">
                                                    @(item.UserProfile?.FirstName?.Substring(0, 1) ?? "U")
                                                </div>
                                                <div class="overflow-hidden">
                                                    <div class="fw-bold text-dark text-truncate">@item.UserProfile?.FirstName @item.UserProfile?.LastName</div>
                                                    <div class="text-muted fs-7 text-truncate">@item.UserProfile?.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                                @(string.IsNullOrWhiteSpace(item.RolePosition) ? "Member" : item.RolePosition)
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.MembershipStatus == "Active")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Active</span>
                                            }
                                            else if (item.MembershipStatus == "Pending")
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2">Invite Pending</span>
                                            }
                                            else if (item.MembershipStatus == "Suspended")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">Suspended</span>
                                            }
                                        </td>
                                        <td class="text-muted fs-7 text-nowrap">@item.DateJoined.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            @if (await MisAuth.CanEditAsync(User, "MisGroups"))
                                            {
                                                <div class="dropdown d-inline-block">
                                                    <button class="btn btn-sm btn-light rounded-pill border px-3 dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bi bi-gear me-1"></i> Actions
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                                        <li>
                                                            <a class="dropdown-item py-2" asp-page="/Platform/Workspace" asp-route-token="@groupToken">
                                                                <i class="bi bi-chat-dots text-success me-2"></i> Chat Workspace
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form method="post" asp-page-handler="ToggleStatus" asp-route-memberId="@item.Id" asp-route-id="@Model.MisGroup.Id">
                                                                @if (item.MembershipStatus == "Suspended")
                                                                {
                                                                    <button type="submit" class="dropdown-item py-2 text-success">
                                                                        <i class="bi bi-play-circle me-2"></i> Activate Member
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="submit" class="dropdown-item py-2 text-warning">
                                                                        <i class="bi bi-pause-circle me-2"></i> Suspend Member
                                                                    </button>
                                                                }
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form method="post" asp-page-handler="Remove" asp-route-memberId="@item.Id" asp-route-id="@Model.MisGroup.Id" onsubmit="return confirm('Are you sure you want to remove this member?');">
                                                                <button type="submit" class="dropdown-item py-2 text-danger">
                                                                    <i class="bi bi-trash me-2"></i> Remove Member
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Members.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-5">No members or pending invites recorded yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Invite Panel -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-link-45deg text-primary me-2 fs-5"></i> Shareable Invite Link</h6>
                    <div class="input-group">
                        <input type="text" id="inviteLinkInput" class="form-control bg-light fs-7" value="@Url.Page("/Platform/Join", null, new { area = "MisGroups", token = Model.ObfuscatedInviteToken }, Request.Scheme)" readonly />
                        <button class="btn btn-primary px-3" type="button" onclick="navigator.clipboard.writeText(document.getElementById('inviteLinkInput').value); alert('Invite link copied to clipboard!')"><i class="bi bi-clipboard me-1"></i> Copy</button>
                    </div>
                    <small class="form-text text-muted mt-2 d-block fs-7">Users with this secure link can request to join this @Model.GroupAlias.ToLower().</small>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-person-plus-fill text-success me-2 fs-5"></i> Send Direct Invite</h6>
                    @if (await MisAuth.CanEditAsync(User, "MisGroups"))
                    {
                        <form method="post" asp-page-handler="Invite" asp-route-id="@Model.MisGroup.Id">
                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold fs-7">Select User</label>
                                <select asp-for="SelectedUserId" class="form-select" required>
                                    <option value="">-- Choose User --</option>
                                    @foreach (var u in Model.AvailableUsers)
                                    {
                                        <option value="@u.Id">@u.FirstName @u.LastName (@u.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-4">
                                <label class="form-label text-muted fw-semibold fs-7">Assign Role (Optional)</label>
                                <input asp-for="RolePosition" class="form-control" placeholder="Default: Member" />
                                <small class="text-muted fs-7">Leave blank to assign default 'Member' role.</small>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-bold"><i class="bi bi-send-fill me-2"></i> Send Invitation</button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">You do not have permission to invite members.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($('#membersTable').length && $.fn.DataTable) {
                $('#membersTable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search members..."
                    }
                });
            }
        });
    </script>
}
