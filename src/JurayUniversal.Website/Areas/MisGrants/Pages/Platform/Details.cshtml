@page
@model JurayUniversal.Website.Areas.MisGrants.Pages.Platform.DetailsModel
@{
    ViewData["Title"] = "Grant Progress Details";
    ViewData["Subtitle"] = "View detailed information and associated records.";
}

<div class="container-fluid max-w-5xl mx-auto">

    @{
        var totalReceived = Model.MisGrant.Milestones.Sum(m => m.AmountReceived ?? 0);
        var progress = Model.MisGrant.TotalAwardAmount > 0 ? (totalReceived / Model.MisGrant.TotalAwardAmount) * 100 : 0;
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-briefcase fs-1"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Funding Progress</h5>
                    <p class="text-muted small mb-4">Tracking disbursements against the total awarded amount.</p>
                    
                    <div class="position-relative d-inline-block mx-auto mb-3" style="width: 150px; height: 150px;">
                        <!-- Using a simple radial progress visualization via CSS -->
                        <div class="rounded-circle d-flex align-items-center justify-content-center border" style="width: 150px; height: 150px; background: conic-gradient(var(--bs-success) @progress%, var(--bs-light) 0);">
                            <div class="bg-white rounded-circle d-flex flex-column align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                <span class="fs-3 fw-bold text-dark">@progress.ToString("0")%</span>
                                <span class="text-muted small">Funded</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top text-start">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted fw-600">Total Award:</span>
                            <span class="fw-bold">@Model.MisGrant.Currency @Model.MisGrant.TotalAwardAmount.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted fw-600">Received:</span>
                            <span class="fw-bold text-success">@Model.MisGrant.Currency @totalReceived.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Milestones & Disbursement Schedule</h5>
                </div>
                <div class="card-body p-4">
                    <div class="timeline-container">
                        @if (!Model.MisGrant.Milestones.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-4 d-block mb-3 opacity-50"></i>
                                No milestones have been scheduled for this grant.
                            </div>
                        }
                        
                        <ul class="list-unstyled mb-0">
                            @foreach (var milestone in Model.MisGrant.Milestones.OrderBy(m => m.ExpectedDate))
                            {
                                <li class="position-relative ps-4 py-3 border-bottom">
                                    <!-- Timeline line/dot -->
                                    <div class="position-absolute top-50 start-0 translate-middle-y rounded-circle @(milestone.AmountReceived.HasValue ? "bg-success" : "bg-warning")" style="width: 12px; height: 12px; margin-left: 6px;"></div>
                                    
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="fw-bold mb-1">@milestone.Title</h6>
                                            <div class="small text-muted mb-2">Expected by @milestone.ExpectedDate.ToString("dd MMM yyyy")</div>
                                            @if (!string.IsNullOrEmpty(milestone.Note))
                                            {
                                                <div class="bg-light p-2 rounded small text-muted fst-italic">"@milestone.Note"</div>
                                            }
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold mb-1">@Model.MisGrant.Currency @milestone.ExpectedAmount.ToString("N0")</div>
                                            @if (milestone.AmountReceived.HasValue)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">
                                                    <i class="bi bi-check-circle me-1"></i> Received @milestone.ReceivedDate?.ToString("dd MMM yy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2">
                                                    <i class="bi bi-clock me-1"></i> Pending
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
