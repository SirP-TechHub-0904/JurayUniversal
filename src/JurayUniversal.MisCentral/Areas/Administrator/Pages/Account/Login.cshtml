@page "/Administrator/Account/Login"
@model JurayUniversal.MisCentral.Areas.Administrator.Pages.Account.LoginModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "MIS Central Staff Portal - Secure Login";
}

<section class="min-h-screen pt-32 pb-20 flex items-center relative overflow-hidden bg-slate-900">
    <!-- Ambient glowing accents -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container mx-auto px-4 max-w-lg relative z-10">
        <!-- Brand Badge -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
                <i class="bi bi-shield-lock-fill"></i> Central Command Hub
            </div>
            <h1 class="text-3xl font-extrabold text-white tracking-tight">Master Admin Login</h1>
            <p class="text-slate-400 text-sm mt-2">Sign in to manage client accounts, features, and platform settings.</p>
        </div>

        <div class="bg-slate-800/80 backdrop-blur-xl border border-slate-700/60 rounded-2xl shadow-2xl p-8">
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="ModelOnly" class="p-3.5 mb-6 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-xs leading-relaxed" role="alert"></div>

                <div class="mb-5">
                    <label asp-for="Input.Email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Staff Email / Username</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <input asp-for="Input.Email" class="w-full pl-10 pr-4 py-3 bg-slate-900/90 border border-slate-700 text-white rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder-slate-500" placeholder="admin@exwhyzee.ng" autofocus autocomplete="username" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div class="mb-5">
                    <div class="flex items-center justify-between mb-2">
                        <label asp-for="Input.Password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Access Password</label>
                        <a href="/Administrator/Account/ForgotPassword" class="text-xs text-blue-400 hover:text-blue-300 transition-colors">Forgot Password?</a>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <input asp-for="Input.Password" type="password" class="w-full pl-10 pr-4 py-3 bg-slate-900/90 border border-slate-700 text-white rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder-slate-500" placeholder="••••••••••••" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between mb-6">
                    <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-400">
                        <input asp-for="Input.RememberMe" type="checkbox" class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-blue-500 focus:ring-offset-slate-900" />
                        <span>Remember credentials</span>
                    </label>
                </div>

                <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition-all flex items-center justify-center gap-2">
                    <span>Sign In to Dashboard</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <div class="mt-6 pt-6 border-t border-slate-700/60 text-center">
                <p class="text-xs text-slate-400 mb-3">Looking for your organization's portal?</p>
                <a href="/Contact" class="inline-flex items-center gap-2 text-xs font-medium text-blue-400 hover:text-blue-300 bg-slate-900/60 px-4 py-2 rounded-lg border border-slate-700 hover:border-slate-600 transition-all">
                    <i class="bi bi-buildings"></i> Find Your Workspace &rarr;
                </a>
            </div>
        </div>

        <div class="mt-6 text-center text-xs text-slate-500">
            Exwhyzee MIS Central &bull; Fast, Secure, and Reliable Management
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
