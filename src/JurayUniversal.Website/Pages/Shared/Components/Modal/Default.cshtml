@using System.Text.RegularExpressions;

@{
    Regex regex = new Regex("[^a-zA-Z0-9]");
    Domain.Models.PostModal xmodal = ViewBag.modal;
}
 
@if (xmodal != null)
{
    <div class="modal fade" id="mainModal" tabindex="-1" role="dialog" aria-labelledby="mainModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document" style="max-width: 700px; width: 90%; margin: 1.75rem auto;">
            <div class="modal-content" style="border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: none;">
                <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; border-bottom: 1px solid #eee;">
                    <h5 class="modal-title" id="mainModalLabel" style="margin: 0; font-size: 1.1rem; font-weight: 600;">
                        @if (xmodal.ShowOnlyImage == false && xmodal.ShowTitle == true && !string.IsNullOrEmpty(xmodal.Title))
                        {
                            @xmodal.Title
                        }
                    </h5>
                    <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal()" style="background: none; border: none; font-size: 1.5rem; line-height: 1; cursor: pointer; color: #6c757d; padding: 0;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="padding: 20px;">
                    @if (xmodal.ShowOnlyImage == false)
                    {
                        @if (xmodal.ShowTitle == true && !string.IsNullOrEmpty(xmodal.Title))
                        {
                            <div style="margin-bottom: 15px;">
                                <a asp-page="/Source" asp-route-id="@xmodal.ButtonLink" asp-route-title="@regex.Replace(xmodal.Title, "-")">
                                    <h3 style="margin: 0; font-size: 1.3rem;">@xmodal.Title</h3>
                                </a>
                            </div>
                        }
                        @if (xmodal.ShowImage == true && xmodal.ShowOnlyImage == false && !string.IsNullOrEmpty(xmodal.ImageUrl))
                        {
                            <div style="margin: 0 auto 15px auto !important; text-align: center;">
                                <a asp-page="/Source" asp-route-id="@xmodal.ButtonLink" asp-route-title="@regex.Replace(xmodal.Title ?? "modal", "-")">
                                    <img src="@xmodal.ImageUrl" alt="@xmodal.Title" class="img-fluid img-responsive" style="max-height: 400px; object-fit: contain; margin: 0 auto !important;" />
                                </a>
                            </div>
                        }
                        @if (xmodal.ShowDescription == true && !string.IsNullOrEmpty(xmodal.Description))
                        {
                            <div>
                                <a asp-page="/Source" asp-route-id="@xmodal.ButtonLink" asp-route-title="@regex.Replace(xmodal.Title ?? "modal", "-")">
                                    @Html.Raw(xmodal.Description)
                                </a>
                            </div>
                        }
                    }
                    else if (xmodal.ShowOnlyImage == true && !string.IsNullOrEmpty(xmodal.ImageUrl))
                    {
                        <div style="margin: 0 auto !important; text-align: center;">
                            <a asp-page="/Source" asp-route-id="@xmodal.ButtonLink" asp-route-title="@regex.Replace(xmodal.Title ?? "modal", "-")">
                                <img src="@xmodal.ImageUrl" alt="@xmodal.Title" class="img-fluid img-responsive" style="max-height: 500px; object-fit: contain; margin: 0 auto !important;" />
                            </a>
                        </div>
                    }
                </div>
                <div class="modal-footer" style="display: flex; justify-content: flex-end; padding: 12px 20px; border-top: 1px solid #eee;">
                    <button type="button" class="btn btn-secondary btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closeModal()">Close</button>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>

    <script>
        function closeModal() {
            try {
                if (typeof $ !== 'undefined' && $.fn && $.fn.modal) {
                    $('#mainModal').modal('hide');
                }
            } catch (e) {
                console.warn('jQuery modal hide error:', e);
            }

            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    var modalEl = document.getElementById('mainModal');
                    if (modalEl) {
                        var modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }
                }
            } catch (e) {
                console.warn('Bootstrap modal hide error:', e);
            }

            // Universal DOM Cleanup fallback: remove modal display, backdrops, and body lock
            setTimeout(function () {
                var modalEl = document.getElementById('mainModal');
                if (modalEl) {
                    modalEl.classList.remove('show');
                    modalEl.style.display = 'none';
                    modalEl.setAttribute('aria-hidden', 'true');
                    modalEl.removeAttribute('aria-modal');
                }
                var backdrops = document.querySelectorAll('.modal-backdrop');
                backdrops.forEach(function (bd) {
                    bd.remove();
                });
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
            }, 100);
        }

        // Handle clicking directly on the backdrop outside the dialog to dismiss
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('mainModal');
            if (modalEl) {
                modalEl.addEventListener('click', function (e) {
                    if (e.target === modalEl) {
                        closeModal();
                    }
                });
            }
        });

        // Trigger opening modal according to frequency
        function showWebsiteModal() {
            var modalShownTime = localStorage.getItem('modalShownTime');
            var currentTime = new Date().getTime();
            var timeDifference = currentTime - (parseInt(modalShownTime) || 0);

            // Convert time difference to minutes (60 mins threshold)
            var minutesDifference = Math.floor(timeDifference / (1000 * 60));

            if (!modalShownTime || minutesDifference >= 60) {
                var modalEl = document.getElementById('mainModal');
                if (!modalEl) return;

                var opened = false;
                try {
                    if (typeof $ !== 'undefined' && $.fn && $.fn.modal) {
                        $('#mainModal').modal('show');
                        opened = true;
                    }
                } catch (err) {
                    console.warn('jQuery modal show failed:', err);
                }

                if (!opened) {
                    try {
                        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                            var bsModal = bootstrap.Modal.getOrCreateInstance ? bootstrap.Modal.getOrCreateInstance(modalEl) : new bootstrap.Modal(modalEl);
                            bsModal.show();
                            opened = true;
                        }
                    } catch (err) {
                        console.warn('Bootstrap modal show failed:', err);
                    }
                }

                if (!opened) {
                    // Fallback manual display
                    modalEl.classList.add('show');
                    modalEl.style.display = 'block';
                    modalEl.removeAttribute('aria-hidden');
                    modalEl.setAttribute('aria-modal', 'true');
                    document.body.classList.add('modal-open');
                }

                localStorage.setItem('modalShownTime', currentTime.toString());
            }
        }

        if (document.readyState === 'complete') {
            showWebsiteModal();
        } else {
            window.addEventListener('load', showWebsiteModal);
        }
    </script>
}