@page
@model JurayUniversal.Website.Areas.MIS.Pages.Platform.IndexModel
@{
    ViewData["Title"] = "My Platform Dashboard";
    ViewData["ActiveMenu"] = "Dashboard";
}

<style>
    /* Premium Dashboard Styles */
    .premium-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        border: 1px solid rgba(255,255,255,0.8);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
        overflow: hidden;
    }
    .premium-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    }
    .hero-banner {
        background: linear-gradient(135deg, #2D1B69 0%, #4625A9 50%, #6830F0 100%);
        border-radius: 24px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(104, 48, 240, 0.25);
    }
    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 50%);
        transform: rotate(30deg);
        pointer-events: none;
    }
    .hero-banner::after {
        content: '';
        position: absolute;
        right: -10%;
        bottom: -20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
    }
    .hero-avatar-wrapper {
        position: relative;
        display: inline-block;
        z-index: 2;
    }
    .hero-avatar-wrapper::after {
        content: '';
        position: absolute;
        bottom: 8px;
        right: 8px;
        width: 22px;
        height: 22px;
        background: #10b981;
        border: 4px solid #fff;
        border-radius: 50%;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }
    .glass-badge {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        font-weight: 600;
        letter-spacing: 0.5px;
    }
    .stats-icon-wrapper {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        background: linear-gradient(135deg, rgba(104, 48, 240, 0.1) 0%, rgba(104, 48, 240, 0.02) 100%);
        color: #6830F0;
        border: 1px solid rgba(104, 48, 240, 0.1);
    }
    .stats-icon-wrapper.success {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(16, 185, 129, 0.02) 100%);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.1);
    }
    .quick-action-btn {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        border-radius: 14px;
        border-width: 2px;
        font-weight: 600;
        background: #ffffff;
    }
    .quick-action-btn:hover {
        transform: translateX(8px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }
    .glass-role-card {
        background: linear-gradient(to right, rgba(255,255,255,1) 0%, rgba(248,249,250,1) 100%);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 16px;
        transition: all 0.3s ease;
    }
    .glass-role-card:hover {
        transform: scale(1.02);
        box-shadow: 0 10px 20px rgba(0,0,0,0.04);
        border-color: rgba(104, 48, 240, 0.2);
    }
</style>

<div class="page-heading mb-4">
    <div class="row align-items-end">
        <div class="col-12 col-md-6 mb-3 mb-md-0">
            <h2 class="fw-bolder mb-1" style="letter-spacing: -0.5px;">My Workspace</h2>
            <p class="text-subtitle text-muted mb-0 fs-6">Welcome back! Here is your personalized performance and access overview.</p>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <div class="d-inline-flex align-items-center bg-white rounded-pill px-4 py-2 shadow-sm border">
                <div class="bg-primary rounded-circle me-3" style="width: 8px; height: 8px;"></div>
                <span class="fw-bold text-dark fs-6">@DateTime.UtcNow.AddHours(1).ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>
</div>

<div class="page-content">
    <div class="row g-4">
        <!-- Main Content Area -->
        <div class="col-12 col-xl-8">
            <!-- Hero Profile Banner -->
            <div class="hero-banner p-4 p-md-5 mb-4">
                <div class="row align-items-center position-relative" style="z-index: 2;">
                    <div class="col-12 col-md-auto text-center text-md-start mb-4 mb-md-0">
                        <div class="hero-avatar-wrapper">
                            @if (!string.IsNullOrEmpty(Model.CurrentUser.PassportFilePathUrl))
                            {
                                <img src="@Model.CurrentUser.PassportFilePathUrl" class="rounded-circle shadow-lg" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid rgba(255,255,255,0.9);" alt="Profile Picture">
                            }
                            else
                            {
                                <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-extrabold shadow-lg mx-auto" style="width: 120px; height: 120px; font-size: 2.5rem; border: 4px solid rgba(255,255,255,0.9);">
                                    @((Model.CurrentUser.FirstName?[0].ToString() ?? "") + (Model.CurrentUser.LastName?[0].ToString() ?? ""))
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md text-center text-md-start ps-md-4">
                        <h1 class="text-white fw-bolder mb-2" style="letter-spacing: -1px; text-shadow: 0 2px 10px rgba(0,0,0,0.2);">Hello, @Model.CurrentUser.GetFullName()</h1>
                        <p class="mb-4 fs-6 text-white-50" style="font-weight: 500;">
                            <i class="bi bi-envelope-at me-2"></i>@Model.CurrentUser.Email
                        </p>
                        <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-3">
                            <span class="badge glass-badge px-4 py-2 rounded-pill fs-7">
                                <i class="bi bi-person-workspace me-2"></i> Staff Member
                            </span>
                            <span class="badge glass-badge px-4 py-2 rounded-pill fs-7" style="background: rgba(16, 185, 129, 0.2); border-color: rgba(16, 185, 129, 0.5); color: #fff;">
                                <i class="bi bi-shield-check me-2"></i> Active Account
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Widgets -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6">
                    <div class="premium-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="stats-icon-wrapper">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div class="text-end">
                                <h2 class="font-extrabold mb-0 text-dark" style="font-size: 2.5rem; letter-spacing: -1px;">@Model.FeatureRoles.Count</h2>
                            </div>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Feature Permissions</h5>
                        <p class="text-muted mb-0 fs-7">Active systems you are explicitly authorized to access and interact with.</p>
                        
                        <!-- Mini progress bar decoration -->
                        <div class="progress mt-4" style="height: 6px; border-radius: 10px; background-color: rgba(104, 48, 240, 0.1);">
                            <div class="progress-bar" style="width: 75%; background-color: #6830F0; border-radius: 10px;"></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="premium-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="stats-icon-wrapper success">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div class="text-end">
                                <h2 class="font-extrabold mb-0 text-dark" style="font-size: 2.5rem; letter-spacing: -1px;">@Model.KpiHistory.Count</h2>
                            </div>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">KPI Evaluations</h5>
                        <p class="text-muted mb-0 fs-7">Total performance reviews successfully completed across all periods.</p>
                        
                        <!-- Mini progress bar decoration -->
                        <div class="progress mt-4" style="height: 6px; border-radius: 10px; background-color: rgba(16, 185, 129, 0.1);">
                            <div class="progress-bar bg-success" style="width: 100%; border-radius: 10px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Feature Permissions Detailed View -->
            <div class="premium-card mb-4">
                <div class="card-header border-bottom bg-transparent p-4 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                        <i class="bi bi-list-check fs-5"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-dark">Assigned Action Roles</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.FeatureRoles.Count == 0)
                    {
                        <div class="text-center py-5">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-shield-slash text-muted fs-1"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">No Access Roles Assigned</h5>
                            <p class="text-muted mb-0 mx-auto" style="max-width: 400px;">You currently do not have any specific feature-level permission roles assigned to your account.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var role in Model.FeatureRoles)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="glass-role-card p-3 h-100 d-flex flex-column justify-content-between">
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="bg-primary text-white rounded p-2 me-3 shadow-sm">
                                                <i class="bi bi-box fs-5"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark">@role.FeatureAreaKey</h6>
                                                <small class="text-muted fw-semibold">Granted: @role.Date.ToString("MMM dd, yyyy")</small>
                                            </div>
                                        </div>
                                        <div>
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill w-100 text-center fw-bold fs-7 border border-primary border-opacity-25">
                                                Level: @role.ActionRole.ToString()
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Actions & Info -->
        <div class="col-12 col-xl-4">
            
            <!-- Quick Actions -->
            <div class="premium-card mb-4 border-top border-4 border-warning">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4 d-flex align-items-center">
                        <i class="bi bi-lightning-charge-fill text-warning fs-4 me-2"></i> Quick Actions
                    </h5>
                    
                    <div class="d-grid gap-3">
                        <a asp-area="MisUserManagement" asp-page="/Platform/MyProfile" class="btn btn-outline-primary text-start p-3 d-flex align-items-center justify-content-between quick-action-btn">
                            <div class="d-flex align-items-center fw-bold">
                                <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                                    <i class="bi bi-person-lines-fill"></i>
                                </div>
                                View My Profile
                            </div>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </a>

                        <a asp-area="MisUserManagement" asp-page="/Platform/MyKpis" class="btn btn-outline-success text-start p-3 d-flex align-items-center justify-content-between quick-action-btn">
                            <div class="d-flex align-items-center fw-bold">
                                <div class="bg-success bg-opacity-10 text-success rounded p-2 me-3">
                                    <i class="bi bi-activity"></i>
                                </div>
                                Track KPI Scores
                            </div>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </a>

                        <a asp-area="MisUserManagement" asp-page="/Platform/ChangePassword" class="btn btn-outline-danger text-start p-3 d-flex align-items-center justify-content-between quick-action-btn">
                            <div class="d-flex align-items-center fw-bold">
                                <div class="bg-danger bg-opacity-10 text-danger rounded p-2 me-3">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </div>
                                Security & 2FA
                            </div>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </a>
                    
            
        </div>
                </div>
            </div>

            <!-- Profile Info Card -->
            <div class="premium-card mb-4">
                <div class="card-body p-0">
                    <div class="p-4 border-bottom bg-light bg-opacity-50">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                            <i class="bi bi-info-square-fill text-info fs-4 me-2"></i> Account Details
                        </h5>
                    </div>
                    <ul class="list-group list-group-flush p-2">
                        <li class="list-group-item list-group-item-custom d-flex justify-content-between align-items-center px-3 py-3">
                            <div class="d-flex align-items-center text-muted fw-semibold fs-7">
                                <i class="bi bi-fingerprint me-2 fs-5"></i> Username
                            </div>
                            <span class="fw-bold text-dark">@Model.CurrentUser.UserName</span>
                        </li>
                        <li class="list-group-item list-group-item-custom d-flex justify-content-between align-items-center px-3 py-3">
                            <div class="d-flex align-items-center text-muted fw-semibold fs-7">
                                <i class="bi bi-telephone-fill me-2 fs-5 text-muted"></i> Phone
                            </div>
                            <span class="fw-bold text-dark">@(Model.CurrentUser.PhoneNumber ?? "Not Available")</span>
                        </li>
                        <li class="list-group-item list-group-item-custom d-flex justify-content-between align-items-center px-3 py-3">
                            <div class="d-flex align-items-center text-muted fw-semibold fs-7">
                                <i class="bi bi-shield-check me-2 fs-5 text-success"></i> Security
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-bold">Verified</span>
                        </li>
                    </ul>
                </div>
                
                <!-- Security & Leaves Widget -->
                <div class="card premium-card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-transparent border-0 pt-4 pb-0">
                        <h5 class="fw-bold mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <a asp-page="/Platform/Leaves/Index" asp-area="MisUserManagement" class="btn btn-outline-primary w-100 rounded-pill fw-bold mb-3 d-flex align-items-center justify-content-center">
                            <i class="bi bi-calendar-check me-2 fs-5"></i> My Leaves & Excuses
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Context Switch Promo (Visible if Admin) -->
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <div class="premium-card bg-dark text-white border-0 overflow-hidden position-relative">
                    <div class="position-absolute top-0 end-0 p-3 opacity-25">
                        <i class="bi bi-arrow-repeat" style="font-size: 6rem;"></i>
                    </div>
                    <div class="card-body p-4 position-relative z-2">
                        <h5 class="fw-bold text-white mb-2">Switch Views</h5>
                        <p class="text-white-50 fs-7 mb-4">You have administrative privileges. You can switch to the Admin Workspace at any time.</p>
                        <a asp-area="MisUserManagement" asp-page="/Dashboard/Index" class="btn btn-light w-100 rounded-pill fw-bold">Go to Admin View</a>
                    
            
        </div>
                </div>
            }

        </div>
    </div>
</div>


