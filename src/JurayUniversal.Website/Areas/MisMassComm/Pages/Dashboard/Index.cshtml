@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Global Mass Communication";
    ViewData["Subtitle"] = "Analytics and administrative command center for the SMS module.";
}

<style>
    /* Premium Dashboard Styles */
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.05);
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.1);
    }
    .metric-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .action-card {
        border-radius: 16px;
        border: none;
        overflow: hidden;
        position: relative;
        z-index: 1;
        transition: all 0.3s ease;
    }
    .action-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
        z-index: -1;
    }
    .action-card:hover {
        transform: scale(1.03);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    }
    .action-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
        opacity: 0.9;
        transition: transform 0.3s ease;
    }
    .action-card:hover .action-icon {
        transform: scale(1.1) rotate(5deg);
    }
</style>

<!-- TOP KPI CARDS -->
<div class="row g-4 mb-4">
    <!-- Wallet Balance -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card p-4 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Global SMS Wallet</h6>
                    <h3 class="fw-bold mb-0 mt-1 text-primary">&#8358;@Model.CompanyWalletBalance.ToString("N2")</h3>
                </div>
                <div class="metric-icon-wrap bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <a href="/MisMassComm/Dashboard/Wallet/Fund" class="text-decoration-none small fw-bold d-inline-flex align-items-center text-primary">
                Fund Wallet <i class="bi bi-arrow-right-short ms-1"></i>
            </a>
        </div>
    </div>
    
    <!-- Total Campaigns -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card p-4 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Campaigns</h6>
                    <h3 class="fw-bold mb-0 mt-1 text-success">@Model.TotalCampaignsGlobal</h3>
                </div>
                <div class="metric-icon-wrap bg-success bg-opacity-10 text-success">
                    <i class="bi bi-megaphone"></i>
                </div>
            </div>
            <a href="/MisMassComm/Dashboard/Campaigns/Index" class="text-decoration-none small fw-bold d-inline-flex align-items-center text-success">
                View All Campaigns <i class="bi bi-arrow-right-short ms-1"></i>
            </a>
        </div>
    </div>
    
    <!-- Total Deliveries -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card p-4 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Attempted Deliveries</h6>
                    <h3 class="fw-bold mb-0 mt-1 text-indigo">@Model.TotalSmsSentGlobal</h3>
                </div>
                <div class="metric-icon-wrap bg-indigo bg-opacity-10 text-indigo">
                    <i class="bi bi-send-check"></i>
                </div>
            </div>
            <span class="text-muted small fw-bold d-inline-flex align-items-center">
                Across all time
            </span>
        </div>
    </div>
    
    <!-- Active Contacts -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card p-4 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Active Contacts</h6>
                    <h3 class="fw-bold mb-0 mt-1 text-dark">@Model.TotalActiveContactsGlobal</h3>
                </div>
                <div class="metric-icon-wrap bg-dark bg-opacity-10 text-dark">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <a href="/MisMassComm/Dashboard/PhoneBooks/Index" class="text-decoration-none small fw-bold d-inline-flex align-items-center text-dark">
                Manage Directories <i class="bi bi-arrow-right-short ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row g-4 mb-4">
    <!-- Delivery Status Donut Chart -->
    <div class="col-xl-4 col-lg-5">
        <div class="glass-card p-4 h-100">
            <h6 class="fw-bold text-uppercase mb-4" style="font-size: 0.8rem; letter-spacing: 0.5px;">Overall Delivery Success</h6>
            <div id="deliveryChart" class="d-flex justify-content-center"></div>
            
            <div class="row text-center mt-4 pt-3 border-top">
                <div class="col-4">
                    <div class="small text-muted mb-1">Delivered</div>
                    <div class="fw-bold text-success fs-5">@Model.TotalSmsDelivered</div>
                </div>
                <div class="col-4 border-start border-end">
                    <div class="small text-muted mb-1">Pending</div>
                    <div class="fw-bold text-warning fs-5">@Model.TotalSmsPending</div>
                </div>
                <div class="col-4">
                    <div class="small text-muted mb-1">Failed</div>
                    <div class="fw-bold text-danger fs-5">@Model.TotalSmsFailed</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Wallet Usage Bar Chart -->
    <div class="col-xl-8 col-lg-7">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bold text-uppercase mb-0" style="font-size: 0.8rem; letter-spacing: 0.5px;">Wallet Flow (Last 30 Days)</h6>
                <a href="/MisMassComm/Dashboard/Wallet/Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">View Ledger</a>
            </div>
            <div id="walletChart" style="height: 250px;"></div>
        </div>
    </div>
</div>

<!-- BOTTOM ROW: RECENT ACTIVITY & ACTION HUB -->
<div class="row g-4">
    <!-- Recent Campaigns -->
    <div class="col-xl-7">
        <div class="glass-card p-0 h-100 overflow-hidden">
            <div class="p-4 border-bottom bg-light bg-opacity-50">
                <h6 class="fw-bold text-uppercase mb-0" style="font-size: 0.8rem; letter-spacing: 0.5px;">Recent SMS Campaigns</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light bg-opacity-75">
                        <tr>
                            <th class="ps-4 border-0 text-uppercase small text-muted">Date</th>
                            <th class="border-0 text-uppercase small text-muted">Subject</th>
                            <th class="border-0 text-uppercase small text-muted">Cost</th>
                            <th class="border-0 text-uppercase small text-muted pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentCampaigns.Any())
                        {
                            foreach (var camp in Model.RecentCampaigns)
                            {
                                <tr>
                                    <td class="ps-4 text-nowrap"><small class="text-muted">@camp.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                                    <td>
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">@(string.IsNullOrEmpty(camp.Subject) ? "No Subject" : camp.Subject)</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">&#8358;@camp.CostIncurred.ToString("N2")</span></td>
                                    <td class="pe-4">
                                        @{
                                            var statusColor = camp.Status == JurayUniversal.Domain.Enum.Enum.MisSmsCampaignStatus.Completed ? "success" :
                                                              camp.Status == JurayUniversal.Domain.Enum.Enum.MisSmsCampaignStatus.Sending ? "primary" :
                                                              camp.Status == JurayUniversal.Domain.Enum.Enum.MisSmsCampaignStatus.Failed ? "danger" : "secondary";
                                        }
                                        <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor border-opacity-25 rounded-pill">
                                            @camp.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">No recent campaigns found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Administrative Action Hub -->
    <div class="col-xl-5">
        <div class="glass-card p-4 h-100 bg-primary bg-opacity-10 border-primary border-opacity-25">
            <h6 class="fw-bold text-uppercase mb-4 text-primary" style="font-size: 0.8rem; letter-spacing: 0.5px;">Quick Actions</h6>
            
            <div class="row g-3">
                <div class="col-6">
                    <a href="/MisMassComm/Dashboard/Campaigns/Create" class="text-decoration-none text-white">
                        <div class="action-card bg-primary p-4 text-center h-100">
                            <i class="bi bi-rocket-takeoff action-icon"></i>
                            <h6 class="fw-bold mb-0">SMS Blast</h6>
                        </div>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/MisMassComm/Dashboard/Wallet/Fund" class="text-decoration-none text-white">
                        <div class="action-card bg-success p-4 text-center h-100">
                            <i class="bi bi-wallet2 action-icon"></i>
                            <h6 class="fw-bold mb-0">Fund Wallet</h6>
                        </div>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/MisMassComm/Dashboard/Campaigns/Index" class="text-decoration-none text-white">
                        <div class="action-card bg-warning p-4 text-center h-100">
                            <i class="bi bi-clock-history action-icon"></i>
                            <h6 class="fw-bold mb-0 text-dark">Campaigns</h6>
                        </div>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/MisMassComm/Dashboard/PhoneBooks/Index" class="text-decoration-none text-white">
                        <div class="action-card bg-indigo p-4 text-center h-100">
                            <i class="bi bi-journal-bookmark-fill action-icon"></i>
                            <h6 class="fw-bold mb-0">Phone Books</h6>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            
            // 1. Delivery Donut Chart
            var delivered = @Model.TotalSmsDelivered;
            var failed = @Model.TotalSmsFailed;
            var pending = @Model.TotalSmsPending;
            
            // Only render if there's data to avoid a blank circle
            if (delivered > 0 || failed > 0 || pending > 0) {
                var donutOptions = {
                    series: [delivered, pending, failed],
                    labels: ['Delivered', 'Pending', 'Failed'],
                    chart: {
                        type: 'donut',
                        height: 250,
                        fontFamily: 'Inter, sans-serif'
                    },
                    colors: ['#10b981', '#f59e0b', '#ef4444'],
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '75%',
                                labels: {
                                    show: true,
                                    name: { show: false },
                                    value: {
                                        show: true,
                                        fontSize: '24px',
                                        fontWeight: 700,
                                        color: '#111827'
                                    },
                                    total: {
                                        show: true,
                                        showAlways: true,
                                        label: 'Total',
                                        color: '#6b7280',
                                        formatter: function (w) {
                                            return w.globals.seriesTotals.reduce((a, b) => { return a + b }, 0)
                                        }
                                    }
                                }
                            }
                        }
                    },
                    dataLabels: { enabled: false },
                    stroke: { width: 0 },
                    legend: { show: false }
                };
                new ApexCharts(document.querySelector("#deliveryChart"), donutOptions).render();
            } else {
                document.querySelector("#deliveryChart").innerHTML = '<div class="text-muted text-center py-5"><i class="bi bi-pie-chart d-block fs-1 opacity-50 mb-2"></i> No delivery data yet</div>';
            }

            // 2. Wallet Bar Chart (30 Days Aggregated)
            var walletOptions = {
                series: [{
                    name: 'Amount (₦)',
                    data: [@Model.TotalDeposits30Days, @Model.TotalDeductions30Days]
                }],
                chart: {
                    type: 'bar',
                    height: 250,
                    toolbar: { show: false },
                    fontFamily: 'Inter, sans-serif'
                },
                plotOptions: {
                    bar: {
                        borderRadius: 6,
                        columnWidth: '40%',
                        distributed: true,
                    }
                },
                colors: ['#10b981', '#ef4444'], // Green for deposits, Red for deductions
                dataLabels: { enabled: false },
                legend: { show: false },
                xaxis: {
                    categories: ['Wallet Deposits', 'SMS Deductions'],
                    labels: {
                        style: {
                            fontSize: '13px',
                            fontWeight: 600,
                            colors: ['#6b7280', '#6b7280']
                        }
                    },
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: {
                    labels: {
                        formatter: function (val) {
                            return "₦" + val.toLocaleString();
                        },
                        style: { colors: '#6b7280' }
                    }
                },
                grid: {
                    borderColor: '#f3f4f6',
                    strokeDashArray: 4,
                }
            };
            new ApexCharts(document.querySelector("#walletChart"), walletOptions).render();
        });
    </script>
}
