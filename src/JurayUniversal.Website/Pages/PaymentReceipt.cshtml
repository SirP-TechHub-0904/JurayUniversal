@page
@model JurayUniversal.Website.Pages.PaymentReceiptModel

@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">Payment Receipt</h4>
                </div>
                <div class="card-body">

                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["error"]</div>
                    }

                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success">@TempData["success"]</div>
                    }

                    @if (Model.Payment != null)
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <tr>
                                    <th style="width:35%;">Category</th>
                                    <td>@Model.Payment.PaymentCategory?.Name</td>
                                </tr>
                                <tr>
                                    <th>Fullname</th>
                                    <td>
                                        @(
                                                                            !string.IsNullOrWhiteSpace(Model.Payment.Fullname)
                                                                            ? Model.Payment.Fullname
                                                                            : Model.Payment.User?.GetFullName()
                                                                            )
                                    </td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td>
                                        @(
                                                                            !string.IsNullOrWhiteSpace(Model.Payment.Email)
                                                                            ? Model.Payment.Email
                                                                            : Model.Payment.User?.Email
                                                                            )
                                    </td>
                                </tr>
                                <tr>
                                    <th>Phone</th>
                                    <td>
                                        @(
                                                                            !string.IsNullOrWhiteSpace(Model.Payment.Phone)
                                                                            ? Model.Payment.Phone
                                                                            : Model.Payment.User?.PhoneNumber
                                                                            )
                                    </td>
                                </tr>
                                <tr>
                                    <th>Amount Paid</th>
                                    <td>@Model.Payment.AmountPaid</td>
                                </tr>
                                <tr>
                                    <th>Reference</th>
                                    <td>@Model.Payment.PaymentReference</td>
                                </tr>
                                <tr>
                                    <th>Status</th>
                                    <td>@Model.Payment.Status</td>
                                </tr>
                                <tr>
                                    <th>Date</th>
                                    <td>@Model.Payment.DatePaid.ToString("ddd dd MMM, yyyy hh:mm tt")</td>
                                </tr>
                            </table>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary" onclick="window.print()">Print Receipt</button>
                            <a asp-page="/Payments" class="btn btn-secondary">Back to Payments</a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            No payment record found.
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>