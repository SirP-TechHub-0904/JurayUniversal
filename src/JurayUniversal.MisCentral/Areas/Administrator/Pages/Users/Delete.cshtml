@page "/Administrator/Users/Delete"
@model JurayUniversal.MisCentral.Areas.Administrator.Pages.Users.DeleteModel
@{
    Layout = "_MisMasterLayout";
    ViewData["Title"] = "Delete Central Administrator";
}

<div class="max-w-xl mx-auto space-y-6">
    <div class="bg-white rounded-xl border border-red-200 p-6 shadow-sm">
        <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-gray-900">Revoke Master Administrator Access</h1>
                <p class="text-xs text-gray-500">Are you sure you want to permanently remove this Central administrator?</p>
            </div>
        </div>

        @if (Model.TargetUser != null)
        {
            <div class="bg-gray-50 rounded-lg p-4 mb-6 border border-gray-200 space-y-2 text-sm">
                <div>
                    <span class="text-xs text-gray-400 font-medium">Administrator Email:</span>
                    <span class="font-semibold text-gray-800 ml-2">@Model.TargetUser.Email</span>
                </div>
                <div>
                    <span class="text-xs text-gray-400 font-medium">Central Roles:</span>
                    <span class="font-medium text-indigo-700 ml-2">@(Model.Roles.Any() ? string.Join(", ", Model.Roles) : "None")</span>
                </div>
            </div>

            <form method="post">
                <div class="flex items-center justify-end gap-3">
                    <a href="/Administrator/Users" class="px-4 py-2 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-xs font-medium transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="px-5 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium text-xs shadow-sm transition-all flex items-center gap-1.5">
                        <i class="bi bi-trash-fill"></i> Permanently Delete Account
                    </button>
                </div>
            </form>
        }
    </div>
</div>
