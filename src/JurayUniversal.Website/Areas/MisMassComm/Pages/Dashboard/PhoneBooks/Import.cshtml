@page
@model JurayUniversal.Website.Areas.MisMassComm.Pages.Dashboard.PhoneBooks.ImportModel
@{
    ViewData["Title"] = $"Import into {Model.PhoneBook.Name}";
    ViewData["Subtitle"] = "Quickly add multiple contacts to your phone book via paste or CSV.";
}

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-header bg-primary bg-opacity-10 border-bottom-0 py-3">
                <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-clipboard-data me-2"></i> Bulk Copy & Paste</h5>
            </div>
            <div class="card-body p-4 bg-light">
                <form method="post" asp-page-handler="BulkPaste" asp-route-id="@Model.PhoneBook.Id">
                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Paste Numbers</label>
                        <textarea asp-for="BulkNumbers" class="form-control rounded-3 border-0 shadow-sm" rows="8" placeholder="08012345678&#10;08123456789&#10;09087654321"></textarea>
                        <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i> Separate numbers by comma, space, or newline.</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 shadow-sm hover-elevate transition-all fw-bold">
                        <i class="bi bi-cloud-upload me-2"></i> Import Pasted Contacts
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-header bg-success bg-opacity-10 border-bottom-0 py-3">
                <h5 class="mb-0 fw-bold text-success"><i class="bi bi-filetype-csv me-2"></i> Upload CSV File</h5>
            </div>
            <div class="card-body p-4 bg-light">
                <form method="post" asp-page-handler="Csv" asp-route-id="@Model.PhoneBook.Id" enctype="multipart/form-data">
                    <div class="alert alert-success bg-white border border-success border-opacity-25 rounded-3 mb-4 shadow-sm">
                        <div class="d-flex">
                            <i class="bi bi-info-circle-fill text-success fs-4 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1">CSV Format Requirements:</h6>
                                <p class="small mb-0 text-muted">Ensure your file has <strong>no header row</strong>. Column 1 must be the Phone Number. Column 2 (optional) can be the Name.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Select File (.csv)</label>
                        <input asp-for="CsvFile" type="file" class="form-control form-control-lg rounded-3 border-0 shadow-sm" accept=".csv" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-3 rounded-3 shadow-sm hover-elevate transition-all fw-bold">
                        <i class="bi bi-upload me-2"></i> Upload & Process CSV
                    </button>
                </form>
                
                <div class="mt-4 pt-4 border-top">
                    <h6 class="mb-2 fw-bold text-dark"><i class="bi bi-file-earmark-excel text-success me-1"></i> Excel / vCard Upload</h6>
                    <p class="text-muted small mb-0">Excel and vCard imports are temporarily processed manually. Please contact support or export your files to CSV to use the uploader above.</p>
                </div>
            </div>
        </div>
    </div>
</div>


