@page
@model JurayUniversal.Website.Pages.Pay.IndexModel
@{
    ViewData["Title"] = "Payment Portal";
    Layout = "~/Pages/Shared/Layouts/_PayLayout.cshtml";
    var dues = Model.Categories.Where(c => c.IsCompulsory).ToList();
    var donations = Model.Categories.Where(c => !c.IsCompulsory).ToList();
}

<div class="mb-4 text-center">
    <h2 class="h3 fw-bold text-dark mb-1">Payment Categories</h2>
    <p class="text-muted">Select a payment category below to make a payment or contribution.</p>
</div>

@if (!Model.Categories.Any())
{
    <div class="card pay-card shadow-sm p-5 text-center">
        <i class="bi bi-wallet2 text-muted fs-1 mb-3 d-block"></i>
        <h5 class="fw-bold">No Active Categories Found</h5>
        <p class="text-muted mb-0">There are currently no active payment categories set up.</p>
    </div>
}
else
{
    @if (dues.Any())
    {
        <div class="row g-3 mb-4">
            @foreach (var cat in dues)
            {
                <div class="col-12">
                    <div class="card pay-card shadow-sm p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px; height:48px;">
                                    <i class="bi bi-credit-card-fill text-danger fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@cat.Title</h6>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <p class="text-muted fs-8 mb-1">@cat.Description</p>
                                    }
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 fs-12px">
                                        Compulsory Due
                                    </span>
                                </div>
                            </div>
                            <div class="text-end">
                                @if (cat.FixedAmount.HasValue)
                                {
                                    <div class="fw-bold fs-5 text-dark">₦@cat.FixedAmount.Value.ToString("N2")</div>
                                }
                                else
                                {
                                    <div class="text-muted small mb-1">Variable Amount</div>
                                }
                                <a href="/pay/@(cat.Key ?? cat.Id.ToString())" class="btn btn-primary rounded-pill px-4 btn-sm fw-bold shadow-sm mt-1">
                                    Pay Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (donations.Any())
    {
        <div class="row g-3 mb-4">
            @foreach (var cat in donations)
            {
                <div class="col-12">
                    <div class="card pay-card shadow-sm p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px; height:48px;">
                                    <i class="bi bi-heart-fill text-success fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@cat.Title</h6>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <p class="text-muted fs-8 mb-1">@cat.Description</p>
                                    }
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 fs-12px">
                                        Optional Donation
                                    </span>
                                </div>
                            </div>
                            <div class="text-end">
                                @if (cat.FixedAmount.HasValue)
                                {
                                    <div class="fw-bold fs-5 text-dark">₦@cat.FixedAmount.Value.ToString("N2")</div>
                                }
                                else
                                {
                                    <div class="text-muted small mb-1">Voluntary Amount</div>
                                }
                                <a href="/pay/@(cat.Key ?? cat.Id.ToString())" class="btn btn-success rounded-pill px-4 btn-sm fw-bold shadow-sm mt-1">
                                    Contribute
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
