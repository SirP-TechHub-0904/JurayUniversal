@page
@model JurayUniversal.Website.Areas.MisGroups.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = Model.GroupAlias + "s Dashboard";
    ViewData["ActiveMenu"] = "MisGroups";
    ViewData["ActiveSubMenu"] = "Dashboard";
}

<style>
    .premium-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.03);
        transition: all 0.3s ease;
        border-radius: 1rem;
    }
    .premium-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px 0 rgba(0, 0, 0, 0.08);
    }
    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .gradient-primary { background: linear-gradient(135deg, #4e54c8, #8f94fb); color: white; }
    .gradient-success { background: linear-gradient(135deg, #11998e, #38ef7d); color: white; }
    .gradient-info { background: linear-gradient(135deg, #00c6ff, #0072ff); color: white; }
</style>

<div class="mis-page-header">
    <h3 class="mis-page-title">@Model.GroupAlias Directory Analytics</h3>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-info btn-sm rounded-pill" type="button" data-bs-toggle="offcanvas" data-bs-target="#misHelpOffcanvas">
            <i class="bi bi-question-circle me-1"></i> Help & Guide
        </button>
        @if (await MisAuth.CanEditAsync(User, "MisGroups"))
        {
            <a asp-page="./List" class="btn btn-primary btn-sm rounded-pill"><i class="bi bi-list-task me-1"></i> Manage @Model.GroupAlias</a>
        }
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <!-- KPI Cards Row -->
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <a asp-page="./List" class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Total @Model.GroupAlias</h6>
                            <h2 class="fw-800 text-dark mb-0">@Model.TotalGroups</h2>
                        </div>
                        <div class="icon-box gradient-primary shadow-sm">
                            <i class="bi bi-collection"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-4 col-md-6">
            <a asp-page="./List" class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Active @Model.GroupAlias</h6>
                            <h2 class="fw-800 text-success mb-0">@Model.ActiveGroups</h2>
                        </div>
                        <div class="icon-box gradient-success shadow-sm">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card premium-card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-600 text-muted mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Total Memberships</h6>
                            <h2 class="fw-800 text-info mb-0">@Model.TotalMemberships</h2>
                        </div>
                        <div class="icon-box gradient-info shadow-sm">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row g-4 mb-4">
        <!-- Growth Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Membership Growth (Last 6 Months)</h5>
                    <div style="height: 300px;">
                        <canvas id="growthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- Status Gauge -->
        <div class="col-xl-4 col-lg-5">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Status Distribution</h5>
                    <div style="height: 300px; display:flex; align-items:center; justify-content:center;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row g-4 mb-4">
        <!-- Top Groups Bar Chart -->
        <div class="col-xl-6">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark">Top 5 Largest @Model.GroupAlias</h5>
                    <div style="height: 350px;">
                        <canvas id="topGroupsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Recent Activity Feed -->
        <div class="col-xl-6">
            <div class="card premium-card h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0 text-dark">Recent Memberships</h5>
                        <a asp-page="./List" class="btn btn-sm btn-light rounded-pill px-3 shadow-sm">View All</a>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <tbody>
                                @foreach (var activity in Model.RecentActivity)
                                {
                                    <tr class="border-bottom border-light">
                                        <td style="width: 50px;">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px; height:40px;">
                                                @(string.IsNullOrEmpty(activity.UserProfile?.FirstName) ? "U" : activity.UserProfile.FirstName.Substring(0,1))
                                            </div>
                                        </td>
                                        <td>
                                            <h6 class="mb-1 fw-bold text-dark">@(activity.UserProfile?.FirstName ?? "Unknown") @(activity.UserProfile?.LastName ?? "")</h6>
                                            <p class="text-muted small mb-0">Joined <strong>@(activity.MisGroup?.Title)</strong> as @(activity.RolePosition ?? "Member")</p>
                                        </td>
                                        <td class="text-end text-muted small fw-500">
                                            @activity.DateJoined.ToString("MMM dd")
                                        </td>
                                    </tr>
                                }
                                @if (!Model.RecentActivity.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-5">
                                            <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                            No recent activity found.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Shared Options
            Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
            Chart.defaults.color = '#6c757d';
            
            // 1. Membership Growth Line Chart
            var growthCtx = document.getElementById('growthChart').getContext('2d');
            
            var gradientBlue = growthCtx.createLinearGradient(0, 0, 0, 400);
            gradientBlue.addColorStop(0, 'rgba(78, 84, 200, 0.4)');
            gradientBlue.addColorStop(1, 'rgba(78, 84, 200, 0.0)');

            new Chart(growthCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GrowthLabels)),
                    datasets: [{
                        label: 'New Memberships',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GrowthData)),
                        borderColor: '#4e54c8',
                        backgroundColor: gradientBlue,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#4e54c8',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, border: { dash: [5, 5] }, grid: { color: '#f0f0f0' }, ticks: { stepSize: 1 } }
                    }
                }
            });

            // 2. Status Gauge (Half-Donut)
            var statusCtx = document.getElementById('statusChart').getContext('2d');
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Active @Model.GroupAlias', 'Inactive @Model.GroupAlias'],
                    datasets: [{
                        data: [@Model.ActiveGroups, @(Model.TotalGroups - Model.ActiveGroups)],
                        backgroundColor: ['#11998e', '#dc3545'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    rotation: -90,
                    circumference: 180,
                    cutout: '75%',
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 20 } }
                    }
                }
            });

            // 3. Top Groups Bar Chart
            var topGroupsCtx = document.getElementById('topGroupsChart').getContext('2d');
            var topGroupsLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopGroups.Select(g => g.Title)));
            var topGroupsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopGroups.Select(g => g.Members.Count(m => m.MembershipStatus == "Active"))));
            
            new Chart(topGroupsCtx, {
                type: 'bar',
                data: {
                    labels: topGroupsLabels,
                    datasets: [{
                        label: 'Active Members',
                        data: topGroupsData,
                        backgroundColor: 'rgba(0, 198, 255, 0.8)',
                        borderRadius: 6,
                        borderWidth: 0,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#f0f0f0' }, ticks: { stepSize: 1 } },
                        y: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}
