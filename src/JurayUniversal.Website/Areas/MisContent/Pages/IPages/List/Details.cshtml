@page
@model JurayUniversal.Website.Areas.MisContent.Pages.IPages.List.DetailsModel

@{
    ViewData["Title"] = "PAGE LIST Details";
    ViewData["BackUrl"] = "./Index";
}

<div class="card card-default">
    
    <!-- /.card-header -->

    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-12">
                <dl class="row">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PageSectionList.VideoUrl)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PageSectionList.VideoUrl)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PageSectionList.VideoKey)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PageSectionList.VideoKey)
                    </dd>
                      <dt class="col-sm-2">
                          @Html.DisplayNameFor(model => model.PageSectionList.ImageUrl)
                      </dt>
                      <dd class="col-sm-10">
                          @if (!string.IsNullOrEmpty(Model.PageSectionList.ImageUrl))
                          {
                              <div class="media-display-block mb-3">
                                  <a href="@Model.PageSectionList.ImageUrl" target="_blank">
                                      <img src="@Model.PageSectionList.ImageUrl" class="img-fluid rounded shadow-sm mb-2" style="max-height: 200px; object-fit: contain;" alt="Preview" />
                                  </a>
                                  <br/>
                                  <div class="btn-group" role="group">
                                      <button type="button" class="btn btn-secondary btn-sm" onclick="copyToClipboard('@Model.PageSectionList.ImageUrl')">
                                          <i class="fa fa-copy"></i> Copy Image URL
                                      </button>
                                      <button type="button" class="btn btn-info btn-sm" onclick="copyToClipboard('@Model.PageSectionList.ImageKey')">
                                          <i class="fa fa-copy"></i> Copy Image Name
                                      </button>
                                  </div>
                              </div>
                          }
                      </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PageSectionList.Title)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PageSectionList.Title)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PageSectionList.MiniTitle)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PageSectionList.MiniTitle)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PageSectionList.Description)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PageSectionList.Description)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PageSectionList.Disable)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PageSectionList.Disable)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PageSectionList.PageSection)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PageSectionList.PageSection.Description)
                    </dd>
                </dl>
            </div>
        </div>
        <!-- /.card-body -->
        <div class="card-footer">
            

        </div>
    </div>
</div>




