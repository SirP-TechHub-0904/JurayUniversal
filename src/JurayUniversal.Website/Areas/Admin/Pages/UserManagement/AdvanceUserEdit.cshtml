@page "{id}"
@model JurayUniversal.Website.Areas.Admin.Pages.UserManagement.AdvanceUserEditModel
@using static JurayUniversal.Domain.Enum.Enum
@{
    ViewData["Title"] = "Advanced User Edit";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center"
             style="width:52px;height:52px">
            <i class="fas fa-user-cog text-white fs-4"></i>
        </div>
        <div>
            <h3 class="mb-0 fw-bold">Advanced User Edit</h3>
            <small class="text-muted">
                @Model.UserDatas?.FullnameX &nbsp;|&nbsp;
                <code>@Model.UserDatas?.Email</code>
            </small>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary ms-auto">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="UserDatas.Id" />

        <div class="row g-4">

            <!-- ══════════════════════════════════════════════════════
                 LEFT COLUMN
            ══════════════════════════════════════════════════════ -->
            <div class="col-lg-6">

                <!-- 🔐 Security & Account -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-danger text-white fw-semibold">
                        <i class="fas fa-shield-alt me-2"></i> Security & Account Control
                    </div>
                    <div class="card-body">

                        <div class="row g-3">
                            <!-- Two Factor -->
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="TwoFactorEnabled" id="twoFactor">
                                    <label class="form-check-label" for="twoFactor">
                                        Two-Factor Authentication
                                    </label>
                                </div>
                            </div>
                            <!-- Lockout -->
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="LockoutEnabled" id="lockout">
                                    <label class="form-check-label" for="lockout">
                                        Account Lockout Enabled
                                    </label>
                                </div>
                            </div>
                            <!-- Email Confirmed -->
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="EmailConfirmed" id="emailConf">
                                    <label class="form-check-label" for="emailConf">
                                        Email Confirmed
                                    </label>
                                </div>
                            </div>
                            <!-- Phone Confirmed -->
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="PhoneNumberConfirmed" id="phoneConf">
                                    <label class="form-check-label" for="phoneConf">
                                        Phone Confirmed
                                    </label>
                                </div>
                            </div>
                            <!-- Force Reset -->
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="ForcePasswordReset" id="forceReset">
                                    <label class="form-check-label" for="forceReset">
                                        Force Password Reset on Login
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <!-- Temp Password -->
                        <div class="mb-2">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-key me-1 text-warning"></i>
                                Set Temporary Password
                            </label>
                            <input asp-for="NewTempPassword" type="text"
                                   class="form-control"
                                   placeholder="Leave blank to keep current password" />
                            <small class="text-muted">
                                Saving a value here will immediately reset the user's password
                                and enable Force Reset.
                            </small>
                        </div>

                        <hr />

                        <!-- Assign Role -->
                        <div class="mb-2">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-user-tag me-1 text-info"></i>
                                Assign Role
                                <span class="badge bg-secondary ms-1">
                                    Current: @Model.CurrentRole
                                </span>
                            </label>
                            <input asp-for="AssignRole" class="form-control"
                                   placeholder="e.g. mSuperAdmin, Manager, Staff" />
                            <small class="text-muted">
                                This removes all existing roles and assigns the one entered.
                            </small>
                        </div>

                    </div>
                </div>

                <!-- 📋 Profile Status & Flags -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white fw-semibold">
                        <i class="fas fa-sliders-h me-2"></i> Profile Status & Flags
                    </div>
                    <div class="card-body row g-3">

                        <div class="col-6">
                            <label class="form-label fw-semibold">User Status</label>
                            <select asp-for="UserDatas.UserStatus" class="form-select"
                                    asp-items="Html.GetEnumSelectList<UserStatus>()"></select>
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-semibold">DOB Status</label>
                            <select asp-for="UserDatas.DateOfBirthStatus" class="form-select"
                                    asp-items="Html.GetEnumSelectList<DOBStatus>()"></select>
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-semibold">Job Designation ID</label>
                            <input asp-for="UserDatas.JobDesignationId" class="form-control"
                                   type="number" />
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-semibold">User Category ID</label>
                            <input asp-for="UserDatas.UserCategoryId" class="form-control"
                                   type="number" />
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-semibold">Ref Code</label>
                            <input asp-for="UserDatas.RefCode" class="form-control" />
                        </div>

                        <div class="col-6 d-flex align-items-center pt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       asp-for="UserDatas.PortfolioProfile" id="portfolio">
                                <label class="form-check-label" for="portfolio">
                                    Portfolio Profile Active
                                </label>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 📬 Communication -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white fw-semibold">
                        <i class="fas fa-envelope-open-text me-2"></i> Communication Flags
                    </div>
                    <div class="card-body row g-3">

                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       asp-for="UserDatas.EmailSent" id="emailSent">
                                <label class="form-check-label" for="emailSent">Email Sent</label>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       asp-for="UserDatas.SmsSent" id="smsSent">
                                <label class="form-check-label" for="smsSent">SMS Sent</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Contact Mail Email</label>
                            <input asp-for="UserDatas.ContactMailEmail" class="form-control"
                                   type="email" />
                        </div>

                    </div>
                </div>

                <!-- 🏠 Accommodation -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white fw-semibold">
                        <i class="fas fa-home me-2"></i> Accommodation
                    </div>
                    <div class="card-body row g-3">

                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       asp-for="UserDatas.HasAccomodation" id="hasAccom">
                                <label class="form-check-label" for="hasAccom">
                                    Has Accommodation
                                </label>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-semibold">Accommodation Status</label>
                            <select asp-for="UserDatas.AccomodationUpdateStatus" class="form-select"
                                    asp-items="Html.GetEnumSelectList<AccomodationUpdateStatus>()">
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Last Accommodation</label>
                            <input asp-for="UserDatas.LastAccomodation" class="form-control" />
                        </div>

                    </div>
                </div>

            </div>

            <!-- ══════════════════════════════════════════════════════
                 RIGHT COLUMN
            ══════════════════════════════════════════════════════ -->
            <div class="col-lg-6">

                <!-- ✅ Profile Completion Overrides -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-warning text-dark fw-semibold">
                        <i class="fas fa-tasks me-2"></i> Profile Completion Overrides
                        <small class="ms-2 fw-normal">(Admin unlock per section)</small>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            @{
                                void Toggle(string aspFor, string label, string id)
                                {
                                    <div class="col-6">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox"
                                                   name="@aspFor" id="@id"
                                                   @(((bool?)ViewData[aspFor] == true ? "checked" : "")) />
                                            <label class="form-check-label" for="@id">@label</label>
                                        </div>
                                    </div>;
                                }
                            }

                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateProfile" id="upProfile">
                                    <label class="form-check-label" for="upProfile">Profile</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateEducation" id="upEdu">
                                    <label class="form-check-label" for="upEdu">Education</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateExperience" id="upExp">
                                    <label class="form-check-label" for="upExp">Experience</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateCertificate" id="upCert">
                                    <label class="form-check-label" for="upCert">Certificate</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateAwards" id="upAwards">
                                    <label class="form-check-label" for="upAwards">Awards</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateSkills" id="upSkills">
                                    <label class="form-check-label" for="upSkills">Skills</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateLanguage" id="upLang">
                                    <label class="form-check-label" for="upLang">Language</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateInterest" id="upInterest">
                                    <label class="form-check-label" for="upInterest">Interest</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           asp-for="UserDatas.UpdateReference" id="upRef">
                                    <label class="form-check-label" for="upRef">Reference</label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- 🪪 Identity & Sensitive Info -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-dark text-white fw-semibold">
                        <i class="fas fa-id-card me-2"></i> Identity & Sensitive Information
                    </div>
                    <div class="card-body row g-3">

                        <div class="col-6">
                            <label class="form-label fw-semibold">Unique ID</label>
                            <input asp-for="UserDatas.UniqueId" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Title</label>
                            <input asp-for="UserDatas.Title" class="form-control"
                                   placeholder="Dr., Mr., Mrs." />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Position / Rank</label>
                            <input asp-for="UserDatas.PositionOrRank" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Nationality</label>
                            <input asp-for="UserDatas.Nationality" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Blood Group</label>
                            <input asp-for="UserDatas.BloodGroup" class="form-control"
                                   placeholder="A+, O-, etc." />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Genotype</label>
                            <input asp-for="UserDatas.Genotype" class="form-control"
                                   placeholder="AA, AS, SS" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">BVN</label>
                            <input asp-for="UserDatas.BVN" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">
                                Int'l Passport Number
                            </label>
                            <input asp-for="UserDatas.InternationalPassportNumber"
                                   class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">
                                Int'l Passport Expiry
                            </label>
                            <input asp-for="UserDatas.InternationalPassportExpiringDate"
                                   class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Previous Appointment</label>
                            <input asp-for="UserDatas.PreviousAppointment" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Sponsor</label>
                            <input asp-for="UserDatas.Sponsor" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Sponsor Address</label>
                            <input asp-for="UserDatas.SponsorAddress" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Referee(s)</label>
                            <textarea asp-for="UserDatas.Referee" class="form-control"
                                      rows="2"></textarea>
                        </div>

                    </div>
                </div>

                <!-- 🚨 Emergency Contact -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-secondary text-white fw-semibold">
                        <i class="fas fa-phone-alt me-2"></i> Emergency Contact
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Name</label>
                            <input asp-for="UserDatas.EmergencyContactName" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Number</label>
                            <input asp-for="UserDatas.EmergencyContactNumber" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Relationship</label>
                            <input asp-for="UserDatas.EmergencyContactRelationship"
                                   class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- 📝 Audit Log (read-only) -->
                <div class="card shadow-sm mb-4 border-secondary">
                    <div class="card-header bg-light fw-semibold text-secondary">
                        <i class="fas fa-clipboard-list me-2"></i> Audit / Logs
                        <small class="ms-1">(read-only)</small>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Last Login</label>
                            <input value="@Model.UserDatas?.LastLogin"
                                   class="form-control bg-light" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Logs</label>
                            <textarea class="form-control bg-light font-monospace"
                                      rows="4" readonly>@Model.UserDatas?.Logs</textarea>
                        </div>
                    </div>
                </div>

            </div>
            <!-- end right column -->

        </div>
        <!-- end row -->

        <!-- Save Bar -->
        <div class="card border-0 shadow sticky-bottom mt-2"
             style="background:rgba(255,255,255,0.95);backdrop-filter:blur(4px);">
            <div class="card-body d-flex gap-3 align-items-center py-2">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="fas fa-save me-2"></i> Save Advanced Settings
                </button>
                <a asp-page="./Edit" asp-route-id="@Model.UserDatas?.Id"
                   class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-user-edit me-1"></i> Basic Edit
                </a>
                <a asp-page="./Index" class="btn btn-outline-danger btn-lg ms-auto">
                    <i class="fas fa-times me-1"></i> Cancel
                </a>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}