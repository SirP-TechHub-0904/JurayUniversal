@page
@model JurayUniversal.Website.Areas.MisVoting.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "My E-Voting Dashboard";
    ViewData["Subtitle"] = "High-level overview and analytics.";
}

<div class="container-fluid content-inner mt-n5 py-0">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title mb-0">Available Elections</h4>
                    </div>
                    
                </div>
                <div class="card-body">
                    @if (Model.AvailableElections.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted display-4"></i>
                            <h5 class="mt-3 text-muted">No active elections available for you at this time.</h5>
                        </div>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                            @foreach (var election in Model.AvailableElections)
                            {
                                <div class="col">
                                    <div class="card h-100 border border-primary shadow-sm">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title fw-bold text-primary mb-0">@election.Title</h5>
                                                @if(election.ElectionType == Domain.Enum.Enum.MisElectionType.Open)
                                                {
                                                    <span class="badge bg-success">Open</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Accredited</span>
                                                }
                                            </div>
                                            
                                            <div class="d-flex align-items-center mb-3 text-muted small">
                                                <i class="bi bi-clock me-2"></i>
                                                <span>Ends: @election.EndDate.ToString("MMM dd, yyyy - hh:mm tt")</span>
                                            </div>
                                            
                                            @if (!string.IsNullOrEmpty(election.Instructions))
                                            {
                                                <p class="card-text text-truncate-2">@election.Instructions</p>
                                            }
                                        </div>
                                        <div class="card-footer bg-transparent border-top-0 pt-0 pb-4 text-center">
                                            <a asp-page="/Platform/Vote" asp-route-shortcode="@(!string.IsNullOrEmpty(election.ShortCode) ? election.ShortCode : election.Id.ToString())" class="btn btn-primary rounded-pill px-4 fw-bold w-100">
                                                Enter Voting Booth <i class="bi bi-arrow-right-circle ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (Model.PastElections.Any())
            {
                <div class="card mt-4">
                    <div class="card-header d-flex justify-content-between">
                        <div class="header-title">
                            <h4 class="card-title">Past Elections & Results</h4>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Ended On</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var election in Model.PastElections)
                                    {
                                        <tr>
                                            <td class="fw-bold">@election.Title</td>
                                            <td>@election.EndDate.ToString("MMM dd, yyyy")</td>
                                            <td><span class="badge bg-secondary">@election.VotingStatus</span></td>
                                            <td>
                                                @if (election.ShowResults)
                                                {
                                                    <a asp-page="./Results" asp-route-id="@election.Id" class="btn btn-sm btn-outline-info rounded-pill">
                                                        View Results
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Results Hidden</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>

