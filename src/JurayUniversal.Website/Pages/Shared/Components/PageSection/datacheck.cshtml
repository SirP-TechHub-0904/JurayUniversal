                        <div class="col-lg-3 col-sm-6">
                            <div class="counter">
                                <i class="@list.IconText"></i>
                                <span class="count-number" data-to="150" data-speed="10000">@list.Title</span>
                                <label>@list.MiniTitle</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
