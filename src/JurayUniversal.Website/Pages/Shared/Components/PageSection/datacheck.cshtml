                                    <span class="wrap">@item.Title</span>
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="container-fluid filter-carousal-1-outer relative">
                    <div class="fliter-left-style">
                        <div class="clearfix filter-pos-left sx-bg-light bg-no-repeat bg-bottom-right" style="background-image: url(../../../../customcss/r-corner.png/);">
                            <ul class="btn-filter-wrap">

                                <li class="btn-active btn-filter" data-filter="*">@item.MiniTitle</li>
                                @foreach (var list in item.PageSectionLists)
                                {
                                    <li class="btn-filter" data-filter=".col-one">@list.Title</li>
                                }

                            </ul>
                        </div>
                        <div class="filter-carousal-1">
