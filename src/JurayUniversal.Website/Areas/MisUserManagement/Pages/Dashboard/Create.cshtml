@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.CreateModel
@{
    ViewData["Title"] = "Create New User";
    ViewData["Subtitle"] = "Register a new team member or employee into the system.";
    ViewData["ShowBackButton"] = false;
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "Users";
}

@section HeaderActions {
    <a asp-page="/Dashboard/List" class="btn btn-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to User Directory
    </a>
}

<div class="page-content">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="bi bi-person-plus-fill me-2 text-primary"></i> New User Registration Form</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12 col-md-3">
                                <label asp-for="Input.Title" class="form-label text-muted fw-semibold"></label>
                                <input asp-for="Input.Title" class="form-control" placeholder="e.g. Mr, Mrs, Dr..." />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Input.FirstName" class="form-label text-muted fw-semibold"></label>
                                <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" required />
                                <span asp-validation-for="Input.FirstName" class="text-danger fs-7"></span>
                            </div>
                            <div class="col-12 col-md-5">
                                <label asp-for="Input.LastName" class="form-label text-muted fw-semibold"></label>
                                <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" required />
                                <span asp-validation-for="Input.LastName" class="text-danger fs-7"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.MiddleName" class="form-label text-muted fw-semibold"></label>
                                <input asp-for="Input.MiddleName" class="form-control" placeholder="Middle Name (Optional)" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.Gender" class="form-label text-muted fw-semibold"></label>
                                <select asp-for="Input.Gender" class="form-select" asp-items="Html.GetEnumSelectList<JurayUniversal.Domain.Enum.Enum.GenderStatus>()">
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.Email" class="form-label text-muted fw-semibold"></label>
                                <input asp-for="Input.Email" type="email" class="form-control" placeholder="name@company.com" required />
                                <span asp-validation-for="Input.Email" class="text-danger fs-7"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.PhoneNumber" class="form-label text-muted fw-semibold"></label>
                                <input asp-for="Input.PhoneNumber" type="tel" class="form-control" placeholder="+234..." />
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger fs-7"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.UserCategoryId" class="form-label text-muted fw-semibold"></label>
                                <select asp-for="Input.UserCategoryId" class="form-select">
                                    <option value="">-- None / Nill --</option>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.Password" class="form-label text-muted fw-semibold"></label>
                                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Default: [REDACTED_BOOTSTRAP_PASSWORD]" required />
                                <span asp-validation-for="Input.Password" class="text-danger fs-7"></span>
                                <small class="text-muted fs-7">Must be at least 6 characters.</small>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="/Dashboard/List" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5">
                                <i class="bi bi-person-check-fill me-1"></i> Create User Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
