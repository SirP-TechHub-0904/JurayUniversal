@page
@model JurayUniversal.MisCentral.Pages.AboutModel
@{
    ViewData["Title"] = "About Us - Mission, Vision & African Vision";
    Layout = "_PublicLayout";
}

<!-- breadcrumb-area -->
<section class="breadcrumb__area breadcrumb__bg fix" data-background="/xyz-mis/assets/img/bg/breadcrumb_bg.jpg">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb__content">
                    <h2 class="title">About Exwhyzee MIS</h2>
                    <nav class="breadcrumb">
                        <span property="itemListElement" typeof="ListItem">
                            <a asp-page="/Index">Home</a>
                        </span>
                        <span class="breadcrumb-separator">/</span>
                        <span property="itemListElement" typeof="ListItem">About Us</span>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- breadcrumb-area-end -->

<!-- who-we-are-area -->
<section class="about__area-four section-py-120 p-relative fix">
    <div class="container">
        <div class="row align-items-center justify-content-center">
            <div class="col-lg-6 col-md-9">
                <div class="about__img-four">
                    <img src="~/xyz-mis/assets/img/images/inner_about-img01.jpg" alt="Exwhyzee MIS Team" class="main-img">
                    <img src="~/xyz-mis/assets/img/images/inner_about-img02.jpg" alt="Exwhyzee African Digital Workspace" class="img-two" data-sal="slide-right" data-sal-duration="700" data-sal-delay="100">
                    <div class="satisfaction__wrap" data-sal="slide-up" data-sal-duration="800" data-sal-delay="200">
                        <div class="icon">
                            <img src="~/xyz-mis/assets/img/icons/satisfaction.svg" alt="icon">
                        </div>
                        <span>100% Private <br> &amp; Dedicated Workspaces</span>
                    </div>
                    <div class="shape">
                        <img src="~/xyz-mis/assets/img/images/inner_about_shape01.svg" alt="shape" class="alltuchtopdown">
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about__content-four">
                    <div class="section__title section__title-two mb-20">
                        <span class="sub-title text-primary fw-bold text-uppercase">Who We Are</span>
                        <h2 class="title">Pioneering Simple, Sovereign &amp; Scalable Cloud Management For Africa</h2>
                    </div>
                    <p class="text-gray-600 leading-relaxed mb-4">
                        <strong>Exwhyzee MIS</strong> is an indigenous, enterprise-grade cloud management software engineered specifically to solve the unique operational challenges of African institutions. From primary and secondary schools to universities, polytechnics, hospitals, government agencies, and corporate businesses, we replace error-prone manual paper registries with effortless digital automation.
                    </p>
                    <p class="text-gray-600 leading-relaxed mb-4">
                        We believe technology should not be intimidating or expensive. Every organization that partners with Exwhyzee MIS gets their own completely private, secure workspace, daily automated backups, and 16+ plug-and-play features that work smoothly on smartphones, tablets, and computers.
                    </p>
                    <div class="about__content-inner-three mt-3">
                        <ul class="choose__list choose__list-three list-wrap" data-sal="slide-right" data-sal-duration="700" data-sal-delay="100">
                            <li>
                                <i class="bi bi-shield-check text-primary fs-4 me-2"></i>
                                100% Private Workspace for Every Organization
                            </li>
                            <li>
                                <i class="bi bi-shield-check text-primary fs-4 me-2"></i>
                                Built for Africa — Fast On Low Bandwidth &amp; Mobile Phones
                            </li>
                            <li>
                                <i class="bi bi-shield-check text-primary fs-4 me-2"></i>
                                Transparent Pricing in Local Currencies with Zero Hidden Fees
                            </li>
                            <li>
                                <i class="bi bi-shield-check text-primary fs-4 me-2"></i>
                                Dedicated 24/7 Human Technical Support via WhatsApp &amp; Phone
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- who-we-are-area-end -->

<!-- mission-vision-area -->
<section class="section-py-120 position-relative" style="background: linear-gradient(180deg, #f8fafc 0%, #edf2f7 50%, #f8fafc 100%);">
    <!-- Subtle Background Glow -->
    <div class="position-absolute top-0 start-50 translate-middle-x w-100 h-100 pointer-events-none overflow-hidden" style="z-index: 0;">
        <div style="position: absolute; top: -10%; left: 50%; transform: translateX(-50%); width: 800px; height: 350px; background: radial-gradient(circle, rgba(13, 110, 253, 0.08) 0%, rgba(255, 255, 255, 0) 70%); filter: blur(50px);"></div>
    </div>

    <div class="container position-relative" style="z-index: 1;">
        <!-- Header -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-xl-8 col-lg-9">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary fw-bold text-uppercase mb-3" style="font-size: 0.78rem; letter-spacing: 1px;">
                    <i class="bi bi-compass-fill"></i>
                    <span>Our Foundation</span>
                </div>
                <h2 class="display-6 fw-bolder text-dark mb-3" style="letter-spacing: -0.5px;">Our Purpose, Mission &amp; Vision</h2>
                <p class="text-secondary fs-6 mb-0 mx-auto" style="max-width: 620px; line-height: 1.65;">
                    Driving the digital transformation of African education, governance, and commerce with world-class, sovereign software.
                </p>
            </div>
        </div>

        <!-- 3 Feature Cards Grid -->
        <div class="row g-4 justify-content-center align-items-stretch">
            <!-- Card 1: Our Vision -->
            <div class="col-lg-4 col-md-6 d-flex" data-sal="slide-up" data-sal-duration="700" data-sal-delay="100">
                <div class="mis-vision-card w-100 bg-white rounded-4 p-4 p-xl-4 d-flex flex-column justify-content-between position-relative overflow-hidden shadow-sm border border-light-subtle">
                    <!-- Accent Top Bar -->
                    <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: linear-gradient(90deg, #0d6efd, #00d2ff);"></div>
                    
                    <div>
                        <!-- Header / Icon & Badge -->
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="mis-card-icon rounded-4 d-inline-flex align-items-center justify-content-center text-primary" style="width: 56px; height: 56px; background: linear-gradient(135deg, #e0edff 0%, #cfe2ff 100%); font-size: 1.6rem; box-shadow: 0 8px 16px rgba(13, 110, 253, 0.12);">
                                <i class="bi bi-eye-fill"></i>
                            </div>
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 fw-semibold" style="font-size: 0.75rem;">
                                <i class="bi bi-globe-africa me-1"></i> Pan-African
                            </span>
                        </div>

                        <!-- Content -->
                        <h3 class="fw-bold text-dark fs-4 mb-3">Our Vision</h3>
                        <p class="text-secondary leading-relaxed mb-4" style="font-size: 0.92rem; line-height: 1.7;">
                            To become Africa’s most trusted, accessible, and comprehensive institutional cloud ecosystem — powering <strong class="text-dark">10,000+ schools, healthcare centers, and corporate bodies</strong> across 54 African nations by 2030.
                        </p>
                    </div>

                    <!-- Bottom Pill / Metric -->
                    <div class="pt-3 mt-2 border-top border-light-subtle">
                        <div class="d-flex align-items-center justify-content-between text-muted" style="font-size: 0.8rem;">
                            <span class="fw-bold text-primary"><i class="bi bi-graph-up-arrow me-1"></i> Goal for 2030</span>
                            <span class="fw-semibold text-dark">54 African Nations</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Our Mission (Highlighted Center Card) -->
            <div class="col-lg-4 col-md-6 d-flex" data-sal="slide-up" data-sal-duration="700" data-sal-delay="200">
                <div class="mis-vision-card mis-mission-featured w-100 rounded-4 p-4 p-xl-4 d-flex flex-column justify-content-between position-relative overflow-hidden shadow" style="background: linear-gradient(180deg, #ffffff 0%, #f0f7ff 100%); border: 1.5px solid #b8d7ff;">
                    <!-- Accent Top Bar -->
                    <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: linear-gradient(90deg, #0052cc, #0d6efd);"></div>
                    
                    <div>
                        <!-- Header / Icon & Badge -->
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="mis-card-icon rounded-4 d-inline-flex align-items-center justify-content-center text-white" style="width: 56px; height: 56px; background: linear-gradient(135deg, #0d6efd 0%, #0045b5 100%); font-size: 1.6rem; box-shadow: 0 10px 20px rgba(13, 110, 253, 0.25);">
                                <i class="bi bi-rocket-takeoff-fill"></i>
                            </div>
                            <span class="badge rounded-pill bg-primary text-white px-3 py-2 fw-semibold shadow-sm" style="font-size: 0.75rem;">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Daily Impact
                            </span>
                        </div>

                        <!-- Content -->
                        <h3 class="fw-bold text-dark fs-4 mb-3">Our Mission</h3>
                        <p class="text-secondary leading-relaxed mb-4" style="font-size: 0.92rem; line-height: 1.7;">
                            To eliminate institutional inefficiency across Nigeria and Africa by delivering intuitive, highly secure, and affordable software that empowers administrators, educators, and leaders to automate daily routines with total peace of mind.
                        </p>
                    </div>

                    <!-- Bottom Pill / Metric -->
                    <div class="pt-3 mt-2 border-top border-primary border-opacity-25">
                        <div class="d-flex align-items-center justify-content-between text-muted" style="font-size: 0.8rem;">
                            <span class="fw-bold text-primary"><i class="bi bi-shield-lock-fill me-1"></i> Approach</span>
                            <span class="fw-semibold text-dark">Accessible Automation</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3: Our Core Values -->
            <div class="col-lg-4 col-md-6 d-flex" data-sal="slide-up" data-sal-duration="700" data-sal-delay="300">
                <div class="mis-vision-card w-100 bg-white rounded-4 p-4 p-xl-4 d-flex flex-column justify-content-between position-relative overflow-hidden shadow-sm border border-light-subtle">
                    <!-- Accent Top Bar -->
                    <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: linear-gradient(90deg, #10b981, #059669);"></div>
                    
                    <div>
                        <!-- Header / Icon & Badge -->
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="mis-card-icon rounded-4 d-inline-flex align-items-center justify-content-center text-success" style="width: 56px; height: 56px; background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%); font-size: 1.6rem; box-shadow: 0 8px 16px rgba(16, 185, 129, 0.15);">
                                <i class="bi bi-shield-fill-check"></i>
                            </div>
                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fw-semibold" style="font-size: 0.75rem;">
                                <i class="bi bi-heart-fill text-danger me-1"></i> Client-First
                            </span>
                        </div>

                        <!-- Content -->
                        <h3 class="fw-bold text-dark fs-4 mb-3">Our Core Values</h3>
                        
                        <!-- Values List with High-Contrast Neat Layout -->
                        <div class="d-flex flex-column gap-3 mb-4">
                            <div class="d-flex align-items-start gap-2">
                                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center flex-shrink-0 mt-1" style="width: 22px; height: 22px; font-size: 0.75rem;">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.88rem;">100% Data Sovereignty</div>
                                    <div class="text-muted" style="font-size: 0.78rem;">Your records are isolated, encrypted &amp; private.</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center flex-shrink-0 mt-1" style="width: 22px; height: 22px; font-size: 0.75rem;">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.88rem;">Everyday Simplicity</div>
                                    <div class="text-muted" style="font-size: 0.78rem;">Zero learning curve for everyday staff.</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center flex-shrink-0 mt-1" style="width: 22px; height: 22px; font-size: 0.75rem;">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.88rem;">African Resilience</div>
                                    <div class="text-muted" style="font-size: 0.78rem;">Fast on mobile devices &amp; low bandwidth.</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center flex-shrink-0 mt-1" style="width: 22px; height: 22px; font-size: 0.75rem;">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.88rem;">Radical Human Support</div>
                                    <div class="text-muted" style="font-size: 0.78rem;">24/7 direct WhatsApp &amp; phone care.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Pill / Metric -->
                    <div class="pt-3 mt-2 border-top border-light-subtle">
                        <div class="d-flex align-items-center justify-content-between text-muted" style="font-size: 0.8rem;">
                            <span class="fw-bold text-success"><i class="bi bi-patch-check-fill me-1"></i> Promise</span>
                            <span class="fw-semibold text-dark">Zero Hidden Costs</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- mission-vision-area-end -->

<!-- Styling for Modern Hover and Lift Effects -->
<style>
    .mis-vision-card {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .mis-vision-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 35px -10px rgba(13, 110, 253, 0.15) !important;
    }
    .mis-mission-featured:hover {
        box-shadow: 0 22px 40px -10px rgba(13, 110, 253, 0.25) !important;
    }
    .mis-card-icon {
        transition: transform 0.3s ease;
    }
    .mis-vision-card:hover .mis-card-icon {
        transform: scale(1.08) rotate(3deg);
    }
    .hover-scale {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .hover-scale:hover {
        transform: translateY(-3px) scale(1.02);
    }
    .backdrop-blur {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
</style>

<!-- target-for-nigeria-and-africa-area -->
<section class="section-py-120 fix position-relative">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-lg-5" data-sal="slide-right" data-sal-duration="700" data-sal-delay="100">
                <div class="section__title mb-25">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary fw-bold text-uppercase mb-3" style="font-size: 0.78rem; letter-spacing: 1px;">
                        <i class="bi bi-map-fill"></i>
                        <span>Our Strategic Roadmap</span>
                    </div>
                    <h2 class="title fw-bold">Our Targets For Nigeria &amp; The African Continent</h2>
                </div>
                <p class="text-secondary leading-relaxed mb-4" style="font-size: 0.95rem; line-height: 1.7;">
                    Africa is the fastest-growing digital economy in the world, yet millions of schools, health centers, and organizations still manage operations with bulky paper files, lost fee receipts, and delayed examination grading.
                </p>
                <p class="text-secondary leading-relaxed mb-4" style="font-size: 0.95rem; line-height: 1.7;">
                    Exwhyzee MIS is structured around four bold developmental milestones to drive genuine institutional transformation across Nigeria and the wider African continent.
                </p>
                <div class="mt-4">
                    <a asp-page="/Contact" class="tg-btn">Partner With Us For Your Institution <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
            </div>

            <div class="col-lg-6 mt-5 mt-lg-0" data-sal="slide-left" data-sal-duration="700" data-sal-delay="100">
                <div class="row g-4">
                    <!-- Target 1: Nigeria Education -->
                    <div class="col-md-6">
                        <div class="bg-white p-4 rounded-4 border shadow-sm h-100 hover-shadow transition-all position-relative overflow-hidden">
                            <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: #0d6efd;"></div>
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center fs-3 mb-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-mortarboard-fill"></i>
                            </div>
                            <h4 class="fw-bold text-dark fs-5 mb-2">5,000+ Nigerian Schools</h4>
                            <p class="text-secondary text-xs leading-relaxed mb-0" style="line-height: 1.6;">
                                Completely digitize admissions, termly report cards, online CBT testing, and fee reconciliation across Nigeria's 36 states.
                            </p>
                        </div>
                    </div>

                    <!-- Target 2: Healthcare & Government -->
                    <div class="col-md-6">
                        <div class="bg-white p-4 rounded-4 border shadow-sm h-100 hover-shadow transition-all position-relative overflow-hidden">
                            <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: #10b981;"></div>
                            <div class="rounded-3 bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center fs-3 mb-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-hospital-fill"></i>
                            </div>
                            <h4 class="fw-bold text-dark fs-5 mb-2">Healthcare &amp; Ministries</h4>
                            <p class="text-secondary text-xs leading-relaxed mb-0" style="line-height: 1.6;">
                                Modernizing staff rosters, monthly payroll, project timelines, and electronic records for public ministries and clinical facilities.
                            </p>
                        </div>
                    </div>

                    <!-- Target 3: Democratic E-Voting -->
                    <div class="col-md-6">
                        <div class="bg-white p-4 rounded-4 border shadow-sm h-100 hover-shadow transition-all position-relative overflow-hidden">
                            <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: #f59e0b;"></div>
                            <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-inline-flex align-items-center justify-content-center fs-3 mb-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-check2-square"></i>
                            </div>
                            <h4 class="fw-bold text-dark fs-5 mb-2">1M+ Digital Votes</h4>
                            <p class="text-secondary text-xs leading-relaxed mb-0" style="line-height: 1.6;">
                                Delivering 100% transparent, mobile-friendly electronic voting for African alumni bodies, cooperatives, and trade unions.
                            </p>
                        </div>
                    </div>

                    <!-- Target 4: Pan-African Expansion -->
                    <div class="col-md-6">
                        <div class="bg-white p-4 rounded-4 border shadow-sm h-100 hover-shadow transition-all position-relative overflow-hidden">
                            <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background: #06b6d4;"></div>
                            <div class="rounded-3 bg-info bg-opacity-10 text-info d-inline-flex align-items-center justify-content-center fs-3 mb-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-globe-americas"></i>
                            </div>
                            <h4 class="fw-bold text-dark fs-5 mb-2">Pan-African Reach</h4>
                            <p class="text-secondary text-xs leading-relaxed mb-0" style="line-height: 1.6;">
                                Expanding into West, East, and Southern Africa (Ghana, Kenya, Rwanda) with multi-currency and localized compliance.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- target-for-nigeria-and-africa-area-end -->

