@page
@model JurayUniversal.Website.Areas.MisFinances.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Financial Analytics Dashboard";
    ViewData["Subtitle"] = "High-level overview and analytics.";
}

<div class="mis-page-header d-flex justify-content-between align-items-center">
    <div>
        
        <p class="text-muted mb-0 small">Overview of revenue, payments, and financial health.</p>
    </div>
    <div class="d-flex gap-2">
        
        <a asp-page="./Ledger" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-journal-text me-1"></i> Ledger</a>
        <a asp-page="./TransactionHistory" class="btn btn-primary btn-sm rounded-pill"><i class="bi bi-clock-history me-1"></i> Transactions</a>
    </div>
</div>

<!-- Date Range Filter -->
<div class="card mb-4 border-0 shadow-sm rounded-4">
    <div class="card-body p-3">
        <form method="get" class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center fw-600 text-muted fs-14px">
                <i class="bi bi-funnel-fill me-2 text-primary fs-5"></i>
                Filter Analytics
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-3">
                    @(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "All Time")
                </span>
            </div>
            
            <div class="d-flex align-items-stretch shadow-sm" style="max-width: 500px; flex-grow: 1; border-radius: 50px;">
                <div class="d-flex align-items-center flex-grow-1 bg-white border border-primary border-opacity-25 border-end-0" style="border-radius: 50px 0 0 50px;">
                    <input type="hidden" name="DateRange" id="DateRangeValue" value="@Model.DateRange" />
                    <input type="text" id="DateRangeDisplay" value="@(Model.StartDate.HasValue && Model.EndDate.HasValue ? $"{Model.StartDate.Value.ToString("dddd dd MMMM, yyyy")} - {Model.EndDate.Value.ToString("dddd dd MMMM, yyyy")}" : "")" class="border-0 shadow-none bg-transparent py-2 px-4 w-100" placeholder="Search by date range..." style="font-size: 14px; font-weight: 500; outline: none; cursor: pointer;" readonly="readonly" />
                    @if (!string.IsNullOrEmpty(Model.DateRange))
                    {
                        <a href="?DateRange=" class="text-danger px-3 d-flex align-items-center" title="Clear Date Filter" style="text-decoration: none;">
                            <i class="bi bi-x-circle-fill fs-5"></i>
                        </a>
                    }
                </div>
                <button type="submit" class="btn btn-primary px-4 m-0 d-flex align-items-center justify-content-center" style="border-radius: 0 50px 50px 0 !important; font-weight: 600; border: 1px solid var(--md-primary); z-index: 1;">
                    <i class="bi bi-search me-2"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="page-content bg-light p-0 p-md-4" style="min-height: 100vh;">
    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Total Revenue</h6>
                        <div class="bg-success bg-opacity-10 text-success rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-cash-stack fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-dark mb-0">&#8358;@Model.TotalRevenue.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Total Transactions</h6>
                        <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-arrow-left-right fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-primary mb-0">@Model.TotalTransactions</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Pending Payments</h6>
                        <div class="bg-warning bg-opacity-10 text-warning rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-hourglass-split fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-warning mb-0">@Model.PendingTransactions</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-600 text-muted mb-0">Failed / Cancelled</h6>
                        <div class="bg-danger bg-opacity-10 text-danger rounded d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                            <i class="bi bi-x-circle fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-800 text-danger mb-0">@Model.FailedTransactions</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Revenue Trend Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-700 mb-0">30-Day Revenue Trend</h5>
                </div>
                <div class="card-body p-4">
                    <div id="revenueChart" style="height: 350px;"></div>
                </div>
            </div>
        </div>

        <!-- Status Distribution Chart -->
        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-700 mb-0">Transaction Status</h5>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center">
                    <div id="statusChart" class="w-100"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>
        $(function() {
            $('#DateRangeDisplay').daterangepicker({
                autoUpdateInput: false,
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                    'All Time': [moment().subtract(10, 'years'), moment()]
                },
                @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                {
                    <text>
                    startDate: '@Model.StartDate.Value.ToString("yyyy-MM-dd")',
                    endDate: '@Model.EndDate.Value.ToString("yyyy-MM-dd")',
                    </text>
                }
                locale: {
                    cancelLabel: 'Clear',
                    format: 'dddd DD MMMM, YYYY'
                }
            });

            $('#DateRangeDisplay').on('apply.daterangepicker', function(ev, picker) {
                $(this).val(picker.startDate.format('dddd DD MMMM, YYYY') + ' - ' + picker.endDate.format('dddd DD MMMM, YYYY'));
                $('#DateRangeValue').val(picker.startDate.format('YYYY-MM-DD') + ' - ' + picker.endDate.format('YYYY-MM-DD'));
            });

            $('#DateRangeDisplay').on('cancel.daterangepicker', function(ev, picker) {
                $(this).val('');
                $('#DateRangeValue').val('');
            });
        });

        document.addEventListener("DOMContentLoaded", function() {
            // Area Chart for Revenue Trend
            var optionsArea = {
                series: [{
                    name: 'Revenue (NGN)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData))
                }],
                chart: {
                    height: 350,
                    type: 'area',
                    fontFamily: 'Inter, sans-serif',
                    toolbar: { show: false }
                },
                colors: ['#009688'],
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 2 },
                xaxis: {
                    categories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                },
                fill: {
                    type: "gradient",
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.7,
                        opacityTo: 0.1,
                        stops: [0, 90, 100]
                    }
                },
                yaxis: {
                    labels: {
                        formatter: function (value) {
                            return "â‚¦" + value.toLocaleString();
                        }
                    }
                }
            };
            var revenueChart = new ApexCharts(document.querySelector("#revenueChart"), optionsArea);
            revenueChart.render();

            // Donut Chart for Status Distribution
            var hasData = @Model.TotalTransactions > 0;
            var optionsDonut = {
                series: hasData ? [@Model.SuccessfulTransactions, @Model.PendingTransactions, @Model.FailedTransactions] : [1],
                labels: hasData ? ['Successful', 'Pending', 'Failed'] : ['No Data'],
                chart: {
                    type: 'donut',
                    fontFamily: 'Inter, sans-serif',
                    height: 300
                },
                colors: hasData ? ['#198754', '#ffc107', '#dc3545'] : ['#e9ecef'],
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                name: { show: true },
                                value: { show: true }
                            }
                        }
                    }
                },
                dataLabels: { enabled: false },
                legend: { position: 'bottom' },
                tooltip: {
                    enabled: hasData
                }
            };
            var statusChart = new ApexCharts(document.querySelector("#statusChart"), optionsDonut);
            statusChart.render();
        });
    </script>
}


