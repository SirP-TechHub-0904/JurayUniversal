@page
@model JurayUniversal.Website.Areas.MIS.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Console Home | Universal MIS";
    ViewData["Subtitle"] = "Launch, configure, and monitor your 25 universal system modules.";
}

@section HeaderActions {
    <button type="button" class="inline-flex items-center justify-center font-medium rounded-md border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 px-3 py-2 text-xs transition-colors duration-200" onclick="resetLayout()">
        Reset layout
    </button>
    <div class="relative inline-block text-left">
        <button type="button" class="inline-flex items-center justify-center font-medium rounded-md bg-[#0069A1] hover:bg-[#005b8b] text-white px-3 py-2 text-xs transition-colors duration-200" id="addWidgetBtn" onclick="document.getElementById('widget-dropdown-menu')?.classList.toggle('hidden')">
            + Add widgets
        </button>
        <div id="widget-dropdown-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl border border-gray-100 py-1 hidden z-50">
            <a href="javascript:;" class="block px-4 py-2 text-xs text-gray-700 hover:bg-gray-50 hover:text-[#0069A1]" onclick="toggleWidget('recent-visited-widget', true); document.getElementById('widget-dropdown-menu')?.classList.add('hidden')">Recently Visited</a>
            <a href="javascript:;" class="block px-4 py-2 text-xs text-gray-700 hover:bg-gray-50 hover:text-[#0069A1]" onclick="toggleWidget('applications-widget', true); document.getElementById('widget-dropdown-menu')?.classList.add('hidden')">Applications Hub</a>
            <a href="javascript:;" class="block px-4 py-2 text-xs text-gray-700 hover:bg-gray-50 hover:text-[#0069A1]" onclick="toggleWidget('financials-widget', true); document.getElementById('widget-dropdown-menu')?.classList.add('hidden')">Financials Chart</a>
            <a href="javascript:;" class="block px-4 py-2 text-xs text-gray-700 hover:bg-gray-50 hover:text-[#0069A1]" onclick="toggleWidget('health-widget', true); document.getElementById('widget-dropdown-menu')?.classList.add('hidden')">System Health Alert</a>
        </div>
    </div>
}

<style>
    .console-bg-gradient {
        background: linear-gradient(135deg, rgba(103, 80, 164, 0.05) 0%, rgba(0, 150, 136, 0.05) 100%);
    }

    .widget-header-drag {
        cursor: grab;
    }

    .feature-card {
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
        border-radius: 12px !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .feature-card:hover {
        transform: translateY(-3px) !important;
        box-shadow: var(--md-shadow-2) !important;
        border-color: rgba(103, 80, 164, 0.3) !important;
    }

    .fav-star {
        cursor: pointer;
        transition: color 0.15s ease;
        color: rgba(0, 0, 0, 0.15);
    }
    .fav-star.active {
        color: #FFC107 !important;
    }

    .recent-service-link {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
    }
    .recent-service-link:hover {
        background-color: rgba(103, 80, 164, 0.06);
    }

    .nav-pills .nav-link {
        border-radius: 20px !important;
        padding: 6px 16px !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        color: rgba(0, 0, 0, 0.6) !important;
        background-color: rgba(0, 0, 0, 0.04) !important;
        margin-right: 6px;
        margin-bottom: 6px;
        border: none !important;
        transition: all 0.15s ease;
    }
    .nav-pills .nav-link.active, .nav-pills .nav-link:hover {
        background-color: var(--md-primary) !important;
        color: #fff !important;
    }

    .badge-status {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 4px 8px;
        border-radius: 4px;
    }

    .timeline-item {
        border-left: 2px solid rgba(103, 80, 164, 0.15);
        padding-left: 15px;
        position: relative;
        padding-bottom: 12px;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -6px;
        top: 4px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--md-primary);
    }
</style>

<div class="container-fluid px-0 console-bg-gradient py-3 rounded-4">
    <!-- Main Grid Workspace -->
    <div class="row px-3">
        <!-- LEFT COLUMN: 7 Cols on Large, 12 on Mobile -->
        <div class="col-xl-7 col-lg-7 d-flex flex-column gap-4">
            
            <!-- WIDGET 1: Recently Visited -->
            <div class="card" id="recent-visited-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-history text-primary"></i>
                            <h5 class="card-title fw-700 mb-0">Recently Visited</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" id="recentDropdown" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item text-danger" href="javascript:;" onclick="clearRecentlyVisited()">Clear history</a></li>
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('recent-visited-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="row g-2" id="recent-list-container">
                        <!-- Loaded dynamically via script -->
                    </div>

                </div>
            </div>

            <!-- WIDGET 2: Applications Hub -->
            <div class="card" id="applications-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-th-large text-primary"></i>
                            <h5 class="card-title fw-700 mb-0">Applications Hub</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('applications-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="text-muted fs-13px">
                        Pin your most used applications here for quick access.
                    </div>
                </div>
            </div>

            <!-- WIDGET 3: Financials Chart -->
            <div class="card" id="financials-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-chart-line text-success"></i>
                            <h5 class="card-title fw-700 mb-0">Financials Chart</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('financials-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>
                    <div id="revenue-chart"></div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: 5 Cols on Large, 12 on Mobile -->
        <div class="col-xl-5 col-lg-5 d-flex flex-column gap-4">
            
            <!-- WIDGET 4: Welcome / Quick Start -->
            <partial name="~/Pages/Shared/Layouts/MIS/_DashboardWelcome.cshtml" />

            <!-- WIDGET 5: Health & Notifications -->
            <div class="card" id="health-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-heartbeat text-danger"></i>
                            <h5 class="card-title fw-700 mb-0">System Health & Alert Hub</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" id="healthDropdown" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('health-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Health Status Indicator -->
                    <div class="d-flex align-items-center justify-content-between mb-4 p-3 border rounded-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
                            <div>
                                <div class="fw-700 fs-13px text-dark">Services Healthy</div>
                                <div class="text-muted fs-11px">All systems are operating normally</div>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success">Healthy</span>
                    </div>

                    <!-- System Data Feeds (connected to backing DB repository counts) -->
                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-gray-600">Total Users</span>
                                <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-[#0069A1]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor"><path d="M13 7C13 9.20914 11.2091 11 9 11C6.79086 11 5 9.20914 5 7C5 4.79086 6.79086 3 9 3C11.2091 3 13 4.79086 13 7Z" stroke="currentColor" stroke-width="1.5"/><path d="M11 14H7C4.23858 14 2 16.2386 2 19C2 20.1046 2.89543 21 4 21H14C16.1046 21 16 20.1046 16 19C16 16.2386 13.7614 14 11 14Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/></svg>
                                </div>
                            </div>
                            <h4 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight my-1">@Model.TotalUsers</h4>
                            <span class="text-[11px] text-gray-500 font-medium">Registered profiles</span>
                        </div>
                        <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-gray-600">Active Users</span>
                                <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor"><path d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                </div>
                            </div>
                            <h4 class="text-xl sm:text-2xl font-extrabold text-emerald-600 tracking-tight my-1">@Model.ActiveUsers</h4>
                            <span class="text-[11px] text-gray-500 font-medium">Active accounts</span>
                        </div>
                        <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-gray-600">Pending</span>
                                <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                </div>
                            </div>
                            <h4 class="text-xl sm:text-2xl font-extrabold text-amber-600 tracking-tight my-1">@Model.PendingUsers</h4>
                            <span class="text-[11px] text-gray-500 font-medium">Approval pending</span>
                        </div>
                        <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-gray-600">Suspended</span>
                                <div class="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center text-red-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" color="currentColor"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                </div>
                            </div>
                            <h4 class="text-xl sm:text-2xl font-extrabold text-red-600 tracking-tight my-1">@Model.SuspendedUsers</h4>
                            <span class="text-[11px] text-gray-500 font-medium">Inactive/Disabled</span>
                        </div>
                    </div>
                </div>
            </div>



        </div>
    </div>
</div>


@Html.AntiForgeryToken()

<!-- ================== SCRIPTS BLOCK ================== -->
<script type="text/javascript">
    // Application Modules Dynamic Data loaded from DB
    const initialModules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model.AvailableFeatures ?? JurayUniversal.Website.Areas.MisManagement.Pages.IndexModel.AvailableFeatures ?? new List<JurayUniversal.Website.Areas.MisManagement.Pages.IndexModel.PredefinedFeature>()).Select(af => {
            var dbFeature = (Model.MisFeatures ?? new List<JurayUniversal.Domain.Models.MisFeature>()).FirstOrDefault(f => f.ModuleFolder == af.ModuleFolder);
            return new {
                id = af.ModuleFolder, // use string ID since it's the folder name
                name = af.Name,
                icon = af.Icon,
                category = af.Category ?? "core",
                status = dbFeature != null ? dbFeature.Status.ToString() : "Setup Pending",
                desc = af.Description,
                link = af.Link
            };
        })
    ));

    let currentCategory = 'all';
    let starredIds = [];
    let recentlyVisitedIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecentVisits ?? new List<string>()));

    // Database Widgets Configuration
    const dbWidgets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model.MisWidgets ?? new List<JurayUniversal.Domain.Models.MisWidget>()).Select(w => new { id = w.Id, code = w.WidgetCode, span = w.ColSpan, sort = w.SortOrder })
    ));

    // Initialize Page State
    document.addEventListener("DOMContentLoaded", function () {
        // Load settings from localStorage
        initSettings();
        
        // Render Widgets
        renderRecentlyVisited();
        
        // Initialize ApexCharts
        initRevenueChart();
    });

    function getElementIdByCode(code) {
        switch(code) {
            case 'welcome_wizard': return 'welcome-widget';
            case 'system_health_hub': return 'health-widget';
            case 'applications_hub': return 'applications-widget';
            case 'financials_chart': return 'financials-widget';
            case 'recent_visited': return 'recent-visited-widget';
            default: return null;
        }
    }

    function buildWidgetGrid() {
        const mainRow = document.querySelector('.row.px-3');
        if (!mainRow) return;

        // Create the new unified grid
        const widgetGrid = document.createElement('div');
        widgetGrid.className = 'row px-3 w-100 m-0';
        widgetGrid.id = 'widget-grid';

        // Extract widgets based on DB order
        dbWidgets.forEach(w => {
            const elId = getElementIdByCode(w.code);
            const el = document.getElementById(elId);
            if (el) {
                const wrapper = document.createElement('div');
                wrapper.className = `col-xl-${w.span} col-lg-${w.span === 12 ? 12 : 6} mb-4 sortable-item`;
                wrapper.dataset.widgetId = w.id;
                wrapper.dataset.widgetCode = w.code;
                
                // Keep the card taking full height
                el.classList.add('h-100');
                
                wrapper.appendChild(el);
                widgetGrid.appendChild(wrapper);
            }
        });

        // Insert new grid and remove old columns
        mainRow.parentElement.insertBefore(widgetGrid, mainRow);
        mainRow.remove();
    }

    function initSettings() {
        // Starred IDs defaults
        const storedStars = localStorage.getItem('mis_starred_ids');
        if (storedStars) {
            starredIds = JSON.parse(storedStars);
        } else {
            starredIds = ["MisUserManagement", "MisReports", "MisTicketing", "MisSmartAssist", "MisDMS"]; // Default Favorites
            localStorage.setItem('mis_starred_ids', JSON.stringify(starredIds));
        }

        // Recently Visited is now loaded directly from the backend Database Model.

        // Load hidden widgets states
        const widgetStates = localStorage.getItem('mis_widget_states');
        if (widgetStates) {
            const states = JSON.parse(widgetStates);
            for (const [widgetId, visible] of Object.entries(states)) {
                toggleWidgetElement(widgetId, visible);
            }
        }
    }

    // Toggle widget view
    function toggleWidget(widgetId, visible) {
        toggleWidgetElement(widgetId, visible);

        // Store configuration state
        let states = {};
        const storedStates = localStorage.getItem('mis_widget_states');
        if (storedStates) states = JSON.parse(storedStates);
        states[widgetId] = visible;
        localStorage.setItem('mis_widget_states', JSON.stringify(states));
    }

    function toggleWidgetElement(widgetId, visible) {
        const el = document.getElementById(widgetId);
        if (el) {
            // Find the wrapper if it was reparented by buildWidgetGrid
            const wrapper = el.parentElement.classList.contains('sortable-item') ? el.parentElement : el;
            
            if (visible) {
                wrapper.classList.remove('d-none');
                el.classList.remove('d-none');
            } else {
                wrapper.classList.add('d-none');
                el.classList.add('d-none');
            }
        }
    }

    function resetLayout() {
        localStorage.removeItem('mis_starred_ids');
        localStorage.removeItem('mis_recent_ids');
        localStorage.removeItem('mis_widget_states');
        
        // Reset local variables
        starredIds = ["MisUserManagement", "MisReports", "MisTicketing", "MisSmartAssist", "MisDMS"];
        recentlyVisitedIds = ["MisUserManagement", "MisTicketing", "MisSmartAssist", "MisDues", "MisDMS", "MisVoting"];
        
        // Make all widgets visible
        const allWidgets = ['recent-visited-widget', 'applications-widget', 'health-widget', 'welcome-widget'];
        allWidgets.forEach(w => toggleWidgetElement(w, true));

        // Re-render
        renderRecentlyVisited();
        
        showToast("Dashboard widgets reset to default settings.");
    }

    // Render Recently Visited List
    function renderRecentlyVisited() {
        const container = document.getElementById('recent-list-container');
        if (!container) return;

        container.innerHTML = '';
        
        if (recentlyVisitedIds.length === 0) {
            container.innerHTML = '<div class="col-12 py-3 text-center text-muted fs-13px">No features visited yet. Start launching modules below!</div>';
            return;
        }

        const itemsToRender = initialModules.filter(m => recentlyVisitedIds.includes(m.id));
        
        // Maintain the order of recentlyVisitedIds
        itemsToRender.sort((a, b) => recentlyVisitedIds.indexOf(a.id) - recentlyVisitedIds.indexOf(b.id));

        itemsToRender.forEach(m => {
            const cardHtml = `
                <div class="col-6 col-md-4">
                    <a href="javascript:;" onclick="visitModule('${m.id}', '${m.link}')" class="recent-service-link border">
                        <div class="d-flex align-items-center gap-2 text-truncate">
                            <span class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                                <i class="fas ${m.icon} fs-16px"></i>
                            </span>
                            <span class="fw-700 fs-13px text-dark text-truncate">${m.name}</span>
                        </div>
                    </a>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', cardHtml);
        });
    }



    function visitModule(id, url) {
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenElement ? tokenElement.value : '';

        // Trigger backend save, then navigate
        fetch('?handler=RecordVisit&moduleId=' + id, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        }).finally(() => {
            window.location.href = url;
        });
    }



    function clearRecentlyVisited() {
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenElement ? tokenElement.value : '';

        fetch('?handler=ClearVisits', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token }
        }).then(() => {
            recentlyVisitedIds = [];
            renderRecentlyVisited();
            showToast("Visited services history cleared.");
        });
    }



    // ApexCharts Financial Setup
    function initRevenueChart() {
        const chartElement = document.querySelector("#revenue-chart");
        if (!chartElement) return;

        // Since the Financial feature is not fully built/enabled yet, we will not show dummy data.
        // Data must come from the DB in the future.
        chartElement.innerHTML = `
            <div class="text-center py-5 text-muted">
                <i class="fas fa-chart-pie fa-3x mb-3 text-opacity-25"></i>
                <h6>No Financial Data Available</h6>
                <p class="fs-12px">This widget will populate with real data from the database once the Financials module is activated.</p>
            </div>
        `;
    }

    // Event Handler Placeholders for interactive UI alerts
    function configureModule(name) {
        showToast(`Configuration panel for [${name}] Area is opening...`);
    }

    function triggerCreateFeature() {
        showToast("Module initialization wizard launched.");
    }

    function runActionRecipe(recipeName) {
        showToast(`Action recipe [${recipeName}] launched successfully in dry run mode!`);
    }

    function openAIConfig() {
        showToast("BYOK AI billing configurations loaded.");
    }

    function openQuickGuide() {
        showToast("Onboarding wizard loaded.");
    }

    // Helper Toast notification simulator
    function showToast(message) {
        // Check if toast container exists, if not create one
        let container = document.getElementById('toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'position-fixed bottom-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
        }

        const toastId = 'toast_' + Date.now();
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-white bg-dark border-0 shadow-lg show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body fs-13px fw-500">
                        <i class="fas fa-check-circle text-success me-2"></i> ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', toastHtml);

        // Remove toast automatically after 3 seconds
        setTimeout(() => {
            const toastEl = document.getElementById(toastId);
            if (toastEl) {
                toastEl.classList.remove('show');
                setTimeout(() => toastEl.remove(), 300);
            }
        }, 3000);
    }
</script>

