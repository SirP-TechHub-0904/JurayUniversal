@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Dashboard.KpiSettingsModel
@{
    ViewData["Title"] = "KPI Settings";
    ViewData["Subtitle"] = "Configure system settings and preferences.";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "KpiSettings";
}

<div class="page-content">
    <div class="row">
        <!-- KPI Indicators List -->
        <div class="col-12 col-md-8">
            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-header border-bottom bg-transparent py-3">
                    <h5 class="mb-0 text-dark"><i class="bi bi-bar-chart-steps me-1 text-success"></i> Active KPI Indicators</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3">Indicator Title</th>
                                    <th class="py-3">Description</th>
                                    <th class="py-3 text-center">Max Score</th>
                                    <th class="py-3 text-center">Order</th>
                                    <th class="px-4 py-3 text-end" style="width: 150px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Indicators.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="bi bi-bar-chart-line fs-2 d-block mb-2"></i>
                                            No KPI indicators defined yet. Use the form on the right to add one.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var ind in Model.Indicators)
                                    {
                                        <tr>
                                            <td class="px-4 py-3">
                                                <div class="text-dark fw-bold">@ind.Title</div>
                                            </td>
                                            <td class="py-3 text-muted fs-7">
                                                @ind.Description
                                            </td>
                                            <td class="py-3 text-center fw-bold text-primary">
                                                @ind.MaxScore
                                            </td>
                                            <td class="py-3 text-center text-muted">
                                                @ind.SortOrder
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                @if (!Model.IsReadOnly)
                                                {
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <a asp-page="/Dashboard/KpiSettings" asp-route-editId="@ind.Id" class="btn btn-sm btn-outline-warning">
                                                            Edit
                                                        </a>
                                                        <form method="post" asp-page-handler="Delete" asp-route-id="@ind.Id">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this indicator? This will remove all user scores associated with it.')">
                                                                Delete
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic fs-12px"><i class="bi bi-lock"></i> Read-only</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Evaluation Periods Management Card -->
            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-header border-bottom bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark"><i class="bi bi-calendar-range me-1 text-primary"></i> Managed Evaluation Periods</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3">Period Title</th>
                                    <th class="py-3">Status</th>
                                    <th class="px-4 py-3 text-end" style="width: 150px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.EvaluationPeriods.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            No custom evaluation periods defined yet. Periods will be created automatically when scores are saved or added via the form.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in Model.EvaluationPeriods)
                                    {
                                        <tr>
                                            <td class="px-4 py-3">
                                                <div class="text-dark fw-bold">@p.Title</div>
                                                @if (!string.IsNullOrEmpty(p.Description))
                                                {
                                                    <small class="text-muted">@p.Description</small>
                                                }
                                            </td>
                                            <td class="py-3">
                                                @if (p.IsActive)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                @if (!Model.IsReadOnly)
                                                {
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <a asp-page="/Dashboard/KpiSettings" asp-route-editPeriodId="@p.Id" class="btn btn-sm btn-outline-warning">
                                                            Edit
                                                        </a>
                                                        <form method="post" asp-page-handler="DeletePeriod" asp-route-id="@p.Id">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this evaluation period?')">
                                                                Delete
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Forms Side Column -->
        <div class="col-12 col-md-4">
            @if (!Model.IsReadOnly)
            {
                <!-- Add/Edit KPI Indicator Form -->
                <div class="card shadow-sm border-0 mb-4 rounded-4">
                    <div class="card-header border-bottom bg-transparent py-3">
                        <h5 class="mb-0 text-dark">
                            <i class="bi bi-pencil-square me-1 text-primary"></i> 
                            @(Model.IndicatorInput.Id > 0 ? "Edit KPI Indicator" : "Add KPI Indicator")
                        </h5>
                    </div>
                    <div class="card-body py-4">
                        <form method="post">
                            <input type="hidden" asp-for="IndicatorInput.Id" />

                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" asp-for="IndicatorInput.Title">Indicator Title</label>
                                <input type="text" asp-for="IndicatorInput.Title" class="form-control" required placeholder="e.g. Attendance & Punctuality" />
                                <span asp-validation-for="IndicatorInput.Title" class="text-danger fs-7"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" asp-for="IndicatorInput.Description">Description</label>
                                <textarea asp-for="IndicatorInput.Description" class="form-control" rows="3" placeholder="Define the scoring rubric..."></textarea>
                                <span asp-validation-for="IndicatorInput.Description" class="text-danger fs-7"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" asp-for="IndicatorInput.MaxScore">Maximum Score</label>
                                <input type="number" step="0.01" asp-for="IndicatorInput.MaxScore" class="form-control" required min="1" max="1000" />
                                <span asp-validation-for="IndicatorInput.MaxScore" class="text-danger fs-7"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" asp-for="IndicatorInput.SortOrder">Sort Order</label>
                                <input type="number" asp-for="IndicatorInput.SortOrder" class="form-control" required />
                                <span asp-validation-for="IndicatorInput.SortOrder" class="text-danger fs-7"></span>
                            </div>

                            <div class="mb-4">
                                <div class="form-check">
                                    <input asp-for="IndicatorInput.IsActive" type="checkbox" class="form-check-input" id="isActiveCheck">
                                    <label class="form-check-label text-muted fs-7" for="isActiveCheck">
                                        Active indicator (visible during scoring)
                                    </label>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary flex-grow-1 py-2 rounded-pill">
                                    <i class="bi bi-save me-1"></i> Save Indicator
                                </button>
                                @if (Model.IndicatorInput.Id > 0)
                                {
                                    <a asp-page="/Dashboard/KpiSettings" class="btn btn-light py-2 rounded-pill">Cancel</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Add/Edit Evaluation Period Form -->
                <div class="card shadow-sm border-0 mb-4 rounded-4">
                    <div class="card-header border-bottom bg-transparent py-3">
                        <h5 class="mb-0 text-dark">
                            <i class="bi bi-calendar-plus me-1 text-primary"></i> 
                            @(Model.PeriodInput.Id > 0 ? "Edit Evaluation Period" : "Create Evaluation Period")
                        </h5>
                    </div>
                    <div class="card-body py-4">
                        <form method="post" asp-page-handler="SavePeriod">
                            <input type="hidden" asp-for="PeriodInput.Id" />

                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" asp-for="PeriodInput.Title">Period Title</label>
                                <input type="text" asp-for="PeriodInput.Title" class="form-control" required placeholder="e.g. Q3 2026, 2026 Mid-Year Audit" />
                                <span asp-validation-for="PeriodInput.Title" class="text-danger fs-7"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted fw-semibold" asp-for="PeriodInput.Description">Description / Notes</label>
                                <input type="text" asp-for="PeriodInput.Description" class="form-control" placeholder="Optional notes for this cycle..." />
                                <span asp-validation-for="PeriodInput.Description" class="text-danger fs-7"></span>
                            </div>

                            <div class="mb-4">
                                <div class="form-check">
                                    <input asp-for="PeriodInput.IsActive" type="checkbox" class="form-check-input" id="isPeriodActiveCheck" checked>
                                    <label class="form-check-label text-muted fs-7" for="isPeriodActiveCheck">
                                        Active evaluation period
                                    </label>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success flex-grow-1 py-2 rounded-pill">
                                    <i class="bi bi-plus-circle me-1"></i> Save Period Title
                                </button>
                                @if (Model.PeriodInput.Id > 0)
                                {
                                    <a asp-page="/Dashboard/KpiSettings" class="btn btn-light py-2 rounded-pill">Cancel</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 mb-4 bg-light rounded-4">
                    <div class="card-body py-4 text-center">
                        <i class="bi bi-lock-fill fs-1 text-muted mb-2 d-block"></i>
                        <h5 class="text-dark">Read-Only Access</h5>
                        <p class="text-muted fs-13px mb-0">You do not have permission to add or edit KPI Settings.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
