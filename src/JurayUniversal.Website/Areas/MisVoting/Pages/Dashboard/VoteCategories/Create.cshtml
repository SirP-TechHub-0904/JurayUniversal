@page
@model JurayUniversal.Website.Areas.MisVoting.Pages.Dashboard.VoteCategories.CreateModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-dark text-white rounded-top-4 p-4">
        <h4 class="card-title mb-0 text-white">Add Vote Category</h4>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Category.MisElectionId" />

            <div class="form-group mb-3">
                <label asp-for="Category.Title" class="form-label fw-bold">Category Title <span class="text-danger">*</span></label>
                <input asp-for="Category.Title" class="form-control form-control-lg rounded-3" placeholder="e.g. President, Secretary" required />
                <span asp-validation-for="Category.Title" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category.Description" class="form-label fw-bold">Description (Optional)</label>
                <textarea asp-for="Category.Description" class="form-control rounded-3" rows="3" placeholder="Additional details about this category..."></textarea>
                <span asp-validation-for="Category.Description" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Category.SortOrder" class="form-label fw-bold">Display Order</label>
                <input asp-for="Category.SortOrder" class="form-control rounded-3" type="number" required />
                <span asp-validation-for="Category.SortOrder" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold"><i class="bi bi-save me-2"></i> Save Category</button>
                <a asp-page="../Elections/Details" asp-route-id="@Model.Category.MisElectionId" class="btn btn-light btn-lg rounded-pill px-5 fw-bold border">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
