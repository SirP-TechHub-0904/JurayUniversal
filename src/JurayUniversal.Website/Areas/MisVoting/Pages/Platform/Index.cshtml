@page
@model JurayUniversal.Website.Areas.MisVoting.Pages.Platform.IndexModel
@{
    ViewData["Title"] = "Elections Hub";
    Layout = "~/Pages/Shared/Layouts/MIS/_MisVotingLayout.cshtml";
}

<div class="container max-w-1200 mt-4 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark">Elections Hub</h1>
        <p class="lead text-muted">Browse and participate in active elections or view past results.</p>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model.Elections == null || !Model.Elections.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-inbox text-muted display-1"></i>
                <h3 class="mt-3 text-muted">No Elections Found</h3>
            </div>
        }
        else
        {
            foreach (var election in Model.Elections)
            {
                var isCompleted = election.VotingStatus == Domain.Enum.Enum.MisVotingStatus.Completed;
                var isActive = election.VotingStatus == Domain.Enum.Enum.MisVotingStatus.Active && election.EndDate >= DateTime.UtcNow;
                var isUpcoming = election.VotingStatus == Domain.Enum.Enum.MisVotingStatus.Upcoming || (election.VotingStatus == Domain.Enum.Enum.MisVotingStatus.Active && election.StartDate > DateTime.UtcNow);

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        @if (!string.IsNullOrEmpty(election.ElectionBannerUrl))
                        {
                            <img src="@election.ElectionBannerUrl" class="card-img-top object-fit-cover" style="height: 180px;" alt="@election.Title">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="bi bi-image text-muted display-4"></i>
                            </div>
                        }
                        
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">@election.Title</h5>
                                @if (isActive)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">Active</span>
                                }
                                else if (isCompleted)
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">Closed</span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Upcoming</span>
                                }
                            </div>
                            
                            <p class="card-text text-muted small mb-4 flex-grow-1">
                                <i class="bi bi-calendar3 me-2"></i> @election.StartDate.ToString("MMM dd, yyyy") - @election.EndDate.ToString("MMM dd, yyyy")
                                <br/>
                                <i class="bi bi-diagram-3 me-2 mt-2"></i> Type: @election.ElectionType
                            </p>

                            <div class="mt-auto">
                                @if (isActive)
                                {
                                    var shortCode = !string.IsNullOrEmpty(election.ShortCode) ? election.ShortCode : election.Id.ToString();
                                    <a asp-page="/Platform/Vote" asp-route-shortcode="@shortCode" class="btn btn-primary w-100 fw-bold rounded-pill">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Enter Voting Booth
                                    </a>
                                }
                                else if (isCompleted)
                                {
                                    if (election.ShowResults)
                                    {
                                        <a asp-page="/Platform/Results" asp-route-id="@election.Id" class="btn btn-outline-secondary w-100 fw-bold rounded-pill">
                                            <i class="bi bi-bar-chart-fill me-2"></i> View Final Results
                                        </a>
                                    }
                                    else
                                    {
                                        <button disabled class="btn btn-outline-secondary w-100 fw-bold rounded-pill">
                                            <i class="bi bi-lock-fill me-2"></i> Results Hidden
                                        </button>
                                    }
                                }
                                else if (isUpcoming)
                                {
                                    <button disabled class="btn btn-outline-warning w-100 fw-bold rounded-pill">
                                        <i class="bi bi-clock-history me-2"></i> Opens Soon
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
