@page
@model JurayUniversal.Website.Areas.MisContent.Pages.IModal.DetailsModel

@{
    ViewData["Title"] = "Details";
    ViewData["BackUrl"] = "./Index";
    @if (User.Identity.IsAuthenticated && User.IsInRole("SubAdmin") || User.IsInRole("mSuperAdmin"))
    {
        

    }
    else
    {
        

    }
}

<div class="card card-default">
    
    <!-- /.card-header -->

    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-12">
                <dl class="row">
                      <dt class="col-sm-2">
                          @Html.DisplayNameFor(model => model.PostModal.ImageUrl)
                      </dt>
                      <dd class="col-sm-10">
                          @if (!string.IsNullOrEmpty(Model.PostModal.ImageUrl))
                          {
                              <div class="media-display-block mb-3">
                                  <a href="@Model.PostModal.ImageUrl" target="_blank">
                                      <img src="@Model.PostModal.ImageUrl" class="img-fluid rounded shadow-sm mb-2" style="max-height: 200px; object-fit: contain;" alt="Preview" />
                                  </a>
                                  <br/>
                                  <div class="btn-group" role="group">
                                      <button type="button" class="btn btn-secondary btn-sm" onclick="copyToClipboard('@Model.PostModal.ImageUrl')">
                                          <i class="fa fa-copy"></i> Copy Image URL
                                      </button>
                                      <button type="button" class="btn btn-info btn-sm" onclick="copyToClipboard('@Model.PostModal.ImageKey')">
                                          <i class="fa fa-copy"></i> Copy Image Name
                                      </button>
                                  </div>
                              </div>
                          }
                      </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.Title)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.Title)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.Description)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.Description)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.ModalTime)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.ModalTime)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.ModalOccurance)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.ModalOccurance)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.StartTime)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.StartTime)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.StopTime)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.StopTime)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.ShowOnlyImage)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.ShowOnlyImage)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.ShowTitle)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.ShowTitle)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.ShowDescription)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.ShowDescription)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.ShowImage)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.ShowImage)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.PostModal.Publish)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.PostModal.Publish)
                    </dd>
                </dl>
            </div>
        </div>
        <!-- /.card-body -->
        <div class="card-footer">
            

        </div>
    </div>
</div>




