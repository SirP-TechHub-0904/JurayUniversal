@page
@model JurayUniversal.Website.Areas.MisUserManagement.Pages.Platform.MyRolesModel
@{
    ViewData["Title"] = "My Permissions Matrix";
    ViewData["ActiveMenu"] = "UserManagement";
    ViewData["ActiveSubMenu"] = "MyRoles";
}

<div class="page-heading">
    <div class="row align-items-center">
        <div class="col-md-6 col-12">
            <h3>My Access Roles</h3>
            <p class="text-subtitle text-muted">Verify which parts of the organization system you have authorization to access.</p>
        </div>
        <div class="col-md-6 col-12 text-md-end">
            <button class="btn btn-outline-info btn-sm rounded-pill me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#misHelpOffcanvas">
                <i class="bi bi-question-circle me-1"></i> Help & Guide
            </button>
            <a asp-page="/Platform/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>

<div class="page-content">
    <div class="card shadow-sm border-0">
        <div class="card-header border-bottom bg-transparent py-3">
            <h5 class="mb-0 text-dark"><i class="bi bi-shield-check text-info me-1"></i> Active Custom Permissions Matrix</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Feature Module</th>
                            <th class="py-3">Role Level</th>
                            <th class="py-3">Assigned By</th>
                            <th class="px-4 py-3">Date Assigned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FeatureRoles.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-shield-slash fs-2 d-block mb-2"></i>
                                    You have not been assigned any custom feature permissions yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var role in Model.FeatureRoles)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light-primary text-primary rounded p-2 me-3">
                                                <i class="bi bi-app-indicator"></i>
                                            </div>
                                            <span class="text-dark fw-bold">@role.FeatureAreaKey</span>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light-primary text-primary px-3 py-2">@role.ActionRole.ToString()</span>
                                    </td>
                                    <td class="py-3 text-muted fs-7">
                                        @role.AssignedBy
                                    </td>
                                    <td class="px-4 py-3 text-muted fs-7">
                                        @role.Date.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
