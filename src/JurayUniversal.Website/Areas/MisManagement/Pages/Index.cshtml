@page
@model JurayUniversal.Website.Areas.MisManagement.Pages.IndexModel
@{
    ViewData["Title"] = "MIS Features Management";
    ViewData["Subtitle"] = "Overview and management of all records.";
    ViewData["ActiveMenu"] = "MisManagement";
    ViewData["ActiveSubMenu"] = "Features";
}



<div class="page-content">
    <div class="row g-4">
        @foreach (var preset in JurayUniversal.Website.Areas.MisManagement.Pages.IndexModel.AvailableFeatures)
        {
            var dbFeature = Model.MisFeatures.FirstOrDefault(x => x.ModuleFolder == preset.ModuleFolder);
            bool isConfigured = dbFeature != null;
            
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm feature-card">
                    <div class="card-body position-relative">
                        <div class="d-flex align-items-start mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                                <i class="@preset.Icon fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1 text-dark">@preset.Name</h6>
                                @if (!isConfigured)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning mb-2">Setup Pending</span>
                                    <div class="fs-12px text-muted mb-2">Not currently configured for use.</div>
                                }
                                else
                                {
                                    @if (dbFeature.Status == JurayUniversal.Domain.Enum.Enum.FeatureBillingStatus.Active)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success mb-2">Active</span>
                                    }
                                    else if (dbFeature.Status == JurayUniversal.Domain.Enum.Enum.FeatureBillingStatus.Disabled)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger mb-2">Disabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark mb-2">Suspended</span>
                                    }
                                    
                                    <div class="fs-12px text-muted mb-2">
                                        <span class="fw-bold text-dark">&#8358;@dbFeature.CostPerDuration.ToString("N2")</span> / @dbFeature.BillingDuration
                                    </div>
                                }
                            </div>
                        </div>
                        <p class="text-muted fs-13px">@preset.Description</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 pt-0 pb-3">
                        @if (!isConfigured)
                        {
                            <form method="post" asp-page-handler="EnablePreset">
                                <input type="hidden" name="moduleFolder" value="@preset.ModuleFolder" />
                                <input type="hidden" name="name" value="@preset.Name" />
                                <input type="hidden" name="description" value="@preset.Description" />
                                <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">
                                    <i class="bi bi-power me-1"></i> Enable Feature
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a asp-page="./Edit" asp-route-id="@dbFeature.Id" class="btn btn-outline-primary w-100 rounded-pill fw-bold"><i class="bi bi-pencil me-1"></i> Edit Pricing</a>
                                
                                @if (dbFeature.Status == JurayUniversal.Domain.Enum.Enum.FeatureBillingStatus.Disabled)
                                {
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@dbFeature.Id" class="w-100 m-0 p-0">
                                        <button type="submit" class="btn btn-outline-success w-100 rounded-pill fw-bold"><i class="bi bi-check-circle"></i> Enable</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@dbFeature.Id" class="w-100 m-0 p-0">
                                        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold"><i class="bi bi-x-circle"></i> Disable</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
