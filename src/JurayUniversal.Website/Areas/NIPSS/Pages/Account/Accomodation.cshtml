    <script>
    $(document).ready(function () {
        $("#uploadButton").on('click', function () {
            const fileInput = $('#remitaFile');
            const uploadStatus = $('#uploadStatus');

            // Check if fileInput exists and has a file
            if (fileInput.length === 0 || fileInput[0].files.length === 0) {
                uploadStatus.html('<span class="text-danger">Please select a file to upload.</span>');
                return;
            }

            const formData = new FormData();
            formData.append('RemitaFile', fileInput[0].files[0]);
            formData.append('xParticipantId', '@Model.ParticipantId'); // Pass the ParticipantId to the server

            const url = '@Url.Page("/Account/Accomodation", new { area = "NIPSS", handler = "UploadFile" })';

            $.ajax({
                type: 'POST',
                url: '/NIPSS/Account/Accomodation?handler=UploadFile',
                data: formData,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result.success) {
                        uploadStatus.html('<span class="text-success">File uploaded successfully.</span>');
                    } else {
                        uploadStatus.html(`<span class="text-danger">${result.message}</span>`);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error uploading file:', error);
                    uploadStatus.html('<span class="text-danger">An error occurred during upload. Please try again.</span>');
                }
            });
        });
    });
    </script>


}