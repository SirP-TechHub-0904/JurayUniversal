                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>
                        }
                        else if (item.ButtonLink == "Direct")
                        {
                            <a href="@item.DirectUrl" class="site-button-secondry btn-half outline m-r15">
                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>

                        }
                        else if (item.ButtonLink == "00")
                        {
                            <a asp-page="/Contact" class="site-button-secondry btn-half outline m-r15">
                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Source" asp-route-id="@item.ButtonLink" asp-route-title="@regex.Replace(item.Title, "-")" class="site-button-secondry btn-half outline m-r15">
                                @item.ButtonText
                                <span class="sx-bg-primary"></span>
                            </a>
                        }


                    </div>
                </div>
            </div>

        </div>

    }


