@page "{schemaId:long}"
@model JurayUniversal.Website.Areas.MisReports.Pages.Platform.SchemaDetailsModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Schema?.Name + " Workspace";
    ViewData["Subtitle"] = Model.Schema?.Description ?? "Monthly reporting workspace and calendar overview.";
    ViewData["ShowBackButton"] = false;
    ViewData["ActiveMenu"] = "MisReports";

    int prevMonth = Model.Month - 1;
    int prevYear = Model.Year;
    if (prevMonth == 0)
    {
        prevMonth = 12;
        prevYear--;
    }

    int nextMonth = Model.Month + 1;
    int nextYear = Model.Year;
    if (nextMonth == 13)
    {
        nextMonth = 1;
        nextYear++;
    }
}

@section HeaderActions {
    <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3 me-2">
        <i class="bi bi-arrow-left"></i> Dashboard
    </a>
    <a asp-page="./SchemaDetails" asp-route-schemaId="@Model.Schema.Id" asp-route-year="@prevYear" asp-route-month="@prevMonth" class="btn btn-light btn-sm rounded-pill px-3">
        <i class="bi bi-chevron-left me-1"></i> @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(prevMonth)
    </a>
    <a asp-page="./SchemaDetails" asp-route-schemaId="@Model.Schema.Id" asp-route-year="@nextYear" asp-route-month="@nextMonth" class="btn btn-light btn-sm rounded-pill px-3">
        @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(nextMonth) <i class="bi bi-chevron-right ms-1"></i>
    </a>
    @if (Model.CanSubmitToday)
    {
        <a asp-page="./Submit" asp-route-schemaId="@Model.Schema.Id" class="btn btn-primary btn-sm rounded-pill px-4 ms-2">
            <i class="bi bi-plus-lg me-1"></i> Submit Report
        </a>
    }
}

<style>
    .kpi-card {
        background: white;
        border-radius: 1rem;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        transition: transform 0.2s ease;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
    }
    .calendar-cell {
        min-height: 100px;
        position: relative;
        border: 1px solid #eef2f5;
        border-radius: 0.5rem;
        transition: all 0.2s ease;
    }
    .calendar-cell.cell-ontime {
        background-color: #d1e7dd !important;
        color: #0f5132;
        border-color: #badbcc;
    }
    .calendar-cell.cell-late {
        background-color: #fff3cd !important;
        color: #664d03;
        border-color: #ffecb5;
    }
    .calendar-cell.cell-missed {
        background-color: #f8d7da !important;
        color: #842029;
        border-color: #f5c2c7;
    }
    .calendar-cell.cell-pending {
        background-color: #e2f0fd !important;
        border-color: #b6d4fe;
        color: #084298;
        border-style: dashed;
        border-width: 2px;
    }
    .calendar-cell.cell-today {
        box-shadow: inset 0 0 0 3px #0d6efd;
    }
    .calendar-cell.cell-empty {
        background-color: #fafbfc;
        opacity: 0.5;
        border-color: #f1f3f5;
    }
    .cell-number {
        position: absolute;
        top: 6px;
        right: 8px;
        font-weight: 700;
        font-size: 0.85rem;
        opacity: 0.8;
    }
    .cell-content {
        margin-top: 24px;
        font-size: 0.75rem;
    }
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }
</style>



<div class="page-content bg-white p-0 p-md-4" style="min-height: 100vh;">
    
    <!-- Month Selector Bar -->
    @if (Model.TodaySubmissionId.HasValue)
    {
        <div class="card bg-success bg-opacity-10 border border-success border-opacity-50 rounded-4 shadow-xs mb-4">
            <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h6 class="fw-bold text-success-emphasis mb-1"><i class="bi bi-check-circle-fill me-2"></i> Report Submitted Successfully</h6>
                    <p class="text-muted small mb-0">Today's report has been recorded. You can edit it anytime before the deadline of <strong>@DateTime.Today.Add(Model.Schema.DeadlineTime).ToString("h:mm tt")</strong>.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="./Details" asp-route-id="@Model.TodaySubmissionId" class="btn btn-success text-white fw-bold rounded-pill px-4">
                        <i class="bi bi-eye me-1"></i> View Details
                    </a>
                    <a asp-page="./Edit" asp-route-id="@Model.TodaySubmissionId" class="btn btn-outline-success fw-bold rounded-pill px-4">
                        <i class="bi bi-pencil me-1"></i> Edit Submission
                    </a>
                </div>
            </div>
        </div>
    }
    else if (Model.TodayIsMissed)
    {
        <div class="card bg-danger bg-opacity-10 border border-danger border-opacity-50 rounded-4 shadow-xs mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-danger-emphasis mb-1"><i class="bi bi-x-circle-fill me-2"></i> Today's Deadline Passed (Missed Report)</h6>
                <p class="text-muted small mb-0">The submission deadline for today's report was <strong>@DateTime.Today.Add(Model.Schema.DeadlineTime).ToString("h:mm tt")</strong>. The workspace is closed for today.</p>
            </div>
        </div>
    }

    <!-- Analytics Dashboard Row -->
    <div class="row g-4 mb-4">
        <!-- Summary Numbers -->
        <div class="col-lg-8 d-flex flex-column">
            <div class="row g-3 flex-grow-1">
                <div class="col-sm-6 col-xl-3">
                    <div class="card kpi-card h-100">
                        <div class="card-body p-3.5 text-center">
                            <span class="fs-8 fw-semibold text-muted text-uppercase d-block mb-1">On-Time</span>
                            <h3 class="fw-bold text-success mb-1">@Model.OnTimeCount</h3>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 fs-9"><i class="bi bi-check-lg me-1"></i> Compliant</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card kpi-card h-100">
                        <div class="card-body p-3.5 text-center">
                            <span class="fs-8 fw-semibold text-muted text-uppercase d-block mb-1">Late</span>
                            <h3 class="fw-bold text-warning mb-1">@Model.LateCount</h3>
                            <span class="badge bg-warning bg-opacity-10 text-warning-emphasis rounded-pill px-2.5 py-1 fs-9"><i class="bi bi-exclamation me-1"></i> Warning</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card kpi-card h-100">
                        <div class="card-body p-3.5 text-center">
                            <span class="fs-8 fw-semibold text-muted text-uppercase d-block mb-1">Missed</span>
                            <h3 class="fw-bold text-danger mb-1">@Model.MissedCount</h3>
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 fs-9"><i class="bi bi-x-circle me-1"></i> Defaulter</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card kpi-card h-100">
                        <div class="card-body p-3.5 text-center d-flex flex-column justify-content-center align-items-center">
                            <span class="fs-8 fw-semibold text-muted text-uppercase d-block mb-1">Compliance Rate</span>
                            <h3 class="fw-bold text-primary mb-1">@Model.ComplianceRate%</h3>
                            <div class="progress w-100 mt-2" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.ComplianceRate%" aria-valuenow="@Model.ComplianceRate" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doughnut Compliance Chart -->
        <div class="col-lg-4">
            <div class="card border rounded-4 shadow-sm h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-center" style="min-height: 180px;">
                    <div class="w-100" style="max-width: 150px; height: 150px;">
                        <canvas id="complianceDoughnut"></canvas>
                    </div>
                    <div class="ms-4">
                        <h6 class="fw-bold text-dark mb-2">Month Performance</h6>
                        <div class="d-flex align-items-center mb-1">
                            <span class="badge rounded-circle bg-success me-2" style="width:10px; height:10px; display:inline-block;"></span>
                            <span class="small text-muted">On-Time</span>
                        </div>
                        <div class="d-flex align-items-center mb-1">
                            <span class="badge rounded-circle bg-warning me-2" style="width:10px; height:10px; display:inline-block;"></span>
                            <span class="small text-muted">Late</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge rounded-circle bg-danger me-2" style="width:10px; height:10px; display:inline-block;"></span>
                            <span class="small text-muted">Missed</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toggle View Selection Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-list-task me-2 text-primary"></i> Workspace Ledger</h5>
        <div class="btn-group shadow-sm rounded-pill overflow-hidden bg-white border p-1" role="group">
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 py-1.5" id="btn-list-view">
                <i class="bi bi-list-ul me-1"></i> List View
            </button>
            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 ms-1 active-toggle" id="btn-calendar-view">
                <i class="bi bi-calendar-week me-1"></i> Calendar View
            </button>
        </div>
    </div>

    <!-- LIST VIEW CONTAINER -->
    <div id="list-view-container" class="card shadow-sm border-0 rounded-4 mb-4 d-none">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Period Date</th>
                            <th>Time Submitted</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DayStatuses.Where(d => d.Status != "NotDue" && d.Status != "Empty").OrderByDescending(d => d.Date))
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@item.Date.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (item.SubmittedAt.HasValue)
                                    {
                                        @item.SubmittedAt.Value.ToString("hh:mm tt")
                                    }
                                    else if (item.Status == "Upcoming")
                                    {
                                        <text>---</text>
                                    }
                                    else
                                    {
                                        <text>--</text>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "OnTime")
                                    {
                                        <span class="badge bg-success rounded-pill px-3"><i class="bi bi-check-circle me-1"></i> On-Time</span>
                                    }
                                    else if (item.Status == "Late")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3"><i class="bi bi-exclamation-triangle me-1"></i> Late</span>
                                    }
                                    else if (item.Status == "Missed")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3"><i class="bi bi-x-circle me-1"></i> Missed</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3"><i class="bi bi-clock me-1"></i> Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3"><i class="bi bi-calendar-event me-1"></i> Upcoming</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    @if (item.SubmissionId.HasValue)
                                    {
                                        <a asp-page="./Details" asp-route-id="@item.SubmissionId.Value" class="btn btn-light btn-sm rounded-circle text-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <a asp-page="./Submit" asp-route-schemaId="@Model.Schema.Id" class="btn btn-primary btn-sm rounded-pill px-3 py-1">Submit</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-bold">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CALENDAR VIEW CONTAINER -->
    <div id="calendar-view-container" class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            
            <div class="table-responsive pb-2">
                <!-- Calendar Headers -->
                <div class="calendar-grid text-center text-uppercase fw-bold text-muted small mb-2" style="min-width: 700px;">
                    <div>Mon</div>
                    <div>Tue</div>
                    <div>Wed</div>
                    <div>Thu</div>
                    <div>Fri</div>
                    <div>Sat</div>
                    <div>Sun</div>
                </div>

                <!-- Calendar Days Grid -->
                <div class="calendar-grid" style="min-width: 700px;">
                @foreach (var day in Model.CalendarDays)
                {
                    <div>
                        @if (day.Status == "Empty")
                        {
                            <div class="calendar-cell cell-empty"></div>
                        }
                        else
                        {
                            var cellClass = "";
                            if (day.Status == "OnTime") cellClass = "cell-ontime";
                            else if (day.Status == "Late") cellClass = "cell-late";
                            else if (day.Status == "Missed") cellClass = "cell-missed";
                            else if (day.Status == "Pending") cellClass = "cell-pending";
                            
                            if (day.IsToday) cellClass += " cell-today";

                            <div class="calendar-cell p-2 d-flex flex-column justify-content-between @cellClass">
                                <span class="cell-number">@day.DayNumber</span>
                                
                                <div class="cell-content text-center font-monospace fw-bold">
                                    @if (day.Status == "OnTime")
                                    {
                                        <div class="badge bg-success rounded-circle p-1.5 text-white shadow-xs">
                                            <i class="bi bi-check-lg" style="font-size: 0.95rem;"></i>
                                        </div>
                                        <a asp-page="./Details" asp-route-id="@day.SubmissionId" class="stretched-link text-decoration-none" title="View details"></a>
                                    }
                                    else if (day.Status == "Late")
                                    {
                                        <div class="badge bg-warning text-dark rounded-circle p-1.5 shadow-xs" title="Submitted Late">
                                            <i class="bi bi-exclamation" style="font-size: 0.95rem;"></i>
                                        </div>
                                        <a asp-page="./Details" asp-route-id="@day.SubmissionId" class="stretched-link text-decoration-none" title="View details"></a>
                                    }
                                    else if (day.Status == "Missed")
                                    {
                                        <div class="badge bg-danger rounded-circle p-1.5 text-white shadow-xs" title="Missed Report">
                                            <i class="bi bi-x-lg" style="font-size: 0.95rem;"></i>
                                        </div>
                                    }
                                    else if (day.Status == "Pending")
                                    {
                                        <a asp-page="./Submit" asp-route-schemaId="@Model.Schema.Id" class="btn btn-outline-primary btn-xs rounded-pill text-uppercase fw-bold text-center border-2 py-0.5 px-2 stretched-link" style="font-size: 0.65rem;">
                                            Submit
                                        </a>
                                    }
                                    else if (day.Status == "Upcoming")
                                    {
                                        <span class="text-muted text-uppercase fw-semibold fs-9">Upcoming</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-40 fs-9">--</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/Layouts/MIS/_MisContextualHelp.cshtml" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Render Compliance Doughnut Chart
            var ctx = document.getElementById('complianceDoughnut').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['On-Time', 'Late', 'Missed'],
                    datasets: [{
                        data: [@Model.OnTimeCount, @Model.LateCount, @Model.MissedCount],
                        backgroundColor: ['#198754', '#ffc107', '#dc3545'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // 2. Local Storage View Preference Toggle
            var btnList = document.getElementById('btn-list-view');
            var btnCalendar = document.getElementById('btn-calendar-view');
            var listContainer = document.getElementById('list-view-container');
            var calendarContainer = document.getElementById('calendar-view-container');

            function setView(viewType) {
                if (viewType === 'calendar') {
                    // Show calendar, hide list
                    listContainer.classList.add('d-none');
                    calendarContainer.classList.remove('d-none');
                    btnCalendar.classList.add('active-toggle', 'btn-primary');
                    btnCalendar.classList.remove('btn-light');
                    btnList.classList.remove('active-toggle', 'btn-primary');
                    btnList.classList.add('btn-light');
                    localStorage.setItem('mis_report_view_pref', 'calendar');
                } else {
                    // Show list, hide calendar
                    calendarContainer.classList.add('d-none');
                    listContainer.classList.remove('d-none');
                    btnList.classList.add('active-toggle', 'btn-primary');
                    btnList.classList.remove('btn-light');
                    btnCalendar.classList.remove('active-toggle', 'btn-primary');
                    btnCalendar.classList.add('btn-light');
                    localStorage.setItem('mis_report_view_pref', 'list');
                }
            }

            btnList.addEventListener('click', function() {
                setView('list');
            });

            btnCalendar.addEventListener('click', function() {
                setView('calendar');
            });

            // Read preference from local storage (default to calendar)
            var savedPref = localStorage.getItem('mis_report_view_pref');
            if (savedPref === 'list') {
                setView('list');
            } else {
                setView('calendar');
            }
        });
    </script>
}


