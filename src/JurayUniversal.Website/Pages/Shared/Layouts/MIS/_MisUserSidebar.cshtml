@using JurayUniversal.Persistence.EF.SQL
@using JurayUniversal.Domain.Enum
@using Microsoft.AspNetCore.Identity
@inject DashboardDbContext _context
@inject UserManager<JurayUniversal.Domain.Models.Profile> UserManager
@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value?.ToLower() ?? "";
    var activeFeatures = _context.MisFeatures.Where(x => x.Status != JurayUniversal.Domain.Enum.Enum.FeatureBillingStatus.Disabled).Select(x => x.ModuleFolder).ToList();
    var settings = _context.MisSettings.FirstOrDefault();
    string groupAlias = settings?.GroupAlias ?? "Committees & Groups";
    string alumniAlias = settings?.AlumniAlias ?? "Alumni";

    bool showUserMgmt = activeFeatures.Contains("MisUserManagement");
    bool showCommittees = activeFeatures.Contains("MisGroups");
    bool showAlumni = activeFeatures.Contains("MisAlumni");
    bool showReports = activeFeatures.Contains("MisReports");
    bool showForms = activeFeatures.Contains("MisForms") || activeFeatures.Contains("MisSurveys");
    bool showManual = activeFeatures.Contains("MisManual");
    bool showFinances = activeFeatures.Contains("MisFinances");
    bool showTicketing = activeFeatures.Contains("MisTicketing");
    bool showRecruitment = activeFeatures.Contains("MisRecruitment");
    bool showVoting = activeFeatures.Contains("MisVoting");
    bool showAssets = activeFeatures.Contains("MisFleet");
    var currentUserId = UserManager.GetUserId(User);
    bool showProjects = activeFeatures.Contains("MisProjects") && _context.MisProjectUsers.Any(x => x.UserId == currentUserId);
    bool showGrants = activeFeatures.Contains("MisGrants");
    bool showProposals = activeFeatures.Contains("MisProposals");
    bool showMassComm = activeFeatures.Contains("MisMassComm");
    bool showNewsletter = activeFeatures.Contains("MisNewsletter");
}

<div class="menu-header">Core & User Space</div>

<div class="menu-item @(currentPath.EndsWith("/mis/platform/index") || currentPath.EndsWith("/mis/platform") ? "active" : "")">
    <a asp-area="mis" asp-page="/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-laptop"></i></span>
        <span class="menu-text">Platform Home</span>
    </a>
</div>

@if (showUserMgmt)
{
    <div class="menu-item has-sub @(currentPath.Contains("/platform/my") ? "active" : "")">
        <a href="#" class="menu-link">
            <span class="menu-icon"><i class="fa fa-user-circle"></i></span>
            <span class="menu-text">My Profile & KPIs</span>
            <span class="menu-caret"><b class="caret"></b></span>
        </a>
        <div class="menu-submenu">
            <div class="menu-item @(currentPath.Contains("/platform/myprofile") ? "active" : "")">
                <a asp-area="MisUserManagement" asp-page="/Platform/MyProfile" class="menu-link">
                    <span class="menu-text">My Details</span>
                </a>
            </div>
            <div class="menu-item @(currentPath.Contains("/platform/mykpis") ? "active" : "")">
                <a asp-area="MisUserManagement" asp-page="/Platform/MyKpis" class="menu-link">
                    <span class="menu-text">My KPI Scores</span>
                </a>
            </div>
            <div class="menu-item @(currentPath.Contains("/platform/myroles") ? "active" : "")">
                <a asp-area="MisUserManagement" asp-page="/Platform/MyRoles" class="menu-link">
                    <span class="menu-text">My Access Roles</span>
                </a>
            </div>
    <div class="menu-item @(currentPath.Contains("/platform/leaves") ? "active" : "")">
                <a asp-area="MisUserManagement" asp-page="/Platform/Leaves/Index" class="menu-link">
                    <span class="menu-text">My Leaves</span>
                </a>
            </div>
        </div>
    </div>
}

@if (showCommittees)
{
<div class="menu-item @(currentPath.Contains("/misgroups/platform") ? "active" : "")">
    <a href="/MisGroups/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-users"></i></span>
        <span class="menu-text">@groupAlias Directory</span>
    </a>
</div>
}

@if (showMassComm)
{
<div class="menu-item @(currentPath.Contains("/mismasscomm/platform") ? "active" : "")">
    <a href="/MisMassComm/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-envelope text-primary"></i></span>
        <span class="menu-text">SMS Broadcast</span>
    </a>
</div>
}

@if (showNewsletter)
{
<div class="menu-item has-sub @(currentPath.Contains("/misnewsletter") ? "active" : "")">
    <a href="javascript:;" class="menu-link">
        <span class="menu-icon"><i class="fa fa-paper-plane text-primary"></i></span>
        <span class="menu-text">Email Newsletter</span>
        <span class="menu-caret"><b class="caret"></b></span>
    </a>
    <div class="menu-submenu">
        <div class="menu-item @(currentPath.Contains("/misnewsletter/platform/dashboard") ? "active" : "")">
            <a href="/MisNewsletter/Platform/Dashboard/Index" class="menu-link">
                <span class="menu-text">Dashboard & Wallet</span>
            </a>
        </div>
        <div class="menu-item @(currentPath.Contains("/misnewsletter/platform/lists") ? "active" : "")">
            <a href="/MisNewsletter/Platform/Lists/Index" class="menu-link">
                <span class="menu-text">My Mailing Lists</span>
            </a>
        </div>
        <div class="menu-item @(currentPath.Contains("/misnewsletter/platform/campaigns") ? "active" : "")">
            <a href="/MisNewsletter/Platform/Campaigns/Index" class="menu-link">
                <span class="menu-text">My Campaigns</span>
            </a>
        </div>
    </div>
</div>
}

@if (showAlumni)
{
<div class="menu-item @(currentPath.Contains("/misalumni") ? "active" : "")">
    <a href="/MisAlumni/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-graduation-cap"></i></span>
        <span class="menu-text">@alumniAlias Network</span>
    </a>
</div>
}

@if (showReports || showForms || showManual)
{
<div class="menu-divider"></div>

<div class="menu-header">Reports & Surveys</div>

@if (showReports)
{
<div class="menu-item @(currentPath.Contains("/misreports") ? "active" : "")">
    <a href="/MisReports/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-clock text-teal"></i></span>
        <span class="menu-text">My Interval Reports</span>
    </a>
</div>
}

@if (showForms)
{
<div class="menu-item @(currentPath.Contains("/misforms") ? "active" : "")">
    <a href="/MisForms/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-poll-h text-primary"></i></span>
        <span class="menu-text">My Surveys & Forms</span>
    </a>
</div>
}



@if (showManual)
{
<div class="menu-item @(currentPath.StartsWith("/kb") ? "active" : "")">
    <a href="/kb" target="_blank" class="menu-link">
        <span class="menu-icon"><i class="fa fa-book"></i></span>
        <span class="menu-text">Knowledge Base</span>
    </a>
</div>
}
}

@if (showFinances || showTicketing)
{
<div class="menu-divider"></div>

<div class="menu-header">Financials & Monetization</div>

@if (showFinances)
{
<div class="menu-item @(currentPath.Contains("/misfinances") && !currentPath.Contains("/transactionhistory") ? "active" : "")">
    <a href="/MisFinances/Platform/MyFinances" class="menu-link">
        <span class="menu-icon"><i class="fa fa-wallet"></i></span>
        <span class="menu-text">My Finances</span>
    </a>
</div>
}

@if (showTicketing)
{
<div class="menu-item @(currentPath.Contains("/misticketing/platform") ? "active" : "")">
    <a href="/MisTicketing/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-ticket-alt"></i></span>
        <span class="menu-text">My Tickets & Events</span>
    </a>
</div>
}
<div class="menu-item @(currentPath.Contains("/misfinances/platform/transactionhistory") ? "active" : "")">
    <a href="/MisFinances/Platform/TransactionHistory" class="menu-link">
        <span class="menu-icon"><i class="fa fa-history"></i></span>
        <span class="menu-text">Transaction History</span>
    </a>
</div>

@if (showProposals)
{
    <div class="menu-item @(currentPath.Contains("/misproposals/platform") ? "active" : "")">
        <a href="/MisProposals/Platform/Index" class="menu-link">
            <span class="menu-icon"><i class="fa fa-file-signature text-success"></i></span>
            <span class="menu-text">My Pitches & Proposals</span>
        </a>
    </div>
}
}

@if (showVoting || showAssets || showProjects)
{
<div class="menu-divider"></div>

<div class="menu-header">Operations & Workflow</div>

@if (showVoting)
{
<div class="menu-item">
    <a href="/MisVoting/Platform/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-vote-yea"></i></span>
        <span class="menu-text">Vote in Elections</span>
    </a>
</div>
}

@if (showAssets)
{
<div class="menu-item">
    <a href="#" class="menu-link">
        <span class="menu-icon"><i class="fa fa-boxes"></i></span>
        <span class="menu-text">My Assigned Assets</span>
    </a>
</div>
}

@if (showProjects)
{
<div class="menu-item">
    <a href="/MisProjects/User/Index" class="menu-link">
        <span class="menu-icon"><i class="fa fa-tasks"></i></span>
        <span class="menu-text">My Project Tasks</span>
    </a>
</div>
}
}



<div class="menu-divider"></div>

<div class="menu-header">Security</div>

<div class="menu-item @(currentPath.Contains("/platform/changepassword") ? "active" : "")">
    <a asp-area="MisUserManagement" asp-page="/Platform/ChangePassword" class="menu-link">
        <span class="menu-icon"><i class="fa fa-key"></i></span>
        <span class="menu-text">Change Password & 2FA</span>
    </a>
</div>

<div class="menu-item">
    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
        <button type="submit" class="menu-link text-danger border-0 bg-transparent w-100 text-start">
            <span class="menu-icon"><i class="fa fa-sign-out-alt"></i></span>
            <span class="menu-text">Log Out</span>
        </button>
    </form>
</div>