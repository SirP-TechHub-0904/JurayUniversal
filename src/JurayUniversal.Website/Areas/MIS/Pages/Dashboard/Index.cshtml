@page
@model JurayUniversal.Website.Areas.MIS.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Console Home | Universal MIS";
}

<!-- Hide Layout Template Header to Render Custom Dynamic Console Header -->
<style>
    .page-header {
        display: none !important;
    }
    
    .console-bg-gradient {
        background: linear-gradient(135deg, rgba(103, 80, 164, 0.05) 0%, rgba(0, 150, 136, 0.05) 100%);
    }

    .widget-header-drag {
        cursor: grab;
    }

    .feature-card {
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
        border-radius: 12px !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .feature-card:hover {
        transform: translateY(-3px) !important;
        box-shadow: var(--md-shadow-2) !important;
        border-color: rgba(103, 80, 164, 0.3) !important;
    }

    .fav-star {
        cursor: pointer;
        transition: color 0.15s ease;
        color: rgba(0, 0, 0, 0.15);
    }
    .fav-star.active {
        color: #FFC107 !important;
    }

    .recent-service-link {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
    }
    .recent-service-link:hover {
        background-color: rgba(103, 80, 164, 0.06);
    }

    .nav-pills .nav-link {
        border-radius: 20px !important;
        padding: 6px 16px !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        color: rgba(0, 0, 0, 0.6) !important;
        background-color: rgba(0, 0, 0, 0.04) !important;
        margin-right: 6px;
        margin-bottom: 6px;
        border: none !important;
        transition: all 0.15s ease;
    }
    .nav-pills .nav-link.active, .nav-pills .nav-link:hover {
        background-color: var(--md-primary) !important;
        color: #fff !important;
    }

    .badge-status {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 4px 8px;
        border-radius: 4px;
    }

    .timeline-item {
        border-left: 2px solid rgba(103, 80, 164, 0.15);
        padding-left: 15px;
        position: relative;
        padding-bottom: 12px;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -6px;
        top: 4px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--md-primary);
    }
</style>

<div class="container-fluid px-0 console-bg-gradient py-3 rounded-4">
    <!-- Header Controls -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom px-3">
        <div>
            <h1 class="h3 fw-800 text-dark mb-1">Console Home <span class="badge bg-secondary bg-opacity-10 text-secondary fs-12px ms-2">Info</span></h1>
            <p class="text-muted fs-14px mb-0">Launch, configure, and monitor your 25 universal system modules.</p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
            <button class="btn btn-outline-secondary btn-sm" onclick="resetLayout()">
                <i class="fas fa-undo me-2"></i>Reset to default layout
            </button>
            <div class="dropdown">
                <button class="btn btn-primary btn-sm dropdown-toggle" type="button" id="addWidgetBtn" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-plus me-2"></i>Add widgets
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="addWidgetBtn">
                    <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('recent-visited-widget', true)">Recently Visited</a></li>
                    <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('applications-widget', true)">Applications Hub</a></li>
                    <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('financials-widget', true)">Financials Chart</a></li>
                    <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('health-widget', true)">System Health Alert</a></li>
                    <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('ai-widget', true)">AI Assistant Status</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Main Grid Workspace -->
    <div class="row px-3">
        <!-- LEFT COLUMN: 8 Cols on Large, 12 on Mobile -->
        <div class="col-xl-8 col-lg-7 d-flex flex-column gap-4">
            
            <!-- WIDGET 1: Recently Visited -->
            <div class="card" id="recent-visited-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-history text-primary"></i>
                            <h5 class="card-title fw-700 mb-0">Recently Visited</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" id="recentDropdown" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item text-danger" href="javascript:;" onclick="clearRecentlyVisited()">Clear history</a></li>
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('recent-visited-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="row g-2" id="recent-list-container">
                        <!-- Loaded dynamically via script -->
                    </div>
                    <div class="text-end mt-2">
                        <a href="#applications-section" class="text-primary fw-600 fs-13px text-decoration-none">View all services <i class="fas fa-chevron-right ms-1 fs-11px"></i></a>
                    </div>
                </div>
            </div>

            <!-- WIDGET 2: Applications Hub -->
            <div class="card" id="applications-widget">
                <div class="card-body p-4" id="applications-section">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-th text-teal"></i>
                            <h5 class="card-title fw-700 mb-0">Applications & Modules Hub <span class="text-muted fw-400 fs-14px" id="modules-count">(25)</span></h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" id="appWidgetDropdown" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('applications-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Filter & Search Panel -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" id="searchFeatures" class="form-control border-start-0 py-2" placeholder="Search features (e.g. directory, ticketing, AI)..." onkeyup="filterFeatures()">
                            </div>
                        </div>
                        <div class="col-md-5 text-md-end d-flex align-items-center justify-content-md-end gap-2">
                            <select class="form-select border rounded-pill py-1 fs-13px" style="width: auto;" id="statusFilter" onchange="filterFeatures()">
                                <option value="all">All States</option>
                                <option value="Active">Active</option>
                                <option value="Setup Pending">Pending Setup</option>
                            </select>
                            <button class="btn btn-outline-primary btn-sm rounded-pill" onclick="triggerCreateFeature()">
                                <i class="fas fa-plus me-1"></i> New Module
                            </button>
                        </div>
                    </div>

                    <!-- Category Pills -->
                    <div class="d-flex flex-wrap mb-4" id="category-tabs-container">
                        <button class="nav-link active" id="tab-all" onclick="setCategory('all')">All</button>
                        <button class="nav-link" id="tab-core" onclick="setCategory('core')">Core & People</button>
                        <button class="nav-link" id="tab-reports" onclick="setCategory('reports')">Reports & Docs</button>
                        <button class="nav-link" id="tab-financials" onclick="setCategory('financials')">Financials</button>
                        <button class="nav-link" id="tab-operations" onclick="setCategory('operations')">Operations</button>
                        <button class="nav-link" id="tab-tech" onclick="setCategory('tech')">Comms & Tech</button>
                        <button class="nav-link" id="tab-compliance" onclick="setCategory('compliance')">Compliance</button>
                    </div>

                    <!-- Features Dynamic Grid -->
                    <div class="row g-3" id="features-grid">
                        <!-- Loaded dynamically via script -->
                    </div>

                    <!-- Pagination / Footer link -->
                    <div class="d-flex align-items-center justify-content-between border-top pt-3 mt-4 fs-13px">
                        <span class="text-muted" id="showing-summary">Showing 25 of 25 features</span>
                        <a href="https://seantheme.com/studio/documentation/index.html" class="text-primary text-decoration-none fw-600">Go to myApplications <i class="fas fa-external-link-alt ms-1 fs-11px"></i></a>
                    </div>
                </div>
            </div>

            <!-- WIDGET 3: Solutions & Recipes Templates -->
            <div class="card mb-4" id="solutions-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="fas fa-lightbulb text-warning"></i>
                        <h5 class="card-title fw-700 mb-0">Solutions & Action Recipes <span class="badge bg-primary bg-opacity-10 text-primary fs-11px">Ready</span></h5>
                    </div>
                    <p class="text-muted fs-13px mb-4">Select a pre-designed action flow to deploy standard assets instantly.</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h6 class="fw-700 mb-0">Survey Data Collector</h6>
                                        <span class="badge bg-success bg-opacity-10 text-success fs-10px">1-Click</span>
                                    </div>
                                    <p class="text-muted fs-12px mb-3">Generate a Drag-and-Drop survey linked to dynamic graphic reports.</p>
                                </div>
                                <a href="javascript:;" onclick="runActionRecipe('Survey Data Collector')" class="btn btn-outline-primary btn-sm text-center w-100 rounded-pill">Deploy recipe</a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h6 class="fw-700 mb-0">Secure Election Setup</h6>
                                        <span class="badge bg-warning bg-opacity-10 text-warning fs-10px">Secure</span>
                                    </div>
                                    <p class="text-muted fs-12px mb-3">Setup secure digital balloting lists and configure automatic tabulations.</p>
                                </div>
                                <a href="javascript:;" onclick="runActionRecipe('Election Setup')" class="btn btn-outline-primary btn-sm text-center w-100 rounded-pill">Deploy recipe</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: 4 Cols on Large, 12 on Mobile -->
        <div class="col-xl-4 col-lg-5 d-flex flex-column gap-4">
            
            <!-- WIDGET 4: Welcome / Quick Start -->
            <partial name="~/Pages/Shared/Layouts/MIS/_DashboardWelcome.cshtml" />

            <!-- WIDGET 5: Health & Notifications -->
            <div class="card" id="health-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-heartbeat text-danger"></i>
                            <h5 class="card-title fw-700 mb-0">System Health & Alert Hub</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" id="healthDropdown" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('health-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Health Status Indicator -->
                    <div class="d-flex align-items-center justify-content-between mb-4 p-3 border rounded-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
                            <div>
                                <div class="fw-700 fs-13px text-dark">Services Healthy</div>
                                <div class="text-muted fs-11px">All 25 modules responsive</div>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success">Healthy</span>
                    </div>

                    <!-- System Data Feeds (connected to backing DB repository counts) -->
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <div class="p-2 border rounded text-center">
                                <div class="text-muted fs-11px mb-1">Total Users</div>
                                <h4 class="fw-800 text-primary mb-0">@Model.TotalUsers</h4>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded text-center">
                                <div class="text-muted fs-11px mb-1">Active Users</div>
                                <h4 class="fw-800 text-success mb-0">@Model.ActiveUsers</h4>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded text-center">
                                <div class="text-muted fs-11px mb-1">Pending Users</div>
                                <h4 class="fw-800 text-warning mb-0">@Model.PendingUsers</h4>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded text-center">
                                <div class="text-muted fs-11px mb-1">Suspended</div>
                                <h4 class="fw-800 text-danger mb-0">@Model.SuspendedUsers</h4>
                            </div>
                        </div>
                    </div>

                    <!-- Notifications Timeline -->
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-700 fs-13px">Dynamic Interval Reports Due</span>
                                <span class="text-muted fs-11px">2h ago</span>
                            </div>
                            <p class="text-muted fs-12px mb-0">2 Scheduled Category Reports are pending user input updates.</p>
                        </div>
                        <div class="timeline-item">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-700 fs-13px">Anonymous Whistleblowing Alert</span>
                                <span class="text-muted fs-11px">1d ago</span>
                            </div>
                            <p class="text-muted fs-12px mb-0">1 encrypted anonymous whistleblower report submitted (Finance category).</p>
                        </div>
                        <div class="timeline-item">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-700 fs-13px">Visitor Gate Request</span>
                                <span class="text-muted fs-11px">Just now</span>
                            </div>
                            <p class="text-muted fs-12px mb-0">Security desk registered visitor: Arrived for interview (Host notified).</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- WIDGET 6: Financials & Cost/Usage Equivalent -->
            <div class="card" id="financials-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-coins text-warning"></i>
                            <h5 class="card-title fw-700 mb-0">Financials & Monetization</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" id="financialDropdown" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('financials-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Metrics row -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="fs-12px text-muted">Current Month intake</div>
                            <h3 class="fw-800 text-dark mb-0">$14,285.50</h3>
                            <div class="text-success fs-11px fw-600"><i class="fas fa-caret-up me-1"></i>12.4% increase</div>
                        </div>
                        <div class="col-6">
                            <div class="fs-12px text-muted">Forecasted Month End</div>
                            <h3 class="fw-800 text-secondary mb-0">$18,450.00</h3>
                            <div class="text-success fs-11px fw-600"><i class="fas fa-caret-up me-1"></i>4.6% increase</div>
                        </div>
                    </div>

                    <!-- Financial Chart Container (Instantiated by ApexCharts) -->
                    <div id="revenue-chart" style="min-height: 250px;"></div>

                    <div class="text-center mt-3">
                        <a href="javascript:;" class="text-primary fw-600 fs-13px text-decoration-none">Go to Billing and Dues Management</a>
                    </div>
                </div>
            </div>

            <!-- WIDGET 7: BYOK AI Engine Key Status -->
            <div class="card" id="ai-widget">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-brain text-purple"></i>
                            <h5 class="card-title fw-700 mb-0">BYOK AI Integration</h5>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0 fs-14px" id="aiDropdown" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="javascript:;" onclick="toggleWidget('ai-widget', false)">Hide widget</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Status Indicator -->
                    <div class="p-3 border rounded-3 mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fs-12px fw-600 text-muted">Gemini API status</span>
                            <span class="badge bg-success bg-opacity-10 text-success">Active & Healthy</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fs-12px fw-600 text-muted">Claude API status</span>
                            <span class="badge bg-warning bg-opacity-10 text-warning">Setup Pending</span>
                        </div>
                    </div>

                    <div class="progress mb-2" style="height: 6px">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 65%" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between text-muted fs-11px mb-3">
                        <span>BYOK Monthly Token limit</span>
                        <span>65,482 / 100,000 tokens used</span>
                    </div>

                    <button class="btn btn-outline-primary btn-sm w-100 rounded-pill" onclick="openAIConfig()">Configure API Keys</button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ================== SCRIPTS BLOCK ================== -->
