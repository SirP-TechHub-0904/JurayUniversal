@page
@model JurayUniversal.Website.Areas.Admin.Pages.IAttendance.TakeAttendanceModel

@{
    ViewData["Title"] = "Take Attendance";
}

<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">TAKE ATTENDANCE</h3>
    </div>

    <div class="card-body">
        <form method="post">
            <div class="form-group">
                <label asp-for="AttendanceDate">Date</label>
                <input asp-for="AttendanceDate" type="date" class="form-control" />
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width:38%;">Staff</th>
                            <th style="width:12%;">Present</th>
                            <th style="width:12%;">Late</th>
                            <th style="width:38%;">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Staff.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model.Staff[i].FullName
                                    <input type="hidden" asp-for="Staff[i].UserId" />
                                    <input type="hidden" asp-for="Staff[i].FullName" />
                                </td>
                                <td>
                                    <input asp-for="Staff[i].Present" type="checkbox" />
                                </td>
                                <td>
                                    <input asp-for="Staff[i].Late" type="checkbox" />
                                </td>
                                <td>
                                    <input asp-for="Staff[i].Note" class="form-control" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn btn-primary">Submit Attendance</button>
        </form>
    </div>
</div>