@page
@model JurayUniversal.Website.Areas.MisProjects.Pages.Backlog.CreateSprintModel
@{
    ViewData["Title"] = "New Sprint";
    ViewData["Subtitle"] = Model.MisProject.Name + " Planning";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form method="post">
            <input type="hidden" asp-for="MisProjectSprint.MisProjectId" value="@Model.MisProject.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="MisProjectSprint.SprintName" class="form-label fw-bold"></label>
                <input asp-for="MisProjectSprint.SprintName" class="form-control" required placeholder="e.g. Sprint 1, Version 2.0 MVP" />
                <span asp-validation-for="MisProjectSprint.SprintName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MisProjectSprint.Goal" class="form-label fw-bold"></label>
                <textarea asp-for="MisProjectSprint.Goal" class="form-control" rows="3" placeholder="What is the main goal of this sprint?"></textarea>
                <span asp-validation-for="MisProjectSprint.Goal" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MisProjectSprint.StartDate" class="form-label fw-bold"></label>
                    <input asp-for="MisProjectSprint.StartDate" type="date" class="form-control" required />
                    <span asp-validation-for="MisProjectSprint.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MisProjectSprint.EndDate" class="form-label fw-bold"></label>
                    <input asp-for="MisProjectSprint.EndDate" type="date" class="form-control" required />
                    <span asp-validation-for="MisProjectSprint.EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-page="./Index" asp-route-projectId="@Model.MisProject.Id" class="btn btn-outline-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">Create Sprint</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
